+            f"({type(_aiter_import_err).__name__}: {_aiter_import_err}). "
+            f"Falling back to TE native kernels. "
+            f"Set NVTE_USE_AITER_ROPE=0 to silence this warning."
+        )
+
+if _HAVE_AITER_ROPE:
+    _te_rope_logger.info("[TE-RoPE] Using AITER fused RoPE kernels (aiter.ops.rope)")
