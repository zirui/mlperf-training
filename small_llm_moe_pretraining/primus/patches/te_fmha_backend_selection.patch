+# ---------------------------------------------------------------------------
+# FMHA backend override for independent SWA / Dense + Fwd / Bwd control
+# ---------------------------------------------------------------------------
+_FMHA_DEBUG = os.getenv("NVTE_FMHA_DEBUG", "0") == "1"
+_FMHA_DEBUG_CALL_COUNT = 0
+_FMHA_DEBUG_MAX_LOGS = int(os.getenv("NVTE_FMHA_DEBUG_MAX_LOGS", "20"))
+
+
+def _fmha_debug_log(direction, attn_type, backend, v3_flag, q_shape, window_size, overridden):
+    """Print FMHA dispatch info when NVTE_FMHA_DEBUG=1."""
+    global _FMHA_DEBUG_CALL_COUNT
+    if not _FMHA_DEBUG:
+        return
+    _FMHA_DEBUG_CALL_COUNT += 1
+    if _FMHA_DEBUG_CALL_COUNT > _FMHA_DEBUG_MAX_LOGS:
+        return
+    hdim = q_shape[-1] if len(q_shape) >= 1 else "?"
+    v3_env = os.environ.get(f"NVTE_CK_USES_{direction.upper()}_V3", "unset")
+    tag = "[FMHA]"
+    ov_str = " (OVERRIDDEN)" if overridden else ""
+    print(
+        f"{tag} {direction} {attn_type} backend={backend} v3_env={v3_env} "
+        f"v3_override={v3_flag} hdim={hdim} window={window_size}{ov_str}",
+        flush=True,
+    )
+
+
+def _is_swa_window(window_size):
+    """Return True if window_size indicates sliding window attention."""
+    if window_size is None:
+        return False
+    return window_size[0] >= 0
+
+
+def _get_fmha_override(is_swa, is_fwd):
+    """Return (backend_override, v3_str_override) based on env vars.
+
+    Env vars (HIP/ROCm only):
+        NVTE_FMHA_BACKEND_DENSE_FWD  - backend for dense fwd  (ck_v3 | ck | aotriton)
+        NVTE_FMHA_BACKEND_DENSE_BWD  - backend for dense bwd  (ck_v3 | ck | aotriton)
+        NVTE_FMHA_BACKEND_SWA_FWD    - backend for SWA fwd    (ck | aotriton)
+        NVTE_FMHA_BACKEND_SWA_BWD    - backend for SWA bwd    (ck | aotriton)
+
+    Returns
+    -------
+    backend_override : NVTE_Fused_Attn_Backend value, or None
+    v3_str           : "1" / "0" / None  (sets NVTE_CK_USES_{FWD,BWD}_V3)
+    """
+    if not IS_HIP_EXTENSION:
+        return None, None
+
+    if is_swa:
+        env_var = "NVTE_FMHA_BACKEND_SWA_FWD" if is_fwd else "NVTE_FMHA_BACKEND_SWA_BWD"
+    else:
+        env_var = "NVTE_FMHA_BACKEND_DENSE_FWD" if is_fwd else "NVTE_FMHA_BACKEND_DENSE_BWD"
+
+    val = os.getenv(env_var, "").strip().lower()
+    if not val:
+        return None, None
+
+    if val == "ck":
+        return FusedAttnBackend["CK"], "0"
+    if val == "ck_v3":
+        if is_swa:
+            warnings.warn(
+                f"{env_var}=ck_v3 requested but CK v3 ASM does not support SWA. "
+                "Falling back to CK (CK-tile)."
+            )
+            return FusedAttnBackend["CK"], "0"
+        return FusedAttnBackend["CK"], "1"
+    if val == "aotriton":
+        return FusedAttnBackend["AOTriton"], None
+    warnings.warn(
+        f"Unknown FMHA backend \'{val}\' for {env_var}. "
+        "Valid options: ck, ck_v3, aotriton. Ignoring."
+    )
+    return None, None
+
+
