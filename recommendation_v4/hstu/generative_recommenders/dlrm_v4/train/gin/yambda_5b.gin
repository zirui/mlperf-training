# Per-rank batch size. Env-overridable so a denser per-sample shape can fit in
# HBM by lowering it without editing gin. Default 1024;
# streaming train+eval both read this macro (make_*streaming_dataloader.batch_size).
batch_size = @bs/env_int()
bs/env_int.key     = "BATCH_SIZE"
bs/env_int.default = 1024
# Dataloader parallelism. Env-overridable (NUM_WORKERS / PREFETCH_FACTOR).
# Default 6 workers per train pool. Eval pools have their own count
# (EVAL_NUM_WORKERS).
num_workers = @nw/env_int()
nw/env_int.key     = "NUM_WORKERS"
nw/env_int.default = 6
prefetch_factor = @pf/env_int()
pf/env_int.key     = "PREFETCH_FACTOR"
pf/env_int.default = 8
dataset = "yambda-5b"

# model parameters
make_model.dataset = %dataset
make_model.bf16_training = True
# Give the HSTU transducer subtree a bf16 _training_dtype. HammerModule defaults
# it to fp32, so without this the transducer's entry cast upcasts the bf16
# embedding back to fp32 and the autocast immediately below re-casts it to
# bf16 — four full-size [tokens, 512] copies per step (two forward, two in the
# backward).
# Scoped to the transducer: _multitask_module gates an autocast on the same
# attribute but runs outside that autocast, so it is deliberately left fp32.
#
# The forward is bit-identical; the backward is not.
# Default 1 = on; $TRANSDUCER_BF16_DTYPE=0 opts out without giving up bf16
# training.
make_model.transducer_bf16_dtype = @tbd/env_int()
tbd/env_int.key     = "TRANSDUCER_BF16_DTYPE"
tbd/env_int.default = 1
# HSTU attention/compute backend: "TRITON" (fused, flash-style — low HBM) or
# "PYTORCH" (unfused; materializes the dense [B,H,N,N] score tensor, ~32 GiB at
# N=2048/bs=1024). TRITON validated on MI350/ROCm. The HSTU_HAMMER_KERNEL env
# var, if set, overrides this binding for one-off runs.
#
# THIS PICKS THE DISPATCH PATH, NOT EVERY KERNEL ON IT. Narrower knobs below
# re-decide individual kernels inside the path chosen here, so "TRITON" does not
# mean every HSTU kernel is a Triton one:
#   apply_env_bootstrap.HSTU_ATTN_BWD        — replaces the attention BACKWARD
#     with the FlyDSL gfx950 kernel, which is the DEFAULT.
#   apply_env_bootstrap.HSTU_ATTN_FWD        — the same for the FORWARD
#     (default FlyDSL on gfx950). So a stock "TRITON" run is really
#     FlyDSL-forward + FlyDSL-backward on MI350X.
#   apply_env_bootstrap.TRITON_FULL_AUTOTUNE — which config the Triton kernels
#     that do remain are compiled with.
#   apply_env_bootstrap.TRITON_HSTU_FAST_INTERIOR — drops mask work on the
#     attention tiles that cannot contain a masked element.
#   apply_env_bootstrap.TRITON_HSTU_LAST_LAYER_TARGETS_ONLY — shrinks the final
#     layer to the one row per sequence the loss actually reads.
# So this binding is not the ground truth for what ran. Read the run's
# `[hstu-attn] backward kernel: ...` line, or the kernel names in a trace.
make_model.hammer_kernel = "TRITON"

# False = use pinned triton kernel configs (deterministic; whether that's
# the fast or slow equilibrium depends on which config was pinned for the
# current training shape + GPU). For a NEW training config (new shape,
# new GPU, new triton/torch version), set True and run with
# TRITON_PRINT_AUTOTUNING=1 to discover the fast configs, then update the
# pinned constants in ops/triton/_autotune_pinning.py call sites.
apply_env_bootstrap.TRITON_FULL_AUTOTUNE = False

# Which HSTU projection GEMMs run on a pinned hipBLASLt solution instead of the
# heuristic pick. TunableOp cannot cache a solution on its own because its key
# includes the jagged token count, which changes every step; the pin table in
# ops/blas_solution_pins.py synthesises the cache entry for whatever count the
# batch has. "0" disables, "1" enables the whole table, or name pins directly.
#
# uvqk_dgrad is not pinned: no solution beats the heuristic pick there, and a
# solution tuned without a numerical check computes the wrong answer for that
# shape (eval NE goes to NaN). targets_vk_wgrad covers the targets-only last
# layer; its dgrad is not pinned for the same reason as uvqk_dgrad.
#
# Three wgrad pins are bit-identical to the default at every realistic token
# count. The other three differ by one to two bf16 ULPs, which is ordinary
# reassociation. Set this to "uvqk_wgrad,out_wgrad,targets_vk_wgrad" for the
# strictly bit-identical subset if a run must not change numerics at all.
#
# Re-tune with PYTORCH_TUNABLEOP_NUMERICAL_CHECK set, never without, and
# re-time any selected solution against the default before pinning it.
#
# OVERLAP WITH FP8: with FUSE_QKV and FUSE_OUTLN the uvqk and output
# projections become torch._scaled_mm calls, while every key in the pin table
# is a BFloat16 TunableOp signature (GemmAndBiasTunableOp_BFloat16_NN and
# friends) that a scaled-gemm key cannot match, so uvqk_fwd and out_fwd stop
# applying. DLRM_HSTU_FP8_BWD=1 turns the output projection's dgrad into a
# torch._scaled_mm call as well, so out_dgrad stops applying too and only
# uvqk_wgrad and out_wgrad still apply.
#
# The launch log reports the pins as installed; that line says
# they were registered, not that a runtime key matched them.
# preproc_*: ContextualPreprocessor MLP GEMMs (dgrad, L2 fwd, wgrad), all
# bit-identical to the heuristic; see blas_solution_pins.py.
apply_env_bootstrap.GR_PIN_BF16_BLAS_SOLUTIONS = "uvqk_fwd,uvqk_wgrad,out_fwd,out_wgrad,out_dgrad,targets_vk_wgrad,preproc_dgrad_n1024,preproc_dgrad_n512,preproc_l2_fwd,preproc_wgrad_n1024"

# Which kernel computes the HSTU attention BACKWARD (the forward is chosen
# separately by HSTU_ATTN_FWD below). Applies only when
# make_model.hammer_kernel selects TRITON above — it is inert on the PYTORCH,
# TRITON_CC and TRITON_INFERENCE paths, which never reach this dispatch.
#   "flydsl" — the gfx950 FlyDSL backward (ops/flydsl/).
#   "triton" — the production fused Triton backward, and the numerical reference
#              the FlyDSL one is judged against.
# gfx950-ONLY. Anywhere else this must be "triton" — an unsupported host RAISES
# rather than quietly running the Triton backward. The HSTU_ATTN_BWD env var overrides this
# binding, so a B200 launcher opts out without editing this AMD-default file.
apply_env_bootstrap.HSTU_ATTN_BWD = "flydsl"

# Which kernel computes the HSTU attention FORWARD. Selected independently of the
# backward because the two are decoupled: HSTU has no softmax, so the forward
# hands the backward no lse and no rowsum(dO*O), and either half can run on
# FlyDSL while the other stays on Triton.
#   "flydsl" — the gfx950 FlyDSL forward (ops/flydsl/hstu_fwd.py).
#   "triton" — the production fused Triton forward, and the numerical reference.
#
# BIT-IDENTICAL to the Triton forward through the fused path -- both accumulate
# both gemms in f32 and round once to bf16, and f32 reassociation (~1e-7
# relative) is far below bf16's quantization step.
#
# With DLRM_HSTU_FP8_FWD on, this knob selects the FlyDSL e4m3
# forward (fused-silu epilogue included) rather than the Triton e4m3 forward.
# Default "flydsl". Opt out with $HSTU_ATTN_FWD=triton. gfx950-only; an unsupported
# host RAISES when flydsl is selected rather than falling back -- a non-gfx950
# launcher sets HSTU_ATTN_FWD=triton the same way it already sets
# HSTU_ATTN_BWD=triton.
apply_env_bootstrap.HSTU_ATTN_FWD = "flydsl"

# Skip mask evaluation on attention tiles that are provably all-ones. A tile
# strictly below the causal diagonal and strictly inside the history region has
# no masked element, so the compare/select work is pure overhead; the kernel
# splits the key loop into that interior span plus the boundary tiles that still
# need the mask. EXACT — the forward output and every gradient are bit-identical
# to the unspecialized kernel (verified at the production shape), so this is a
# pure work removal, not an approximation.
#
# SCOPE: the Triton forward always. The Triton BACKWARD only when
# HSTU_ATTN_BWD="triton" above — under the "flydsl" default the FlyDSL kernel
# owns the backward and never reaches this code, so on gfx950 this knob is a
# forward-only change. Inert with max_attn_len != 0 (a window's lower bound can
# invalidate otherwise-causal elements, so those tiles keep the masked path).
# Override per-run via $TRITON_HSTU_FAST_INTERIOR.
apply_env_bootstrap.TRITON_HSTU_FAST_INTERIOR = True

# In the LAST HSTU layer, compute U/Q for only the one candidate row per
# sequence instead of all L rows. That row is the only one whose output the loss
# consumes, so the full-length U/Q projection, the full attention, and the full
# output projection are all discarded work; K/V stay full length because the
# candidate attends over the entire history. Exact in math (the surviving row is
# the same function of the same inputs, and the dropout mask is drawn with the
# candidate's own RNG row indices so the mask stream matches the full path),
# though not bit-identical: the compacted reductions run in a different order.
#
# GUARDED AT RUNTIME. It activates only for a shape where the rewrite is
# provably equivalent — not inference, non-listwise, exactly one
# non-interleaved suffix target per sequence, target-aware causal attention, no
# contextual/window mask, no group norm, no full-embedding consumer, and the
# Triton kernel path. Anything else silently takes the normal full-length
# forward, so this is safe to leave on across configs. See
# STULayer.supports_targets_only.
#
# NOTE FOR PERF ACCOUNTING: this removes real FLOPs, but the MFU estimate in
# dlrm_hstu.py still charges every layer at full sequence length, so reported
# MFU is inflated while this is on. Compare ms/step, not MFU.
# Override per-run via $TRITON_HSTU_LAST_LAYER_TARGETS_ONLY.
apply_env_bootstrap.TRITON_HSTU_LAST_LAYER_TARGETS_ONLY = True

# Whether the eval passes take that same path. The holdout batches are one
# target per sequence just like the training ones, so the rewrite is equally
# exact there, and eval was paying a full-length last layer for no reason.
# Separate from the knob above so eval can change without changing
# training: eval numerics are what the convergence metric and the RCP
# comparison are built on, and reduction order shifts them in the last digits.
# Override per-run via $TRITON_HSTU_TARGETS_ONLY_EVAL.
apply_env_bootstrap.TRITON_HSTU_TARGETS_ONLY_EVAL = True

# ARM-PRINT: one-write arming lines (logging only; bit-identical)
#     WHAT: ops/utils.arm_print_all_ranks (the every-rank "armed OK ... [rank
#     N]" lines of the LN-family, L11, DO8, maskgen, LPT and EC knobs) writes
#     each line as ONE os.write of "\n<msg> [rank N]\n" instead of print().
#     WHY: a launcher may pipe the trainer's stdout+stderr through a filter
#     for hipBLASLt's untuned-shape warning, which eight ranks write token by
#     token into the same pipe. A line printed while a token waits for its
#     newline shares the token's physical line and is deleted with it. The
#     leading newline gives the line a physical line of its own (a write of at
#     most PIPE_BUF bytes to a pipe is atomic).
#     NUMERICS: none (logging only). The text of every line is unchanged; an
#     empty line before each arming line is the only visible difference.
#     FALLBACK: print() when stdout has no file descriptor (e.g. a
#     redirect_stdout) or the write fails before any byte.
#     Opt out: DLRM_HSTU_FP8_ARM_PRINT_ATOMIC=0 (env wins; read per call).
apply_env_bootstrap.DLRM_HSTU_FP8_ARM_PRINT_ATOMIC = True

# -----------------------------------------------------------------------------
# FP8 HSTU. Runs the HSTU linear layers and attention on 1-byte e4m3 operands
# with per-tensor scales that are calibrated for a few steps and then FROZEN, so
# the steady-state step computes no amax and reads nothing back from the device.
# The control path (embeddings, optimizer, loss, comms) stays bf16.
#
# Code default OFF, and off means absent: DLRM_HSTU_FP8_FWD below is the only
# switch, and _env_bootstrap exports none of the arm's knobs unless it resolves
# on. So a run with it off is byte-identical to one where this section was
# deleted — worth knowing because one of the knobs (SAVE_UVQK_LAYERS) is parsed
# on the bf16 path too and raises on a layer that no STUStack owns.
#
# MEMORY: the arm keeps quantized copies that have no bf16 tensor to replace,
# so it raises worst-rank HBM; a longer max_seq_len, a bigger batch, or a
# larger HBM_CAP_GB reduces the remaining headroom.
#
# gfx950-ONLY, and it FAILS CLOSED (see FAIL_CLOSED below) rather than falling
# back. Every knob honors its env var over the preset, so a per-run override or a
# non-gfx950 launcher opts out without editing this AMD-default file.

# THE ONE KNOB, and it is ON. The whole arm below applies; off, this
# section is inert and nothing is exported. Turn it off per-run via
# $DLRM_HSTU_FP8_FWD=0. It is gfx950-only and fails closed, which is the same
# contract HSTU_ATTN_BWD=flydsl above carries as a default -- a non-gfx950
# launcher opts out with $DLRM_HSTU_FP8_FWD=0 the way it passes
# HSTU_ATTN_BWD=triton, rather than editing this AMD-default file.
apply_env_bootstrap.DLRM_HSTU_FP8_FWD = True

# The backward half, as a separate knob. This switch IS the arm
# -- the output-projection dgrad in e5m2, its scale controller and the refresh
# cadence all follow from it; ops/triton/bwd_fp8.py reads it directly.
#
# ON alongside the forward; bf16 forward plus FP8 backward is not a validated
# combination. Turn it off per-run with $DLRM_HSTU_FP8_BWD=0.
apply_env_bootstrap.DLRM_HSTU_FP8_BWD = True

# Attention-backward qk GEMM math. Independent of DLRM_HSTU_FP8_BWD (that knob
# is the output-projection dgrad). Default fp8: k128 fp8 MFMA on calls whose
# q AND k are already e4m3; calibration (bf16 q/k) stays on bf16 math. Opt
# out per-run with $DLRM_HSTU_FP8_BWD_QK_MFMA=bf16.
#   "fp8"        default.
#   "bf16"       explicit opt-out.
#   "fp8_strict" raise if any call is not e4m3 q and k. Kernel benches only;
#                a trainer's calibration window will abort.
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_QK_MFMA = "fp8"

# -----------------------------------------------------------------------------
# Six independent switches.
# A pre-set env var wins, as for every binding above (absent = off in the
# kernel modules, except GC_FREEZE and FLYDSL_CURRENT_STREAM, which default ON
# when absent). Opt out of any one per run with <KNOB>=0 in the launcher env.
# The DLRM_HSTU_FP8_ prefix on the non-FP8 knobs (GC_FREEZE,
# FLYDSL_CURRENT_STREAM, SYNCFREE) lets a launcher that forwards every
# DLRM_HSTU_FP8_* name pass them through.
#
# C8  Full-FP8 attention backward.
#     WHAT: all five FlyDSL bwd_dkdv GEMMs on the f8f6f4 MFMA (k128). dO is
#     quantized to e4m3 with one pow2 scale per (sequence, head, 32-token MX
#     K-block group) (ops/flydsl/hstu_do_fp8.py quantize_do_e4m3_blk), undone
#     inside the out-gemm MFMAs through their E8M0 scale operands, and the
#     e4m3 casts of silu/ds saturate at +-448 (gfx950 cvt_scalef32_pk_fp8_f32
#     returns NaN, not 448, on overflow). Block dO scales + saturation are the
#     ONLY C8 path; the old DLRM_HSTU_FP8_BWD_FULL_DOBLK / _SAT knobs were
#     removed and setting either to 0 raises. A call shape the block path
#     cannot serve (needs BM=64, BN%128==0, pow2 heads and heads*dim) runs
#     the bf16-dO kernel, logged once ("f8b_full_skip_shape").
#     NUMERICS: PRECISION CHANGE (e4m3 dq/dk/dv operands); dk/dv sit at the
#     e4m3 mantissa floor.
#     WHY BLOCK SCALES: real dO rows span several orders of magnitude, so a
#     single per-tensor dO scale flushes most small rows to zero and loses
#     their dq. Per-block scales keep small-row dq.
#     ARMED log: "FULL-FP8 backward ARMED ... do_blk=1 ... sat=1". Opt out:
#     DLRM_HSTU_FP8_BWD_FULL=0.
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_FULL = True
#
# 16-bit Philox dropout decisions.
#     WHAT: dropout keep decisions from the 16-bit halves of each Philox
#     output instead of one 32-bit value each (half the Philox work).
#     NUMERICS: RNG-STREAM CHANGE. Same keep-probability, different dropout
#     masks; not bit-comparable to the 32-bit path.
#     WHY SAFE: dropout is still Bernoulli at the configured rate; only which
#     elements drop changes.
#     ARMED log: "armed OK: dropout mask16 ACTIVE".
#     Opt out: DLRM_HSTU_FP8_MASK16=0.
apply_env_bootstrap.DLRM_HSTU_FP8_MASK16 = True
#
# FlyDSL bwd_dkdv SiLU/grad-coefficient epilogue: "legacy" | "reuse".
#     WHAT: share sig/N between SiLU and its derivative and fold the
#     grad-coefficient into one fma, so the VALU-bound epilogue issues fewer
#     ops.
#     NUMERICS: ~1 ULP. Same math in real arithmetic, different f32 rounding
#     order.
#     WHY SAFE: identical formula; only f32 operation order differs.
#     Opt out: DLRM_HSTU_FP8_BWD_EPILOGUE=legacy.
#     "reuse_pk" (used by the dq-split C8 backward below) is the same "reuse" chain on packed f32
#     (v_pk_mul/add/fma_f32): bitwise equal outputs, fewer registers, no spills.
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_EPILOGUE = "reuse_pk"
#
# GC freeze (train/utils.py _collect_and_freeze_gc).
#     WHAT: one gc.collect() + gc.freeze() on every rank right before the
#     first window rendezvous. Without it each rank runs its first full
#     (gen-2) Python GC (hundreds of ms on the main thread) at whatever step its
#     own promotion count crosses CPython's threshold -- a different step per
#     rank -- and every other rank stalls at the next collective.
#     NUMERICS: BIT-IDENTICAL. Host-side Python memory management only; no
#     tensor or kernel changes. Frozen objects are still freed by refcount.
#     WHY SAFE: runs once, before training; collected only once (never
#     re-frozen per window).
#     ARMED log: "armed OK: gc_freeze ACTIVE". Opt out:
#     DLRM_HSTU_FP8_GC_FREEZE=0 (logs "gc_freeze OFF").
apply_env_bootstrap.DLRM_HSTU_FP8_GC_FREEZE = True
#
# FlyDSL current-stream launch.
#     WHAT: FlyDSL attention fwd/bwd launch on torch.cuda.current_stream()
#     instead of launch()'s default HIP null stream, which does not order
#     against PyTorch's non-blocking side streams.
#     NUMERICS: same results on the default stream (same handle; out/dk/dv
#     bitwise equal, dq differs only at atomic-order noise).
#     WHY: a correctness fix. It is the prerequisite for the host-sync-free
#     step below: a launch issued while a side stream is current races its
#     own producers. Logs "[flydsl] launch stream: current|legacy" once.
#     Opt out: DLRM_HSTU_FP8_FLYDSL_CURRENT_STREAM=0 (launch()'s default
#     stream); refused at startup while DLRM_HSTU_FP8_SYNCFREE=1.
apply_env_bootstrap.DLRM_HSTU_FP8_FLYDSL_CURRENT_STREAM = True
#
# Host-sync-free step (dlrm_v4/host_sync_free.py).
#     WHAT: removes every per-step blocking host read that empties the GPU
#     queue (GAUC max_length .item(), fx_length_stats .tolist(), MLPerf
#     train-loss float(), torchrec KJT length_per_key D2H): length stats and
#     length_per_key come from the CPU lengths before the H2D copy (sent with
#     the existing splits all_to_all), the loss is read one step late from a
#     pinned copy (same value, same MLLOG order), and a one-step event fence
#     bounds the host lead. It uses one configuration for every
#     node count: the forward's dist_init runs on the main stream (with
#     record_stream on the all-to-all buffers) and the deferred splits wait is
#     issued only once the collective has completed (_SPLITWAIT_POLL, default
#     1). No node-count gate and no topology-dependent setting;
#     DLRM_HSTU_FP8_SYNCFREE_MULTINODE is accepted and ignored.
#     NUMERICS: BIT-IDENTICAL. Same integers and same kernels on every
#     sample; nothing skipped, cached across steps, or reordered on device
#     (debug cross-check: DLRM_HSTU_FP8_SYNCFREE_VERIFY=N; identical values).
#     WHY SAFE: only when the host reads values changes. Requires
#     DLRM_HSTU_FP8_FLYDSL_CURRENT_STREAM on.
#     CPU ProfilerStep spans cannot see this mechanism (profiler
#     launch cost sets the traced host time); use GPU-iteration traces.
#     Opt out: DLRM_HSTU_FP8_SYNCFREE=0.
apply_env_bootstrap.DLRM_HSTU_FP8_SYNCFREE = True

# -----------------------------------------------------------------------------
# Four time-to-train knobs. None changes the model's training math except the
# autotune pin table, which is a reduction-order class change. They act on
# different parts of time-to-train: the logging profile on train rate, the
# eval pool on eval passes, the extension prebuild and autotune pins on
# one-time startup inside the MLPerf timed region. Each prints one "armed OK"
# line; opt out of any one per run with the env named below.
#
# Submission logging profile (gin): training metrics OFF, MLPerf train_loss OFF,
#     FP8 scale-refresh log OFF; every MLPerf-required event unchanged.
#     WHAT: the streaming loop's METRIC_LOG_FREQ default is 0 (mlf/env_int
#     below): no per-step train torchmetrics update and no
#     train compute_and_log, so no "Step N metrics/perf" or LR console lines.
#     The MLPerf train_loss cadence defaults to 0 = OFF (mltlf/env_int below):
#     no train_loss event and no per-step loss all_reduce; MLPerf 6.1 does not
#     require train_loss. The FP8 backward scale-refresh console line (two
#     blocking .item() reads per site every 200 steps) is off unless
#     DLRM_HSTU_FP8_BWD_SCALE_LOG=1 (ops/triton/bwd_fp8.py). Eval and every
#     required MLLOG event are unchanged; MLPERF_LOGGING=1 stays required (early
#     stop reads window_auc through it) and the MLPerf log must be its own file
#     (MLPERF_LOG_PATH != LOG). This gin file is the single source of both
#     defaults, so every run gets OFF / OFF unless it sets METRIC_LOG_FREQ or
#     MLPERF_TRAIN_LOSS_LOG_FREQ. Each console/TB metric-log step drains the
#     host-sync-free run-ahead queue (the torchmetrics gather blocks on the
#     host). OFF is the MLPerf submission setting.
#     NUMERICS: none (logging only).
#     ARMED log (rank 0): "armed OK: training metrics OFF (METRIC_LOG_FREQ=0):
#     no train metric update/compute_and_log mlperf_train_loss_every=0" and
#     "armed OK: MLPerf train_loss OFF (MLPERF_TRAIN_LOSS_LOG_FREQ=0): no
#     train_loss event or loss all_reduce".
#     Opt-ins: METRIC_LOG_FREQ=50 (coarse metrics for debugging; armed line
#     "armed OK: metric_cadence metric_log_frequency=50
#     mlperf_train_loss_every=0"). Add MLPERF_TRAIN_LOSS_LOG_FREQ=1 (or 20)
#     when per-step MLLOG timing is needed.
#     THROUGHPUT COMPARISONS: set METRIC_LOG_FREQ explicitly, with the same
#     value in every run being compared; the "Step N perf" lines and the
#     train curve exist only with METRIC_LOG_FREQ>0.
#
# Eval DataLoader pool: 8 workers per rank (train pools keep NUM_WORKERS).
#     WHAT: the persistent eval pool (double-buffer path) gets num_workers =
#     $EVAL_NUM_WORKERS; the holdout eval pass is input-pipeline bound at 4.
#     NUMERICS: none. Same eval set, order, cadence and metric.
#     ARMED log (rank 0): "armed OK: eval_pool num_workers=8". Opt out:
#     EVAL_NUM_WORKERS=-1 (inherit NUM_WORKERS).
streaming_train_eval_loop.eval_num_workers = @enw/env_int()
enw/env_int.key     = "EVAL_NUM_WORKERS"
enw/env_int.default = 8
streaming_train_eval_loop.eval_rearm_prefetch_factor = @erpf/env_int()
erpf/env_int.key     = "EVAL_REARM_PREFETCH_FACTOR"
erpf/env_int.default = 1
streaming_train_eval_loop.eval_arm_lead_steps = @eals/env_int()
eals/env_int.key     = "EVAL_ARM_LEAD_STEPS"
eals/env_int.default = 64
streaming_train_eval_loop.eval_warm_lead_steps = @ewls/env_int()
ewls/env_int.key     = "EVAL_WARM_LEAD_STEPS"
ewls/env_int.default = 560
#
# C++ extension prebuild before RUN_START.
#     WHAT: train_ranker builds the runtime torch C++ extension of the FP8
#     residual-fused hipBLASLt path (ops/triton/hipblaslt_scaled_addmm.cpp,
#     triton_fp8.prebuild_extensions) during initialization, after the model,
#     optimizer, dataloaders and checkpoint load and before INIT_STOP /
#     RUN_START, instead of lazily on the first FP8 step inside the timed
#     region. Builds only if DLRM_HSTU_FP8_FUSE_RESIDUAL is on (it is, in the
#     FP8 forward arm). Touches no training or eval data.
#     NUMERICS: BIT-IDENTICAL. Same module, same flags, same lru_cache entry
#     the lazy path returns.
#     ARMED log (every rank): "armed OK: prebuild before run_start:
#     residual_fused_ext=1 <seconds>s". Opt out: DLRM_HSTU_FP8_PREBUILD=0.
apply_env_bootstrap.DLRM_HSTU_FP8_PREBUILD = True
#
# Robust Triton autotune pin table.
#     WHAT: right after the Phase-2 imports, train_ranker seeds each Triton
#     Autotuner's in-memory cache with an offline minimax-regret config for 23
#     multi-config keys (ops/triton/autotune_pin_table.py; the 22nd and 23rd
#     are the posenc concat rows below, with their own switch), so those keys skip
#     benchmarking and the compile of every candidate config. Only configs
#     already in each kernel's own autotune list are used; keys not in the
#     table (new shape/dtype) autotune exactly as before.
#     NUMERICS: REDUCTION-ORDER change. BLOCK_N / num_warps of the LayerNorm,
#     dropout, jagged and position kernels; per-row statistics unchanged, but
#     dw/db partial-sum order in the *_bwd* kernels can differ from the winner
#     a rank would have picked (which already varies between identical runs).
#     ARMED log (every rank): "armed OK: [autotune-pins] seeded 23/23 keys"
#     (21/21 with the posenc concat rows switched off).
#     Opt out: DLRM_HSTU_FP8_AUTOTUNE_PINS=0 (TRITON_FULL_AUTOTUNE=1 also
#     disables it). Re-derive the table after any Triton/ROCm or
#     kernel-config change; a stale
#     key falls back to autotune and shows up in the "skipped:" list.
apply_env_bootstrap.DLRM_HSTU_FP8_AUTOTUNE_PINS = True
#
# Autotune pin rows for the position-embedding concat kernel
#     (extends the autotune pin table above; ops/triton/
#     autotune_pin_table.py, last two PIN_TABLE rows).
#     WHAT: the DLRM_HSTU_FP8_POSENC_CONCAT_FOLD kernel (ops/triton/triton_position.py
#     _add_timestamp_position_embeddings_concat_kernel) is autotuned over its
#     own config list; without a row, the first training step compiles and
#     benchmarks every candidate config inside the timed region. One more row
#     seeds its autotune key with one config from that list (BLOCK_N=32,
#     num_warps=2, num_stages=2), picked by the same minimax-regret rule as
#     the table above over four sequence-length regimes. A twin row with the
#     same config covers the int16 position/timestamp index keys of
#     DLRM_HSTU_FP8_POSENC_SORT16 (with DLRM_HSTU_FP8_POSENC_DROPOUT_FUSE on,
#     the concat kernel runs in the eval forward only). Keys outside the table (another MAX_SEQ_LEN;
#     listwise training without num_targets) autotune as before.
#     IMPACT: removes this kernel's autotune benchmark (and the compile of
#     every other candidate config) from the first training step. The pinned
#     config still compiles once per process at first use, like every pinned
#     kernel. Steady state: the pinned config is the autotuner's own pick at the
#     production lengths.
#     NUMERICS: BIT-IDENTICAL. The kernel is elementwise per row and every
#     config in its list writes the same bytes; the pin only fixes the launch
#     config.
#     ARMED log (every rank, rank 0 included): the autotune-pins line, "armed OK:
#     [autotune-pins] seeded 23/23 keys"; with the rows off "seeded 21/21 keys;
#     posenc concat row OFF (...)". A key mismatch is silent (the
#     kernel autotunes as before); the first step's Triton compile warnings
#     from triton_position.py then show one compile per candidate config
#     instead of one per rank.
#     Opt out: DLRM_HSTU_FP8_AUTOTUNE_PIN_POSENC_CONCAT=0 (these rows only; the
#     table seeds the other 21 rows as before). DLRM_HSTU_FP8_AUTOTUNE_PINS=0
#     still turns off the whole table. Code default (binding absent): rows off.
apply_env_bootstrap.DLRM_HSTU_FP8_AUTOTUNE_PIN_POSENC_CONCAT = True
#
# -----------------------------------------------------------------------------
# Each knob below is gin-guarded (except the host-side cache flush): the
# binding below turns it on, the code default when the binding is absent is
# OFF, and a pre-set env var of the same name still wins per knob (opt-out:
# set it to 0). This file states what each knob does and its numerics class.
#
# Caching-allocator pre-grow before RUN_START.
#     WHAT: with expandable segments (PYTORCH_CUDA_ALLOC_CONF)
#     every mid-run growth of a stream pool calls hipMemMap, which drains the
#     device and blocks the host for a large part of a step; the rank then joins
#     the next sparse all-to-all late and every peer waits (trace chain:
#     start_sparse_data_dist > dedup_ec_indices > jagged_unique_indices >
#     aten::empty > hipMemMap). During initialization, before INIT_STOP /
#     RUN_START, train_ranker maps the train pipeline's main / memcpy /
#     data_dist pools and the eval pipeline's two stream pools once
#     (allocate + free, dlrm_v4/alloc_pregrow.py) and the pipelines adopt those
#     streams, so no pool grows mid-run. "main=rest" takes all free HBM above
#     `margin` GiB, which stays free for RCCL and non-torch workspaces. Touches
#     no training or eval data (allowed initialization under the MLPerf rules).
#     IMPACT: removes the allocator-growth stall class; worth most at multi-node
#     where one late rank stalls all of them. Startup cost is untimed.
#     NUMERICS: BIT-IDENTICAL (memory placement only).
#     ARMED (every rank): "armed OK: alloc pregrow before run_start:" and
#     "armed OK: alloc pregrow streams adopted by the train pipeline".
#     Opt out: DLRM_HSTU_FP8_ALLOC_PREGROW=0. Growth report (diagnostic, off by
#     default): DLRM_HSTU_FP8_ALLOC_REPORT=1.
apply_env_bootstrap.DLRM_HSTU_FP8_ALLOC_PREGROW = "memcpy=2.81,data_dist=1.82,main=rest,memcpy_small=0.02,data_dist_small=0.03,main_small=0.22,eval_memcpy=1.6,eval_data_dist=1.6,eval_memcpy_small=0.01,eval_data_dist_small=0.01,margin=56"
#
# Targeted HIP code-object preload before RUN_START
#     (dlrm_v4/train/hip_preload.py with its checked-in table
#     hip_preload_table.jsonl, hook in train_ranker.py). Its hook runs right
#     after the allocator pre-grow. Code default (no binding): OFF. The
#     binding below turns it ON.
#     WHAT: ROCm loads the statically registered kernels of libtorch_hip.so
#     and fbgemm_gpu*.so lazily: the FIRST launch of any kernel of a
#     translation unit (one fat-binary bundle) digests that bundle and loads
#     its gfx950 code object on the current device (the cost grows with the
#     bundle's uncompressed size). Without the preload those first
#     launches fall in training step 1 (also in its once-per-process checks),
#     inside the timed region. The hook calls hipFuncGetAttributes on ONE host
#     kernel stub per bundle listed in the table: that load and nothing else.
#     WHEN: train_ranker, every rank, once: after setup()'s set_device, the
#     library imports, every warmup and prebuild and the allocator
#     pre-grow; right before the TSPEC run_start guard and INIT_STOP /
#     RUN_START.
#     TABLE: 48 rows (26 dlsym, 22 symtab). Rows per run shape
#     (world_size / gpus_per_node, header entries_by_set): 1n 46, 2n 48,
#     4n 48. A shape the table does not list (e.g. 8n) uses every row. The
#     rows cover the code objects first used by steady training steps plus
#     the step-1-only first-use code objects that no steady step shows.
#     A symtab row is used only if the loaded library's
#     GNU build-id equals the table's (libtorch_hip 9889ac94...) and a dlsym'd
#     anchor confirms the load base; otherwise every symtab row of that
#     library is skipped (fail-open, counted as symtab_unverified).
#     NUMERICS: BIT-IDENTICAL. No kernel launch, no tensor, no torch
#     caching-allocator call, no RNG, model, optimizer or data state. Only
#     code objects the run loads anyway at their first use (step 1, its
#     checks, the FP8 switch) are loaded earlier; their device memory comes
#     out of the allocator pre-grow's margin as it does at first use, so the
#     pool sizing is unchanged.
#     MLPERF: library initialization before RUN_START (training_rules.adoc
#     "Run Results": imports and Triton/HIP compile/JIT are allowed before
#     RUN_START), the same class as the C++ extension prebuild and the BLAS /
#     FP8 warmups. It reads no sample and the state at RUN_START is a fresh
#     initialization's. Reasoning: the hip_preload.py module docstring.
#     COST: untimed initialization, per rank: the load time of the listed
#     bundles that no warmup has loaded yet. A bundle a warmup already
#     loaded costs a lookup and is counted in already_loaded. No effect on
#     the steady step.
#     RESUME: an MLPerf resume relaunch runs it again. Neutral: the same
#     loads move from the relaunch's first step to its pre-loop, both inside
#     the running clock.
#     ARMED (rank 0 only, once): "armed OK: [hip-preload]
#     table=hip_preload_table.jsonl shape=1n entries=46 (other_shape=2
#     bad_lines=0) ok=46 already_loaded=K failed=0 (nolib=0 nosym=0
#     symtab_unverified=0 hip=0 error=0) in S.SSs (hip S.SSs) dev=D before
#     run_start; no kernel launch, no tensor/RNG state". At 2n and 4n:
#     "shape=2n" / "shape=4n", "entries=48 (other_shape=0 bad_lines=0)
#     ok=48", "failed=0".
#     Must be ABSENT:
#       "[hip-preload] NOT armed" (rank 0: nothing loaded, or the table or
#       the HIP lookup failed; the run continues, step 1 loads lazily)
#       "[hip-preload] rank N:" (another rank with failed > 0)
#       a rank-0 line with failed > 0 (e.g. "symtab_unverified=22": the
#       loaded libtorch_hip's build-id is not the table's; those bundles
#       then load lazily at first use, as without the preload)
#     FAIL-OPEN, never raises: a missing symbol, a HIP error (cleared with
#     hipGetLastError) or an exception skips its row; a library that is not
#     loaded skips its rows, a build-id or base mismatch its symtab rows.
#     Kill switch: DLRM_HSTU_FP8_HIP_PRELOAD=0 (a pre-set env var wins over this
#     binding; off/false/no/none also disarm). Use 0: an sbatch launch forwards
#     only non-empty DLRM_HSTU_FP8_* values (an empty one leaves the gin "1"),
#     but an empty value already in the trainer's env disarms.
apply_env_bootstrap.DLRM_HSTU_FP8_HIP_PRELOAD = True
# Diagnostic env knobs for the HIP preload (not set in production):
#   DLRM_HSTU_FP8_HIP_PRELOAD_REPORT=<dir> (env only; unset = off; no gin
#   binding): every rank writes <dir>/hip_preload_rank<R>.json with each
#   row's result and milliseconds. Report only; it never changes what is
#   loaded. A write failure logs "[hip-preload] report not written".
#   DLRM_HSTU_FP8_HIP_PRELOAD=all (env only, overrides the binding): every
#   table row at any shape (at 1n also libtorch_hip b98 and fbgemm_gpu_py
#   b37, the 2n/4n-only rows).
#   DLRM_HSTU_FP8_HIP_PRELOAD=<table path> (env only, overrides the
#   binding): every row of another table file (e.g. a regenerated table).
#
# C8 attention backward: dq-split + packed-f32 epilogue + lookahead.
#     WHAT: the fused FlyDSL bwd_dkdv kernel stores its e4m3 ds tile to a
#     persistent grow-only workspace instead of accumulating dq with bf16
#     atomics; a Triton kernel (ops/flydsl/hstu_dq_split.py, XCD-grouped grid)
#     then computes dq = ds * K in f32 with one store per row, so the dq
#     zero-fill disappears. The fused kernel also runs the packed-f32 "reuse_pk"
#     epilogue (DLRM_HSTU_FP8_BWD_EPILOGUE) and stages both m tiles of a pair so tile B's MFMAs
#     overlap tile A's VALU chain (PIPE=2).
#     IMPACT: shortens the largest single kernel of the step (attention
#     backward); the atomic RMW traffic that bound the dq path is gone.
#     NUMERICS: dq ACCUMULATION CHANGE -- f32 split instead of bf16 atomics;
#     deterministic (the atomic path is not), fp64-oracle SNR on par with the
#     atomic path; dk/dv bitwise. reuse_pk and PIPE are bitwise.
#     ARMED (every rank): "[hstu-attn] bwd dq SPLIT ARMED",
#     "packed-f32 epilogue ARMED", "intra-pair lookahead ARMED: pipe=2".
#     Opt out: DLRM_HSTU_FP8_BWD_DQ_SPLIT=0 (PIPE only acts in split mode);
#     DLRM_HSTU_FP8_BWD_EPILOGUE=reuse restores the unpacked epilogue.
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_DQ_SPLIT = True
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_PIPE = 2
#
# EC cat-fuse + fast position embedding.
#     WHAT: the EC bf16-output gather writes the kept keys straight into one
#     interleaved buffer instead of per-key outputs followed by torch.cat, and
#     backward reads row-strided column slices of that buffer (no copies). The
#     timestamp position embedding uses a tiled Triton forward/backward with a
#     segmented reduction over sorted keys instead of the scatter path.
#     IMPACT: removes the concat copies and elementwise traffic around the
#     embedding output.
#     NUMERICS: REDUCTION-ORDER change in the tiled position-embedding backward.
#     ARMED: "DLRMV4 armed OK: ec_cat_fuse ACTIVE"; "armed OK: ... kernel
#     switches: ... posenc_fast=1".
#     Opt out: DLRM_HSTU_FP8_EC_CAT_FUSE=0, DLRM_HSTU_FP8_EC_STRIDED_GRAD=0,
#     DLRM_HSTU_FP8_POSENC_FAST=0 (each independently).
apply_env_bootstrap.DLRM_HSTU_FP8_EC_CAT_FUSE = True
apply_env_bootstrap.DLRM_HSTU_FP8_EC_STRIDED_GRAD = True
apply_env_bootstrap.DLRM_HSTU_FP8_POSENC_FAST = True
#
# Pipelined LayerNorm backward v2.
#     WHAT: the weighted-LayerNorm backward dx and the LN*U*dropout backward
#     move to v2 Triton kernels that issue the next block's loads before the
#     current block's math (HBM latency hiding), with the same per-element
#     formula. The swish sigmoid inside the v2 weighted-LN backward uses
#     fast_dividef (sub-switch).
#     IMPACT: these kernels are HBM-latency bound; v2 raises achieved bandwidth.
#     NUMERICS: dw/db partial-sum REDUCTION ORDER; the fast sigmoid changes a
#     very small fraction of dx elements by one bf16 ulp (error against an fp64
#     reference unchanged).
#     ARMED: "armed OK: ... kernel switches: wln_bwd_v2=1 fast_sigmoid=1
#     lnmd_bwd_v2=1".
#     Opt out: DLRM_HSTU_FP8_WLN_BWD_V2=0 / DLRM_HSTU_FP8_LNMD_BWD_V2=0;
#     DLRM_HSTU_FP8_WLN_BWD_V2_FAST_SIGMOID=0 keeps v2 with tl.sigmoid.
apply_env_bootstrap.DLRM_HSTU_FP8_WLN_BWD_V2 = True
apply_env_bootstrap.DLRM_HSTU_FP8_WLN_BWD_V2_FAST_SIGMOID = True
apply_env_bootstrap.DLRM_HSTU_FP8_LNMD_BWD_V2 = True
#
# Store instead of recompute: normed X and the targets-only VK.
#     WHAT: the forward LayerNorm keeps its BF16 normalized HSTU input for the
#     projection wgrad, and the targets-only attention keeps its e4m3 VK for
#     backward, instead of recomputing both in backward. A deliberate
#     memory-for-compute trade (the saved tensors stay in HBM from forward to
#     backward; they fit inside the allocator pre-grow pool).
#     IMPACT: removes a LayerNorm forward and an FP8 GEMM of recompute per step.
#     NUMERICS: LN statistics REDUCTION ORDER of the saving forward variant; the
#     saved VK is the same e4m3 tensor the recompute would produce.
#     ARMED: "armed OK: ... kernel switches: ... save_normed_x=1
#     save_targets_vk=1".
#     Opt out: DLRM_HSTU_FP8_SAVE_NORMED_X=0 / DLRM_HSTU_FP8_SAVE_TARGETS_VK=0.
apply_env_bootstrap.DLRM_HSTU_FP8_SAVE_NORMED_X = True
apply_env_bootstrap.DLRM_HSTU_FP8_SAVE_TARGETS_VK = True
#
# Bias-grad column sum + preprocessor GEMM pins.
#     WHAT: a Triton column-sum kernel (triton_colsum) replaces the torch reduce
#     for the HSTU bias gradients, and four ContextualPreprocessor BF16 GEMMs use
#     pinned hipBLASLt solutions (the preproc_* entries of
#     GR_PIN_BF16_BLAS_SOLUTIONS above).
#     IMPACT: cheaper bias-grad reduction and faster preprocessor GEMM tiles.
#     Pins are context-sensitive: re-measure them after any GEMM-path change.
#     NUMERICS: BIT-IDENTICAL.
#     ARMED: "[colsum] DLRM_HSTU_FP8_COLSUM on: triton_colsum armed for bias
#     grads".
#     Opt out: DLRM_HSTU_FP8_COLSUM=0; the pins by removing the preproc_* keys
#     from GR_PIN_BF16_BLAS_SOLUTIONS (or setting that env var).
apply_env_bootstrap.DLRM_HSTU_FP8_COLSUM = True
#
# MLPerf cache flush before the timed run (run_with_docker*.sh; NOT a gin
#     knob: it must run on the host before the trainer process exists), so
#     every run starts with the dataset on disk, not in RAM.
#     WHAT: every node runs `sync && sudo sysctl vm.drop_caches=3` right before
#     the trainer starts (the staged dataset otherwise stays resident in host RAM
#     between runs). The trainer logs the MLPerf cache_clear event with the
#     real outcome ($MLPERF_CACHE_CLEARED) and warns when it is false.
#     IMPACT: a one-time cold-read cost at startup, offset by the cold-start
#     bundle below (streaming section). NUMERICS: none.
#     Opt out (development only, not a compliant timed run): CLEAR_CACHES=0.
#
# Reference-data-only staging flag (nothing in the trainer reads it; the
#     bootstrap only exports it). A flag the launcher's data-staging step may
#     read: True = stage only the reference data set
#     (dl_prestart.reference_data_files(): the hstu_cache_L<N> entries of
#     checksums/sha256sums_yambda_5b_cache.txt, the time-window index
#     ts_indices/ts_offsets, processed_5b/item_popularity.npy and the two
#     shared_metadata item mappings), so no non-reference file is in the data
#     directory. Keep True for an MLPerf submission: no knowledge of the
#     training data may be generated offline or before RUN_START beyond what
#     the reference prepares.
#     NUMERICS: none (the trainer opens the same reference files either way).
#     Kill switch: env DLRM_HSTU_FP8_STAGE_REF_ONLY=0 (wins over this binding).
#     Not FP8 math.
apply_env_bootstrap.DLRM_HSTU_FP8_STAGE_REF_ONLY = True
#
# Persistent compiled-kernel cache across containers (KCACHE_DIR; NOT a gin
#     knob: it runs in the launcher, before and after the trainer process).
#     Default OFF (KCACHE_DIR unset = none).
#     WHAT: Triton keeps compiled kernels in the container's writable layer,
#     so a freshly provisioned container compiles every Triton kernel inside
#     the timed region. With KCACHE_DIR=<absolute dir under REPO_MOUNT or
#     DATA_MOUNT>, each node's worker copies $KCACHE_DIR/triton into the
#     container-local TRITON_CACHE_DIR before the trainer starts (untimed, no
#     dataset touched; per-entry temp copy + rename, time-bounded) and logs
#     the bundle's content digest. With KCACHE_PUBLISH=1 (populating runs
#     only) it also publishes the entries this run compiled back, by atomic
#     rename, after the trainer exits with rc=0 (after RUN_STOP); the default
#     KCACHE_PUBLISH=0 never creates, chmods or writes the bundle. Nothing
#     touches shared storage while the clock runs, and Triton autotune results
#     are never copied (only compiled code). Triton keys every entry on the
#     kernel source, constexprs, specialization, target and Triton build, so
#     a stale entry is a miss, never a wrong kernel; the key does not cover
#     the ROCm runtime or the image, so keep one bundle per image and tree.
#     KCACHE_FLYDSL=1 (default 0; FlyDSL writes its own disk cache
#     non-atomically from the node's 8 ranks) also carries that cache.
#     Scored-run policy: populate a bundle with KCACHE_PUBLISH=1 in
#     dedicated non-scored runs of the same image and tree at every node
#     count used (a bundle holds only the specializations its runs compiled),
#     freeze it read-only, and run scored runs with the default
#     KCACHE_PUBLISH=0 on the frozen copy (every log carries the same digest).
#     IMPACT: the Triton compiles of the first training steps and of the FP8
#     switch become cache loads; no steady-state effect.
#     NUMERICS: none (the same compiled kernels are loaded instead of built).
#     RULES: compilation and its caching are initialization work done before
#     the run (training_rules.adoc L545-549; training_policies issue #399 on
#     pre-compiling, caching and loading before the run); the page-cache
#     flush above still runs, and the cache holds compiled code only, no
#     dataset content.
#     ARMED log: launcher "[kcache] armed: seed+writeback <dir> publish=0|1
#     triton_entries=<n>", one "[kcache] seeded <host>: ... bundle_sha=<hex>
#     files=<n> publish=0|1" per node, and on trainer rank 0 "armed OK:
#     [kcache] seeded entries=<n> bundle_sha=<hex> ... TRITON_CACHE_DIR=...".
#     Kill switch: KCACHE_DIR unset or none (the default).
#
# TSPEC, a Triton specialization table compiled
#     before RUN_START ($TRITON_SPEC_REPLAY; dlrm_v4/train/triton_spec.py,
#     called from train_ranker). ON: the binding below names the table.
#     WHAT: a fresh container compiles every Triton kernel variant at its first
#     call, inside the timed region (first steps, attention seq-len buckets,
#     the FP8 switch). A non-scored record run (TRITON_SPEC_RECORD=<dir>)
#     writes one JSON line per Triton compile on every rank: the kernel's
#     module and qualname, its in-process kernel-cache key, the argument
#     dtypes, the integer and pointer specialization classes (%16, integer
#     width, storage <= 2 GiB), the constexpr values and launch options, and
#     whether it was first compiled before or after RUN_START; `python3
#     generative_recommenders/dlrm_v4/train/triton_spec.py merge TABLE.jsonl
#     <dir>/rec.*.jsonl` merges the ranks' files into one table. With
#     TRITON_SPEC_REPLAY=<table>, every rank, after torch.cuda.set_device and
#     the process group and before the BLAS warmup, the FP8 first-use
#     warmup and the startup preload, compiles the table's rows
#     (TRITON_SPEC_REPLAY_PHASES=post, the default: rows first compiled after
#     RUN_START; all: every row) from the CURRENT kernel source exactly as the
#     runtime compiles them at first use (JITFunction._do_compile with the
#     recorded key, as JITFunction.preload does), shares that work among the
#     node's ranks through the container's Triton cache, and loads each kernel
#     on its GPU, so the first call after RUN_START finds it in the in-process
#     kernel cache. No binary crosses runs: each run compiles
#     from source (an edited kernel body is compiled as it is now). A row is
#     skipped, and compiles at first use as before, only when its kernel is
#     gone or its parameter list, a module global it reads, the GPU target or
#     a Triton setting that enters the cache key changed. Not on a resume
#     relaunch (the clock is already running there): no table, as before.
#     Re-record after changing a kernel's parameters, a call site's constexprs
#     or launch options, the autotune pin table, the Triton build or a
#     TRITON_* / AMDGCN_* environment variable, and record at every node count
#     used (merge all files into one table).
#     IMPACT: the Triton JIT the record run saw after RUN_START moves into
#     untimed initialization; untimed initialization grows. No effect on the
#     steady step. Not covered: FlyDSL and hipcc builds, hipBLASLt loads,
#     autotune benchmarking of unpinned keys and specializations the record
#     run never saw (TRITON_SPEC_MONITOR=1 names those).
#     NUMERICS: none (bit-identical): the same source, specialization and
#     options give the binary the run compiles at first use. No kernel is
#     launched, no tensor is allocated, no model / optimizer / RNG state is
#     read or written.
#     RULES: MLPerf training_rules.adoc (model initialization before
#     the clock, which starts before any part of the system touches the
#     dataset; this touches none; processing metadata such as document
#     sizes is not touching the training data; high-level statistics
#     such as size distributions are fine) and training WG issue #399 ("some
#     metadata (possible shapes) can be used in the compilation process").
#     The table comes from a record run over the training data and
#     holds kernel names, dtypes, integer / pointer specialization classes
#     (%16, integer width, storage <= 2 GiB), sequence-length bucket constexprs
#     and launch options only, no sample values: the same class of metadata
#     as the autotune pin table.
#     ARMED log (every rank, tagged rank=R): "armed OK: [triton-spec] replay
#     table=... rows=N resolved=... unresolved=... compiled=... primed=...
#     errors=... in ...s (A ...s, B ...s)"; a record run logs "armed OK:
#     [triton-spec] record -> <file>". Fail-open: any failure logs
#     "[triton-spec] NOT armed: <reason>" and the run continues exactly as
#     without it; a bad row is counted, never raised. TRITON_SPEC_MONITOR=1
#     logs "[triton-spec] monitor post-run_start: compiles=N kernels=..." at
#     RUN_STOP and at exit (compiles=0: every timed-region compile covered).
#     Knobs (env, gin-bindable as
#     apply_env_bootstrap.<name>): TRITON_SPEC_RECORD, TRITON_SPEC_REPLAY,
#     TRITON_SPEC_REPLAY_PHASES, TRITON_SPEC_MONITOR. Bound through
#     apply_env_bootstrap, not an @env_str macro like FP8_WARMUP: the recorder
#     must be installed before the Phase-2 kernel imports, and an @env_str
#     binding resolves only at the Phase-3 parse, after the replay.
#     ON with the table recorded on this tree at 1n/2n/4n on synthetic data
#     (start windows 0-7 + final eval of window 8, late windows 9-10 + final
#     eval of window 11; dlrm_v4/train/tspec_synth_data.py builds the dataset
#     on each node and scripts/ts_index_tool.py prebuild builds its window
#     index from that synthetic cache; the unmodified trainer reads both
#     through DLRM_DATA_PATH with DL_WINDOW_INDEX=1 (the production path),
#     TRITON_SPEC_RECORD=<dir> and TRITON_SPEC_REPLAY=0), merged into
#     ops/triton/triton_spec_table.jsonl. Re-record after any change listed
#     above.
#     Kill switch: TRITON_SPEC_REPLAY=0. Off costs one INFO line
#     ("env bootstrap: TRITON_SPEC_REPLAY=0") and that env var per rank; no
#     triton import, no other output.
apply_env_bootstrap.TRITON_SPEC_REPLAY = "generative_recommenders/ops/triton/triton_spec_table.jsonl"
#
# Cold-start bundle (DataLoader pre-start, cold first-batch prefetch, BLAS
#     first-use warmup, startup preload): bindings and full description in the
#     streaming section below, next to the loop macros they mirror.
#
# C8 attention backward: VALU diet, m-split body, dq-split schedule and
#     load options (on top of DLRM_HSTU_FP8_BWD_DQ_SPLIT; dq-split calls only).
#     WHAT: VALU "undef,rfl,ilp" trims the bwd_dkdv act chain (no zero-init of
#     the e4m3 cvt destination, folded per-row scales, the two independent
#     halves of the silu/grad chain interleaved); "msat" sets MODE.FP16_OVFL at
#     kernel entry so the hardware e4m3 cvt saturates and the per-element clamps
#     go away (cleared before the bf16 dk/dv epilogue). MSPLIT=1 runs 8 waves
#     per workgroup with waves w and w+4 sharing 32 n rows (m-split score/act,
#     d-split out-gemm, 2 waves/SIMD); it replaces the PIPE=2 pair body.
#     MSPLIT_SCHED "mid,sb,wsl,sgv5,la" places each wave's out-gemm(k-1) and dq
#     ws store under its own act chain and issues the next pair's prefetch after
#     the score A-operand LDS reads. DQ_SPLIT_SCHED "ilr" deals (b, h) units
#     across the XCDs balanced; DQ_SPLIT_OPT "sp,r1,wcg" turns the ws stream
#     into buffer loads with a scalar tile base, masks ws rows past the
#     sequence end and marks the read-once ws stream non-temporal.
#     IMPACT: shortens the attention-backward kernels (bwd_dkdv and the
#     dq-split dq kernel), the largest kernels of the step.
#     NUMERICS: BIT-IDENTICAL dq/dk/dv vs the plain dq-split kernel (same tiles, same MFMA
#     operands and per-accumulator order; only work placement and instruction
#     selection change). VALU "vf2" (scale fold) is a numerics change and is
#     NOT enabled here.
#     ARMED (every rank): "[hstu-attn] bwd_dkdv VALU diet ARMED:
#     valu=ilp,msat,rfl,undef", "bwd_dkdv m-split ARMED: msplit=1",
#     "bwd dq SPLIT XCD-balanced schedule ARMED: ilr", "bwd dq SPLIT load opts
#     ARMED".
#     Opt out: DLRM_HSTU_FP8_BWD_VALU=0, DLRM_HSTU_FP8_BWD_MSPLIT=0 (PIPE=2 then
#     applies again), DLRM_HSTU_FP8_BWD_DQ_SPLIT_SCHED=0,
#     DLRM_HSTU_FP8_BWD_DQ_SPLIT_OPT=0 (each independently; DQ_SPLIT_OPT needs
#     a DQ_SPLIT_SCHED).
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_VALU = "undef,rfl,ilp,msat"
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_MSPLIT = 1
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_MSPLIT_SCHED = "mid,sb,wsl,sgv5,la"
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_DQ_SPLIT_SCHED = "ilr"
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_DQ_SPLIT_OPT = "sp,r1,wcg"
#
# dq8 EPILOGUE DIET V3 (bit-identical outputs, no precision change).
# Files: ops/triton/hstu_dq_e5m2.py (`_dq8_unit_v3`, `_dq8_epi_full`; the shipped
# epilogue stays as `_dq8_unit_v0`). What: the dq-split dq GEMM `_dq8_sched_kernel`
# (attention backward; the e5m2 dq sink) runs, for every FULL 128-row
# tile (every row < the sequence length; most in-model tiles), an epilogue
# without the row mask: the int64 row bases fold into scalars and the tile amax
# is reduced from |out| in fp32 and rounded to bf16 once, instead of from the
# bf16-rounded tile (bf16 RNE is odd-symmetric and monotone, so the value is
# the same). Partial tiles run the shipped epilogue verbatim. Bit-identical:
# the e5m2 dz8 q block, the q colsum partials (pcol) and the finalized amax;
# the per-tile amax partial (pamax) of an all-NaN tile may differ in NaN
# payload only, and _dq8_fin_kernel's maxnum drops NaN partials. Kernel name
# and parameter list are unchanged, so the TSPEC rows of `_dq8_sched_kernel`
# compile it with the selected epilogue before RUN_START in both settings
# (the replay detail line counts them as src_changed).
# Arming line (stdout print, once per process at the first dq8 launch):
#   "[dq8-diet] epilogue diet V3 ARMED: _dq8_sched_kernel runs _dq8_unit_v3";
#   with the kill switch: "[dq8-diet] epilogue diet V3 OFF: ...".
# Code default OFF; the binding below turns it ON; a pre-set env var wins over
# gin (_bind_bool). Kill switch: env DLRM_HSTU_FP8_DQ8_DIET=0 (the shipped
# epilogue, `_dq8_unit_v0`). Only "1" arms it ("true"/"True" do not); the
# value is read once at import.
apply_env_bootstrap.DLRM_HSTU_FP8_DQ8_DIET = True
#
# LayerNorm-family folds (five independent switches).
#     WHAT: (a) WLN_FWD_V2: the D=256 swish LinearNorm forward of the
#     preprocessor MLPs (ops/fused_linear_norm.py) runs a persistent v2 kernel
#     with an exact fast sigmoid; it launches only after the old kernel's
#     autotune pick is known and is one of the configs v2 reproduces, otherwise
#     the old kernel runs. (b) LNMD_FWD_V2: the LN*U*dropout forward of the
#     output projection runs a persistent v2 kernel (exact fast sigmoid,
#     bit-mask dropout keep) for N >= 2^20 rows with a sigmoid activation.
#     (c) POSENC_CONCAT_FOLD: the ContextualPreprocessor no longer materializes
#     the contextual/UIH concat_2D_jagged; the position kernel reads both pieces
#     and its backward writes both gradients (no split_2D_jagged). Acts only
#     with POSENC_FAST in training. (d) DROPOUT_MSCALE_FOLD: the
#     HSTU input dropout's backward (mask * scale) is applied in the epilogue of
#     the layer-0 input-LayerNorm backward instead of a separate
#     native_dropout_backward; the forward dropout call and its RNG stream are
#     unchanged. Acts only with WLN_BWD_V2 and the fused residual.
#     (e) TGT_SPARSE_RESID: the targets-only final layer returns only the
#     candidate rows as its residual proxy, so the residual gradient is
#     index-added into those rows of dx instead of a zero-filled dense [L, D]
#     tensor read by the LN backward. Coexists with SAVE_NORMED_X /
#     SAVE_TARGETS_VK: the saved BF16
#     normed X and e4m3 VK are used unchanged.
#     IMPACT: removes memory passes and VALU work in the LayerNorm family
#     (preprocessor LN forward, LN*U*dropout forward, the input concat/split
#     copies, the dropout backward pass, the dense targets-only residual).
#     NUMERICS: BIT-IDENTICAL. (a) runs only when the old kernel's autotune
#     pick is one whose fp32 operation order v2 reproduces. (b) reproduces the
#     old kernel's (BLOCK_N=1, num_warps=1) config, the production pick; the
#     old kernel's other autotune configs already differ from it in reduction
#     order. (c)-(e) move the same ops into another kernel; (e) can flip the
#     sign of an exact -0.0 dx element on non-candidate rows (equal value).
#     With DLRM_HSTU_FP8_WLN_BWD_FLYDSL on, the (d) opt-out is not
#     bit-identical (layer 0's LayerNorm backward then runs on FlyDSL; see
#     that knob's NUMERICS).
#     ARMED: "armed OK: ... LN-fold switches: wln_fwd_v2=1 lnmd_fwd_v2=1
#     posenc_concat_fold=1 dropout_mscale_fold=1 tgt_sparse_resid=1"; at first
#     use "armed OK: posenc concat fold ACTIVE", "armed OK: input-dropout
#     mask/scale fold ACTIVE", "[hstu] targets-only row-sparse residual gradient
#     ACTIVE".
#     Opt out (each independently): DLRM_HSTU_FP8_WLN_FWD_V2=0,
#     DLRM_HSTU_FP8_LNMD_FWD_V2=0, DLRM_HSTU_FP8_POSENC_CONCAT_FOLD=0,
#     DLRM_HSTU_FP8_DROPOUT_MSCALE_FOLD=0, DLRM_HSTU_FP8_TGT_SPARSE_RESID=0.
apply_env_bootstrap.DLRM_HSTU_FP8_WLN_FWD_V2 = True
apply_env_bootstrap.DLRM_HSTU_FP8_LNMD_FWD_V2 = True
apply_env_bootstrap.DLRM_HSTU_FP8_POSENC_CONCAT_FOLD = True
apply_env_bootstrap.DLRM_HSTU_FP8_DROPOUT_MSCALE_FOLD = True
apply_env_bootstrap.DLRM_HSTU_FP8_TGT_SPARSE_RESID = True
#
# Embedding-collection backward and sequence-a2a permutes.
#     Two parts, each with its own switch.
#     Code default OFF when the binding is absent; a pre-set env var wins.
#   (a) Grouped EC expand backward (train/ec_bf16_output.py _ECExpandGroup).
#     WHAT: all per-key expands of one EC call become ONE autograd node with ONE
#     fp32 [U, W] gradient accumulator. Hoisted keys (including the
#     EC_CAT_FUSE cat-fused artist/album member) are segment-reduced into it with the
#     Triton kernels' ACCUM mode (out[row] += segment sum); kept keys
#     scatter_add_ into it. Removes the per-key [U, W] fp32 zero-fill and the
#     K-1 full-size grad adds autograd ran to sum them. Engages only with the
#     segment-reduce backward on and no backward chunking (this config).
#     NUMERICS: forward BITWISE; backward fp32 SUMMATION-ORDER change only
#     (same addends, same fp32 accumulator; hot pieces were already atomic).
#     ARMED: "DLRMV4 armed OK: ec_group_bwd ACTIVE" (WARNING, first backward)
#     and the ec_cat_fuse line gains "(one member of the grouped EC
#     backward)". Opt out: DLRM_HSTU_FP8_EC_GROUP_BWD=0.
#   (b) Sequence-embedding comm permutes (dlrm_v4/seq_a2a_rowperm.py,
#     dlrm_v4/unbucketize_gather.py; patched in MetricsLogger.__init__).
#     WHAT: TorchRec's All2All_Seq_Req element-level permute_2D_sparse_data on
#     the fp32 sequence embeddings (forward and backward) becomes a row-index
#     build over per-block row counts plus one row gather in the wire dtype;
#     the row-wise unbucketize backward (zeros + index_add_) becomes an inverse-
#     permutation gather (int64 permutations, bijectivity checked on the first
#     calls, stock fallback otherwise). The unbucketize part only engages with
#     row-wise sequence sharding (NODES>=2).
#     NUMERICS: BITWISE (unbucketize: up to the sign of zero).
#     ARMED: "DLRMV4 armed OK: seq a2a rowperm:" and "DLRMV4 armed OK:
#     unbucketize gather:" (the latter multi-node only).
#     Opt out: DLRM_HSTU_FP8_SEQ_A2A_ROWPERM=0 / DLRM_HSTU_FP8_UNBUCKETIZE_GATHER=0
#     (part (b) as a unit by setting both).
apply_env_bootstrap.DLRM_HSTU_FP8_EC_GROUP_BWD = True
apply_env_bootstrap.DLRM_HSTU_FP8_SEQ_A2A_ROWPERM = True
apply_env_bootstrap.DLRM_HSTU_FP8_UNBUCKETIZE_GATHER = True
#
# -----------------------------------------------------------------------------
# Sparse-chain removals (dlrm_v4/b1pp.py, dlrm_v4/seq_a2a_fused.py). On top
# of the sequence-embedding comm permutes above.
#     Four switches, five parts. Each part only removes or fuses kernels on
#     the 2n/4n critical sparse chain (the forward sequence all-to-all's last
#     arriver); part (a) also on the 1n one (the table-wise owners' send
#     path). Bitwise; no compute reduction, no precision change.
#     NODE DEFAULTS: (a) binds like the items above (_bind_bool): a True
#     binding turns it on at EVERY node count. (b)-(d) have a MULTI-NODE
#     DEFAULT: a True binding turns the part on ONLY WHEN THE JOB SPANS MORE
#     THAN ONE NODE (NNODES, else SLURM_NNODES;
#     train/_env_bootstrap.py _bind_bool_multinode). At one node they
#     bind "0": the one-node plan (KJT.split children, table-wise owners
#     whose rebag predicate already holds) has no in-model check of them.
#     A pre-set env var wins at any node count: =1 forces a part on (also at
#     one node), =0 is its kill switch.
#   (a) SEQ_A2A_FUSED (dlrm_v4/seq_a2a_fused.py, called from
#     seq_a2a_rowperm.py; needs DLRM_HSTU_FP8_SEQ_A2A_ROWPERM).
#     WHAT: send: the forward row index, fp16 encode + clamp and row gather
#     run as ONE Triton kernel (K1; it also writes the permuted lengths), the
#     backward row gather, fp16 decode and GRADIENT_DIVISION scale as ONE
#     kernel (K2). Receive: after the forward a2a wait, the fp16 decode and
#     the row-wise unbucketize gather run as ONE kernel (K3'); in the
#     backward, the unbucketize scatter and the fp16 encode run as ONE kernel
#     (K4) before the backward a2a (patched All2All_Seq_Req_Wait; the
#     permutation is handed over by the unbucketize-gather patch).
#     Engages only with exact fbgemm fp16 codecs both ways, fp32 input,
#     D % 8 == 0 and a power-of-two world size; otherwise the rowperm path runs.
#     Table-/column-wise sets (the one-node plan) have no permutation: K3'
#     is the plain decode and K4 the plain encode (seq_a2a_rowperm.py);
#     K1/K2 run on every rank with local features (n_blocks <= 1024).
#     Its sub-switches _SEND (K1 + K2; _FWD = K1, _BWD = K2) and _RECV
#     (K3' + K4) are bound True after the four switches below; see there.
#   (b) KJT_RECAT_FUSED (dlrm_v4/b1pp.py; hook in host_sync_free's
#     p_kjtt_wait; needs DLRM_HSTU_FP8_SYNCFREE and its _LPK sub-switch, else
#     FALLBACK): the KJT recat (fbgemm permute_2D_sparse_data, scans, fill)
#     becomes two Triton kernels that also write the KJT offsets, so the TBE
#     offsets cumsum has nothing left when the lookup takes the whole KJT.
#   (c) TBE_REBAG: the sequence (pooling NONE) TBE gets a re-cut bag
#     partition of the SAME indices with fewer bags, chosen so fbgemm's ROCm
#     backward predicate total_L/total_B > 1 keeps its value; the KJT is not
#     changed.
#   (d) TBE_BOUNDS_TRITON: fbgemm bounds_check_indices (WARNING, v2) of that
#     TBE becomes two Triton kernels on the original KJT offsets (same
#     repairs, same warning counter; fbgemm's device printf is not
#     reproduced), and fbgemm runs that call with its own check off.
#     (c) and (d) patch torchrec BatchedFusedEmbedding.forward, only when one
#     of them is on and torchrec's forward is the body b1pp re-implements; a
#     non-eligible call (pooled TBE, VBE, weights, hash-ZCH, non-int64 ids)
#     runs stock.
#     WARMUP: before RUN_START (train_ranker, after the FP8 warmup) the
#     kernels of every part that is on compile on synthetic tensors, K1-K4
#     with the shapes of the model's sequence all-to-alls (D, local features,
#     world size, per-rank batch); the jit line below checks in-model that
#     none compiles after RUN_START. A failed launch runs that part stock;
#     any failed synchronize (device fault) stops the run before RUN_START.
#     NUMERICS: BITWISE (wire, permuted lengths, received embeddings,
#     gradients, repaired ids and offsets, warning counter, weights and
#     Adagrad state) for well-formed KJT offsets (a cumsum of the lengths, as
#     torchrec builds them). On malformed offsets fbgemm's own repair is
#     racy: (d) lands on one of its legal outcomes, and (c) without (d) lets
#     fbgemm repair the rebagged copy instead of the KJT offsets. Multi-node
#     run-to-run nondeterminism is as without these parts.
#     ARMED (every rank, multi-node): "DLRMV4 armed OK: [b1pp-warmup]
#     kernels=", "DLRMV4 armed OK: [b1pp-warmup] seq_a2a K1-K4", "DLRMV4
#     armed OK: seq a2a fused send (", "... seq a2a fused send bwd ran",
#     "... seq a2a fused recv (", "... seq a2a fused recv bwd ran", "... b1pp
#     kjt recat fused (", "... b1pp tbe rebag Rkeep", "... b1pp tbe bounds
#     triton"; once: "b1pp jit after run_start: b1pp +0 seq_a2a +0".
#     ARMED at one node (every rank): "env bootstrap:
#     DLRM_HSTU_FP8_SEQ_A2A_FUSED=1", the "[b1pp-warmup] seq_a2a K1-K4" line
#     and the four "seq a2a fused" lines above (recv with perm=off); (b)-(d)
#     log "env bootstrap: <name>=0 (multi-node default: single node, off)"
#     and no "[b1pp-warmup] kernels=" or "b1pp" armed line appears. No jit
#     line at one node (it counts b1pp calls): use TRITON_SPEC_MONITOR=1.
#     MUST BE ABSENT: "b1pp <part> FALLBACK", "DISABLED", "MISMATCH",
#     "not eligible", "hand-off refused", "K1-K4 not warmed",
#     "[b1pp-warmup] skipped", "bitwise=False", "Traceback".
#     VERIFY (diagnostic, env only, default off): DLRM_HSTU_FP8_B1PP_VERIFY=N
#     and DLRM_HSTU_FP8_SEQ_A2A_FUSED_VERIFY=N compare the first N calls of
#     each part with the stock path (a host sync per call); a b1pp mismatch
#     raises, a seq-a2a mismatch logs "bitwise=False" and runs stock.
#     MLPerf: same per-index lookups, gradients and bounds checks; only the
#     kernel count and the bag partition handed to the nobag TBE change.
apply_env_bootstrap.DLRM_HSTU_FP8_SEQ_A2A_FUSED = True
apply_env_bootstrap.DLRM_HSTU_FP8_KJT_RECAT_FUSED = True
apply_env_bootstrap.DLRM_HSTU_FP8_TBE_REBAG = True
apply_env_bootstrap.DLRM_HSTU_FP8_TBE_BOUNDS_TRITON = True
#   (a)'s SUB-SWITCHES.
#     Each narrows what DLRM_HSTU_FP8_SEQ_A2A_FUSED turns on; read once, at
#     install (seq_a2a_rowperm.py fused_config / recv_config):
#       DLRM_HSTU_FP8_SEQ_A2A_FUSED_SEND  the send part, K1 + K2;
#       DLRM_HSTU_FP8_SEQ_A2A_FUSED_FWD   K1 (forward; inert if SEND is 0);
#       DLRM_HSTU_FP8_SEQ_A2A_FUSED_BWD   K2 (backward; inert if SEND is 0);
#       DLRM_HSTU_FP8_SEQ_A2A_FUSED_RECV  the receive part, K3' + K4.
#     DEFAULT: True = "1", the code default (absent = on), so these bindings
#     change nothing. They are PLAIN bindings, NOT multi-node ones: the code
#     ANDs each with SEQ_A2A_FUSED, so a sub-switch never turns a part on by
#     itself and (a)'s node-count default stays with SEQ_A2A_FUSED alone (on
#     at every node count, so every part runs at 1n, 2n and 4n).
#     NUMERICS: BITWISE, as (a); a part that is off runs the rowperm path.
#     ARMED: "env bootstrap: DLRM_HSTU_FP8_SEQ_A2A_FUSED_SEND=1" (and _FWD,
#     _BWD, _RECV) on every rank; with (a) on, the "seq a2a fused send ("
#     line reads "[fwd=on bwd=on" and "seq a2a fused recv (" appears.
#     Kill switch (env wins): =0 turns off only that part, e.g. _RECV=0
#     keeps the send part. The VERIFY knobs are in the "diagnostic env knobs
#     (not set in production)" block after DLRM_HSTU_FP8_PIPE_STREAM_PRIO_MN.
apply_env_bootstrap.DLRM_HSTU_FP8_SEQ_A2A_FUSED_SEND = True
apply_env_bootstrap.DLRM_HSTU_FP8_SEQ_A2A_FUSED_FWD = True
apply_env_bootstrap.DLRM_HSTU_FP8_SEQ_A2A_FUSED_BWD = True
apply_env_bootstrap.DLRM_HSTU_FP8_SEQ_A2A_FUSED_RECV = True
#
# The next two knobs (DLRM_HSTU_FP8_BWD_OUT_WGRAD, DLRM_HSTU_FP8_BWD_UVQK) are
# NUMERICS-CHANGING: both move a BF16 backward GEMM onto FP8 operands. They
# are a declared precision choice, not a bitwise refactor.
#
# FP8 output-projection weight gradient (ops/triton/triton_hstu_linear.py
#     HSTUComputeOutputFunction; gradient cast in ops/triton/bwd_fp8.py; GEMM
#     in ops/hipblaslt_fp8_nn.py).
#     WHAT: d(output_weight) = y^T @ dout of every STU layer runs as an FP8
#     GEMM instead of BF16 torch.mm. y is the e4m3 LN*U*dropout output the FP8
#     forward already produced for the forward output-projection GEMM; it is
#     kept for backward (store instead of recompute), so the LN-mul-dropout
#     backward skips its BF16 y recompute. dout is cast ONCE by the
#     e5m2 output-projection dgrad pass, which also writes a token-major
#     e4m3 copy for the wgrad. The wgrad is one hipBLASLt FP8 NN GEMM (C API)
#     on the row-major e4m3 y and the token-major dout copy, fp32 accumulate;
#     if the library offers no NN algorithm for the shape, it falls back to a y
#     transpose + FP8 TN GEMM (path=nn_fallback_tn on the armed line). The one
#     binding resolves IMPL=nn, DFMT=e4m3, DFMT_SHIFT=auto. Engages only with
#     DLRM_HSTU_FP8_BWD (on above, its scale controller supplies the dout
#     scale) and the FP8 fused output-LN forward with recompute_y; until the
#     controller has published a scale (warmup calls) the BF16 wgrad runs.
#     IMPACT: removes the BF16 y recompute and replaces the BF16 wgrad GEMM of
#     every layer's output projection with an FP8 GEMM. Costs: the e4m3 y
#     [tokens, 3*D] of each layer stays resident until backward (more
#     activation memory), a persistent hipBLASLt workspace per device, and
#     under DFMT_SHIFT=auto one blocking host read per site at each scale
#     refresh (every DLRM_HSTU_FP8_BWD_REFRESH_CALLS steps, mid-backward). The
#     BLAS first-use warmup gains one NN case for this GEMM
#     (synthetic tensors, no RNG draw).
#     NUMERICS: precision change on d(output_weight) only. Operands: y e4m3
#     (identical bytes to the forward GEMM's operand); dout e4m3 token-major
#     copy cast with the delayed per-site dout scale times 2^SHIFT,
#     saturating at the e4m3 max. SHIFT=7 clips exactly where the e5m2 dgrad
#     operand clips (the full DLRM_HSTU_FP8_BWD_MARGIN headroom); SHIFT 4-6
#     give that headroom back to mantissa resolution, so the copy CAN clip
#     when a window's amax grows past the reduced headroom. Clipped windows are
#     counted per site (t_clipped_windows). SHIFT=auto starts at the floor
#     (DLRM_HSTU_FP8_BWD_OUT_WGRAD_DFMT_SHIFT_FLOOR, default 5), steps up one
#     binade after any refresh window that clipped (max 7) and back down after
#     DLRM_HSTU_FP8_BWD_OUT_WGRAD_DFMT_SHIFT_RELAX clean windows, so a late
#     amax jump clips for at most one window; every decode scale is an exact
#     power of two of the per-site scale. Accumulation fp32, result cast to the
#     weight-gradient dtype. The output-projection dgrad stays e5m2, but on the
#     armed path it decodes with the scale snapshot taken before a refresh, so
#     on refresh calls it differs from the unarmed dgrad (it decodes with the
#     scale the bytes were cast at).
#     ARMED (every rank, once per process at the first FP8 wgrad):
#     "[fp8-out-wgrad] armed impl=nn path=nn dfmt=e4m3 shift=auto rank=";
#     "env bootstrap: DLRM_HSTU_FP8_BWD_OUT_WGRAD=1"; at warmup "[blas-warmup]
#     fp8 e4m3 x fp8 -> f32 out_proj wgrad (nn)". "path=nn_fallback_tn" means
#     the NN GEMM was unavailable (still FP8); "path=nn_ck" means
#     the custom CK wgrad kernel (DLRM_HSTU_FP8_BWD_WGRAD_CK_W3) ran it. With
#     DLRM_HSTU_FP8_BWD_SCALE_LOG=1 the scale lines gain "t_clipped_windows=".
#     Opt out: DLRM_HSTU_FP8_BWD_OUT_WGRAD=0 (BF16 wgrad and y
#     recompute). Diagnostic sub-knobs (testing only): _IMPL=nn|producer|tn|triton,
#     _DFMT=e5m2|e4m3, _DFMT_SHIFT=4..7|auto; _SNR is an fp64 numerics probe,
#     never in timed runs.
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_OUT_WGRAD = True
#
# FP8 uvqk / vk projection backward (ops/triton/bwd_fp8.py
#     uvqk_projection_backward; ops/triton/triton_hstu_preprocess_and_attention.py;
#     ops/triton/triton_layer_norm.py; ops/triton/hstu_delta_bwd_e5m2.py;
#     extension ops/triton/hipblaslt_fp8_wgrad_tm.cpp).
#     Four switches, each a refinement of the previous one:
#   (a) UVQK: e5m2 dgrad. The input-projection gradient d(uvqk) of every
#     ordinary STU layer, and d(vk) of the targets-only layer, is read once by
#     a fused pass that writes the e5m2 copy, its amax for the delayed-scale
#     controller and the fp32 bias-gradient column sum (replacing the separate
#     DLRM_HSTU_FP8_COLSUM pass for these sites). d(normed_x) = dz @ W^T runs as
#     an e5m2 x e4m3 TN torch._scaled_mm. Independent of DLRM_HSTU_FP8_BWD.
#   (b) UVQK_WGRAD="fp8t": the weight gradient dW = normed_x^T @ dz runs as one
#     hipBLASLt FP8 NN GEMM (own extension dlrm_hstu_fp8_wgrad_tm, built before
#     RUN_START by the C++ extension prebuild) on the same row-major e5m2 dz and a TOKEN-MAJOR
#     e4m3 normed_x [D, tokens padded to 128], fp32 output. Without (c) the
#     token-major e4m3 normed_x is recomputed in backward from the saved
#     mean/rstd. When fp8t is planned the forward skips the SAVE_NORMED_X BF16
#     normed_x save for that call (fp8t never reads it). The first call per
#     (device, K, N) resolves one concrete hipBLASLt solution and validates it
#     against an exact-product, fp64-summed reference of the same FP8
#     operands; later calls run that solution strictly. A failed guard
#     disables fp8t (BF16 wgrad, FP8 dgrad kept).
#   (c) UVQK_STORE_T: the training forward LN also writes the token-major
#     e4m3 normed_x, kept one-shot for backward, so backward skips the
#     token-major recompute.
#   (d) VK_PRODUCER: the targets-only delta-attention backward emits the e5m2
#     dV|dK payload, its amax and bias column sum directly (no BF16 dvk tensor,
#     no separate cast pass).
#     Calls that need the BF16 normed_x anyway (dual-LN Q/K/V recompute, BF16
#     uvqk recompute, retained-graph second backward) decline fp8t and take
#     the BF16 wgrad with the FP8 dgrad; warmup calls (scale not yet published)
#     take the BF16 path.
#     IMPACT: the uvqk/vk projection backward GEMMs run on FP8 MFMA; the
#     separate bias-colsum pass and (with (c)) the BF16 normed_x save/recompute
#     go away; with (d) the targets-only BF16 dvk round trip goes away. Costs:
#     the e4m3 token-major normed_x per layer stays resident to backward under
#     (c), and the one-time guard per (device, K, N) runs inside the first
#     FP8 step. The allocation profile differs from the BF16 one (no BF16
#     normed_x, e4m3 stored copy, e5m2 dz copies), so the allocator pre-grow
#     sizes may not match it; check the allocator growth report
#     (DLRM_HSTU_FP8_ALLOC_REPORT=1).
#     NUMERICS: precision change on the uvqk/vk input gradient and weight
#     gradient. Gradient dz: e5m2, delayed per-site scale from the shared
#     controller (margin, warmup, refresh cadence as DLRM_HSTU_FP8_BWD;
#     per-layer scale keyed on the leaf weight for uvqk, one site
#     "vk_projection" for vk), saturating at the e5m2 max; windows whose amax
#     exceeded the representable range are counted per site
#     (clipped_windows), and the decode uses the scale snapshot the bytes were
#     cast at. Weight: e4m3 per-tensor (the FP8 forward weight cast).
#     Activation (fp8t): e4m3 normed_x at the FP8 forward's per-layer
#     input scale, the same bytes as the FP8 forward uvqk GEMM operand (the
#     STORE_T LN kernel computes mean/rstd in its own compiled kernel:
#     last-bit reduction-order class). All GEMMs accumulate in fp32. Bias
#     gradient: fp32 column sum of the UNQUANTIZED BF16 gradient (no FP8
#     rounding; reduction order differs). The VK producer payload is
#     byte-identical to casting the BF16 dV|dK it replaces.
#     ARMED (every rank): "[hstu-fp8-bwd-uvqk] requested: uvqk=1 wgrad=fp8t
#     store_t=1 vk_producer=1"; "[hstu-fp8-bwd-uvqk] prebuild: fp8t wgrad
#     extension (dlrm_hstu_fp8_wgrad_tm) built"; "[hstu-fp8-bwd-uvqk] fp8t
#     guard uvqk_projection on cuda:... -> armed"; "[hstu-fp8-bwd-uvqk] ARMED
#     uvqk_projection on cuda:"; "[hstu-fp8-bwd-uvqk] ARMED vk_projection on
#     cuda:... PRODUCER-cast e5m2 dz"; "[hstu-fp8-bwd-uvqk] STORE_T
#     site=uvqk_projection used forward-stored token-major E4M3 normed_x".
#     Must be ABSENT: "[hstu-fp8-bwd-uvqk] DISABLED", "fp8t wgrad DISABLED",
#     "-> INERT", "DECLINED for this contract", "fell back to the backward
#     recompute".
#     Opt out: DLRM_HSTU_FP8_BWD_UVQK=0 (all four; triton_addmm_bwd
#     path); DLRM_HSTU_FP8_BWD_UVQK_WGRAD=bf16 (FP8 dgrad only, BF16 wgrad);
#     DLRM_HSTU_FP8_BWD_UVQK_STORE_T=0 (recompute the token-major normed_x);
#     DLRM_HSTU_FP8_BWD_VK_PRODUCER=0 (BF16 dvk + cast pass). STORE_T and
#     VK_PRODUCER are inert without WGRAD=fp8t (the requested line says so).
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_UVQK = True
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_UVQK_WGRAD = "fp8t"
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_UVQK_STORE_T = True
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_VK_PRODUCER = True
#
# -----------------------------------------------------------------------------
# Same contract as the knobs above: each is
# gin-guarded (the bindings below turn it on, the code default when a binding
# is absent is OFF), every switch has an env kill switch of the same name, and
# a pre-set env var wins over gin. Where two knobs reach the same kernel call,
# the precedence is stated under both and in the code at the call site, and
# turning the winner off hands the call back to the other (or to the default
# path when that one is off too). Sub-switch letters are stable identifiers
# shared with the code comments. Precedence summary:
#   - FP8 weight-shadow refresh: WSHADOW_FUSED, then SHADOW_FUSED, then the
#     aten chain.
#   - C8 dq-split dq kernel: the BWD_DQ_E5M2 sink takes the ordinary-layer
#     calls it accepts (and ignores BWD_ATTN_V2's "kb" K-addressing hint);
#     declined calls and other layers run the BWD_ATTN_V2 dq kernel with "kb".
#   - Weighted-LayerNorm backward: WLN_BWD_FLYDSL, else WLN_DXSUM_V3 dxs512
#     (D=512 dx-sum) / D256_V3 (swish dx-sum), else WLN_BWD_V2 with
#     WLN_BWD_POW2, else v1.
#   - FWD_PIPE / DELTA_FWD_BM16 and BWD_ATTN_V2 touch different attention
#     kernels (forward / delta paths vs. the C8 backward); PREPROC_GROUPED_TAIL
#     changes the preprocessor LayerNorm forward only, its backward runs
#     through the same LayerNorm-backward dispatch.
#
# Bitwise bundle: EC sort/gather, LN-backward 2^-k, FP8
#     weight-shadow refresh, DDP gradient copy. Five independent switches.
#     WHAT: (a) EC_SORT32: the EC backward segment argsort sorts the row ids as
#     int32 keys (stable) instead of int64 keys (train/ec_offsets.py).
#     (c) EC_GATHER_V2: the EC expand forward gathers (dedup reverse indices,
#     including the EC_CAT_FUSE cat-fused member) run as one multi-row Triton
#     row copy with non-temporal stores instead of several aten gathers;
#     small index tensors stay on torch.gather (train/ec_expand_gather.py).
#     (d) WLN_BWD_POW2: the WLN_BWD_V2 weighted-LN backward forms its row means
#     with an exact power-of-two multiply instead of a runtime-int divide when
#     D is a power of two; v1 and non-power-of-two D are unchanged. It only
#     reaches the v2 calls that D256_V3 / WLN_DXSUM_V3 and WLN_BWD_FLYDSL
#     leave on v2.
#     (e) WSHADOW_FUSED: stale FP8 weight shadows are refreshed by two Triton
#     launches (amax partials, then scale/transpose/e4m3 cast), batching every
#     stale shadow on the same device and stream, instead of the aten
#     pack/amax/scale/quantize chain per weight (ops/triton/triton_fp8.py,
#     triton_fp8_wshadow.py). Runs ahead of SHADOW_FUSED.
#     (f) DDP_BATCHED_COPY: dense DDP copies gradients into its buckets with
#     torch's batched_grad_copy (one foreach copy plus one flat divide per
#     bucket) instead of one scaled copy per parameter (train/utils.py).
#     IMPACT: removes serial main-stream elementwise, sort, gather and copy
#     launches from the step.
#     NUMERICS: BIT-IDENTICAL. (a) same stable permutation (the int32 key is
#     order-preserving for any row id the table can hold). (c) a pure copy of
#     the same bytes (indices are in range by construction; unlike aten they
#     are not range-checked).
#     (d) the multiply and the divide by a power of two round identically;
#     re-validate after a Triton/LLVM change (the multiply can be contracted
#     into an FMA where the divide was not). (e) same amax, scale formula,
#     clamp and round-to-nearest-even e4m3 bytes as the aten chain; a Triton
#     failure disables it for the process with one warning and the aten chain
#     takes over. (f) both paths multiply by the same fp32 reciprocal of the
#     world size on ROCm/CUDA; builds without batched_grad_copy keep the
#     per-parameter copy with a warning. The new Triton kernels compile at
#     first use.
#     ARMED (rank log, once per rank): "DLRMV4 armed OK: ec sort32",
#     "DLRMV4 armed OK: ec gather v2", "armed OK: wln_bwd_pow2=1", "DLRMV4
#     armed OK: fp8 wshadow fused (batch=1)" then "DLRMV4 fp8 wshadow batch:",
#     "DLRMV4 armed OK: ddp batched copy". Must be ABSENT: "fp8 wshadow fused
#     DISABLED".
#     Opt out (each independently): DLRM_HSTU_FP8_EC_SORT32=0,
#     DLRM_HSTU_FP8_EC_GATHER_V2=0, DLRM_HSTU_FP8_WLN_BWD_POW2=0,
#     DLRM_HSTU_FP8_WSHADOW_FUSED=0
#     (DLRM_HSTU_FP8_WSHADOW_BATCH=0 keeps the fused kernels, one shadow per
#     call), DLRM_HSTU_FP8_DDP_BATCHED_COPY=0.
apply_env_bootstrap.DLRM_HSTU_FP8_EC_SORT32 = True
apply_env_bootstrap.DLRM_HSTU_FP8_EC_GATHER_V2 = True
apply_env_bootstrap.DLRM_HSTU_FP8_WLN_BWD_POW2 = True
apply_env_bootstrap.DLRM_HSTU_FP8_WSHADOW_FUSED = True
apply_env_bootstrap.DLRM_HSTU_FP8_DDP_BATCHED_COPY = True
#
# FP8 cast/producer diet + U-forward data-parallel GEMM (on top of
#     DLRM_HSTU_FP8_BWD_UVQK; ops/triton/triton_layer_norm.py, hstu_delta_bwd_e5m2.py,
#     bwd_fp8.py, hstu_dq_e5m2.py, fp8_helpers_fused.py, triton_fp8.py,
#     hipblaslt_scaled_mm_bias.cpp; the optional dq_fp8_sink argument of
#     ops/flydsl/hstu_flydsl_mha.py). One item switch plus seven sub-switches.
#   (a) BWD_STORE_T_V2: the UVQK_STORE_T LayerNorm that writes e4m3 normed_x and
#     its token-major copy runs more tokens per program on an XCD-grouped grid.
#   (b) BWD_VKP_V2: the VK_PRODUCER targets-only delta-attention backward runs a v2
#     kernel: exact per-row amax, element-wise dq accumulator, longest-first
#     launch order.
#   (c) BWD_COLSUM_V2: the BWD_UVQK dz -> e5m2 + amax + bias-colsum cast runs
#     on a 1-D XCD-grouped grid; under (d) only on the calls (d) declines.
#   (d) BWD_DQ_E5M2: on ordinary layers the C8 dq-split (BWD_DQ_SPLIT,
#     BWD_VALU / BWD_MSPLIT, BWD_ATTN_V2) writes the e5m2 q columns of dz with their amax / colsum partials
#     (a fork of the dq-split kernel, same main loop): no BF16 dq is stored
#     and the cast covers u|v|k only. Only fp8t calls with a published
#     per-layer scale and a covered dq-split schedule; other calls take the
#     BWD_UVQK path. It accepts BWD_ATTN_V2's "kb" token and keeps its own
#     runtime-stride K addressing (bitwise either way).
#   (e) SHADOW_FUSED: the FP8 forward weight-shadow refresh as two Triton
#     kernels instead of the aten chain, on the refreshes WSHADOW_FUSED
#     declines (with WSHADOW_FUSED on it normally never runs).
#   (f) BWD_HELPERS_FUSED: per-site scale bookkeeping and weight cast of the
#     FP8 backward sites run as two Triton kernels per site.
#   (g) FWD_U_DP: the U-slice GEMM of the QKV-fused FP8 forward calls
#     hipBLASLt through its own extension (the call torch._scaled_mm makes)
#     with a private workspace sized by DLRM_HSTU_FP8_FWD_U_DP_WS_MIB, which
#     keeps the library on its data-parallel grid. Built before RUN_START by
#     the C++ extension prebuild (only when the QKV-fused FP8 forward is on),
#     exercised by the BLAS warmup; a failed build stops the run before RUN_START.
#   IMPACT: fewer, shorter memory-bound passes around the FP8 GEMMs and a
#     stable U-forward grid. Costs: (d) keeps each ordinary layer's e5m2 dz
#     alive from the dq-split to the end of that layer's attention backward;
#     (g) one more extension build in initialization plus its workspace; the
#     new Triton kernels compile at first use.
#   NUMERICS: (a), (c), (e), (f), (g) BIT-IDENTICAL (payloads, scales, amax,
#     column sums, GEMM outputs). (b) and (d) are DECLARED fp32
#     summation-order changes: payload and amax bit-identical; the
#     targets-only dq (b) and the q-column bias-gradient sums (d) are the same
#     fp32 math in a different order. No dtype, scale rule, GEMM operand or
#     accumulation precision changes.
#   ARMED (every rank): "requested ... kernels: colsum_v2=1 store_t_v2=1
#     vkp_v2=1", "requested ... kernels: dq_e5m2=1", "ARMED store_t_v2 on
#     cuda:", "ARMED vkp_v2 on cuda:", "ARMED dq_e5m2 on cuda:", "ARMED
#     helpers_fused", "prebuild: u_dp extension (dlrm_hstu_fp8_scaled_mm_bias)
#     built/loaded", "ARMED u_dp on cuda:", "[blas-warmup] fp8 e4m3->bf16
#     +bias uvqk_u data-parallel (ext)". "ARMED colsum_v2" only where (d)
#     declines; "ARMED shadow_fused" only where WSHADOW_FUSED declines.
#     Must be ABSENT: "-> dq_e5m2 INERT", "-> vkp_v2 INERT", "-> store_t_v2
#     INERT", "-> colsum_v2 INERT", "dq_e5m2 sink NOT used", "u_dp NOT
#     engaged".
#   Opt out: DLRM_HSTU_FP8_TARGET_B=0 turns off all seven sub-switches that are
#     not themselves pre-set; any sub-switch alone with =0. To turn all of
#     them off regardless of other pre-set values, set all eight to 0.
apply_env_bootstrap.DLRM_HSTU_FP8_TARGET_B = True
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_STORE_T_V2 = True
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_VKP_V2 = True
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_COLSUM_V2 = True
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_DQ_E5M2 = True
apply_env_bootstrap.DLRM_HSTU_FP8_SHADOW_FUSED = True
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_HELPERS_FUSED = True
apply_env_bootstrap.DLRM_HSTU_FP8_FWD_U_DP = True
#
# Attention kernel configs: FP8 forward pipeline and delta-query
#     forward block. Two independent switches, each read per call by its
#     kernel module and armed only by "1".
#   (a) FWD_PIPE: the e4m3 FlyDSL attention forward (ops/flydsl/
#     hstu_flydsl_mha.py _FP8_FWD_PIPE_CFG, compiled by ops/flydsl/hstu_fwd.py;
#     active only with the FP8 FlyDSL forward, DLRM_HSTU_FP8_FWD with
#     HSTU_ATTN_FWD=flydsl) compiles a taller m-block over more waves, issues
#     the next n-iteration's K/V global loads one iteration early, and builds
#     the P@V A-fragment from the silu values in registers instead of an LDS
#     round trip.
#     NUMERICS: BIT-IDENTICAL output for finite V (same MFMAs on the same
#     operands; the taller block only adds zero-weight products, so a
#     non-finite V value could reach more causally earlier rows of its block).
#     ARMED (every rank, once): "[hstu-fwd] DLRM_HSTU_FP8_FWD_PIPE=1 armed:
#     BM128 waves4 kv_prefetch p_direct".
#   (c) DELTA_FWD_BM16: the delta-query attention forward of the targets-only
#     final layer (ops/triton/triton_hstu_attention.py triton_cached_hstu_mha)
#     launches a short query block instead of the pinned tall one when the
#     delta is small (ROCm, TMA off, not under TRITON_FULL_AUTOTUNE=1), so the
#     masked padding query rows are not computed.
#     NUMERICS: BIT-IDENTICAL (each query row walks the same key blocks with
#     the same MFMA shape; only padding rows go away).
#     ARMED (every rank, once): "[hstu_delta_fwd] DLRM_HSTU_FP8_DELTA_FWD_BM16=1
#     armed: delta-query forward uses BLOCK_M=16".
#   IMPACT: shortens the FlyDSL attention forward of the ordinary layers and
#     the targets-only delta attention forward.
#   Opt out (each independently): DLRM_HSTU_FP8_FWD_PIPE=0,
#     DLRM_HSTU_FP8_DELTA_FWD_BM16=0.
apply_env_bootstrap.DLRM_HSTU_FP8_FWD_PIPE = True
apply_env_bootstrap.DLRM_HSTU_FP8_DELTA_FWD_BM16 = True
#
# C8 attention backward, bitwise schedule bundle (on top of the VALU-diet /
#     m-split knobs above; dq-split calls only; ops/flydsl/hstu_bwd_dkdv.py,
#     hstu_flydsl_mha.py, hstu_dq_split.py). One switch,
#     DLRM_HSTU_FP8_BWD_ATTN_V2: the env bootstrap appends its tokens to the
#     gin-bound DLRM_HSTU_FP8_BWD_VALU / MSPLIT_SCHED / DQ_SPLIT_OPT lists and
#     binds the dq-split workspace store layout and aux bits. A pre-set env
#     value of any of those names is used verbatim, and a list that is off
#     stays off.
#     WHAT: (a) workspace store layout "l128t" with aux "2": the dq-split ds
#     workspace is stored as full rows without a lane exchange (the reads are
#     re-addressed so each lane already holds its payload), with the
#     non-temporal store policy; same bytes at the same addresses.
#     (b) DQ_SPLIT_OPT "kb": constexpr K row stride, so the dq kernel loads K
#     with buffer loads (only with "sp" and a dq-split schedule).
#     (c) MSPLIT_SCHED "xt,rs2,lc,ek,nk,wh": wider silu exchange,
#     loop-invariant per-lane offsets, narrower loop counter, carried K-block
#     scale select, no prologue K staging for the operand dq-split never
#     reads, and the workspace header load issued early.
#     (d) VALU "nobr" with MSPLIT_SCHED "mc" (only with VALU "msat"): the dk/dv
#     epilogue stores unconditionally with descriptors that end at the
#     sequence, and the overflow-mode clear moves to the top of the drain,
#     fenced. (e) "dzr" (only with layout l128t): workspace stores of padding
#     rows past the sequence end are dropped (the dq kernel masks them on read
#     and never stores them); the launcher asserts the sequence-length bound
#     this needs. (f) "bst": score-MFMA program order interleaved by operand.
#     (g) "ob0,obj" (together): the out-gemm B operands are read earlier.
#     IMPACT: shortens bwd_dkdv and the dq-split dq kernel. No MFMA or VALU
#     work is skipped (dzr drops only stores of values nothing reads).
#     NUMERICS: BIT-IDENTICAL dq/dk/dv vs the lists without these tokens: same
#     tiles, same MFMA operands, same per-accumulator order; only instruction
#     selection, addressing, placement and store layout/cache policy change.
#     Precedence: on ordinary layers the BWD_DQ_E5M2 sink runs the dq-split
#     calls it accepts with its own kernel (bitwise to this one), so "kb" acts
#     on the remaining dq-split calls; (a), (c)-(g) act regardless.
#     ARMED (every rank): "env bootstrap: DLRM_HSTU_FP8_BWD_ATTN_V2=1",
#     "[hstu-attn] bwd_dkdv VALU diet ARMED: valu=ilp,msat,nobr,rfl,undef",
#     "[hstu-attn] bwd dq SPLIT ws store ARMED: layout=l128t aux=2",
#     "[hstu-attn] bwd dq SPLIT load opts ARMED: {... 'rsk': 1}", and the env
#     echo "DLRM_HSTU_FP8_BWD_MSPLIT_SCHED=mid,sb,wsl,sgv5,la,xt,rs2,lc,ek,nk,
#     wh,mc,dzr,bst,ob0,obj".
#     Opt out: DLRM_HSTU_FP8_BWD_ATTN_V2=0 (the lists exactly as bound above).
#     Partial: pre-set the list without the token to drop (nobr and
#     mc together; ob0 and obj together; dzr, bst and kb alone).
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_ATTN_V2 = True
#
# LayerNorm-family v3 kernels, single-launch EC segment reduce and a
#     mask-generating LN*U*dropout forward. Five independent switches.
#     WHAT: (a) D256_V3: the D=256 swish LinearNorm of the preprocessor MLPs
#     launches v3 forward/backward kernels (the WLN_FWD_V2 / WLN_BWD_V2 v2
#     kernels with D as a compile-time constant) and, in the dx-sum backward
#     with WLN_BWD_V2 on and the pinned finalize config, a two-phase finalize.
#     The forward runs only where v2 would; the backward only on calls
#     WLN_BWD_FLYDSL leaves to Triton.
#     (b) WLN_DXSUM_V3: the non-swish D=512 LinearNorm dx-sum backward runs a
#     one-wave dxs512 kernel on more programs instead of v2's pipelined
#     programs. Only with WLN_BWD_V2, and only on calls WLN_BWD_FLYDSL leaves
#     to Triton.
#     (c) LNMD_FWD_V3: where LNMD_FWD_V2 runs v2 with a full-width block, the
#     LN*U*dropout forward runs v3 (same per-row code, next row's loads
#     pipelined, a larger persistent grid).
#     (d) EC_REDUCE_LPT: the GPU-planned EC segment reduce
#     (train/ec_gpu_plan.py) runs ONE launch (hot pieces first, then cold rows
#     longest class first, planned on the GPU without a host sync) with a
#     one-wave even/odd tile fold, instead of the cold + hot launches. It
#     accumulates into the EC_GROUP_BWD grouped EC backward buffer. The
#     first call per (width, dtype, row-stride) key runs a small bitwise
#     self-check and falls back to the two-wave fold where the identity does
#     not hold.
#     (e) LNMD_FWD_MASKGEN: where the training forward would run the separate
#     16-bit Philox mask generator and then (c) (or the LNMD_FWD_V2 kernel), ONE
#     kernel recomputes the same keep decisions in registers, stores the same
#     int8 mask (the backward still reads it) and runs (c)'s per-row math.
#     Only the configuration it implements (concat u and x, silu, e4m3 output,
#     D = BLOCK_D = 512, bf16 inputs, gfx950, and a row count within its int32
#     counter bound); everything else keeps the existing launches.
#     IMPACT: shorter LayerNorm-family kernels and EC backward segment reduce;
#     (e) one launch instead of two and no mask write-then-read. The new
#     kernels compile at first use.
#     NUMERICS: (a), (c), (e) BIT-IDENTICAL (same per-element operations; (e)
#     gives the same mask bytes and the same e4m3 y, mean and rstd). (d) cold
#     rows BIT-IDENTICAL (self-checked), hot rows keep the atomic-order
#     nondeterminism. (b) is a DECLARED fp32 reduction-order change: the D=512
#     LinearNorm dw/db/dx-sum partial order changes and rare bf16 dx elements
#     can differ by one ulp (fp64-oracle error unchanged).
#     ARMED (every rank, once each per process, tagged "[rank N]"):
#     "armed OK: D256 swish LN v3 ACTIVE (fwd)";
#     "armed OK: LN*U*dropout fwd v3 ACTIVE" (printed by the bf16 FP8
#     calibration calls, which (e) never takes); "... ec_reduce_lpt armed";
#     per self-check key "... ec_reduce_lpt width=... one-wave even/odd fold
#     bitwise OK" or "... -> incumbent 2-wave fold" (both kinds are expected,
#     one per EC width); "armed OK: LN*U*dropout fwd maskgen ACTIVE". With
#     WLN_BWD_FLYDSL off (or where it falls back): "armed OK: D256 swish LN v3 ACTIVE (bwd)",
#     "... (fin)", "armed OK: wln dxsum v3 ACTIVE".
#     Opt out: DLRM_HSTU_FP8_D256_V3=0, DLRM_HSTU_FP8_WLN_DXSUM_V3=0,
#     DLRM_HSTU_FP8_LNMD_FWD_V3=0, DLRM_HSTU_FP8_EC_REDUCE_LPT=0,
#     DLRM_HSTU_FP8_LNMD_FWD_MASKGEN=0. Only the value 0 disarms a switch.
#     (e) does not consult (c): restoring this forward's previous launches
#     takes both LNMD_FWD_V3=0 and LNMD_FWD_MASKGEN=0.
apply_env_bootstrap.DLRM_HSTU_FP8_D256_V3 = True
apply_env_bootstrap.DLRM_HSTU_FP8_WLN_DXSUM_V3 = True
apply_env_bootstrap.DLRM_HSTU_FP8_LNMD_FWD_V3 = True
apply_env_bootstrap.DLRM_HSTU_FP8_EC_REDUCE_LPT = True
apply_env_bootstrap.DLRM_HSTU_FP8_LNMD_FWD_MASKGEN = True
#
# MGPK: the LNMD_FWD_MASKGEN mask-generating LN*U*dropout forward on a
#     bitwise VALU-diet kernel (ops/triton/triton_hstu_linear.py
#     _ln_mul_dropout_fwd_maskgen_pk, gate _use_lnmd_fwd_maskgen_pk). Code
#     default OFF; the bindings below turn it ON.
#     WHAT: where LNMD_FWD_MASKGEN launches _ln_mul_dropout_fwd_maskgen, the same
#     launch (arguments, grid, Philox counters, keep decisions, per-row
#     arithmetic) runs the _pk kernel: the dropout keep masks are applied to
#     the e4m3 output bytes instead of the fp32 values, the int8 mask row and
#     the y planes are stored as dwords, the per-element fp32 math runs on
#     packed column pairs, the Philox keep-bit merge is one shift-or per word
#     and two rows run per loop trip. The fp8 saturation mode bit that
#     Triton's own e4m3 conversion sets at kernel entry is set explicitly.
#     Only on calls LNMD_FWD_MASKGEN arms, and per call only when the fp32 Y_INV_SCALE
#     the kernel receives is in (0, inf) and the y / mask rows are
#     dword-aligned (always true for the launch site's fresh allocations);
#     any other call runs the plain maskgen kernel. A launch that raises
#     latches MGPK off for the process; the plain kernel then writes
#     every output.
#     WHY: the maskgen forward is bound by vector-ALU issue; most of the
#     removed work is the per-element dropout bit extraction and masking in
#     fp32.
#     LAYER LIST (DLRM_HSTU_FP8_MASKGEN_PK_LAYERS, bound below to "1"): the
#     zero-based STU layers on which the _pk kernel may run; on the others
#     the plain kernel runs (same bytes, so the list only picks the
#     kernel per call site). Each STULayer tags its compute output
#     with its STUStack index right before the call (modules/stu.py
#     _tag_lnmd_layer). An untagged call (the first-use warmup, a direct
#     call) with a list runs both kernels into the same buffers. Unset or
#     empty: every layer, and an untagged call runs the _pk kernel only. The
#     default is layer 1 only: in the training step the _pk kernel is faster
#     on the second full-length layer and not on the first.
#     IMPACT: shorter LN*U*dropout forward on the listed layers (the step
#     makes two full-length maskgen calls, one per STU layer below the
#     targets-only layer). Every specialization the TSPEC table
#     (ops/triton/triton_spec_table.jsonl, which carries _pk rows next to the
#     plain maskgen kernel's) recorded for either kernel compiles before
#     RUN_START: the post rows through the TSPEC replay, the warm-up class
#     through the FP8 first-use warmup's L4 case (FP8_WARMUP != 0), which
#     reaches both kernels through the production wrapper with untagged calls.
#     NUMERICS: BIT-IDENTICAL. The same int8 mask (bit 0 y, bit 1 x, bit 2 u;
#     the LN*U*dropout backward v2, BWD_DU_E5M2 and the L11 fused kernel read
#     it unchanged) and the same e4m3 y, mean and rstd. A dropped element is
#     +0.0 before the fp8 conversion in the plain kernel and converts to
#     0x00 for every Y_INV_SCALE in (0, inf); kept elements run the same
#     IEEE operations and conversion instruction. Independent of
#     DROPOUT_MASK_BITS, which packs the HSTU input-dropout mask, not
#     this one.
#     ARMED (every rank, once per process, after the first successful
#     launch): "armed OK: LN*U*dropout fwd maskgen pk ACTIVE ... STU layers
#     1"; with the layer list, also once "LN*U*dropout fwd maskgen pk
#     layer-gated (DLRM_HSTU_FP8_MASKGEN_PK_LAYERS=1): STU layer 0 runs the
#     shipped _ln_mul_dropout_fwd_maskgen"; LNMD_FWD_MASKGEN's "armed OK: LN*U*dropout
#     fwd maskgen ACTIVE" still prints. Must be ABSENT: "LN*U*dropout fwd
#     maskgen pk DISABLED", "LN*U*dropout fwd maskgen pk declined".
#     Opt out: DLRM_HSTU_FP8_MASKGEN_PK=0 in the environment (a pre-set
#     value wins over the binding): the plain maskgen kernel on every
#     layer; DLRM_HSTU_FP8_LNMD_FWD_MASKGEN=0 turns MGPK off as well.
#     DLRM_HSTU_FP8_MASKGEN_PK_LAYERS (env wins) overrides the layer list.
#     A launcher that forwards only non-empty values cannot pass an empty
#     list, so select every layer with an explicit list (e.g. 0,1,2). The
#     bindings below need an apply_env_bootstrap that declares these
#     parameters; otherwise gin parse rejects them.
apply_env_bootstrap.DLRM_HSTU_FP8_MASKGEN_PK = True
apply_env_bootstrap.DLRM_HSTU_FP8_MASKGEN_PK_LAYERS = "1"
#
# FlyDSL weighted LayerNorm backward (ops/flydsl/ln_bwd.py, with a guard for
#     32-bit row offsets and a cold-start prebuild). Not an FP8 knob.
#     WHAT: the weighted-LayerNorm backward of the four variants the step runs
#     (the STU norms with the residual add; the targets-only STU norm of
#     TGT_SPARSE_RESID without it; the preprocessor MLP output norms with the dx
#     sum; the MLP SwishLayerNorms with the dx sum) runs as one FlyDSL kernel
#     plus a FlyDSL finalize, ahead of the Triton v1/v2/v3 choice, so
#     WLN_BWD_V2, WLN_BWD_POW2 and D256_V3 / WLN_DXSUM_V3 no longer reach
#     these calls. Rows
#     interleave over a persistent grid, partials stay in registers and reduce
#     in LDS, blocks take rows in an XCD-aware order and the streamed loads
#     and dx store use a streaming cache policy (both bitwise-neutral, each
#     with its own kill switch). The layer-0 input-LayerNorm backward with the
#     DROPOUT_MSCALE_FOLD mask/scale epilogue, the fp32 item-MLP LayerNorm and any
#     non-gfx950 device stay on Triton. A FlyDSL import/compile/launch error
#     latches the FlyDSL path off for the process with one loud line and every
#     call falls back to Triton.
#     COLD START: with the cold-start bundle's startup preload on, the production variants
#     are JIT-built on synthetic zero/one tensors before RUN_START (no data, no
#     RNG; skip only that with run_startup_preload.ln_bwd = 0).
#     IMPACT: shortens the LayerNorm-backward kernels.
#     NUMERICS: last-bit, not a precision change: not bit-identical to the
#     WLN_BWD_V2 Triton v2 + fast sigmoid (a very small fraction of dx elements
#     differ by about one bf16 ulp; fp64-oracle error unchanged); the dW/dB/
#     dx-sum partials use a different deterministic order (no atomics). With
#     this on, the WLN_BWD_V2 / FAST_SIGMOID opt-outs no longer reach the calls
#     it takes, and the DROPOUT_MSCALE_FOLD=0 opt-out moves STU
#     layer 0 onto FlyDSL (so that opt-out is not bit-identical).
#     ARMED (every rank, once per process at first use): "armed OK: ...
#     kernel switches: ... wln_bwd_flydsl=1"; four "[ln-bwd] flydsl:" lines
#     (D=512 residual=1; D=512 residual=0 dxsum=0; D=512 dxsum=1; D=256 swish=1
#     dxsum=1); "armed OK: [startup-preload] flydsl ... ln_bwd=4"; exactly one
#     expected "[ln-bwd] triton:" line (the fp32 item-MLP LayerNorm). Must be
#     ABSENT: "[ln-bwd] flydsl DISABLED".
#     Opt out: DLRM_HSTU_FP8_WLN_BWD_FLYDSL=0 (the Triton dispatch above takes
#     every call again); sub-switches DLRM_HSTU_FP8_WLN_BWD_FLYDSL_XCD_REMAP=0
#     and DLRM_HSTU_FP8_WLN_BWD_FLYDSL_STREAM_CACHE=0 (bitwise-neutral).
apply_env_bootstrap.DLRM_HSTU_FP8_WLN_BWD_FLYDSL = True
#
# Grouped preprocessor LayerNorm(512) tail, forward (ops/
#     preproc_grouped_tail.py, kernel ops/triton/triton_preproc_tail.py, call
#     site modules/preprocessors.py ContextualPreprocessor.forward).
#     WHAT: with fuse_linear_norm and fuse_ln_residual on, the three
#     preprocessor MLPs each end in a Linear + LayerNorm(512) pair chained by
#     fuse_ln_residual's round-before-add residual. Instead of three LayerNorm launches that
#     write the content output and the running sum to HBM for the next launch
#     to read back, the three last-pair Linears run at the end of the MLP
#     section and ONE grouped Triton launch computes all three LayerNorms and
#     the residual chain, reading each input once and writing the output once.
#     The backward runs the per-pair body for the three pairs in
#     autograd's order on the same saved tensors, so its LayerNorm backwards go
#     through the WLN_BWD_FLYDSL / WLN_DXSUM_V3 / WLN_BWD_V2 dispatch.
#     IMPACT: less LayerNorm-tail forward HBM traffic and two fewer launches.
#     Cost: the three last-pair inputs stay live until the grouped node's
#     backward finishes (one more [N, 512] bf16 at the end of the step's
#     backward; the preprocessor forward peak drops by one). Declines (per-MLP
#     path) on non-ROCm builds.
#     NUMERICS: BIT-IDENTICAL output, statistics and gradients per rank, given
#     the autotune pins of the per-MLP LayerNorm(512) forward (the
#     armed line reports bitwise=yes/no). The parameter-gradient ready order
#     inside the preprocessor backward changes, so DDP can bucket differently:
#     an fp32 all-reduce summation-order change.
#     ARMED (every rank, once per process): "armed OK: [preproc-grouped-tail]
#     inputs=3 N=... ln512_pins=8x1/4x1 bitwise=yes rank=". Must be ABSENT:
#     "[preproc-grouped-tail] DLRM_HSTU_FP8_PREPROC_GROUPED_TAIL=1 but the
#     grouped tail DECLINED", "armed OK: [preproc-grouped-tail-bwd]".
#     Opt out: DLRM_HSTU_FP8_PREPROC_GROUPED_TAIL=0 (per-MLP tails;
#     PREPROC_GROUPED_TAIL_BWD, which runs inside this backward, is then inert).
#     The grouped LayerNorm backward (DLRM_HSTU_FP8_PREPROC_GROUPED_TAIL_BWD)
#     is a separate knob: see below and ops/preproc_grouped_tail.py.
apply_env_bootstrap.DLRM_HSTU_FP8_PREPROC_GROUPED_TAIL = True

# Train DataLoader workers per pool: 6 (binding: nw/env_int.default at the
#     top of this file; consumed by make_persistent_streaming_dataloader via
#     %num_workers).
#     WHAT: each rank's train pool(s) (one with DL_SINGLE_POOL=1, two with
#     DL_SINGLE_POOL=0) fork 6 worker processes each. Sampler,
#     sample order, collate and prefetch depth (PREFETCH_FACTOR) are unchanged;
#     only how many processes build batches in parallel changes.
#     WHY: at one node, full-size late data windows produce long-history
#     samples whose batch build can be slower than the step; with too few
#     workers each window's prefetch buffer drains part-way through and
#     the slowest rank then waits on the loader every step (seen as a
#     saw-tooth: GPU-speed steps while buffered, loader-paced steps after).
#     Larger pools cost more at every window start (each new window's pool
#     spins up and competes with the trainer's host thread), so more workers
#     is not better.
#     IMPACT: removes the loader-paced stretches of full-size windows at 1n;
#     smaller effect at 2n/4n (each rank needs fewer batches per window). No
#     effect on short or early windows (they stay inside the prefetch buffer).
#     Cost: more forked workers per pool (host memory and CPU), and a
#     slightly longer pool start at each window boundary and before RUN_START.
#     NUMERICS: unchanged inputs: same samples, same order, same batches.
#     Not a compute reduction.
#     ARMED (every rank, once per pool set): "armed OK: train pool
#     num_workers=6".
#     Opt out: NUM_WORKERS=4.
#
# -----------------------------------------------------------------------------
# Same contract as the earlier knobs: each is
# gin-guarded (the binding turns it on; the code default when a binding is
# absent is OFF), every switch has an env kill switch of the same name, and a
# pre-set env var wins over gin. Blocks that extend an earlier knob sit next
# to it: the posenc concat pin rows after the autotune pin table; the
# eval/train batched batch builders, the FP8 first-use warmup and the
# cold-cache read-ahead in the streaming section next to the cold-start
# bundle; the fused dense Adam next to the dense optimizer.
# Precedence where knobs reach the same call site:
#   - Train loader: DL_SINGLE_POOL replaces the two alternating train pools
#     with one chained pool. The eval
#     batched builder changes only the eval pools' batch builder; the train
#     batched builder moves the single train pool to the same builder, and
#     with DL_SINGLE_POOL=0 the train pools keep the per-sample builder unless
#     DL_FAST_BATCH is set in the environment. The cold-cache read-ahead
#     (DL_COLD_PREFETCH_STREAM), when armed, walks the stream of whichever
#     train loader runs; the cold-start bundle's pre-start forks the single
#     pool. The FP8 first-use warmup touches no loader.
#   - Allocator pre-grow: the FP8 first-use warmup's converge pass sizes the
#     main pool first, then TM_NONEXP maps its private token-major pool from
#     the margin. The warmup holds TM_NONEXP's pool off (plain allocations).
#   - FP8 GEMMs: the K=tokens weight-gradient bundle (BWD_DU_E5M2 ...
#     BWD_WGRAD_CK_W3_T256S) replaces only the backward K=tokens
#     weight-gradient GEMMs (uvqk, vk, out-projection) and their operand
#     producers; FWD_K512 / FWD_K1536 replace forward projection /
#     out-projection GEMMs. No call site is shared. Build order before
#     RUN_START: BWD_WGRAD_CK / BWD_WGRAD_CK_W3, FWD_K512 (then, when
#     FWD_K512_TILED_A is armed, the self-check of FWD_K512's tiled-A entry),
#     FWD_K1536, then BWD_OUTPROJ_LNMD_FUSED. FWD_K512_TILED_A (after DSC_K
#     below) moves the targets-only layer's V/K projection from FWD_K512's
#     row-major entry to its tiled-A entry, which reads
#     BWD_WGRAD_CK_XT_TILED's step-tiled yT; it adds no call site.
#   - Out-projection backward of the ordinary STU layers:
#     BWD_OUTPROJ_LNMD_FUSED (L11) when armed (e5 mode when BWD_DU_E5M2
#     emits, else bf16-du mode; it passes BWD_WGRAD_CK_W3_TILED's step-tiled
#     dout_t decision through), else hipBLASLt dgrad + the LN*U*dropout
#     backward: BWD_DU_E5M2's v3 kernel when it emits, else LNMD_BWD_V2.
#   - uvqk dz8 of the ordinary STU layers (the e5m2 operand of the BWD_UVQK
#     FP8 projection backward): the first producer in backward order
#     allocates it (L11 in e5 mode, else BWD_DU_E5M2, writing the u block);
#     BWD_DKDV_E5M2 adopts it and writes v|k from the attention backward,
#     the BWD_DQ_E5M2 dq sink writes q, and the cast covers the rest (nothing
#     when all three emit). Without a u producer BWD_DKDV_E5M2 allocates
#     the dz8.
#   - Attention sort_by_length permutation: GLUE_FOLD3 makes it
#     lazy (kill switch DLRM_HSTU_FP8_GLUE_FOLD3_SORT=0); ATTN_GLUE_LAZY defers
#     only the fallback Q/K/V scale tensor of the saved-FP8 backward (its
#     sort half is the same change and is not wired twice), so its ARMED
#     line prints at the first backward, not at the first forward.
#   - Layer-0 input-LayerNorm backward with the dropout mask/scale epilogue:
#     WLN_BWD_FLYDSL_MSCALE (reads DROPOUT_MASK_BITS's bit-packed mask when
#     that is on), else DROPOUT_MASK_BITS's Triton bits fold, else
#     DROPOUT_MSCALE_FOLD's Triton v2 kernel.
#     Preprocessor LayerNorm(512) dx-sum backward: PREPROC_GROUPED_TAIL_BWD
#     grouped FlyDSL when WLN_BWD_FLYDSL owns all three calls, else
#     WLN_BWD_FLYDSL per call.
#   - Position encoding: POSENC_DROPOUT_FUSE moves the concat kernel out of
#     the training forward (the eval forward still runs it); the int16
#     posenc concat pin row matches POSENC_SORT16's int16 sort keys, its
#     int32 row the keys with POSENC_SORT16 off.
#
# One chained train pool per rank.
#     WHAT: ONE persistent train pool per rank serves the whole run: its batch sampler
#     (_ChainedWindowBatchSampler) yields window k's batches and then window
#     k+1's, with the same per-window per-rank slice, the same drop_last per
#     window, the same per-window cap and the same resume skip as the
#     per-window sampler. The prefetch depth simply continues across each
#     boundary, so the pool builds one batch for each batch the trainer
#     consumes. Window indices are still computed ahead in a background
#     thread, inside the timed region. utils.py window_single_pool /
#     _PrefetchingWindowLoader._stream_single.
#     WHY: the trainer step is sensitive to host-side contention. With two
#     alternating pools (DL_SINGLE_POOL=0), at every window boundary except
#     the last the pool that just finished a window is reset for the window
#     after next and handed its whole prefetch depth (PREFETCH_FACTOR x
#     NUM_WORKERS batch indices) at once, so all of its workers build batches
#     back to back and its pin-memory thread pins them during the first steps
#     of the new window, inside the trainer's own process. That burst slows
#     the trainer's host thread for many steps after each boundary and grows
#     with the worker count.
#     IMPACT: removes the per-window re-prime burst, and with it the boundary
#     slowdown it causes, at every node count,
#     including short per-rank windows at 2n/4n and the short early windows
#     of a run; half the train worker processes per rank (one pool instead
#     of two). The prefetch depth the first window starts with is unchanged.
#     NUMERICS: unchanged inputs: same samples, same order, same batches,
#     same per-window batch counts; only which worker process builds a batch
#     and when changes. Input reads stay inside the timed region; nothing is
#     read or prefetched before RUN_START (the pre-started pool's sampler
#     yields nothing until the stream starts). Not a compute reduction.
#     Needs the persistent double-buffered loader (PERSISTENT_LOADER=1 and
#     DOUBLE_BUFFER=1, both default). With the chained window stream
#     (TP_WARM_WINDOWS=1, default) each window is bounded by its batch count;
#     the per-window consumers (TP_WARM_WINDOWS=0 or TRAIN_PIPELINE=0) get a
#     view of the shared iterator that ends after the window's (capped)
#     batches, and batches a window abandoned early are dropped before the
#     next window, as with the alternating pools.
#     ARMED (every rank, once per run): "armed OK: [wbnd] single train pool
#     rank=" followed by the rank and the world size.
#     Opt out: DL_SINGLE_POOL=0: two alternating pools, the freed pool
#     re-primed one-shot (its whole prefetch depth) for the window after next.
window_single_pool.enabled = @dlsp/env_int()
dlsp/env_int.key     = "DL_SINGLE_POOL"
dlsp/env_int.default = 1
#
# -----------------------------------------------------------------------------
# FP8 K=tokens weight-gradient bundle: e5m2 du emission, a plain-segment
#     pool for the token-major operands, custom wgrad kernels (on top of
#     MASK16, LNMD_BWD_V2, BWD_OUT_WGRAD, BWD_UVQK and the TARGET_B bundle;
#     ops/triton/hstu_du_e5m2.py, hstu_dq_e5m2.py, triton_hstu_linear.py,
#     triton_hstu_preprocess_and_attention.py, bwd_fp8.py, fp8_tm_alloc.py,
#     triton_layer_norm.py, triton_fp8.py, wgrad_ck.py + wgrad_tm_ck.cu,
#     wgrad_ck_w3.py + wgrad_tm_ck_w3.cu; dlrm_v4/alloc_pregrow.py). Eight
#     switches, read at import after the env bootstrap: four independent parts
#     (a)-(d); (e)/(f), which only change the layout of the operand that
#     (c)/(d) read and are inert without them; (g), which only chooses
#     where (b) allocates the (e)/(f) operands; and (h), which only
#     chooses the kernel entry with which (d) reads the (f) operand ((h) is
#     bound on below).
#   (a) BWD_DU_E5M2: on ordinary STU layers whose backward plans the
#     UVQK_WGRAD=fp8t uvqk wgrad, the LN*U*dropout backward runs a v3 kernel (the
#     LNMD_BWD_V2 per-row math specialised to the production layout) that
#     writes the e5m2 u columns of that layer's dz8 (tokens padded x 2048),
#     with their amax and fp32 column-sum partials, instead of a BF16 du: no
#     BF16 du and no BF16 d(uvqk)-wide buffer in that backward. The preprocess
#     backward then casts only the remaining columns (v|k when the BWD_DQ_E5M2
#     dq-split sink filled q in the same dz8, else v|q|k; with BWD_DKDV_E5M2
#     engaged: nothing, or q only) and merges amax and
#     column sums before the FP8 uvqk projection backward. Needs MASK16,
#     LNMD_BWD_V2 and BWD_UVQK with UVQK_WGRAD=fp8t (its requested line says
#     INERT otherwise); with or without BWD_DQ_E5M2. The LNMD_FWD_MASKGEN forward
#     stores the same int8 mask bytes this backward reads. Calls outside its
#     contract (warm-up before the per-layer scale is published, a
#     retained-graph second backward, another layout, BF16-dz diagnostics)
#     run the LNMD_BWD_V2 kernel and log "du_e5m2 NOT used (<reason>)".
#   (b) TM_NONEXP: the token-major e4m3 operands of the K=tokens wgrad
#     GEMMs -- normed_x^T from the UVQK_STORE_T / BWD_STORE_T_V2 LayerNorm
#     store_t and from the backward recompute (xT), and BWD_OUT_WGRAD's dual-cast dout copy
#     (dout_t) -- come from a private torch.cuda.MemPool of plain
#     (non-expandable) segments instead of the expandable main pool. Same
#     tensors, shapes and strides; only the allocation moves. Requests round
#     up to 512 MiB with a 2 GiB floor and each tensor is a view of a whole
#     block, so freed blocks are reused whole. The allocator pre-grow maps five
#     2 GiB blocks (three xT, one dout_t, one spare) AFTER the main pool took
#     "rest", i.e. from its margin, before RUN_START. The allocator setting is
#     switched to expandable_segments:False for each pool allocation only and
#     restored. Inert unless the allocator conf has expandable_segments:True.
#   (c) BWD_WGRAD_CK: the UVQK_WGRAD=fp8t uvqk (N=2048) and vk (N=1024) weight
#     gradients run a custom kernel (wgrad_tm_ck.cu: split-K over XCD cohorts,
#     each token chunk of both operands fetched from HBM once per cohort, fp32
#     partials in a persistent per-(device, N, stream) workspace, fixed-order
#     reduction applying both scales) instead of the hipBLASLt NN GEMM, on the
#     same e5m2 dz8 and e4m3 xT.
#   (d) BWD_WGRAD_CK_W3: BWD_OUT_WGRAD's NN-mode out-projection wgrad runs the same
#     design for N=1536 (wgrad_tm_ck_w3.cu) instead of the hipBLASLt NN GEMM,
#     on the same e4m3 y and dout_t (it zero-fills the <= 15 dout_t padding
#     columns it reads). Needs BWD_OUT_WGRAD with IMPL=nn (INERT line otherwise).
#   (e) BWD_WGRAD_CK_XT_TILED: while (c) is armed on a device (requested, not
#     latched, its library loaded, gfx950), the producers of (c)'s token-major
#     operand -- the UVQK_STORE_T / BWD_STORE_T_V2 LayerNorm store_t and the backward
#     recompute -- write xT STEP-TILED: a 3-D e4m3 tensor [ceil(M/128), 512,
#     128] in which step k holds tokens [128k, 128k+128) of all 512 rows as one
#     contiguous block (zero tail tokens), instead of row-major [512, Mp]. (c)
#     reads it with its tiled entries wgrad_ck_w1_t / wgrad_ck_w2_t (same
#     tiles, splits and fp32 order as the row-major entries). y, mean and rstd
#     are unchanged.
#   (f) BWD_WGRAD_CK_W3_TILED: while (d) is armed, BWD_OUT_WGRAD's NN-mode dual
#     cast writes its token-major dout copy (dout_t) in the same step-tiled
#     layout, and (d) reads it with its tiled entry wgrad_ck_w3_t (same tiles,
#     splits and fp32 order; it zero-fills the tail tokens of the last step,
#     where the cast already wrote zeros). The row-major e4m3 dout, its amax
#     and its partials are unchanged.
#   (g) TM_NONEXP_TILED: where (b) allocates the step-tiled operands of
#     (e)/(f). "1" (the binding below; also the code default when absent) =
#     (b)'s private pool, like the row-major operands; "0" = the ordinary
#     expandable caching allocator, and the allocator pre-grow then skips (b)'s prewarm
#     when every operand the pool would serve is step-tiled (an explicit
#     DLRM_HSTU_FP8_TM_NONEXP_BLOCKS still prewarms; a row-major operand after
#     a latch maps the pool on demand, logged once per device). Inert without
#     (b) and (e)/(f).
#   (h) BWD_WGRAD_CK_W3_T256S: while (f) is armed, (d) reads the step-tiled
#     dout_t with the entry wgrad_ck_w3_t256s instead of wgrad_ck_w3_t: W1's
#     wider output tile over more token splits, so nearly every CU holds a
#     split, and a fixed-order reduction over those splits (a larger
#     persistent partial workspace). Its own first-call guard per device
#     against the same hipBLASLt reference and tolerance; declines, the latch,
#     the deferred guard and the tiling-off rule are those of (f), and a
#     row-major dout_t still runs (d)'s row-major entry. Requested without (d)
#     and (f), it prints an INERT requested line and changes nothing.
#     On by default: bound True below (the code default when the binding is
#     absent is off). Kill switch: DLRM_HSTU_FP8_BWD_WGRAD_CK_W3_T256S=0 in
#     the environment (a pre-set env value wins over the binding), or its
#     binding below set to False: (f)'s entry wgrad_ck_w3_t then runs, with
#     its own values.
#   (e) and (f): the layout tag is the tensor rank (3-D = step-tiled), and the
#     tiling is decided before the producer runs, from the custom kernel's
#     latch state, so the steady state never re-lays an operand out. Every
#     other reader of a tiled operand (the first-call guard's hipBLASLt
#     reference, hipBLASLt after a decline or a latch; for (f) also
#     BWD_OUT_WGRAD's TN fallback and the SNR probe) first copies it back to the exact
#     row-major bytes, into (b)'s pool when that is mapped on the device
#     (normally its prewarmed spare block), else into the main pool. Each
#     tiled entry has its own first-call guard per device and N; a failure
#     latches the whole (c) or (d) kernel off, after which the producers write
#     the row-major layout again. A decline of a tiled operand (a call outside
#     the kernel's contract) turns that tiling off for the process with one
#     line and no latch, so a steady decline never re-lays out every call.
#     Out of memory on the row-major copy latches nothing: for (e) that call's
#     uvqk / vk weight gradient runs the BWD_UVQK BF16 wgrad (FP8 dgrad kept)
#     and a first-call guard that needed the copy is deferred to the next
#     call; for (f) a deferred first-call guard keeps (d)'s result of that
#     call if it is all-finite (one host sync; else (d) latches as a rejected
#     guard), while on hipBLASLt after a (d) decline or latch the error
#     propagates as before (no allocation-free fallback at that site).
#     Requested without (c) / (d), each prints an INERT requested line and
#     changes nothing.
#   (c) and (d) are built with hipcc before RUN_START by the C++ extension
#     prebuild (at first use if it is off) into /tmp/dlrm_hstu_fp8_wgrad_ck/<hash of
#     source, flags, arch, hipcc version>/ (temporary file per host/pid/thread,
#     atomic rename; a cache hit skips the build). The first call per (device,
#     N) also runs that call's
#     hipBLASLt GEMM and requires the custom result to be all-finite with
#     rel_l2 <= 1e-4 against it. A rejection, a build/load failure, a
#     non-gfx950 device or any launch error latches that kernel off for the
#     process with one loud line, and hipBLASLt runs that call and every later
#     one; calls outside a kernel's contract (dtype, layout, alignment, N)
#     decline to hipBLASLt with one line per reason. (c) and (d) latch
#     independently.
#   IMPACT: (a) the BF16 du write and its re-read by the dz cast go away;
#     (b) the K=tokens wgrad GEMMs (hipBLASLt or (c)/(d)) and the token-major
#     writers stop paying the expandable segment's mapping granularity on
#     these operands; (c)/(d) each token chunk of
#     both wgrad operands is fetched from HBM once per XCD cohort and re-served
#     from that XCD's L2 instead of being re-read per output tile; (e)/(f)
#     each 128-token step of that operand is one contiguous block, so the
#     custom kernels' reads no longer stride over the token count of a
#     row-major operand (no extra kernel, no extra bytes).
#     Costs: (b) up to 10 GiB of plain segments per device out of the
#     allocator pre-grow margin (RCCL and non-torch workspaces keep the rest); (c)/(d)
#     176 MiB of persistent fp32 partial workspace per device (64 + 64 +
#     48 MiB, main pool, first FP8 step; 191 MiB with (h), bound on below:
#     its 21 token splits make (d)'s part 63 MiB), one hipcc build per host
#     before RUN_START, and the first-call guard per (device, N) inside the
#     first FP8 step (one extra hipBLASLt GEMM, an fp64 compare, two host
#     syncs);
#     (e)/(f) no steady-state memory (the tiled tensor replaces the row-major
#     one byte for byte), a transient row-major copy for each tiled entry's
#     first-call guard and for any fallback (from (b)'s spare block when
#     mapped). (g)=0 returns (b)'s prewarm to the margin when every pooled
#     operand is step-tiled. (h) enlarges (d)'s persistent partial
#     workspace (more token splits) at the first call of its entry on a
#     device and stream.
#   NUMERICS: (a) e5m2 payload (incl. pad rows), amax, dx and the LayerNorm
#     dW/dB BIT-IDENTICAL; the 512 u-column bias-gradient sums are a DECLARED
#     fp32 summation-order change (as BWD_DQ_E5M2's q columns). A failure after
#     the emission (consumer cast error, FP8 projection decline) restores the
#     BF16 u columns of that call from the e5m2 payload (lossy) and latches
#     (a) off. (b) BIT-IDENTICAL (allocation only).
#     (c)/(d) DECLARED fp32 summation-order change of the weight gradient:
#     the same 128-token fp8 chunks on the same MFMA instruction as hipBLASLt,
#     only the order of the fp32 chunk sums differs; deterministic
#     (fixed-order split-K reduction, no atomics), checked against hipBLASLt
#     by the first-call guard; after the cast to the parameter dtype a small
#     fraction of bf16 weight-gradient elements differ by one ulp. Every other
#     gradient BIT-IDENTICAL. (e)/(f) BIT-IDENTICAL to (c)/(d) on row-major
#     operands (every gradient and the FP8 scale/amax state; the producers'
#     other outputs unchanged), and every fallback stays bitwise the knob-off
#     hipBLASLt result, except a call whose row-major copy is out of memory:
#     (e) then takes the BWD_UVQK BF16 wgrad for that call and (f) keeps (d)'s
#     all-finite result unverified (both logged, nothing latched). (g)
#     BIT-IDENTICAL (allocation only). (h) DECLARED fp32
#     summation-order change of the out-projection weight gradient against
#     (f) (the same chunks on the same MFMA
#     instruction, a different fixed-order split sum), deterministic; every
#     other gradient BIT-IDENTICAL. No dtype, scale rule, operand or
#     accumulation precision changes.
#   ARMED (every rank): (a) "[hstu-fp8-bwd-uvqk] requested ... kernels:
#     du_e5m2=1", "ARMED du_e5m2 on cuda:"; the BWD_UVQK uvqk line then reads
#     "PRODUCER-cast e5m2 dz (LNMD bwd e5m2 u columns + dq-split e5m2 q
#     columns + v|k-only cast" (with BWD_DKDV_E5M2 on: "PRODUCER-cast e5m2 dz
#     (LNMD bwd e5m2 u + bwd_dkdv e5m2 dV|dK + dq-split e5m2 q"), so the
#     BWD_DQ_E5M2-only form "PRODUCER-cast e5m2 dz (dq-split e5m2 q columns"
#     is not printed. (b) "[hstu-fp8-tm]
#     requested: tm_nonexp=1", "[hstu-fp8-tm] prewarm before run_start on
#     cuda:N: 5 x 2.00 GiB", "[hstu-fp8-tm] ARMED tm_nonexp on cuda:".
#     (g) "[hstu-fp8-tm] tiled operands: ... pool" ("0" prints "tiled
#     operands: ordinary allocator (DLRM_HSTU_FP8_TM_NONEXP_TILED=0)" and, if
#     every pooled operand is tiled, "prewarm skipped: every pooled operand is
#     step-tiled" instead of (b)'s prewarm and ARMED lines).
#     (c) "[hstu-fp8-bwd-uvqk] requested: wgrad_ck=1", "prebuild: wgrad_ck
#     built", "wgrad_ck guard uvqk_projection on cuda:... -> armed"; its W1/W2
#     ARMED lines are those of (e) below (with (e) off: "ARMED wgrad_ck w1 on
#     cuda:", "ARMED wgrad_ck w2 on cuda:"). (d) "[fp8-out-wgrad] requested:
#     wgrad_ck_w3=1", "prebuild: wgrad_ck_w3 built", "wgrad_ck_w3 guard
#     out_projection on cuda:... -> armed", "ARMED wgrad_ck w3 on cuda:", and
#     BWD_OUT_WGRAD's armed line reads "path=nn_ck". (e) "[hstu-fp8-bwd-uvqk]
#     requested: wgrad_ck_xt_tiled=1", "ARMED wgrad_ck xt_tiled producer
#     store_t_v2 on cuda:", guards "wgrad_ck guard uvqk_projection on cuda:N:
#     N=2048 ... xT=tiled ... -> armed" (N=1024 for vk_projection), "ARMED
#     wgrad_ck w1_t on cuda:", "ARMED wgrad_ck w2_t on cuda:", "ARMED wgrad_ck
#     xt_tiled on cuda:", and the uvqk / vk projection ARMED lines name
#     "token-major (custom wgrad_ck_w1_t (" / "(custom wgrad_ck_w2_t (".
#     (f) "[fp8-out-wgrad] requested: wgrad_ck_w3_tiled=1", "wgrad_ck_w3 guard
#     out_projection on cuda:N: N=1536 ... dout_t=step-tiled ... -> armed",
#     "ARMED wgrad_ck w3 on cuda:N (dout_t step-tiled)", and BWD_OUT_WGRAD's armed
#     line shows "dout=(<steps>, 512, 128)". (h) (bound True below; (f)'s
#     guard and ARMED lines then end as these):
#     "[fp8-out-wgrad] requested: wgrad_ck_w3_t256s=1", "prebuild:
#     wgrad_ck_w3_t256s bound", "wgrad_ck_w3 guard out_projection on cuda:N:
#     ... dout_t=step-tiled entry=wgrad_ck_w3_t256s ... -> armed", "ARMED
#     wgrad_ck w3 on cuda:N (dout_t step-tiled) entry=wgrad_ck_w3_t256s".
#     Must be ABSENT: "du_e5m2 INERT", "du_e5m2 NOT used (producer failed",
#     "LOSSY e5m2->bf16 restore", "tm_nonexp=1 -> INERT", "tm_nonexp
#     DISABLED", "pool GREW", "wgrad_ck INERT", "wgrad_ck DISABLED", "wgrad_ck
#     declined", "wgrad_ck_w3 INERT", "wgrad_ck_w3 DISABLED", "wgrad_ck_w3
#     declined", "wgrad_ck_xt_tiled=1 -> INERT", "xt_tiled declined by",
#     "wgrad_ck_w3_tiled=1 (INERT", "wgrad_ck_w3_t256s=1 (INERT",
#     "xt_tiled OFF", "dout_t tiling OFF",
#     "deferred (", "untiled copy of the step-tiled xT", "re-laid-out copy of
#     the step-tiled dout_t", "pool created lazily" (a guard rejection prints
#     "-> rejected" and then DISABLED).
#   Opt out (each independently): DLRM_HSTU_FP8_BWD_DU_E5M2=0,
#     DLRM_HSTU_FP8_TM_NONEXP=0, DLRM_HSTU_FP8_BWD_WGRAD_CK=0,
#     DLRM_HSTU_FP8_BWD_WGRAD_CK_W3=0, DLRM_HSTU_FP8_BWD_WGRAD_CK_XT_TILED=0,
#     DLRM_HSTU_FP8_BWD_WGRAD_CK_W3_TILED=0, DLRM_HSTU_FP8_TM_NONEXP_TILED=0.
#     (e)=0 / (f)=0 = the row-major custom kernels of (c) / (d) with the same
#     values; (c)=0 leaves (e) INERT and (d)=0 leaves (f) INERT (set the pair
#     to 0 for a silent log); (g)=0 = the same values with the tiled operands
#     in the main pool; all seven 0 = the bundle off ((g) is inert once (b)
#     is 0).
#     DLRM_HSTU_FP8_BWD_WGRAD_CK_W3_T256S=0 = (f)'s entry wgrad_ck_w3_t with
#     its own values; (d)=0 or (f)=0 leaves (h) INERT (set it to 0 too for a
#     silent log).
#     Env-only sub-switches: DLRM_HSTU_FP8_TM_NONEXP_XT=0 (xT from the main
#     pool, dout_t still pooled, two prewarm blocks),
#     DLRM_HSTU_FP8_TM_NONEXP_BLOCKS=<n> (prewarm block count),
#     DLRM_HSTU_FP8_BWD_WGRAD_CK_HIPCC / _CACHE (hipcc path, build cache root).
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_DU_E5M2 = True
apply_env_bootstrap.DLRM_HSTU_FP8_TM_NONEXP = True
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_WGRAD_CK = True
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_WGRAD_CK_W3 = True
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_WGRAD_CK_XT_TILED = True
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_WGRAD_CK_W3_TILED = True
apply_env_bootstrap.DLRM_HSTU_FP8_TM_NONEXP_TILED = True
# (h) is on: (d) reads the step-tiled dout_t of (f) with wgrad_ck_w3_t256s.
# Kill switch: DLRM_HSTU_FP8_BWD_WGRAD_CK_W3_T256S=0 (a pre-set env value
# wins over this binding); (f)'s entry wgrad_ck_w3_t then runs.
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_WGRAD_CK_W3_T256S = True
#
# -----------------------------------------------------------------------------
# L11 OUTPROJ_LNMD_FUSED: the output-projection FP8 dgrad fused with
#     the LN*U*dropout backward (on top of MASK16, PREBUILD, LNMD_BWD_V2 and
#     BWD_OUT_WGRAD;
#     ops/hip/l11_outproj_lnmd.cu + l11_outproj_lnmd.py, the seam in
#     HSTUComputeOutputFunction.backward of ops/triton/triton_hstu_linear.py,
#     bwd_fp8.py output_projection_dgrad_operands / _gemm, triton_fp8.py
#     prebuild). Code default OFF; the binding below turns it on.
#     WHAT: in the backward of the two ordinary STU layers, where BWD_OUT_WGRAD's
#     FP8 out-proj wgrad branch runs with the published scale controller, ONE
#     persistent HIP kernel l11_outproj_lnmd_bwd (hipcc -> .so -> ctypes)
#     replaces the hipBLASLt out-proj dgrad (torch._scaled_mm, the F8B8BS
#     ..._NTB0_..._SK3_ stream-K kernel, plus its workspace fill) AND the
#     LNMD_BWD_V2 kernel _ln_mul_dropout_bwd_dx_du_rng_v2: it computes the
#     dgrad 64 rows x 1536 columns at a time, keeps the bf16 dy rows in
#     registers (dy [M, 1536] is never written to HBM) and runs v2's per-row
#     math on them (dx, du into the [M, 2048] d(uvqk) buffer the preprocess
#     backward adopts, per-wave fp32 dW/dB partials [P <= 16384, 512] reduced
#     by the unchanged _ln_mul_dropout_bwd_dwdb finalize). That is its
#     bf16-du mode; with BWD_DU_E5M2 it also runs in an e5m2-du mode (below), so
#     it runs in BOTH modes, chosen per call. Unchanged: the dout cast
#     (BWD_HELPERS_FUSED included; one owner of the e5m2
#     bytes and of the token-major e4m3 copy), the per-call e4m3 weight cast,
#     every scale-state update, the FP8 NN wgrad (BWD_WGRAD_CK_W3 included), the
#     du-buffer hand-off, the targets-only layer, eval, and the scale-
#     controller warm-up calls (bf16 torch.mm + the unfused backward). With
#     BWD_WGRAD_CK_W3_TILED on, the L11 seam hands the dual cast
#     the same step-tiled decision as the unfused path, so the BWD_WGRAD_CK_W3
#     wgrad keeps reading the step-tiled dout_t (L11 itself reads only the
#     row-major e5m2 gradient). Dispatch (host metadata only, all checked
#     BEFORE the cast):
#     gfx950; eager (no compile/AOTI); BWD_OUT_WGRAD FP8 y saved; SNR probe off;
#     training, dropout > 0, saved int8 mask, silu_u, concat_u, concat_x,
#     'silu'; v2 at one wave per row (BLOCK_D = 512); bf16 [M, 512]
#     stride-512 16-B-aligned x/u/mask, fp32 [M] mean/rstd, bf16 [512] norm
#     weight/bias, out-proj weight [1536, 512]; 1 <= M <= 4,194,304; du row
#     width 2048; built and self-checked before RUN_START in this process.
#     Anything else runs the unfused path unchanged (one NOT armed line per
#     reason).
#     WITH BWD_DU_E5M2: on an eligible call the backward asks BWD_DU_E5M2's own plan
#     once, after the cast and before the GEMM (host state and dy metadata
#     only). No plan (BWD_DU_E5M2 declined this call, e.g. its warm-up before the
#     per-layer uvqk scale is published) -> the bf16-du mode above. A plan
#     (BWD_DU_E5M2 would emit this call's e5m2 u block) -> the e5m2-du mode: the same
#     .so's E5 instantiation of l11_outproj_lnmd_bwd computes the same dgrad
#     and per-row math and, instead of the bf16 du, writes BWD_DU_E5M2's e5m2 u
#     block of the uvqk dz8 (cols 0..511, with BWD_DU_E5M2's inv_scale and its
#     v3 kernel's exact convert/clamp/store ops; the pad rows zeroed; cols
#     512.. left to the consumer cast) plus per-wave amax and u column-sum
#     partials, reduced as BWD_DU_E5M2 reduces its own, and returns BWD_DU_E5M2's
#     emission record (placeholder du, record on it): the hipBLASLt dgrad and
#     _ln_mul_dropout_bwd_dx_du_rng_v3 do not run on those calls, and the
#     uvqk projection backward (the u-only consumer cast) consumes
#     the record exactly as BWD_DU_E5M2's. If the e5m2-du mode declines a call
#     (its own e5m2 / launch-shape / pad / scale checks, one NOT armed line
#     per reason) or is latched off, the GEMM runs on the same FP8 operands
#     (no second cast, no second scale-state update) and BWD_DU_E5M2's path runs
#     unchanged, bit for bit.
#     IMPACT: the dy write and its re-read by v2 (bf16-du mode) or by
#     BWD_DU_E5M2's v3 (e5m2-du mode) go away and two launches become one on the
#     calls L11 runs; the backward's transient peak loses the dy buffer.
#     Cost: all CUs held by one kernel for the duration of the fused call.
#     COLD START: built and self-checked in the pre-RUN_START prebuild
#     (DLRM_HSTU_FP8_PREBUILD; after the other prebuilds, before the
#     BLAS warm-up): hipcc once per container, cached under
#     /tmp/dlrm_hstu_fp8_l11/<hash of source, flags, arch, hipcc version>
#     (temporary file per host/pid/thread, atomic rename; a cache hit skips
#     the build; ONE .so holds both instantiations), then a seeded
#     SYNTHETIC-data self-check against the unfused chain at M = 32,805
#     (private generator: no training data, no global RNG draw, no FP8 scale
#     state): the bf16-du mode against v2, and, when BWD_DU_E5M2 is enabled, the
#     e5m2-du mode against BWD_DU_E5M2's own producer with a synthetic scale.
#     Nothing is built or compiled for L11 after it. Without that prebuild
#     (DLRM_HSTU_FP8_PREBUILD off) every call declines (NOT armed "D11 not
#     prebuilt"): no build and no unchecked kernel inside the timed run.
#     NUMERICS (declared): same FP8 operands, products,
#     fp32 accumulation and hipBLASLt epilogue (RNE_bf16(acc*(sa*sb) + 0)),
#     bf16 outputs; no compute removed, no precision change. dy is never
#     materialized; it equals hipBLASLt's dy bit for bit on hipBLASLt's
#     data-parallel tiles, for any data. On hipBLASLt's stream-K (SK3) tail
#     tiles (the last (T mod 256) + 256 of the T = 6*ceil(M/256) 256x256
#     tiles) hipBLASLt sums split-K partials plus a fixup while L11 sums the
#     4 K blocks in order (as hipBLASLt's own data-parallel tiles do): an
#     fp32 summation-order difference of those rows. du and dx are v2's
#     operations op for op (FMA contraction and tl.sum tree replicated):
#     bitwise vs v2 on the same dy, hence bitwise vs the unfused path on the
#     data-parallel rows; in the SK-tail rows du and dx (all 512 columns)
#     inherit dy's fp32 order. Bitwise means finite values: NaN outputs (only
#     from non-finite inputs) sit at the same positions, but their sign bit
#     can differ. dW/dB: a DECLARED fp32 reduction-order change (per-wave
#     partial chains of <= 8*fl rows, fl = ceil(ceil(nblk/G)/8), P = G*8*nf
#     <= 16384 rows, v2-like chain lengths; same finalize kernel).
#     e5m2-du mode, in addition: the e5m2 u block of dz8 (payload incl. the
#     pad rows) and its amax are BWD_DU_E5M2's v3 operations (convert the fp32 du
#     to bf16, scale, clamp, convert to e5m2): bitwise vs BWD_DU_E5M2's producer
#     on the same dy for any data (saturation, NaN/Inf and subnormals
#     included), hence bitwise vs BWD_DU_E5M2's path on hipBLASLt's data-parallel
#     rows; on the SK3-tail rows the payload bytes inherit dy's fp32 order
#     (and the amax, only where its maximum sits in those rows); dx as in
#     the bf16-du mode; the u column sums (the u part of the uvqk bias
#     gradient) are a DECLARED fp32 reduction-order change (per-wave chains,
#     as dW/dB), like BWD_DU_E5M2's own sums vs the plain cast; LN dW/dB as
#     above. Both modes: deterministic run to run; no atomics. Calls that
#     keep BWD_DU_E5M2's path and every declined call are BIT-IDENTICAL to
#     this knob off.
#     ALSO (logging only, no switch): the LayerNorm-family v3 arming lines
#     (D256 v3, wln dxsum v3, LN*U*dropout fwd v3 and maskgen, ec_reduce_lpt)
#     print on every rank, tagged "[rank N]", once each per process.
#     ARMED (every rank, "[rank N]", once each per process): "armed OK: L11
#     prebuild before run_start: built+loaded+self-check OK ..." and, at the
#     first fused call of each mode, "armed OK: L11 out-proj dgrad +
#     LN*U*dropout bwd fused ACTIVE mode=e5 ..." (the
#     e5m2-du mode: with BWD_DU_E5M2 on, every call after the FP8 warm-up calls
#     of the site) and/or "armed OK: L11 out-proj dgrad + LN*U*dropout bwd
#     fused ACTIVE (DLRM_HSTU_FP8_BWD_OUTPROJ_LNMD_FUSED, ...): ..."
#     (the bf16-du mode: BWD_DU_E5M2 off, or a call BWD_DU_E5M2 declines). Trace:
#     l11_outproj_lnmd_bwd (template argument E5 = 0 or 1) under
#     "## hstu_l11_outproj_lnmd_bwd ##" in place of the NTB0 out-proj dgrad
#     and v2 (bf16-du mode) or _ln_mul_dropout_bwd_dx_du_rng_v3 (e5m2-du
#     mode) on the calls it runs. Must be
#     ABSENT: "L11 out-proj dgrad + LN*U*dropout bwd fused NOT armed",
#     "... fused DISABLED", "... fused INERT", "... prebuild DEVICE FAULT",
#     "inside the timed region".
#     Opt out: DLRM_HSTU_FP8_BWD_OUTPROJ_LNMD_FUSED=0 (the unfused path,
#     bit for bit; nothing is built and nothing printed). Only
#     the value 1 arms the switch (0 or any other value disarms it).
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_OUTPROJ_LNMD_FUSED = True
#
# L11-VD: the L11 fused kernel built from a VALU-diet
#     source of the same kernel (ops/hip/l11_outproj_lnmd_vd.cu; the plain
#     source ops/hip/l11_outproj_lnmd.cu is what L11 builds with this knob
#     off). Code default OFF; the binding below turns it ON.
#     WHAT: the LN*U*dropout backward consumer of l11_outproj_lnmd_bwd builds
#     the three plane keep masks in the bf16 domain and applies them to the
#     packed planes before the unpack (instead of per-element compare and
#     select), runs one Newton step for the fast sigmoid reciprocal (equal to
#     the former chain and to the IEEE quotient on the whole fast-path
#     domain), tests the IEEE-fallback condition with one unsigned max, keeps
#     the per-wave dW/dB partial chains as packed fp32 column pairs, and
#     recomputes the lane id after the row loop. The in-lane row-sum adds keep
#     the former operand order (inline assembly) so NaN payloads match. Same
#     kernel name, ABI, grid, LDS, launch and outputs; both E5 and bf16-du
#     modes.
#     WHY: the consumer phase of L11 is bound by vector-ALU issue at the
#     power cap; the diet deletes compare/select, Newton and fallback-check
#     instructions from every row.
#     NUMERICS: BIT-IDENTICAL to the pre-diet kernel: dx, du (e5m2 bytes incl.
#     pad rows, or bf16), amax, column-sum and dW/dB partials, NaN payloads
#     included. The launches reject a dscale outside (0, FLT_MAX] (the mask
#     form needs a finite positive scale; production passes 1/(1-p)); a
#     rejected launch latches L11 off and the hipBLASLt dgrad + unfused
#     LN*U*dropout backward chain runs.
#     ARMED (every rank, the L11 lines): "armed OK: L11 prebuild before
#     run_start: ..." and "armed OK: L11 out-proj dgrad + LN*U*dropout bwd
#     fused ACTIVE mode=e5 ... impl=l11_outproj_lnmd_bwd ... +vd(C1,C2,C3,C4,
#     LANEFIX,PIN) ..." (the bf16-du warm-up line carries the same impl).
#     Must be ABSENT: an L11 DISABLED line.
#     Opt out: DLRM_HSTU_FP8_L11_VD=0 in the environment (a pre-set value
#     wins over the binding; only the value 1 selects the diet source).
#     Absent from the environment the binding below applies; 0 or any other
#     value: L11 builds the plain ops/hip/l11_outproj_lnmd.cu. Inert while
#     L11 is off.
apply_env_bootstrap.DLRM_HSTU_FP8_L11_VD = True
#
# DO8: L11 dO8 emission (producer side): the C8 attention
#     backward's dO quantization folded into L11's e5m2-du mode
#     (ops/hip/l11_do8.cu + l11_do8.py, the seam in
#     HSTUComputeOutputFunction of ops/triton/triton_hstu_linear.py, the
#     triton_fp8.py prebuild). Consumer: the dO8 registry hook
#     (ops/flydsl/hstu_do8_registry.py, contract v1.2, its own knob
#     DLRM_HSTU_FP8_BWD_DO8, bound together with this knob). Code default
#     OFF; the binding below turns it on. Inert unless L11 and
#     BWD_DU_E5M2 run, the C8 attention backward plans its block-scaled dO and
#     DLRM_HSTU_FP8_BWD_DO8 is 1.
#     WHAT: on an ordinary-layer backward call that L11 runs in its
#     e5m2-du mode and whose attention backward will quantize dO with
#     quantize_do_e4m3_blk (the attention forward tagged a dO8 site on the
#     attention output), ONE launch of a separate kernel,
#     l11_outproj_lnmd_bwd_do8, replaces L11's E5 launch. It writes all
#     that launch writes (the bf16 d(attn), BWD_DU_E5M2's e5m2 u block and pad
#     rows, the amax, u column-sum and dW/dB partials) on sequence-aligned
#     64-token tiles, and also the attention backward's e4m3 dO and its
#     E8M0 scales (one per sequence, head and 32-token group). The tiles
#     come from a device work list (l11_do8_wl_build, no host sync) built
#     from the attention call's own seq_offsets tensor, once per step and
#     shared by both ordinary layers. After the last write to d(attn) the
#     backward publishes dO8/E8 on the site; the C8 attention backward
#     takes them instead of running quantize_do_e4m3_blk on the bf16
#     d(attn), which is still written ('plus'), so every fallback, check
#     and reference that reads it is unchanged.
#     DISPATCH (host metadata only, decided before the launch): knob on;
#     built and self-checked before RUN_START in this process; not latched;
#     L11 e5m2-du mode with all of its own checks; a dO8 site; consumer
#     knob on; site rows = M, 4 heads of 128; seq_offsets int32 or int64,
#     contiguous, on the device, at most 8192 sequences. Anything else,
#     L11's bf16-du mode included, runs L11's own launch (no emission;
#     the attention backward quantizes). Only expected states (no site,
#     bf16-du mode, latched) are silent; any other decline prints one NOT
#     armed line per reason.
#     NUMERICS: d(attn), the e5m2 u block (incl. pad rows) and its amax are
#     bitwise vs L11's E5 launch on the same operands; dO8 and E8 are
#     bitwise vs quantize_do_e4m3_blk on that d(attn) on every row the
#     quantizer writes (same token groups, same maxnum group maximum, same
#     exponent rule, same saturating e4m3 convert under the same MODE bit);
#     the u column sums and LN dW/dB stay in L11's DECLARED fp32
#     reduction-order class (the tile walk changes the per-wave partial
#     chains). Deterministic; no atomics. A call declined before the
#     launch (any DISPATCH check, incl. every call after a latch) and a
#     call whose DO8 launch failed (L11's own E5 launch then reruns it on
#     fresh buffers) are BIT-IDENTICAL to DO8 off. NOT bit-identical: a
#     call whose DO8 launch ran but whose record is then refused or
#     latched at publish, or declined or discarded by the consumer: the
#     attention backward quantizes the bf16 d(attn) (dO8/E8, d(attn), u
#     block and amax still bitwise), but the u column sums and LN dW/dB
#     of that call keep DO8's tile-walk order (the DECLARED class above).
#     BUILD: its own hipcc build without L11's iterative-ilp scheduler
#     flag, cache /tmp/dlrm_hstu_fp8_l11_do8/<hash of source, flags, arch,
#     hipcc version>, resource gate (0 VGPR spill, 0 scratch, full LDS) and
#     synthetic self-check against L11's own E5 launch and the stock
#     quantizer, after L11's prebuild; any failure latches DO8 off only
#     (L11 keeps its own launches, the attention backward its quantizer).
#     SOURCE: DO8 follows the L11-VD switch. With
#     DLRM_HSTU_FP8_L11_VD=1 it builds ops/hip/l11_do8.cu, which carries
#     L11-VD's VALU diet in DO8's kernel body (impl tag "+vd(C1,C2,C3,
#     C4,LANEFIX,PIN)"; same outputs, bit for bit; the launch rejects a
#     dscale outside (0, FLT_MAX]); any other value builds the pre-diet
#     ops/hip/l11_do8_novd.cu. Each source has its own cache key and .so.
#     ARMED (every rank, "[rank N]", once each per process): "armed OK: L11
#     DO8 dO8/E8 emission prebuild before run_start ..." and, at the first
#     published record, "armed OK: L11 DO8 dO8/E8 emission ACTIVE mode=e5
#     plus ..."; the hook's "[hstu-attn] dO8 registry ARMED" at the first take.
#     Trace: l11_outproj_lnmd_bwd_do8 in place of l11_outproj_lnmd_bwd (E5)
#     under "## hstu_l11_outproj_lnmd_bwd ##" on the emitting calls,
#     l11_do8_wl_build once per step, no _blk_wl_kernel /
#     _blk_wl_build_kernel (the DOBLK_WL work-list quantizer) and no
#     _blk_kernel after the warm-up calls. Must be ABSENT: "L11 DO8
#     dO8/E8 emission NOT armed", "... DISABLED", "... INERT", "...
#     prebuild DEVICE FAULT".
#     Opt out: DLRM_HSTU_FP8_L11_DO8=0 (the path without DO8, bit for
#     bit; nothing built and nothing printed by DO8; the dO8 registry,
#     armed by DLRM_HSTU_FP8_BWD_DO8=1, still creates its quiet sites and
#     prints its REQUESTED line). Only the value 1 arms it.
#     DLRM_HSTU_FP8_BWD_DO8=0 alone also stops every emission (no sites:
#     bit for bit as without DO8), but DO8 is still built and
#     self-checked before RUN_START and prints its prebuild line.
#     DLRM_HSTU_FP8_L11_VD=0 keeps DO8 on with the pre-diet source
#     ops/hip/l11_do8_novd.cu (bitwise-equal outputs).
apply_env_bootstrap.DLRM_HSTU_FP8_L11_DO8 = True
# The consumer half of DO8: the dO8 registry hook's knob
# (ops/flydsl/hstu_do8_registry.py; bound here because the hook is inert
# without a producer).
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_DO8 = True
# Force-off alias of the consumer hook: True (= "1")
# behaves as unset; it cannot turn anything on. While
# DLRM_HSTU_FP8_BWD_DO8 is 1, any other value -- a pre-set environment value
# wins, e.g. DLRM_HSTU_FP8_BWD_DO8_TAKE=0, or a False binding here -- turns
# the consumer off with the same effect as DLRM_HSTU_FP8_BWD_DO8=0 (no sites,
# no takes, same numerics; DO8 is still prebuilt), but unlike that silent
# switch it prints one "[hstu-attn] dO8 registry: ... (retired v1 kill
# switch)" line per process. Prefer DLRM_HSTU_FP8_BWD_DO8=0, the primary kill
# switch above.
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_DO8_TAKE = True
# Diagnostic env knobs for DO8 (not set in production; env-only by design),
# ops/hip/l11_do8.py:
#   DLRM_HSTU_FP8_L11_DO8_FAIL_CLOSED=1 (smoke/debug only; exactly "1" arms
#     it, any other value = the default behaviour): a failure that would latch
#     DO8 off for the process (build/load, resource gate, self-check, launch,
#     publish) raises a RuntimeError instead. INERT / NOT armed declines and
#     registry refusals are not latches and never raise. Never set it in a
#     timed or production run.
#   DLRM_HSTU_FP8_L11_DO8_SRC=<path> (testing a candidate .cu only; unset = the
#     L11-VD switch selects l11_do8.cu / l11_do8_novd.cu): builds that file
#     instead; it must still pass the resource gate and the synthetic
#     self-check before RUN_START (a failure latches DO8 off: DISABLED line).
#   DLRM_HSTU_FP8_L11_DO8_SCHED=iterative-ilp (diagnostic; unset or "default"
#     = the default build flags): adds L11's iterative-ilp scheduler
#     flag to the DO8 build; any other value = "default" with one line. With
#     this flag clang's greedy register allocator can fail on DO8's
#     instantiation: a failed build -> DO8 DISABLED for the
#     process (a RuntimeError with _FAIL_CLOSED=1).
#   DLRM_HSTU_FP8_L11_DO8_CACHE=<dir> (unset or empty =
#     /tmp/dlrm_hstu_fp8_l11_do8): the DO8 build-cache root; an empty or new
#     directory builds again before RUN_START.
#   DO8's build and cache key also follow L11's compiler override
#     DLRM_HSTU_FP8_BWD_OUTPROJ_LNMD_FUSED_HIPCC.
#
# DO8 'only' mode (DLRM_HSTU_FP8_L11_DO8_ONLY; default OFF without this
#     binding): DO8 under the dO8 registry's 'only' contract
#     (ops/hip/l11_do8.py; ops/hip/l11_do8.cu built a second time with
#     -DL11DO8_ONLY=1; consumer: the dO8 registry in
#     ops/flydsl/hstu_do8_registry.py, hstu_flydsl_mha.py and the attention
#     Function's backward of triton_hstu_preprocess_and_attention.py). Inert
#     unless DO8 emits for the call (its DISPATCH above) and
#     DLRM_HSTU_FP8_BWD_DO8 is 1.
#     WHAT: on a call DO8 emits for, after every decline check and the
#     dz8/dO8/E8 allocations (host only; the placeholder/partials allocations
#     and the launch's checks follow it and are covered by cancel), the
#     consumer's plan(site, attn) answers "only" when the attention backward
#     of THIS call will take the C8 do_blk branch (the forward gate's own
#     predicate, re-evaluated with the environment of that moment: FP8
#     calibration steps have BF16 q/k and answer "plus"), no debug reader of
#     the bf16 dO is armed (DLRM_HSTU_FP8_BWD_FULL_STATS,
#     DLRM_HSTU_FP8_BWD_DUMP, DLRM_HSTU_FP8_BWD_DUMP_CALLS,
#     HSTU_ATTN_BWD_CHECK) and nothing in autograd can read d(attn) (grad or
#     anomaly mode, hooks or retain_grad on attn or on the attention output).
#     Then ONE launch of the EM = 2 instantiation of l11_outproj_lnmd_bwd_do8
#     writes everything DO8 writes EXCEPT the bf16 d(attn); autograd
#     receives that launch's untouched d(attn) buffer (the allocation 'plus'
#     makes, same shape and dtype) and the record is published with
#     bf16_written=False. The attention backward and the exact re-runs of
#     that layer call take the same dO8/E8 (retained until the attention
#     Function's backward returns); any path that would read the bf16 dO
#     raises Do8OnlyError (fail closed). "plus" (or the knob off): DO8
#     exactly.
#     WHY: deletes the bf16 d(attn) write of every ordinary-layer call.
#     NUMERICS: bit-identical to DO8 'plus' on every training value. The
#     attention backward takes the same dO8/E8 bytes (EM = 2 vs EM = 1:
#     dO8, E8, dz8 and every partial byte-identical, checked at prebuild)
#     and the C8 branch reads no bf16 dO. Memory: dO8 + E8 (T x 516 B) stay
#     alive until the attention Function's backward returns (through the
#     uvqk projection backward).
#     FALLBACK: a planned call that fails after the plan (the launch's
#     checks, the placeholder/partials allocations, the EM = 2 launch or
#     the host work after it) is cancelled (hstu_do8_registry.cancel) and
#     rerun by L11's own E5 launch (bf16 d(attn) written; the attention
#     backward quantizes it). Only a failed EM = 2 kernel launch (rc > 0)
#     latches 'only' alone (DO8 keeps its 'plus' launches); any other
#     failure there latches DO8, as in 'plus'. A failed 'only' publish
#     raises.
#     BUILD: the 'only' .so (the EM = 2 instantiation), its own cache key,
#     resource gate (0 VGPR spill, 0 scratch, LDS 163840) and self-check
#     (EM = 2 vs EM = 1 on DO8's synthetic inputs: dO8, E8, dz8, AMAXP,
#     DWP, DBP, DUCS byte-identical; a NaN sentinel prefilled in the EM = 2
#     d(attn) buffer untouched), right after DO8's prebuild; any failure
#     latches 'only' only. Needs DO8-VD (DLRM_HSTU_FP8_L11_VD=1): with the
#     pre-diet ops/hip/l11_do8_novd.cu 'only' is INERT ('plus', one line).
#     ARMED (every rank, "[rank N]", once each per process): "armed OK: L11
#     DO8 dO8/E8 emission only prebuild before run_start ..." and, at the
#     first 'only' record, "armed OK: L11 DO8 dO8/E8 emission only ACTIVE
#     mode=e5 only ..."; the registry's "[hstu-attn] dO8 registry only
#     REQUESTED", "... only ARMED" and its counter line (planned ==
#     published == taken == released, released_untaken=0, cancelled=0). The
#     producer's counters: "[l11-do8] only counters: planned= only_launched=
#     published= cancelled= fallback= plan_plus= latched=". Trace: the
#     l11_outproj_lnmd_bwd_do8<..., 2, 0, 2, 0> (EM = 2) kernel in place of
#     the EM = 1 one; no _blk_wl_kernel / _blk_kernel.
#     Must be ABSENT: "L11 DO8 dO8/E8 emission only DISABLED", "... only
#     INERT", "... only prebuild DEVICE FAULT", "Do8OnlyError".
#     Debug: DLRM_HSTU_FP8_L11_DO8_ONLY_POISON=1 fills every placeholder
#     with bf16 NaN (0x7FC0), so a hidden reader of d(attn) shows NaN.
#     With DLRM_HSTU_FP8_BWD_DQ_E5M2=0 also set DLRM_HSTU_FP8_L11_DO8_ONLY=0.
#     Opt out: DLRM_HSTU_FP8_L11_DO8_ONLY=0 in the environment (a pre-set
#     value wins over the binding; only the value 1 arms it): DO8 'plus'
#     bit for bit (the registry is not asked; nothing 'only' is built or
#     printed). DLRM_HSTU_FP8_L11_DO8=0 or DLRM_HSTU_FP8_BWD_DO8=0
#     also end it (no emission at all).
apply_env_bootstrap.DLRM_HSTU_FP8_L11_DO8_ONLY = True
#
# DO8 diet (DLRM_HSTU_FP8_L11_DO8_DIET; bit-identical outputs, no precision
#     change): the VALU/SGPR diet of DO8's emission
#     tail in ops/hip/l11_do8.cu (preprocessor switch L11DO8_DIET, default 1;
#     ops/hip/l11_do8.py adds -DL11DO8_DIET=0 to every DO8 build when this
#     knob is not 1). Inert unless DO8 builds (and the DO8-VD source
#     l11_do8.cu is selected, DLRM_HSTU_FP8_L11_VD=1; the pre-diet
#     l11_do8_novd.cu has no switch).
#     WHAT: O1 the two group maxima as ONE packed pair of bf16 bit patterns
#     through the 16-lane DPP max, the LDS exchange and the 8-wave max
#     (v_pk_max_u16); combine v6x: the 8 packed exchange words as a 3-level
#     tree after both ds_read_b128; O7(i) one wave-uniform SGPR row count
#     per tile (nit) for every row-valid test (no hoisted, spilled per-row
#     constants); O11 + v3b: grp_exp without the E == 0 select (implied by
#     the clamp) and with the carry form of its +1; O2 + E8 window
#     (RET 0 / EMV 2 / TM 0, the production family): a straight-line 8-row
#     convert loop with rolling 4+4 staging reads and E8 built and stored
#     in the reads' latency. Applies to the 'plus' and the 'only' .so.
#     NUMERICS: bit-identical to the diet off on every output (dO8, E8, the
#     dz8 u block and pad rows, d(attn), AMAXP/DWP/DBP/DUCS partials); each
#     transform is an exact identity (u16 order = value order on the
#     non-negative bf16 maxima).
#     Each .so still passes DO8's and DO8 'only''s prebuild self-checks.
#     BUILD: the knob only changes the hipcc flags (a separate cache key and
#     .so per setting); on = exactly the flags without this switch.
#     ARMED: DO8's and DO8 'only''s prebuild lines unchanged; with the knob
#     off they end in "; diet OFF (DLRM_HSTU_FP8_L11_DO8_DIET != 1: ...)".
#     Code default OFF; the binding below turns it ON; a pre-set env var
#     wins over gin (_bind_bool). Only the value 1 arms it; the value is
#     read once (the first DO8 build). Kill switch: env
#     DLRM_HSTU_FP8_L11_DO8_DIET=0 (every guarded region of l11_do8.cu
#     compiles its "#else" / "#if !" branch; same output bytes).
apply_env_bootstrap.DLRM_HSTU_FP8_L11_DO8_DIET = True
#
# -----------------------------------------------------------------------------
# Same contract: the bindings
# below turn it on, the code default when a binding is absent is OFF, and a
# pre-set env var of the same name wins. Precedence against the earlier knobs
# is stated per part.
#
# Posenc concat + input dropout in one kernel, posenc
#     sort keys and backward, EC joint sort, preprocessor glue fusions, lazy
#     FLOPs stash, next-batch input-dist placement gate. Nine switches (one a
#     refinement of another) and one three-way gate.
#     WHAT: (a) POSENC_DROPOUT_FUSE: where POSENC_CONCAT_FOLD runs the concat-folded
#     position kernel in training, the HSTU input dropout after it is computed
#     inside that kernel by an exact replica of aten's dropout Philox stream,
#     so the position output is not written to HBM and read back by a
#     separate dropout kernel (ops/triton/triton_position.py,
#     modules/hstu_transducer.py). The mask/scale reach the DROPOUT_MSCALE_FOLD
#     layer-0 LayerNorm-backward fold through the same handoff;
#     WLN_BWD_FLYDSL does not take that masked call; the FlyDSL mscale knob
#     (DLRM_HSTU_FP8_WLN_BWD_FLYDSL_MSCALE) runs it when on, otherwise it
#     stays on Triton. A one-time check
#     per (device, scale) compares the kernel's fp32 -> bf16 rounding with
#     this build's cast on every bf16 pattern; a mismatch keeps the separate
#     dropout. POSENC_DROPOUT_V2 refines (a) and is inert without it: the
#     same kernel in a bandwidth layout (streamed rows read with .cg, outputs
#     stored non-temporal, random words drawn in registers, row tiles counted
#     from the sequence end). Its first use per shape key runs a bitwise
#     self-test against design A and aten::native_dropout that leaves the RNG
#     state untouched; a mismatch or a compile/launch error falls back to
#     design A with one warning.
#     (b) POSENC_SORT16: the POSENC_CONCAT_FOLD position kernel (fused or not)
#     writes its pos/ts indices as int16 when the table sizes prove the range
#     fits, so the two backward key sorts run 16-bit radix passes instead of
#     32-bit ones; the dead torch.arange of the absent hammer sort is skipped.
#     (c) POSENC_BWD_V2: the POSENC_CONCAT_FOLD position backward's two sorted
#     segment reductions (d_pos with the d_left/d_right split; d_ts) run as
#     row-loop kernels that carry a running fp32 sum per key across sub-tiles
#     and flush one atomic per (program, key). A launch error falls back to
#     the tiled kernels.
#     (d) EC_JOINT_SORT: the EC_GROUP_BWD grouped EC backward argsorts both
#     hoisted members' row ids with ONE stable int32 sort (member 1's keys
#     offset by the row count) instead of one per member, and hands each
#     member the (order, offsets) its own EC_SORT32 sort would give
#     (train/ec_offsets.py, train/ec_bf16_output.py). Needs EC_SORT32. Only the
#     sort changes: EC_REDUCE_LPT, or the two-launch reducer when it is off,
#     reduces the supplied segments.
#     (e) ACTION_ENC_FUSE, EC_MERGED_INDEX_FUSE, CONTEXTUAL_FUSE
#     (ops/glue_fusion.py). The action encoder's mask/multiply/concat and the
#     action MLP's fp32 -> bf16 input cast become one forward kernel that
#     writes bf16 rows, and one backward kernel; the table-gradient reduction
#     stays aten's sum_to. It arms only for a bf16 consumer under bf16
#     autocast: ContextualPreprocessor's action MLP, including
#     PREPROC_GROUPED_TAIL's grouped-tail head pair (modules/action_encoder.py,
#     modules/preprocessors.py). The merged uih+candidate EC reverse index of
#     each merged pair is written by one integer-copy kernel, straight into
#     the stacked layout of the EC_CAT_FUSE cat-fused pair, instead of ~20 aten
#     launches (train/ec_bf16_output.py). The contextual features' casts,
#     jagged-to-padded-dense and cat run as one Function (one kernel per
#     feature, forward and backward) and their offsets as one row-wise scan
#     (modules/preprocessors.py, modules/dlrm_hstu.py). A Triton error in a
#     fused forward turns that part off for the process with one warning.
#     (f) LAZY_FLOPS_STASH: the forward keeps only the merged per-sample
#     lengths; the jagged FLOPs/sample kernels run when MetricsLogger reads
#     the estimate, i.e. never with the submission logging profile
#     (modules/dlrm_hstu.py, dlrm_v4/utils.py).
#     (g) IDIST_AFTER_PREV_FWD: with the deferred next-batch input dist
#     (TP_DEFER_INPUT_DIST=1, the default), the host polls, without a
#     GPU-queue barrier, until the previous step's forward has finished on
#     the GPU before it issues the next batch's input dist, so those sorts no
#     longer land under the targets-only layer's forward kernels
#     (train/utils.py build_train_pipeline). 0 = off, 1 = single-node runs
#     only, 2 = every node count.
#     IMPACT: removes main-stream elementwise, copy, sort and small launches
#     around the preprocessor, the position encoding and its backward and the
#     EC backward, and keeps the next-batch input-dist sorts off the forward.
#     Costs: the new Triton kernels compile at first use, and the two
#     one-time checks of (a) run in the first training step; (g) moves where
#     the host waits inside a step (at 1n it releases before the existing
#     next-batch split wait would).
#     NUMERICS: BIT-IDENTICAL except (c). (a) same output bits, bool mask,
#     generator offset and gradients as the position kernel followed by
#     aten::native_dropout. (b) same permutation (int16 is order-preserving
#     on the proven range). (d) same per-member segments, so the same
#     reduction. (e) integer copies, the c10 round-to-nearest-even cast and an
#     exact bf16 -> fp32 widening, aten's sum_to; the parameter gradients
#     become ready in the same order. (f) the same ops on the same tensor,
#     later. (g) scheduling only: same kernels, same collective order. (c) is
#     a DECLARED fp32 summation-order change in the position and timestamp
#     table gradients (d_pos/d_ts); d_left/d_right stay bit-identical.
#     ARMED (rank log, once per process at first use): "armed OK:
#     posenc+input-dropout fusion ACTIVE", "armed OK: posenc+input-dropout
#     fusion V2 layout ACTIVE", "armed OK: posenc int16 sort keys ACTIVE",
#     "armed OK: posenc row-loop backward ACTIVE", "DLRMV4 armed OK: ec joint
#     sort", "DLRMV4 armed OK: glue action_enc ACTIVE", "DLRMV4 armed OK: glue
#     ec_merged_index ACTIVE", "DLRMV4 armed OK: glue contextual ACTIVE",
#     "DLRMV4 armed OK: lazy flops stash". The two idist lines are per
#     pipeline build, not per process: every build (train and eval) logs
#     "DLRMV4 idist gate: DLRM_HSTU_FP8_IDIST_AFTER_PREV_FWD='1' -> ON (mode
#     1, single node" (on more than one node "-> OFF (mode 1, multi-node
#     ..."), and the first gated step of each training
#     pipeline logs "DLRMV4 armed OK: idist gate ON (mode 1, single node"
#     (never on more than one node). A run builds several pipelines, so the
#     armed line appears once per training pipeline build per rank. Must be
#     ABSENT: "posenc+input-dropout fusion DISABLED", "V2 layout DISABLED",
#     "DLRM_HSTU_FP8_POSENC_BWD_V2 launch failed", "ec joint sort FAILED
#     CLOSED", "DISABLED for this process", "idist gate disabled", "-> OFF
#     (unrecognized value", "no consumer folded".
#     Opt out (each independently): DLRM_HSTU_FP8_POSENC_DROPOUT_FUSE=0
#     (DLRM_HSTU_FP8_POSENC_DROPOUT_V2=0 keeps the fusion as design A),
#     DLRM_HSTU_FP8_POSENC_SORT16=0, DLRM_HSTU_FP8_POSENC_BWD_V2=0,
#     DLRM_HSTU_FP8_EC_JOINT_SORT=0, DLRM_HSTU_FP8_ACTION_ENC_FUSE=0,
#     DLRM_HSTU_FP8_EC_MERGED_INDEX_FUSE=0, DLRM_HSTU_FP8_CONTEXTUAL_FUSE=0,
#     DLRM_HSTU_FP8_LAZY_FLOPS_STASH=0, DLRM_HSTU_FP8_IDIST_AFTER_PREV_FWD=0
#     (=2 gates at every node count). Only the value 0 is a documented
#     opt-out of a switch.
apply_env_bootstrap.DLRM_HSTU_FP8_POSENC_DROPOUT_FUSE = True
apply_env_bootstrap.DLRM_HSTU_FP8_POSENC_DROPOUT_V2 = True
apply_env_bootstrap.DLRM_HSTU_FP8_POSENC_SORT16 = True
apply_env_bootstrap.DLRM_HSTU_FP8_POSENC_BWD_V2 = True
apply_env_bootstrap.DLRM_HSTU_FP8_EC_JOINT_SORT = True
apply_env_bootstrap.DLRM_HSTU_FP8_ACTION_ENC_FUSE = True
apply_env_bootstrap.DLRM_HSTU_FP8_EC_MERGED_INDEX_FUSE = True
apply_env_bootstrap.DLRM_HSTU_FP8_CONTEXTUAL_FUSE = True
apply_env_bootstrap.DLRM_HSTU_FP8_LAZY_FLOPS_STASH = True
apply_env_bootstrap.DLRM_HSTU_FP8_IDIST_AFTER_PREV_FWD = 1
#
# On top of POSENC_DROPOUT_FUSE. Same contract: the bindings below turn it
# on, the code default when a binding is absent is OFF, and a pre-set env var
# of the same name wins.
#
# Input-dropout mask bit-pack, timestamp concat folds,
#     STU parameter cast fold and lazy attention sort. Three switches; (b)
#     and (c) each have two per-site refinements.
#     WHAT: (a) DROPOUT_MASK_BITS: where POSENC_DROPOUT_FUSE computes the HSTU input
#     dropout inside the concat-folded position kernel and DROPOUT_MSCALE_FOLD hands
#     the mask to the layer-0 LayerNorm-backward fold, the kernel stores the
#     keep mask as packed bits (uint8 [N, D / 8], bit k of byte j = column
#     8 j + k) instead of one byte per element, and the layer-0 fold reads
#     the bits: the Triton v2 epilogue, or the FlyDSL packed-mask kernel when
#     WLN_BWD_FLYDSL_MSCALE is on (ops/triton/triton_position.py,
#     ops/triton/triton_layer_norm.py, ops/input_dropout_fold.py). The forward
#     packs only where that fold will consume the bits: a mask/scale handoff
#     (DROPOUT_MSCALE_FOLD), the FP8 forward arm's fused residual and fused input LN
#     (the only wiring whose layer-0 STU claims the handoff), the WLN_BWD_V2
#     LN backward at its validated launch config with D % 8 == 0 and
#     BLOCK_D <= 512, and a first-use self-test, per device, D and
#     WLN_BWD_POW2 setting, of the packed fold against the bool fold (raw bits and
#     compiled reduce layouts on synthetic rows; no RNG use). Otherwise it
#     keeps the bool mask with one warning naming the reason. WLN_BWD_FLYDSL does
#     not take the masked layer-0 call; with WLN_BWD_FLYDSL_MSCALE on, FlyDSL runs it and
#     reads the packed bits. Inert without POSENC_DROPOUT_FUSE.
#     (b) CONCAT_FOLD: the two one-column int64 timestamp jagged concats run
#     as one Triton kernel each: user_forward's uih + candidate timestamps
#     (modules/dlrm_hstu.py; per site DLRM_HSTU_FP8_CONCAT_FOLD_UIH_TS) and
#     the contextual preprocessor's zero-padded timestamps, which also writes
#     lengths + L and their offsets (modules/preprocessors.py; per site
#     DLRM_HSTU_FP8_CONCAT_FOLD_CTX_TS), instead of concat_2D_jagged plus the
#     zeros, add and cumsum kernels (ops/glue_fusion.py section 4).
#     Independent of POSENC_CONCAT_FOLD (that one folds the embedding concat)
#     and of the glue fusions above.
#     (c) GLUE_FOLD3: at the start of the STU stack forward one Triton launch
#     casts every layer's fp32 LayerNorm weights and biases (and the
#     targets-only layer's output weight) to bf16 into one buffer; each call
#     site takes its copy through one autograd node per (weight, bias) pair
#     whose backward upcasts both gradients in one launch (per site
#     DLRM_HSTU_FP8_GLUE_FOLD3_PCAST). The attention's sort_by_length
#     permutation is computed only where a Triton attention kernel will read
#     it, not when the FlyDSL forward and backward serve the call (per site
#     DLRM_HSTU_FP8_GLUE_FOLD3_SORT) (ops/glue_fold3.py, modules/stu.py,
#     ops/triton/triton_hstu_preprocess_and_attention.py). The pair nodes
#     upcast the bf16 LayerNorm parameter gradients whichever LayerNorm
#     backward produced them (WLN_BWD_FLYDSL or Triton).
#     WHY: (a) the mask is the largest byte stream of the position forward
#     and of the layer-0 LayerNorm backward; one bit per element carries the
#     same keep decisions. (b) each concat launches a grid of mostly
#     one-element programs and its site adds four small kernels; one launch
#     per site does the same integer work. (c) the 13 parameter casts and 13
#     gradient upcasts are separate tiny launches, and the sort's result is
#     never read when FlyDSL serves the attention.
#     IMPACT: (a) shorter layer-0 LayerNorm backward (fewer mask bytes read)
#     and less activation memory between the position forward and that
#     backward; the packed store itself is not faster than the bool store;
#     (b), (c) fewer main-stream kernels per step. Costs: the new Triton
#     kernels compile at first use (fixed configs, no autotune), and (a)'s
#     self-test runs once per process at the first packing forward.
#     NUMERICS: BIT-IDENTICAL. (a) same keep decisions, output bits, generator
#     offset and gradients (each bit is the kernel's own keep test; the fold
#     applies the same 0/1 factor and scale). (b) integer copies and integer
#     adds only. (c) the same per-element round-to-nearest-even fp32 -> bf16
#     casts and exact bf16 -> fp32 widenings; the parameter gradients become
#     ready in the same order, so DDP buckets are unchanged; the skipped sort's
#     result was never read. Each fused path fails closed to the unfused ops
#     for the process with one warning.
#     ARMED (rank log, once per process at first use, every rank): "DLRMV4
#     armed OK: input-dropout mask bit-packed", "DLRMV4 armed OK:
#     concat_fold uih_ts ACTIVE", "DLRMV4 armed OK: concat_fold ctx_ts
#     ACTIVE", "DLRMV4 armed OK: glue_fold3 pcast ACTIVE", "DLRMV4 armed OK:
#     glue_fold3 sort ACTIVE". Must be ABSENT: "DLRM_HSTU_FP8_DROPOUT_MASK_BITS
#     set but NOT armed", "bit-packed dropout mask was not folded", "no
#     consumer folded", "glue concat_fold_uih_ts DISABLED", "glue
#     concat_fold_ctx_ts DISABLED", "glue_fold3 pcast DISABLED".
#     Opt out (each independently): DLRM_HSTU_FP8_DROPOUT_MASK_BITS=0,
#     DLRM_HSTU_FP8_CONCAT_FOLD=0 (one site: DLRM_HSTU_FP8_CONCAT_FOLD_UIH_TS=0
#     or DLRM_HSTU_FP8_CONCAT_FOLD_CTX_TS=0), DLRM_HSTU_FP8_GLUE_FOLD3=0 (one
#     site: DLRM_HSTU_FP8_GLUE_FOLD3_PCAST=0 or
#     DLRM_HSTU_FP8_GLUE_FOLD3_SORT=0).
#     Only the value 0 is a documented opt-out of a switch.
apply_env_bootstrap.DLRM_HSTU_FP8_DROPOUT_MASK_BITS = True
apply_env_bootstrap.DLRM_HSTU_FP8_CONCAT_FOLD = True
apply_env_bootstrap.DLRM_HSTU_FP8_GLUE_FOLD3 = True
#
# On top of POSENC_DROPOUT_V2.
# Same contract: the binding below turns it on, the code default when the
# binding is absent is OFF, and a pre-set env var of the same name wins. It
# refines the V2 layout only; the mask bit-pack and glue folds above are
# unchanged by it.
#
# gfx950 hardware epilogue of the fused position +
#     input-dropout V2 kernel. One switch.
#     WHAT: POSENC_DROP_HWEPI: where POSENC_DROPOUT_FUSE launches its V2 layout (V2
#     on and its own first-use self-test passed), the V2 kernel is compiled
#     with HW_EPI: the fp32 -> bf16 conversion of the output uses the
#     hardware round-to-nearest-even instruction (v_cvt_pk_bf16_f32) instead
#     of the software rounding, and each Philox round's two XORs run as one
#     three-input v_bitop3_b32 with the round key in a scalar register
#     (ops/triton/triton_position.py). Tiling, grid, cache hints, the mask
#     layout (bool, or DROPOUT_MASK_BITS's packed bits), the element -> Philox
#     counter / word mapping and the bf16 add before the dropout (software
#     rounding) are V2's. gfx950 only: the arch is read from the device
#     (gcnArchName gfx950*); any other arch keeps the V2 binary as before,
#     with one warning. Inert where V2 is off or has fallen back to design A.
#     WHY: the V2 kernel is limited by vector-ALU issue, not by memory; the
#     software bf16 rounding and the paired XORs are a large share of its
#     per-element instructions, and gfx950 does each in one instruction.
#     IMPACT: shorter position + input-dropout forward (one call per step and
#     rank). Costs: the HW_EPI compile, a small cast-check kernel and the
#     first-use self-test run in the first training step, inside the timed
#     region (nothing of this is compiled before RUN_START).
#     NUMERICS: BIT-IDENTICAL. The hardware conversion equals the software
#     one on every fp32 input (NaN payloads quieted the same way) and
#     v_bitop3_b32 with truth table 0x96 is the three-input XOR: y, mask,
#     indices, generator offset and gradients are unchanged. Fail-closed per
#     V2 key, the shape key of the V2 self-test (device, D,
#     context length, table and timestamp dtypes, targets mode, time-bucket
#     function, dropout p, mask layout): at a key's first use, before its
#     first HW_EPI launch, the hardware cast must equal torch's cast on the
#     reachable epilogue values and the HW_EPI binary must match design A
#     and aten::native_dropout bit for bit (both RNG states, all 65536 bf16
#     bit patterns; the RNG state is left untouched). A mismatch, a compile
#     error or a launch exception keeps V2's software epilogue for THAT key
#     only, with one warning; other keys keep the hardware epilogue (training
#     has one key per rank).
#     ARMED (rank log, once per process at the first HW_EPI launch, every
#     rank): "DLRMV4 armed OK: posenc dropout hw epilogue (v_cvt_pk_bf16_f32
#     + v_bitop3 philox) ACTIVE". Must be ABSENT: "posenc dropout hw epilogue
#     DISABLED", "DLRM_HSTU_FP8_POSENC_DROP_HWEPI set but NOT armed".
#     Opt out: DLRM_HSTU_FP8_POSENC_DROP_HWEPI=0. Only the value 0 is a
#     documented opt-out of the switch.
apply_env_bootstrap.DLRM_HSTU_FP8_POSENC_DROP_HWEPI = True
#
# -----------------------------------------------------------------------------
# Forward FP8 GEMMs and FlyDSL LayerNorm backwards. Precedence:
#   - Out-projection forward: FWD_K1536 when on, else the residual-fused
#     hipBLASLt call (DLRM_HSTU_FP8_FUSE_RESIDUAL).
#   - Preprocessor last-pair LayerNorm(512) dx-sum backward:
#     PREPROC_GROUPED_TAIL_BWD's FlyDSL grouped kernel when WLN_BWD_FLYDSL
#     owns all three calls, else the per-pair loop (WLN_BWD_FLYDSL per call)
#     when it owns some, else the Triton grouped kernel.
#   - Layer-0 input-LayerNorm backward with DROPOUT_MSCALE_FOLD's dropout
#     mask/scale epilogue: WLN_BWD_FLYDSL_MSCALE when on and WLN_BWD_FLYDSL
#     is on (not latched off), for calls inside its coverage; else
#     DROPOUT_MSCALE_FOLD's Triton v2 kernel.
#
# K=512 FP8 forward projection GEMM.
#     WHAT: the two e4m3-output forward projections of the HSTU layers run on a
#     HIP kernel built from source (ops/hip/k512_fp8_gemm.cu, dispatched by
#     ops/triton/triton_fp8.scaled_mm_fp8_out_preq) instead of hipBLASLt:
#     - V/Q/K, [M,512] x [512,1536];
#     - the targets-only layer's V/K, [M,512] x [512,1024].
#     The math is the same as the hipBLASLt call it replaces in the input_scale
#     backend mode: C = e4m3_rne(sat448(acc * (scale_a * scale_b) + bias)).
#     - acc is fp32 over four in-order K=128 steps of v_mfma_f32_16x16x128_f8f6f4.
#     - The mul and the add round separately (no FMA).
#     - The fp8 convert saturates under MODE.FP16_OVFL.
#     Kernel structure:
#     - two resident 4-wave workgroups per CU, so one workgroup's epilogue
#       overlaps the other's MFMA mainloop;
#     - a 128x256 tile and a 5-slot 80 KiB LDS ring;
#     - operand-swapped MFMA, so each lane stores 16 consecutive output bytes;
#     - XCD-aware tile order;
#     - M-tail rows are dropped by the buffer range.
#     Everything else stays on hipBLASLt: the U GEMM, the out-projection
#     (FWD_K1536 takes it while that is on), other shapes, other scale modes, fast
#     accumulation, and torch.compile tracing. gfx950 only.
#     FALLBACK: a call outside that coverage takes hipBLASLt and logs one line
#     per reason kind: "[k512-fwd] declined -> hipBLASLt ...". A failed build
#     or a failed self-check is latched for the process, and the calls then
#     take hipBLASLt. Under DLRM_HSTU_FP8_FAIL_CLOSED=1, either one aborts the
#     run before RUN_START instead.
#     COLD START: with DLRM_HSTU_FP8_PREBUILD=1 (gin default),
#     triton_fp8.prebuild_extensions builds both libraries with
#     /opt/rocm/bin/hipcc before RUN_START, into
#     /tmp/dlrm_hstu_fp8_k512/pid<pid>_*. It then runs one self-check launch
#     per N on synthetic zeros, with no data and no RNG. MLPerf: compiling on
#     synthetic inputs is initialization-phase work.
#     IMPACT: shortens the V/Q/K and targets V/K forward GEMM kernels.
#     NUMERICS: fp32 summation order only (same inputs, same math, same
#     precision; not a compute reduction). Each output is one in-order fp32
#     chain over K. At in-model token counts hipBLASLt runs these shapes on a
#     persistent stream-K grid. Its data-parallel tiles use the same
#     per-element K order, so they are bit-identical, also on order-sensitive
#     data. Its last ("tail") tiles are split in K across workgroups and the
#     partial sums are added in fp32 through its workspace; there a row with
#     wide-dynamic-range or cancelling products can round to a different e4m3
#     value. On narrow Gaussian data every byte matches. Re-check parity
#     after any hipBLASLt update: it is defined against the kernel hipBLASLt
#     picks.
#     ARMED (every rank, once per process):
#     - before RUN_START: "[k512-fwd] prebuilt: N=1024,1536 ... self-check
#       M=257 OK";
#     - at the first forward: "[k512-fwd] armed: N=1536 ..." and
#       "[k512-fwd] armed: N=1024 ...", both with impl='2wg: ...'.
#     Must be ABSENT: "[k512-fwd] declined" for N=1536 or N=1024, and
#     "[k512-fwd] prebuild FAILED".
#     Opt out: DLRM_HSTU_FP8_FWD_K512=0.
apply_env_bootstrap.DLRM_HSTU_FP8_FWD_K512 = True
# Scaled-bias cache of the FP8 forward (ops/triton/triton_fp8.py
#     _scale_bias_for_fp8_output; the e4m3-output projections with a bias):
#     a cached scaled bias is served only while a weak reference shows that
#     the very bias tensor it came from is alive and is the caller's tensor;
#     entries whose tensor is gone or updated are purged at a fixed bound,
#     and the clear_* functions also clear the references. A freed temporary
#     bias (the targets-only V/K concat) can otherwise hand its key to a
#     later bias with other values, and the cache grows every step.
#     NUMERICS: bit-identical to the unchecked cache on every call except one
#     where that cache would have returned an entry computed from another,
#     already freed tensor with different values (a stale scaled bias; which
#     calls those are depends on Python id and allocator reuse, so the
#     unchecked cache is not reproducible there). Such a call gets the scaled
#     value of its own bias: a DECLARED correction, rare in-model but not
#     absent.
#     Read lazily at the first FP8 forward with a bias. ARMED (every rank,
#     once per process): "[fp8-bias-cache] strict: weakref-validated hits".
#     Must be ABSENT: "[fp8-bias-cache] legacy".
#     Kill switch: DLRM_HSTU_FP8_BIAS_CACHE_STRICT=0 (a pre-set env
#     value wins over this binding) = the unchecked cache, logged as
#     "[fp8-bias-cache] legacy (DLRM_HSTU_FP8_BIAS_CACHE_STRICT=0)".
apply_env_bootstrap.DLRM_HSTU_FP8_BIAS_CACHE_STRICT = True
#
# K=1536 FP8 output-projection forward GEMM with the fused residual
#     (companion of FWD_K512, same kernel family).
#     WHAT: the HSTU output projection forward
#     x' = bf16(y2 [M,1536] e4m3 x W_o [1536,512] e4m3 * scales + x) runs on a
#     HIP kernel built from source (ops/hip/k1536_fp8_addmm.cu, dispatched by
#     ops/triton/triton_fp8.scaled_addmm_fp8_preq in its residual-fused
#     branch). It replaces the residual-fused hipBLASLt call
#     (ops/triton/hipblaslt_scaled_addmm.cpp, alpha = beta = 1, heuristic
#     algorithm 1, 64 MiB workspace).
#     The math is the same:
#     D = bf16_rne(f32(acc * (scale_w * scale_act)) + f32(residual)).
#     - acc is fp32 over twelve in-order K=128 steps of
#       v_mfma_f32_16x16x128_f8f6f4.
#     - The mul and the add round separately (no FMA).
#     Kernel structure: two resident 4-wave workgroups per CU; a 128x256 tile;
#     a 5-slot 80 KiB LDS ring. The residual tile is LDS-DMA'd into the ring
#     slots the last two K steps free. Stores are 16 B each; M-tail rows are
#     dropped by the buffer range. gfx950 only.
#     Needs DLRM_HSTU_FP8_FUSE_RESIDUAL=1 (part of the DLRM_HSTU_FP8_FWD arm);
#     otherwise the residual is added outside the GEMM.
#     FALLBACK: a call outside the coverage keeps the hipBLASLt call and logs
#     once per reason kind: "[k1536-fwd] declined -> hipBLASLt ...". The
#     coverage is: K=1536, N=512, a contiguous e4m3 activation, a contiguous
#     bf16 residual, fp32 scalar scales, and no torch.compile tracing. A failed
#     build or self-check is latched, and the calls then take hipBLASLt. Under
#     DLRM_HSTU_FP8_FAIL_CLOSED=1, either one aborts before RUN_START instead.
#     COLD START: with DLRM_HSTU_FP8_PREBUILD=1 (gin default),
#     triton_fp8.prebuild_extensions builds the library with
#     /opt/rocm/bin/hipcc before RUN_START, into
#     /tmp/dlrm_hstu_fp8_k1536/pid<pid>_*. It then runs one self-check launch
#     on synthetic zeros, with no data and no RNG.
#     IMPACT: shortens the out-projection forward GEMM kernel.
#     NUMERICS: fp32 summation order only, as for FWD_K512 (same inputs, same math,
#     same precision; not a compute reduction): one in-order chain of twelve K
#     steps against hipBLASLt's persistent stream-K grid. Its data-parallel
#     tiles are bit-identical; in its tail tiles the split-K partial sums are
#     added in fp32 through the workspace, so a row with wide-dynamic-range
#     products can round to a different bf16 value. On narrow Gaussian data
#     every output word matches. Re-check parity after any hipBLASLt update:
#     it is defined against the kernel hipBLASLt's algorithm 1 selects.
#     ARMED (every rank, once per process):
#     - before RUN_START: "[k1536-fwd] prebuilt: K=1536 N=512 ... self-check
#       M=257 OK";
#     - at the first forward: "[k1536-fwd] armed: K=1536 N=512 ...".
#     Must be ABSENT: "[k1536-fwd] declined" and "[k1536-fwd] prebuild FAILED".
#     Opt out: DLRM_HSTU_FP8_FWD_K1536=0.
apply_env_bootstrap.DLRM_HSTU_FP8_FWD_K1536 = True
#
# Grouped preprocessor LayerNorm(512) backward on the FlyDSL grouped kernel
#     (PREPROC_GROUPED_TAIL's grouped backward; ops/
#     preproc_grouped_tail.py, kernel ops/flydsl/ln_bwd_grouped.py).
#     WHAT: turns on PREPROC_GROUPED_TAIL's grouped backward. The three last-pair
#     LayerNorm(512) dx-sum backwards of the preprocessor all read the same dy.
#     With WLN_BWD_FLYDSL on, its FlyDSL kernel owns those three calls; they
#     run as ONE grouped FlyDSL launch (ln_bwd_flydsl_grp3_d512_dxsum_x16_c3,
#     then one grouped finalize) that loads each dy row once, instead of three
#     per-call launches. Same grid, XCD block order, cache policy and per-problem
#     arithmetic as the per-call FlyDSL kernel; each problem keeps its own dW, dB and dx-sum
#     accumulators, so no computation is shared between problems. The
#     dgrad/wgrad matmuls that follow are unchanged.
#     WHY THIS KERNEL: the Triton grouped kernel slows down sharply while the
#     DDP gradient all-reduce, launched just before this backward, spins on
#     the same GPU (every rank but the last to arrive). The FlyDSL grouped
#     kernel keeps the per-call kernel's grid of many small blocks, which
#     holds up under that contention.
#     FALLBACK: when WLN_BWD_FLYDSL owns some or all of the calls but the grouped kernel
#     declines (two problems, a host-side error), the per-pair loop runs, so
#     the result stays the per-call kernel's. When WLN_BWD_FLYDSL owns none of
#     them (e.g. off or latched, or not gfx950), the Triton grouped kernel
#     runs. One WARNING per process names the reason and the
#     fallback. A host-side error latches only the grouped FlyDSL path, never
#     WLN_BWD_FLYDSL.
#     COLD START: with the cold-start bundle's startup preload on, both grouped kernels are
#     JIT-built on synthetic zero/one tensors before RUN_START, after
#     WLN_BWD_FLYDSL's four (no data, no RNG).
#     IMPACT: shortens the preprocessor's LayerNorm-backward tail on every rank
#     (one launch and one dy read instead of three).
#     Cost: out of place (the default) the three dh_k are fresh [N, 512] bf16
#     tensors, so the preprocessor backward holds one more [N, 512] bf16 than
#     the per-pair loop, at the end of the step's backward. Opt in to
#     DLRM_HSTU_FP8_PREPROC_GROUPED_TAIL_BWD_INPLACE=1 to write dh_k over the
#     saved h_k instead (bit-identical; it donates only when autograd will not
#     reuse the node: no retain_graph, no create_graph), so no dh is allocated.
#     NUMERICS: BIT-IDENTICAL output and gradients per rank to the three
#     per-call FlyDSL launches (WLN_BWD_FLYDSL through the per-pair
#     loop), out of place and in place. The gradients still come from
#     PREPROC_GROUPED_TAIL's single autograd node, so the DDP gradient-ready
#     order does not change.
#     ARMED (every rank, once per process):
#     - before RUN_START: "armed OK: [startup-preload] flydsl ... ln_bwd=4
#       grp3=1" (with WLN_BWD_FLYDSL_MSCALE on: "... ln_bwd=4 mscale=1 grp3=1");
#     - at the first backward: "armed OK: [preproc-grouped-tail-bwd-flydsl]
#       kernel=ln_bwd_flydsl_grp3_d512_dxsum_x16_c3 inputs=3 N=... remap=16
#       cache=3/3 inplace=no rank=".
#     With this knob on, WLN_BWD_FLYDSL's per-call "[ln-bwd] flydsl: D=512 swish=0
#     residual=0 dxsum=1" line is not printed: the grouped kernel takes
#     those three calls.
#     Must be ABSENT: "FlyDSL grouped LayerNorm backward DECLINED",
#     "[preproc-grouped-tail-bwd-flydsl] DISABLED", "grp3=error",
#     "[ln-bwd] flydsl DISABLED" and "armed OK: [preproc-grouped-tail-bwd]
#     inputs" (the Triton grouped kernel ran).
#     Opt out: DLRM_HSTU_FP8_PREPROC_GROUPED_TAIL_BWD=0 (the per-pair
#     loop, bit-identical). Not an opt-out, testing only:
#     DLRM_HSTU_FP8_PREPROC_GROUPED_TAIL_BWD_FLYDSL=0 keeps the grouped
#     backward on its Triton grouped kernel (not bit-identical while
#     WLN_BWD_FLYDSL is on). Turning WLN_BWD_FLYDSL off
#     (DLRM_HSTU_FP8_WLN_BWD_FLYDSL=0) while this knob is on also lands on
#     that Triton grouped kernel; set DLRM_HSTU_FP8_PREPROC_GROUPED_TAIL_BWD=0
#     as well to get the per-pair Triton path. Inert while
#     PREPROC_GROUPED_TAIL is off.
apply_env_bootstrap.DLRM_HSTU_FP8_PREPROC_GROUPED_TAIL_BWD = True
#
# FlyDSL LayerNorm backward for the layer-0 input LayerNorm with the
#     DROPOUT_MSCALE_FOLD dropout mask/scale epilogue (ops/flydsl/ln_bwd.py mscale;
#     dispatch ops/triton/triton_layer_norm.py _wln_bwd_flydsl_mscale). Not
#     an FP8 knob. Needs WLN_BWD_FLYDSL on; with DROPOUT_MSCALE_FOLD off there
#     is no such call and this knob does nothing.
#     WHAT: DROPOUT_MSCALE_FOLD folds the HSTU input dropout's
#     backward into the layer-0 input-LayerNorm backward (the residual call,
#     with a bool mask * scale epilogue), a call that WLN_BWD_FLYDSL leaves on the
#     Triton v2 kernel. With this on, that call runs as WLN_BWD_FLYDSL's FlyDSL residual
#     kernel with the same epilogue: one more FlyDSL main kernel
#     (ln_bwd_flydsl_d512_res_mscale_x32_c3) with the residual variant's XCD
#     block order, streaming cache policy, grid and finalize; the mask is read
#     once, non-temporal, and the fp32 scale is passed as its bits (a runtime
#     argument, so one build serves every dropout rate).
#     COLD START: with WLN_BWD_FLYDSL's startup prebuild, the mscale kernel is built
#     before RUN_START as well (synthetic zero/one tensors, an all-ones mask;
#     no data, no RNG).
#     IMPACT: shortens the layer-0 input-LayerNorm backward (one call per
#     step).
#     NUMERICS: last-bit, not a precision change. dx is bit-identical to
#     native_dropout_backward applied to the WLN_BWD_FLYDSL residual call's dx
#     (signed zeros and NaN payloads included), and dW/dB are bit-identical to
#     that call's. Against the Triton v2 mscale path it replaces: the same
#     class as WLN_BWD_FLYDSL -- a very small fraction of dx elements differ, by about
#     one bf16 ulp of the LayerNorm term (more ulps of the result only where
#     the residual cancels it), every such element being one where the
#     unmasked residual outputs already differ; dropped elements stay exact
#     zeros; dW/dB use WLN_BWD_FLYDSL's deterministic partial order (no
#     atomics). With this on, the layer-0 dx, dW and dB equal, bit for bit,
#     what the DROPOUT_MSCALE_FOLD=0 opt-out computes for that layer
#     (WLN_BWD_FLYDSL's residual call followed by native_dropout_backward).
#     ARMED (every rank, once per process at first use): "[ln-bwd] flydsl:
#     D=512 swish=0 residual=1 dxsum=0 mscale=1 weight=torch.bfloat16
#     remap=32 cache=3/3"; the startup preload line carries "ln_bwd=4
#     mscale=1" (WLN_BWD_FLYDSL's "ln_bwd=4" is unchanged). Must be ABSENT:
#     "[ln-bwd] triton: D=512 swish=0 residual=1 dxsum=0 mscale=1",
#     "[ln-bwd] flydsl DISABLED".
#     WITH DROPOUT_MASK_BITS armed (the forward wrote the
#     packed uint8 [N, D / 8] mask): the same call runs the packed-mask main
#     ln_bwd_flydsl_d512_res_mscaleb_x32_c3 (one ubyte load per row slot, the
#     same epilogue, finalize, numerics and opt-outs as above; dx is
#     bit-identical to the bool-mask kernel's). ARMED then: "[ln-bwd] flydsl:
#     D=512 swish=0 residual=1 dxsum=0 mscale=1 bits=1 weight=torch.bfloat16
#     remap=32 cache=3/3" and the startup preload "ln_bwd=4 mscale=1 bits=1";
#     Must be ABSENT also: "[ln-bwd] triton: D=512 swish=0 residual=1 dxsum=0
#     mscale=1 bits=1". With this off the packed mask stays on
#     DROPOUT_MASK_BITS's Triton bits fold.
#     Opt out: DLRM_HSTU_FP8_WLN_BWD_FLYDSL_MSCALE=0 (the layer-0 call returns
#     to the Triton v2 mscale kernel);
#     DLRM_HSTU_FP8_WLN_BWD_FLYDSL=0 turns this off as well.
apply_env_bootstrap.DLRM_HSTU_FP8_WLN_BWD_FLYDSL_MSCALE = True
#
# -----------------------------------------------------------------------------
# On top of the posenc / EC sort and glue knobs above. Same
# contract as the earlier knobs: the bindings below turn it on, the code
# default when a binding is absent is OFF, and a pre-set env var of the same
# name wins. Its precedence against the earlier knobs is stated under each
# part. The posenc concat pin rows key the concat kernel, which (a)/(b) leave
# unchanged; (f) OFFS writes the same uih/candidate offset values that
# CONCAT_FOLD's uih_ts kernel reads; (c)'s extension builds after the earlier
# prebuilds (see (c)).
#
# The posenc and grouped EC backward sorts without
#     torch.sort, the EC expand launch geometry, the grouped EC backward
#     reduce of both hoisted members in one launch, and four small-kernel
#     glue folds. Six switches; (f) has four per-site refinements.
#     IMPACT: fewer and shorter main-stream kernels in the position forward,
#     the EC expand forward, the EC backward and the preprocessor /
#     postprocessor glue. Costs: one C++/HIP extension build for (b) and (c)
#     (current device arch only, before RUN_START; see (c)); the new Triton
#     kernels compile at first use (fixed configs, no autotune); the
#     first-use self-checks named under each part.
#     NUMERICS: BIT-IDENTICAL, every part (stated under each). No fp32
#     summation order changes; hot EC rows and the POSENC_BWD_V2 position-
#     table gradients keep the atomic-order nondeterminism they already had.
#     (a) POSENC_POS_ARITH.
#     WHAT: the pos keys of the POSENC_CONCAT_FOLD position kernel (with or
#     without POSENC_DROPOUT_FUSE's fused input dropout) are a function of the sequence
#     lengths, targets, contextual length and pos table size only, so their
#     stable sorted order (sorted keys + int64 indices, what the position
#     backward reads) is written by one Triton kernel from the jagged
#     metadata (each key's tokens form one run per sequence; a run starts
#     after the tokens with a smaller key) instead of a radix sort of the
#     keys (ops/triton/triton_pos_perm.py, ops/triton/triton_position.py).
#     WHY: these keys need no sort at all; torch.sort wraps its digit passes
#     in fills, an iota and a key copy.
#     NUMERICS: BIT-IDENTICAL. Above 4096 elements torch.sort runs a stable
#     radix sort and the stable sorting permutation of a key sequence is
#     unique; the kernel writes exactly that permutation and the sorted keys
#     (same dtype, shape and contiguity) from the closed form of the keys.
#     NEEDS: POSENC_SORT16 (it acts only in that int16-key
#     branch, hammer sort absent, above torch's small-sort cutoff) and the
#     POSENC_CONCAT_FOLD position kernel; inert otherwise.
#     Fail-closed: its first two results per process are compared with
#     torch.sort (raw bits); a mismatch or a raising call keeps torch.sort
#     for the process with one log line.
#     ARMED (every rank, once per process at first use): "DLRMV4 armed OK:
#     posenc pos permutation arithmetic". Must be ABSENT: "posenc pos
#     permutation arithmetic SELF-CHECK FAILED", "posenc pos sort FAILED
#     CLOSED".
#     Opt out: DLRM_HSTU_FP8_POSENC_POS_ARITH=0.
#     (b) POSENC_TS_ONESWEEP.
#     WHAT: the timestamp-bucket keys of the same position kernel are sorted
#     by ops/onesweep_sort.py, a HIP extension that runs rocPRIM's onesweep
#     device code (the code torch.sort runs) over the key bits the ts table
#     size proves, in 6-bit digit passes, with a counting-iterator index and
#     one fill per sort, instead of torch.sort (key copy, iota kernel,
#     per-pass fills, 8-bit digit passes over the full key width).
#     WHY: the key range is known statically, so narrower digit passes cover
#     it, and the iota, the key copy and most fills around them go.
#     NUMERICS: BIT-IDENTICAL. An LSD radix sort is stable: the same keys
#     sorted stably over bits that cover every key give torch.sort's sorted
#     keys and int64 indices.
#     NEEDS: POSENC_SORT16 (same branch as (a)) and the
#     extension (built as described under (c)).
#     Fail-closed: its first two results per process are compared with
#     torch.sort (raw bits); a mismatch, a raising call or an extension that
#     does not build keeps torch.sort for the process with one log line
#     (plus the extension's own warning when it does not build).
#     ARMED (every rank, once per process at first use): "DLRMV4 armed OK:
#     posenc ts onesweep sort". Must be ABSENT: "posenc ts onesweep sort
#     SELF-CHECK FAILED", "posenc ts sort FAILED CLOSED".
#     Opt out: DLRM_HSTU_FP8_POSENC_TS_ONESWEEP=0.
#     (c) EC_JOINT_ONESWEEP.
#     WHAT: EC_JOINT_SORT's joint argsort of the two hoisted EC members' row
#     ids runs on the same extension over bit_length(2U - 1) key bits in
#     9-bit digit passes, reads the keys straight from the two members'
#     int64 ids (no int32 key build), carries member-relative positions (no
#     subtract kernel) and writes both members' segment offsets from the
#     sorted keys (one pass over the run boundaries plus one kernel for long
#     runs of absent ids) instead of two binary searches
#     (train/ec_offsets.py).
#     WHY: the keys are bounded by 2U, so fewer digit passes cover them, and
#     the key build, the subtract and the offset searches around the sort
#     are separate launches.
#     NUMERICS: BIT-IDENTICAL. Same stable permutation of the same keys, so
#     each member gets exactly its EC_JOINT_SORT order (int64, contiguous, 16-byte
#     aligned) and the same integer offsets: the reducer, EC_REDUCE_LPT or (e)
#     below, sees the same tensors.
#     NEEDS: EC_JOINT_SORT (it refines that sort and is inert
#     without it, hence also without EC_SORT32 or
#     EC_GROUP_BWD); int64 ids (int32 ids keep the EC_JOINT_SORT chain). The
#     extension is compiled from copies of its sources in
#     /tmp/dlrm_hstu_onesweep_sort for the current device arch, before
#     RUN_START by the prebuild hook (DLRM_HSTU_FP8_PREBUILD)
#     whenever (b) or (c) is on, right after the earlier prebuilds
#     (BWD_WGRAD_CK / BWD_WGRAD_CK_W3, FWD_K512, FWD_K1536, L11). The ranks of a node take turns on a file
#     lock that the kernel drops when its holder dies, with a timeout; a
#     stale torch build lock left by a killed build is removed under it.
#     Without the prebuild it is built at first use. One call sorts fewer
#     than 2^30 keys (one onesweep batch); larger inputs keep the incumbent
#     sort, as do (b)'s.
#     Fail-closed: its first two builds per process also run the EC_JOINT_SORT
#     chain and compare raw bits; a mismatch, a raising call or an extension
#     that does not build keeps the EC_JOINT_SORT chain for the process with one
#     log line (plus the extension's own warning when it does not build).
#     ARMED (every rank): before RUN_START "armed OK: prebuild before
#     run_start: onesweep_sort_ext=1" (a failed build logs "DLRMV4 NOT armed:
#     prebuild before run_start: onesweep_sort_ext=0" instead); once per
#     process at first use "DLRMV4 armed OK: ec joint onesweep". Must be
#     ABSENT: "onesweep_sort_ext=0", "onesweep sort extension unavailable",
#     "ec joint onesweep SELF-CHECK FAILED", "ec joint onesweep FAILED
#     CLOSED".
#     Opt out: DLRM_HSTU_FP8_EC_JOINT_ONESWEEP=0.
#     (d) EC_GATHER_WIDE.
#     WHAT: where EC_GATHER_V2 runs the EC expand forward row
#     copy (train/ec_expand_gather.py), the same _expand_rows kernel launches
#     64 rows per program on 16 warps instead of 32 rows on 4 warps (an
#     explicit DLRM_HSTU_FP8_EC_GATHER_V2_ROWS / _WARPS still wins).
#     WHY: the copy's time is set by the rows each wave keeps in flight and
#     by the workgroups dispatched, not by its bytes.
#     NUMERICS: BIT-IDENTICAL. A pure copy of the same bytes (raw bits equal
#     to torch.gather).
#     NEEDS: EC_GATHER_V2 (inert without it).
#     ARMED (every rank, once per process at first use): "DLRMV4 armed OK: ec
#     gather wide".
#     Opt out: DLRM_HSTU_FP8_EC_GATHER_WIDE=0.
#     (e) EC_REDUCE_FUSED.
#     WHAT: where EC_REDUCE_LPT reduces the hoisted members of
#     the EC_GROUP_BWD grouped EC backward one call per member (a [U, W] zero
#     fill, then per member a plan chain and a reduce over every row, the
#     second member as a read-modify-write of all U rows), one plan chain and
#     one main launch compute the same accumulator (train/ec_gpu_plan.py
#     segment_reduce_grouped, hook in train/ec_bf16_output.py): a per-row
#     plan kernel (piece counts of both members, the LPT long-row flag of the
#     fused cold work, +0.0 into exactly the rows whose first write is an
#     atomic), one cumsum, a table kernel (the 2-class LPT row order and
#     explicit piece tables), a main kernel (member-0 hot pieces, member-1
#     hot pieces of rows member 0 does not touch, then every row once: both
#     members' cold segments folded and combined with the incumbent's
#     member-1 add) and a small post kernel (the member-1 add on member-0 hot
#     rows, after their atomics, and member-1 pieces of rows both members
#     touch). It reduces the (order, offsets) that EC_JOINT_SORT or (c) supply, or
#     builds them per member when the joint sort does not engage; the kept
#     keys' scatter_add_ is unchanged.
#     WHY: LPT's member-1 launch re-reads and re-writes the whole fp32
#     accumulator, its member-0 launch stores +0.0 into every member-1 row on
#     top of a full zero fill, both launches run U row programs plus a plan
#     chain each, and every hot program binary-searches its piece.
#     NUMERICS: BIT-IDENTICAL. Every segment is folded by the unchanged
#     one-wave / two-wave folds with LPT's own fold decision, tile and piece
#     boundaries: rows cold in both members are raw-bit identical (NaN
#     payloads, -0.0 and denormals included); hot rows get the same piece
#     sums and atomic adds in the same launch order (member 0 before member
#     1), i.e. they stay within the pre-existing atomic-order
#     nondeterminism. The member-1 add is pinned (inline asm) to LPT's
#     compiled operand order: for the production key (W=512, bf16, unit
#     column stride, one-wave fold) from an offline-validated table (no
#     runtime probe), for any other key from a one-time self-test against
#     the per-member LPT calls on overlapping rows with NaN payloads; no
#     match keeps the per-member calls. Production member rows are disjoint
#     (different tables), so one operand is always +0.0 there.
#     NEEDS: EC_REDUCE_LPT with the GPU planner, inside
#     EC_GROUP_BWD (inert otherwise); engages with one or two hoisted
#     members (EC_CAT_FUSE's cat-fused pair plus the item member; with more,
#     the per-member calls run).
#     Fail-closed: a raising call keeps the per-member calls for the process
#     with one warning.
#     ARMED (every rank, tagged "[rank N]", once per process at first use):
#     "DLRMV4 armed OK: ec reduce fused" and "ec_reduce_fused width=512
#     dtypes=['bfloat16', 'bfloat16']: offline-validated key". Must be
#     ABSENT: "ec reduce fused FAILED CLOSED", "self-test found no raw-bit
#     match".
#     Opt out: DLRM_HSTU_FP8_EC_REDUCE_FUSED=0.
#     (f) GLUE_FOLD4: four sites, each with a refinement switch that is on by
#     default under the master and inert without it (ops/glue_fusion.py
#     section 5).
#     WHAT: ACTSUM: ACTION_ENC_FUSE's fused action-encoder backward stores the
#     masked [N, A * D] gradient product as bf16 instead of fp32 and reduces
#     it with torch.sum(.., dtype=float32) instead of sum_to_size. CTX1:
#     CONTEXTUAL_FUSE's fused contextual pad/cat runs one forward and one backward
#     launch for all (up to eight) features instead of one per feature.
#     OFFS: DlrmHSTU.preprocess's UIH and candidate offsets (two complete
#     cumsums) run as one integer kernel (modules/dlrm_hstu.py). POST: the
#     targets-only output postprocessor's candidate-timestamp selection, its
#     fp32 time features (floor division, remainder, division, scaling,
#     polar), their bf16 cast and the cat with the embeddings run as one
#     kernel, and the bf16 -> fp32 -> bf16 round trip in front of its Linear
#     (the identity under bf16 autocast) is skipped
#     (modules/hstu_transducer.py, modules/postprocessors.py).
#     WHY: each site is a chain of tiny main-stream kernels (ACTSUM: an fp32
#     write and read of a tensor whose values are all bf16-exact).
#     NUMERICS: BIT-IDENTICAL. ACTSUM: every product g * m is exactly a bf16
#     value (g bf16, m in {0, 1}) and ATen's launch config for an fp32-
#     accumulating sum does not depend on the input width, so the same fp32
#     additions run in the same order (for one row the unfused path runs).
#     CTX1: the per-feature programs unchanged, in one launch. OFFS: integer
#     prefix sums. POST: the same fp32 operations in the same order (int64 ->
#     fp32, c10 div_floor_floating, ATen's float remainder, IEEE division,
#     multiplies by the fp32-rounded scalars 2 and 3.14, ocml cos/sin, RNE
#     bf16 cast); bf16 -> fp32 -> bf16 is exact, so the Linear input and
#     every gradient are unchanged. No parameter's autograd node changes.
#     NEEDS: ACTSUM ACTION_ENC_FUSE, CTX1
#     CONTEXTUAL_FUSE (each inert without it); OFFS and POST stand alone
#     (POST arms only under bf16 autocast with an fp32 Linear weight).
#     Fail-closed: ACTSUM and POST self-test against the unfused ops (raw
#     bits) at first use; at every site a self-test mismatch, a compile or a
#     launch error turns that site off for the process with one warning (the
#     unfused ops recompute a call that failed).
#     ARMED (every rank, once per process at first use): "DLRMV4 armed OK:
#     glue_fold4 actsum ACTIVE", "DLRMV4 armed OK: glue_fold4 ctx1 ACTIVE",
#     "DLRMV4 armed OK: glue_fold4 offs ACTIVE", "DLRMV4 armed OK: glue_fold4
#     post ACTIVE". Must be ABSENT: "glue_fold4 actsum DISABLED", "glue_fold4
#     ctx1 DISABLED", "glue_fold4 offs DISABLED", "glue_fold4 post DISABLED".
#     Opt out: DLRM_HSTU_FP8_GLUE_FOLD4=0 (one site:
#     DLRM_HSTU_FP8_GLUE_FOLD4_ACTSUM=0, _CTX1=0, _OFFS=0 or _POST=0).
#     Only the value 0 is a documented opt-out of a switch.
apply_env_bootstrap.DLRM_HSTU_FP8_POSENC_POS_ARITH = True
apply_env_bootstrap.DLRM_HSTU_FP8_POSENC_TS_ONESWEEP = True
apply_env_bootstrap.DLRM_HSTU_FP8_EC_JOINT_ONESWEEP = True
apply_env_bootstrap.DLRM_HSTU_FP8_EC_GATHER_WIDE = True
apply_env_bootstrap.DLRM_HSTU_FP8_EC_REDUCE_FUSED = True
apply_env_bootstrap.DLRM_HSTU_FP8_GLUE_FOLD4 = True
#
# -----------------------------------------------------------------------------
# DKDV_E5M2: dV|dK e5m2 emission by the C8 attention backward
#     (on top of BWD_UVQK, BWD_DQ_E5M2 and BWD_ATTN_V2; ops/flydsl/hstu_bwd_dkdv.py
#     e8emit epilogue, ops/flydsl/hstu_dkdv_e5m2.py, the dkdv_fp8_sink
#     argument of ops/flydsl/hstu_flydsl_mha.py, the ordinary-layer backward
#     in ops/triton/triton_hstu_preprocess_and_attention.py, bwd_fp8.py,
#     hstu_dq_e5m2.py). Code default OFF; the binding below turns it on.
#     WHAT: on ordinary layers whose BWD_UVQK fp8t projection backward will run
#     with a published per-layer scale, ONE dz8 [Mp, 2048] e5m2 is allocated
#     before the attention backward (pad rows zeroed once) with ONE immutable
#     per-call scale epoch (inv and decode-scale snapshots). The bwd_dkdv
#     epilogue writes the e5m2 dV|dK columns (the bytes the BWD_UVQK cast
#     writes) plus amax/colsum partials INSTEAD of BF16 dV/dK; the BWD_DQ_E5M2 dq
#     sink adopts the same dz8 and epoch for the q columns; the cast pass
#     shrinks to the u columns (u|q when BWD_DQ_E5M2 declines). amax = max of all
#     producers, bias colsum = [u | v | q | k] from the producers, ONE
#     prequant projection backward per call. Arms only with the dq-split
#     msplit=1 kernel, VALU nobr,msat and MSPLIT_SCHED mc (BWD_ATTN_V2); every
#     other call runs the TARGET_B path unchanged.
#     IMPACT: the u|v|k cast pass becomes u only; bwd_dkdv stores e5m2 bytes
#     instead of BF16 dV/dK. Costs: the e5m2 epilogue work inside bwd_dkdv,
#     dz8 lives from before the attention backward, and an engaged call keeps
#     its Q/K/V pack until its projection backward returns (exact fallback).
#     NUMERICS: dz8 payload (every byte, pad rows) and amax BIT-IDENTICAL, so
#     every GEMM operand and the delayed-scale state are unchanged; the 1024
#     v|k bias-gradient column sums are a DECLARED fp32 summation-order
#     change (same class as BWD_DQ_E5M2's q columns). A failure after emission
#     re-runs the attention backward without the sinks and continues exactly
#     like the knob-off path (exact BF16 dq/dV/dK wherever the knob-off twin
#     reads BF16; on calls joint with BWD_DQ_E5M2 or BWD_DU_E5M2 a BF16 wgrad inside
#     the FP8 projection backward decodes the e5m2 payload exactly as that
#     twin does (first-call failures only)). The first failure after
#     emission latches DKDV_E5M2 off for the process with one "[hstu-attn] bwd
#     dkdv e5m2 DISABLED (latched): <reason>" line; every later call takes
#     the knob-off path from the arm decision, without an extra attention
#     backward.
#     WITH BWD_DU_E5M2: when the LN*U*dropout backward
#     emitted the layer's e5m2 u block and the preprocess backward took its
#     record, the dz8 above IS that buffer (adopted: one dz8 per layer call,
#     no second allocation; the pad rows are still zeroed here once). With
#     BWD_DQ_E5M2 engaged NO cast kernel runs (u from BWD_DU_E5M2, v|k from
#     bwd_dkdv, q from the dq sink), else the cast covers q only. A consumer
#     cast or finalize failure after emission (raised before the FP8
#     projection backward ran, so the delayed-scale state is untouched)
#     keeps BWD_DU_E5M2's u block: the attention backward is re-run without the
#     sinks (exact BF16 dq/dV/dK) and BWD_DU_E5M2's own consumer casts v|q|k
#     into the same dz8 for ONE FP8 projection call, bitwise the call with
#     DKDV_E5M2 and BWD_DQ_E5M2 off; only if that consumer fails too does
#     BWD_DU_E5M2 restore u LOSSY and latch itself off. If the FP8 projection
#     backward returns None after emission, u has no exact source:
#     BWD_DU_E5M2's LOSSY restore (BWD_DU_E5M2 latched off), then the sink-less
#     re-run (exact BF16 dq/dV/dK) and the BF16-input projection call. Either
#     failure latches DKDV_E5M2 off as above; BWD_DU_E5M2 then runs as
#     without it. When DKDV_E5M2 declines before emission, BWD_DU_E5M2 runs
#     as without it.
#     ARMED (every rank): "[hstu-attn] bwd dkdv e5m2 sink ARMED: mode=only",
#     "[hstu-attn] bwd dkdv e5m2 sink engaged=1 counters=" (and at 10, 100,
#     1000, 10000 engaged calls); with BWD_DU_E5M2 the ARMED line reads "cast
#     none: u from the LN*U*dropout backward ..., q from the dq-split sink",
#     and "ARMED du_e5m2 on cuda:... dz8 shared with the ... dV|dK sink"
#     and "ARMED dq_e5m2 on cuda:... no cast kernel" follow. Must be ABSENT:
#     "[hstu-attn] bwd dkdv e5m2 sink DECLINED", "[hstu-attn] bwd dkdv e5m2
#     FALLBACK", "[hstu-attn] bwd dkdv e5m2 DISABLED".
#     Opt out: DLRM_HSTU_FP8_BWD_DKDV_E5M2=0 (the TARGET_B path).
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_DKDV_E5M2 = True
#
# -----------------------------------------------------------------------------
# Attention-adjacent bitwise bundle: work-list dO quantizer, VALU-diet
#     VKP_V2 delta backward, lazy fallback glue, forward causal-mask
#     arithmetic. Four independent switches, each read per
#     call and armed only by the value "1". Code default OFF when the
#     binding is absent; a pre-set env var wins.
#   (a) DOBLK_WL: C8 dO block quantizer (ops/flydsl/hstu_do_fp8.py
#     quantize_do_e4m3_blk -> ops/flydsl/hstu_do_fp8_wl.py).
#     WHAT: a small device kernel builds a sequence-major list of the
#     non-empty (sequence, 64-token tile) items (no host sync) and the
#     quantizer runs one program per item, instead of the (B, cdiv(N, 64))
#     grid in which most programs past a sequence's end exit immediately.
#     Per tile: a scalar base pointer with int32 offsets (keeps buffer loads
#     on a dO larger than 2 GiB), one joined max for both MX token groups,
#     16 warps, an unmasked path for complete tiles. Batches of more than
#     8192 sequences per call keep the grid kernel (in-model: 1024).
#     IMPACT: shortens the dO quantizer of every ordinary STU layer backward.
#     NUMERICS: BIT-IDENTICAL e4m3 dO and E8 bytes (same group rule, same
#     exponent and scale math; max is order-free); same coverage as the grid.
#     ARMED (every rank, once, at the first C8 backward): "[hstu_do_fp8]
#     DLRM_HSTU_FP8_DOBLK_WL=1 armed: work-list dO block quantizer ...".
#     Opt out (kill switch): DLRM_HSTU_FP8_DOBLK_WL=0 (the grid kernel
#     _blk_kernel).
#   (b') DELTA_BWD_V2_DIET: E5M2 targets-only delta-attention backward
#     producer, BWD_VKP_V2 path (ops/triton/hstu_delta_bwd_e5m2.py
#     -> ops/triton/hstu_delta_bwd_e5m2_v2_diet.py
#     _hstu_attn_delta_bwd_e5m2_v2_diet).
#     WHAT: the same math as the BWD_VKP_V2 v2 kernel (same LPT program order,
#     row-max amax, element-wise dq accumulator and epilogue) with fewer VALU
#     instructions per tile: one conversion instruction per bf16 round trip,
#     explicit packed multiplies and med3 clamp, and the qk/dqk partial sums
#     pinned in asm to the v2 build's exact fused/unfused sequence and operand
#     order; the > 2 GiB (in-model) build peels the masked tail tile and drops
#     to 163 VGPR (3 waves/SIMD; v2: 179, 2 waves). Used ONLY in the
#     configuration it was verified in (the bound VKP_V2 constants, BLOCK_N
#     32, 4 warps, D 128, bf16 q/dout/dQ, e4m3 K/V, e5m2 payload, gfx950,
#     Triton 3.6.0); any other call runs the v2 kernel and logs one
#     "declined (<reason>)" line. Inert while BWD_VKP_V2 is off.
#     PRECEDENCE: acts only inside the BWD_VKP_V2 branch of the producer
#     (same call, same LPT order); it does not change which knob takes the
#     producer call.
#     IMPACT: shortens the targets-only delta backward producer.
#     NUMERICS: BIT-IDENTICAL to the BWD_VKP_V2 v2 kernel: E5M2 payload bytes,
#     pad rows, dQ, amax and the fp32 bias colsum, including NaN payload and
#     sign bits in the edge cases tested (NaN/inf/-0 inputs, product
#     overflow/subnormals). Re-verify after any Triton or LLVM change.
#     ARMED (every rank, once, at the first producer call):
#     "[hstu_delta_bwd_e5m2] DLRM_HSTU_FP8_DELTA_BWD_V2_DIET=1 armed:
#     VALU-diet kernel _hstu_attn_delta_bwd_e5m2_v2_diet ..."; the BWD_VKP_V2
#     "ARMED vkp_v2 on" line still prints. Must be ABSENT:
#     "DLRM_HSTU_FP8_DELTA_BWD_V2_DIET=1 declined".
#     Opt out (kill switch): DLRM_HSTU_FP8_DELTA_BWD_V2_DIET=0 (the BWD_VKP_V2
#     v2 kernel).
#   (c) ATTN_GLUE_LAZY: full-layer attention Function (ops/triton/
#     triton_hstu_preprocess_and_attention.py).
#     WHAT: the sort_by_length indices (a torch.sort of the sequence lengths in
#     the forward) and the (1, 1) Q/K/V scale tensor of the saved-FP8 backward
#     are read only by the Triton attention fallback; they are now built on
#     the fallback path, when it runs, instead of on every call. While FlyDSL
#     serves both halves (the default) nothing is built.
#     IMPACT: removes a sort, its copies and a fill from every ordinary STU
#     layer step.
#     NUMERICS: BIT-IDENTICAL (dead work removed; on the fallback path the
#     indices only reorder which program serves which sequence and the scale
#     tensor holds the same frozen value).
#     ARMED (every rank, once, at the first full-layer forward): "[hstu-attn]
#     DLRM_HSTU_FP8_ATTN_GLUE_LAZY=1 armed: ...".
#     Opt out (kill switch): DLRM_HSTU_FP8_ATTN_GLUE_LAZY=0 (both built
#     eagerly).
#   (d) FWD_MASK_ARITH: e4m3 FlyDSL attention forward (ops/flydsl/
#     hstu_flydsl_mha.py _FP8_FWD_MASK_ARITH, compiled by ops/flydsl/
#     hstu_fwd.py mask_arith=3).
#     WHAT: in the diagonal (masked) n-iterations of fwd_kernel_0 (the last
#     BM/BN=4 of each 128-row m-block under mask_split) the causal zeros are
#     applied to the packed bf16 P fragment, one v_and_b32 per bf16 pair, with
#     per-lane pair masks from two packed-int16 ops per distinct (n-tile -
#     m-tile) offset, instead of an f32 compare and select per score element
#     followed by a bf16 unpack/repack. Every score element is still computed
#     (silu, conversion, MFMA) and every predicate is a runtime per-lane
#     value; no tile or element is skipped. Applies only together with
#     FWD_PIPE (needs its p_direct); set alone it is ignored with one log line.
#     IMPACT: shortens the masked iterations of the attention forward of every
#     ordinary STU layer.
#     NUMERICS: BIT-IDENTICAL to the FWD_PIPE build for all inputs, including
#     NaN in q, k or v (bf16(+0.0) is 0x0000, the same value the f32 select
#     produced).
#     ARMED (every rank, once, at the first FP8 FlyDSL forward): "[hstu-fwd]
#     DLRM_HSTU_FP8_FWD_MASK_ARITH=1 armed: mask_arith=3 ...".
#     Opt out (kill switch): DLRM_HSTU_FP8_FWD_MASK_ARITH=0 (the f32 select
#     of the FWD_PIPE build).
apply_env_bootstrap.DLRM_HSTU_FP8_DOBLK_WL = True
apply_env_bootstrap.DLRM_HSTU_FP8_DELTA_BWD_V2_DIET = True
apply_env_bootstrap.DLRM_HSTU_FP8_ATTN_GLUE_LAZY = True
apply_env_bootstrap.DLRM_HSTU_FP8_FWD_MASK_ARITH = True
# -----------------------------------------------------------------------------
# INTGLUE: Fused attention-backward int glue (bit-identical).
# ops/flydsl/hstu_flydsl_mha.py
# _attn_intglue_reason -> ops/flydsl/hstu_dq_split.py build_workspace_intglue.
#   WHAT: every dq-split attention-backward call needs the int32 seq offsets
#   (cu, bwd_dkdv's SEQ_OFF operand) and the ds workspace's int32 tile-prefix
#   header (pre[0] = 0, pre[1+b] = sum_{c<=b} H*nb_c*(nb_c+1), nb = ceil(L/128);
#   read by bwd_dkdv, the dq-split/dq e5m2 kernels and the bc bounds kernel).
#   Unarmed, they cost 10 tiny torch kernels back to back on the main stream
#   (to, sub, add, floor_divide, fill, mul, add, mul, cumsum, copy). Armed,
#   ONE single-program Triton launch
#   (_intglue_kernel) writes both per call. No memo, no state across calls.
#   NUMERICS: bit-identical (the same int32 values: int64 difference, floor via
#   arithmetic shift, wrapping int64 product and scan, int32 truncation as
#   copy_ / .to(torch.int32)). No model math changes; not a precision change.
#   ARMED (every rank, once, at the first dq-split backward after the FP8
#   warmup): "[hstu-attn] DLRM_HSTU_FP8_ATTN_INTGLUE=1 armed: dq-split backward
#   int glue (cu int32 + ds workspace tile-prefix header) in one Triton launch
#   per call (_intglue_kernel), ...". The line is an untagged warning and can
#   be lost in multi-process logs: prove arming from traces instead. Trace
#   check: every dq-split backward call has one
#   _intglue_kernel right before bwd_dkdv_kernel_0 (after the dO quantizer, or
#   after the e5m2 sink fill when the dO8 take removes the quantizer) and none
#   of the 10 torch kernels.
#   Diagnostic env knobs (not set in production; env-only by design):
#     DLRM_HSTU_FP8_ATTN_INTGLUE_CHECK=1 recomputes the stock values every call
#     and raises on a difference (host sync per call). Never set in a timed or
#     production run; unset/0 = no check (the default).
#   Opt out (kill switch): DLRM_HSTU_FP8_ATTN_INTGLUE=0 (the 10 torch ops).
apply_env_bootstrap.DLRM_HSTU_FP8_ATTN_INTGLUE = True
# -----------------------------------------------------------------------------
# FP8 P@V attention forward (DECLARED PRECISION CHANGE). e4m3 FlyDSL
# attention forward (ops/flydsl/hstu_flydsl_mha.py
# _FP8_FWD_PV_CFG, compiled by ops/flydsl/hstu_fwd.py pv="k128").
#   WHAT: the silu output P of fwd_kernel_0 is rounded to e4m3 with a static
#   scale (P8 = e4m3(sat(P' * s)), s = $DLRM_HSTU_FP8_FWD_PV_SCALE, default
#   10.04, folded into the silu chain's fma, out_scale *= 1/s), V is consumed
#   as raw e4m3 (no bf16 widening), and P@V runs as one
#   v_mfma_scale_f32_16x16x128_f8f6f4 per 128 keys instead of four bf16
#   16x16x32. Every score element of a real key is still computed; only
#   padded tail-group phases (first key >= seq_len) skip score and silu
#   (pv_tg), where P8 = 0 as the mask gives.
#   Arms only on the FWD_PIPE config, alone or composed with FWD_MASK_ARITH
#   (then the causal mask applies to the packed e4m3 P, bit-identical to the
#   pv select); otherwise it declines with one log line and the forward is the
#   bf16-P kernel. Kernel name unchanged (fwd_kernel_0).
#   WHY s = 10.04 (not a power of two): P' = -log2(e) * silu peaks at the silu
#   minimum, where many values pile up; a power-of-two scale keeps that pile
#   1.1% below an e4m3 grid point and rounds it up systematically (a coherent
#   bias on late gradient rows); s = 10.04 puts the pile where the mean
#   rounding error crosses zero.
#   NUMERICS: NOT bit-identical (e4m3 P and V operands of P@V).
#   ARMED (every rank, once, at the first FP8 FlyDSL forward): "[hstu-fwd]
#   DLRM_HSTU_FP8_FWD_PV=1 armed: pv=k128 pv_k=3 pv_s=10.04 ...".
#   Opt out (kill switch): DLRM_HSTU_FP8_FWD_PV=0 (bf16 P, the FWD_PIPE /
#   FWD_MASK_ARITH forward).
apply_env_bootstrap.DLRM_HSTU_FP8_FWD_PV = True
# -----------------------------------------------------------------------------
# FP8 preprocessor L2 GEMMs + stacked LN512 backward (DECLARED
# PRECISION CHANGE). ops/preproc_fp8_l2.py.
#   WHAT: the L2 GEMMs of the content and additional preprocessor MLPs run in
#   FP8 (forward e4m3 x e4m3 + bias, dgrad e5m2 x e4m3, hipBLASLt NN wgrad) on
#   producer-emitted operands (SwishLN256 forward writes e4m3 a1, LN512
#   backward writes e5m2 dh2, delayed per-tensor scales). The LN512 dx-sum
#   backward of all three MLPs is one stacked FlyDSL launch (the PREPROC_GROUPED_TAIL_BWD kernel
#   plus an e5m2/amax epilogue); the action MLP stays bf16 and bit-identical.
#   A pre-RUN_START warm-up removes the first-step JIT.
#   NUMERICS: NOT bit-identical (e4m3 a1/W2, e5m2 dh2).
#   ARMED (every rank): "armed OK: [preproc-fp8-l2] first FP8 call",
#   "armed OK: [preproc-fp8-l2-grouped]", "[preproc-fp8-l2] pre-run_start
#   warm-up OK". With it armed, PREPROC_GROUPED_TAIL_BWD's grouped-tail-bwd line does not print.
#   Opt out (kill switch): DLRM_HSTU_FP8_PREPROC_L2=0; per-MLP path instead of
#   the stacked launch: DLRM_HSTU_FP8_PREPROC_L2_GROUPED=0.
apply_env_bootstrap.DLRM_HSTU_FP8_PREPROC_L2 = True
# -----------------------------------------------------------------------------
# E-X2b: Preprocessor L1 dgrad fused into the grouped EC backward segment
# reduce (DECLARED fp32 REDUCTION-ORDER NUMERICS CLASS; no precision change).
# Files: ops/triton/triton_ec_dgrad_segreduce.py and dlrm_v4/train/ec_dgrad_ports.py;
# hooks in dlrm_v4/train/ec_bf16_output.py, ops/fused_linear_norm.py,
# ops/preproc_fp8_l2.py and ops/preproc_grouped_tail.py. The kernels are prebuilt
# before RUN_START by dlrm_v4/train/blas_warmup.py.
#   WHAT: the first Linear of the content and additional MLPs no longer writes
#   its input gradient dX = dh @ W1 ([M,512] / [M,1024] bf16). Its backward
#   still returns dW1, db1 and the SwishLayerNorm gradients. dh [M,256] goes
#   to the grouped EC backward through a dedicated autograd edge: a stride-0
#   "dh port" output of the EC expand, one per hoisted member.
#   The EC backward then runs one Triton pass per hoisted member (item; cat =
#   artist|album interleaved) over its segment-sorted positions. Each pass:
#   gathers the dh rows; computes every token's dX row on bf16 MFMA (K = 256
#   in one dot, rounded to bf16 like the GEMM output); sums the rows of each
#   embedding row in fp32 with a 0/1 indicator MFMA; stores each finished row
#   once; and hands rows still open at a tile end to a fixed-order combine
#   kernel. Rows no hoisted member touches are set to +0.0. The kept keys'
#   scatter_add_ accumulates as before.
#   Every token's dX row is still computed; no FLOP is removed.
#   PRECEDENCE: for the two hoisted members it replaces
#   EC_REDUCE_FUSED and its per-member fallback, EC_REDUCE_LPT.
#   Both still run for every other grouped EC call and on the E-X2b fallback.
#   It consumes EC_JOINT_ONESWEEP's (order, offsets) unchanged
#   (ec_bf16_output._ec_joint_segments).
#   With it armed, the hoisted-member reduce lines print only if another
#   grouped EC call still reduces hoisted members:
#     "DLRMV4 armed OK: ec reduce fused"
#     "ec_reduce_fused width=512 ..."
#     "DLRMV4 armed OK: ec_segment_reduce backward active"
#     "... ec_reduce_lpt ..."
#   The ec_group_bwd line reports 0 segment-reduced keys.
#   NEEDS: EC_GROUP_BWD with the segment reduce, EC_CAT_FUSE,
#   ec_merge_uih_candidate, fuse_linear_norm, bf16 autocast, and a ROCm build.
#   It works with or without PREPROC_L2 and the grouped tail.
#   NUMERICS: NOT bit-identical; DECLARED fp32 reduction-order class.
#   - Addends: the single-pass K=256 dot rounded to bf16. This equals the
#     unfused GEMM's dX element for element wherever its stream-K schedule
#     does not split K; otherwise it differs by one bf16 ulp.
#   - Per-row sums: fp32, reassociated (tile sums + a fixed-order combine,
#     instead of the fused reduce's order).
#   - Deterministic run to run on rows no kept key touches.
#   - A non-finite dX element reaches every row sum of its 128-position tile;
#     the unfused path reaches only its own row.
#   - dW1, db1, dh and every other gradient are unchanged.
#   FALLBACKS:
#   - No port (the unfused path) under no_grad, tracing or compile, or when
#     the call lacks exactly the cat and item members.
#   - Pair 0 returns dX the unfused way when: a member output has hooks or
#     retain_grad; under create_graph; inside a backward (reentrant
#     checkpoint); with the FP8 SNR probe armed; or when the EC backward will
#     not run (autograd.grad / backward(inputs=)).
#   - The EC backward rebuilds dX = dh @ W1 (the unfused GEMM) and runs the
#     unfused reduce when only one member routed dh, or when a member output
#     has another consumer.
#   - A raising fused call, a failed first-use invariant check (disjoint
#     member rows, no mixed artist/album segment) or a failed pre-RUN_START
#     prebuild does the same, and latches E-X2b off for the process.
#   - A row covered by both members is NaN-poisoned.
#   ARMED (every rank, once, tagged "[rank N]"):
#     "armed OK: [ec-dgrad-segreduce] ports"
#     "armed OK: [ec-dgrad-segreduce] fused"
#     "[ec-dgrad-segreduce] invariants OK"
#     "[ec-dgrad-segreduce] pre-run_start prebuild OK" (with BLAS_WARMUP on)
#   Must be ABSENT:
#     "[ec-dgrad-segreduce] FALLBACK"
#     "[ec-dgrad-segreduce] DECLINED"
#     "[ec-dgrad-segreduce] FAILED CLOSED"
#     "INVARIANT"
#     "[ec-dgrad-segreduce] DLRM_HSTU_FP8_EC_DGRAD_SEGREDUCE=1 IGNORED"
#   Opt out (kill switch): DLRM_HSTU_FP8_EC_DGRAD_SEGREDUCE=0.
apply_env_bootstrap.DLRM_HSTU_FP8_EC_DGRAD_SEGREDUCE = True
# -----------------------------------------------------------------------------
# Diagnostic env knobs for PREPROC_L2 and E-X2b (not set in production).
# Env only, no gin binding, unset = off:
#   DLRM_HSTU_FP8_EC_DGRAD_SEGREDUCE_CHECK=1 (any other value = off): for the
#   first 2 fused EC backward calls in the process it rebuilds each member's
#   dX = dh @ W1 with the unfused GEMM, runs the unfused segment reduce on it
#   and logs the difference ("[ec-dgrad-segreduce] self-check vs shipped
#   reduce of rebuilt dX: ..."). Log only: it never changes a result and
#   never raises. It costs a transient dX per member and a host sync.
#   DLRM_HSTU_FP8_PREPROC_SNR=<count>[:<stride>] (sub-knobs _SNR_RANKS,
#   _SNR_ROWS, _SNR_EMB, _SNR_DIR; ops/triton/preproc_fp8_snr.py): in-model
#   FP8 numerics probe of the preprocessor-MLP GEMMs. It writes fp64-reference
#   error records ("[preproc-fp8-snr]") and never changes what a step
#   computes, but while it is armed PREPROC_L2, E-X2b and IX run the bf16
#   path, and a sampled step costs seconds on the armed rank.
#   Never set either in a timed or production run.
#
# -----------------------------------------------------------------------------
# X2H: E-X2b's pass as one persistent HIP kernel, x2h_pass
# (BIT-IDENTICAL to the Triton pass; no numerics change). Code default OFF;
# the binding below turns it ON; a pre-set env var wins over gin
# (_bind_bool).
# Files: ops/hip/ec_dgrad_x2h.py and ops/hip/x2h_pass.cu; dispatch in
# ops/triton/triton_ec_dgrad_segreduce.dgrad_segreduce; prebuild hook in
# dlrm_v4/train/blas_warmup.py (_prebuild_ec_dgrad_x2h, before RUN_START).
#   WHAT: E-X2b's two Triton passes (_ecx_dgrad_pass: cat, item) run as
#   x2h_pass, one persistent workgroup per CU. Each of its 8 waves owns 64
#   output columns and keeps that W1 slice in registers. The dh rows of a
#   128-position tile are gathered into LDS by LDS-DMA, double-buffered. The
#   MFMA chains, the bf16 rounding, the slots, the passes and the STORE /
#   fragment rules are Triton's, operation for operation. The allocations,
#   _ecx_combine and _ecx_zero_uncovered are unchanged; each pass adds one
#   small x2h_wpack launch (W1 into register-fragment order).
#   NUMERICS: none (bit-identical to E-X2b). Each run checks it before
#   RUN_START (PREBUILD: one role, finite inputs, three grids) and stays on
#   Triton on a mismatch.
#   MLPerf: the same FLOPs as E-X2b; only the schedule differs.
#   PREBUILD (every rank, before RUN_START, after E-X2b's prebuild; needs
#   BLAS_WARMUP):
#   - hipcc builds x2h_pass.cu into /tmp/dlrm_hstu_ec_dgrad_x2h (cached by
#     source, flags and toolchain);
#   - an exact check on E-X2b's synthetic input;
#   - a bitwise cross-check against the Triton passes on a deterministic
#     rounding-heavy input (> 6 tiles per CU per member; grids #CU / 7 / #CU;
#     the transient is released before alloc_pregrow).
#   Every check runs on sentinel-filled output buffers (a skipped write cannot
#   pass on recycled memory), and the tile counters and the zero row are
#   checked after every x2h_pass call.
#   Only then is the device armed. Nothing is built after RUN_START: without
#   a passed prebuild the Triton passes run.
#   FALLBACKS (E-X2b stays on with the Triton passes):
#   - knob off; E-X2b off;
#   - no prebuild on the device ("NOT armed");
#   - an input outside x2h_pass's contract, or CUDA graph capture
#     ("DECLINED", that call only);
#   - a failed prebuild or a raising launch: X2H off for the process
#     ("FAILED CLOSED").
#   ARMED (every rank, once, tagged "[rank N]"):
#     "armed OK: [ec-dgrad-x2h] pre-run_start prebuild OK"
#     "armed OK: [ec-dgrad-x2h] fused passes"
#     E-X2b's "armed OK: [ec-dgrad-segreduce] fused" line, which names
#     "x2h_pass x2"
#   Must be ABSENT:
#     "[ec-dgrad-x2h] FAILED CLOSED"
#     "[ec-dgrad-x2h] DECLINED"
#     "[ec-dgrad-x2h] NOT armed"
#     "[ec-dgrad-x2h] DLRM_HSTU_FP8_EC_DGRAD_SEGREDUCE_HIP=1 IGNORED"
#     (printed when E-X2b is off, not armed or latched off)
#     "[ec-dgrad-segreduce] X2H unavailable"
#   Opt out (kill switch): DLRM_HSTU_FP8_EC_DGRAD_SEGREDUCE_HIP=0.
#   Diagnostic env knobs (never set in a timed run):
#   - DLRM_HSTU_FP8_EC_DGRAD_SEGREDUCE_HIP_ROLE=0: Triton's MFMA roles plus
#     an LDS transpose (default 1);
#   - DLRM_HSTU_FP8_EC_DGRAD_SEGREDUCE_HIP_HIPCC;
#   - DLRM_HSTU_FP8_EC_DGRAD_SEGREDUCE_HIP_CACHE.
apply_env_bootstrap.DLRM_HSTU_FP8_EC_DGRAD_SEGREDUCE_HIP = True
# -----------------------------------------------------------------------------
# IX: Indexed-X preprocessor L1 (DECLARED fp32
# REDUCTION-ORDER NUMERICS CLASS; no precision change). Code default OFF; the
# binding below turns it ON; a pre-set env var wins over gin (_bind_bool).
# Files: ops/ec_indexed_l1.py and ops/triton/triton_ec_indexed_l1.py; hooks in
# dlrm_v4/train/ec_bf16_output.py, dlrm_v4/train/utils.py,
# ops/fused_linear_norm.py, ops/preproc_fp8_l2.py and
# ops/preproc_grouped_tail.py. The kernels are prebuilt and self-checked before
# RUN_START by dlrm_v4/train/blas_warmup.py (no TSPEC row needed).
#   WHAT: the first Linear of the content (item member, K=512) and additional
#   (cat member = artist|album interleaved, K=1024) MLPs reads its input rows
#   through the EC index from the bf16 unique-row table U instead of from the
#   expanded EC output. The one eligible grouped EC call issues stride-0
#   placeholders for these two members, so the EC expand and its [M,512] /
#   [M,1024] bf16 outputs are not written. The PREPROC_L2 FP8 head computes
#   h = X W1^T + b1 with one Triton GEMM whose A rows are gathered by the
#   index (_ecix_fwd) and saves U and the index instead of X. dW1 is summed
#   over ALL M tokens, each token's own dh row times its own gathered row, by a
#   split-K Triton kernel over token ranges plus a fixed-order fp32 reduce
#   (_ecix_wgrad + _ecix_wgrad_reduce). dX = dh W1 is unchanged; with E-X2b
#   armed it leaves through the EC dh ports. Every MAC of the unfused
#   GEMMs is still computed; nothing is pre-summed over tokens that share a
#   unique row, and nothing is reused across tokens, samples or steps.
#   NEEDS: PREPROC_L2 with the grouped tail and FP8_MLPS covering both
#   MLPs, EC_CAT_FUSE with the 2-key cat group, ec_merge_uih_candidate,
#   fuse_linear_norm, fuse_ln_residual, bf16 training, the grouped EC backward
#   and a ROCm build. E-X2b is optional: IX works with it on or off.
#   WARM-UP: during PREPROC_L2's BF16 warm-up calls
#   (DLRM_HSTU_FP8_BWD_WARMUP_CALLS) the grouped tail rebuilds the exact
#   X (identity backward to the placeholder) and runs the unfused pair
#   0. That rebuilt X carries no E-X2b dh port, so with E-X2b armed those
#   steps reduce through the unfused grouped EC backward: EC_REDUCE_FUSED's
#   "DLRMV4 armed OK: ec reduce fused" prints once per rank, with that rank's
#   step-1 U, before "armed OK: [ec-indexed-l1] fwd". From the first FP8-head
#   call on, the indexed path and the E-X2b ports run.
#   NUMERICS: NOT bit-identical; DECLARED fp32 reduction-order class.
#   - h: raw-bit equal to the unfused GEMM except where its stream-K schedule
#     splits K (a few near-zero outputs differ by bf16 ulps).
#   - dW1: fp32 summation order (token-range split-K + fixed-order reduce).
#   - dX, dU, db1 and every other gradient: unchanged wherever h is unchanged.
#   - Warm-up calls, rebuilds and declines: the unfused arithmetic bit for bit.
#   - The new kernels use no atomics; they are deterministic run to run.
#   - Operands stay bf16 with fp32 accumulation: the MLPerf precision log is
#     unchanged.
#   FALLBACKS: eval, no_grad, tracing, saved-tensor hooks (activation
#   checkpointing), a non-eligible grouped EC call, a non-FP8 head or a second
#   consumer of a member: the exact X is rebuilt (or never replaced) and the
#   unfused pair 0 runs. A failed first-use invariant or a failed pre-RUN_START
#   prebuild latches IX off for the process ("FAILED CLOSED").
#   ARMED (every rank, once, tagged "[rank N]"):
#     "armed OK: [ec-indexed-l1] fwd"
#     "armed OK: [ec-indexed-l1] wgrad"
#     "[ec-indexed-l1] invariants OK"
#     "[ec-indexed-l1] pre-run_start prebuild OK" (with BLAS_WARMUP on)
#   Info (expected): "[ec-indexed-l1] ec placeholders issued",
#   "[ec-indexed-l1] X rebuilt at _run_head" (warm-up calls).
#   Must be ABSENT:
#     "[ec-indexed-l1] INVARIANT"
#     "[ec-indexed-l1] FAILED CLOSED"
#     any "[ec-indexed-l1]" line containing "declined"
#     "placeholder issued but not consumed"
#     "DLRM_HSTU_FP8_EC_INDEXED_L1=1 IGNORED"
#   Opt out (kill switch): DLRM_HSTU_FP8_EC_INDEXED_L1=0.
apply_env_bootstrap.DLRM_HSTU_FP8_EC_INDEXED_L1 = True
# -----------------------------------------------------------------------------
# Diagnostic env knobs for IX (not set in production):
#   DLRM_HSTU_FP8_EC_INDEXED_L1_CHECK=1 (env only; unset = off; no gin binding).
#   For the first 2 indexed forwards and the first 2 indexed wgrads per member
#   it rebuilds X, runs the unfused GEMM on it and logs the element
#   differences ("[ec-indexed-l1] check fwd" / "[ec-indexed-l1] check wgrad").
#   Log only: it never changes a result and never raises. It costs a transient
#   X and host syncs, so never set it in a timed or production run.
#
# -----------------------------------------------------------------------------
# IX wgrad index order: IX's split-K wgrad loads the next block's EC
# indices AFTER the current block's dot (no precision change, bitwise
# identical P and dW1). Code default OFF; the
# binding below turns it ON; a pre-set env var wins over gin (_bind_bool).
# Files: ops/triton/triton_ec_indexed_l1.py (wgrad_idx_after_dot(), read once
# per process at the first wgrad or prebuild; dlrm_v4/train/_env_bootstrap.py).
# It acts only on IX's indexed wgrad: with IX off, declined or latched off,
# nothing here runs.
#   WHAT: ON launches `_ecix_wgrad`, whose token loop loads block it+1's
#   indices after tl.dot of block it; the software pipeliner then schedules
#   the next block's gathered U rows earlier in the loop body. OFF launches
#   `_ecix_wgrad_idxpf`: block it+1's indices loaded one iteration ahead,
#   before block it's gather (IDXPF=1). Same values, same tl.dot sequence,
#   same tail.
#   NUMERICS: BIT-IDENTICAL (P partials and dW1); the forward, the reduce
#   and every other gradient are untouched.
#   TSPEC / specialization: `_ecix_wgrad`'s L1 specialization key and its
#   TSPEC row identity (module, qualname, key) are the same in both settings
#   (same parameters, constexprs, launch options); the TSPEC replay compiles
#   the row from the current source before RUN_START. OFF compiles the
#   separate kernel `_ecix_wgrad_idxpf` (same parameter list and
#   specialization class) in IX's prebuild.
#   ARMED: no new loud line (INFO log "[ec-indexed-l1] wgrad loop order: ...",
#   once per process); IX's "armed OK: [ec-indexed-l1] wgrad" as before.
#   Opt out (kill switch): DLRM_HSTU_FP8_EC_IX_WGRAD_IDX_AFTER_DOT=0 (the
#   IDXPF order). Only "1"/"true"/"on"/"yes" arm it; read once per process.
apply_env_bootstrap.DLRM_HSTU_FP8_EC_IX_WGRAD_IDX_AFTER_DOT = True
# -----------------------------------------------------------------------------
# IX-FP8F: Indexed-X preprocessor L1 forward on FP8 operands
# (DECLARED PRECISION CHANGE: fp8 e4m3, TRAIN ONLY; eval stays bf16). Code
# default OFF; the binding below turns it ON; a pre-set env var wins over gin
# (_bind_bool). Files: ops/triton/triton_ec_indexed_l1_fp8.py (kernels, gate,
# prebuild); hooks in ops/ec_indexed_l1.py, ops/preproc_fp8_l2.py,
# dlrm_v4/train/blas_warmup.py and dlrm_v4/train/_env_bootstrap.py. It acts
# only on IX's indexed path: with IX off, declined or latched off,
# nothing here runs.
#   WHAT: in a training step, IX's indexed L1 forward (content: item member,
#   K=512; additional: cat member artist|album, K=1024) reads e4m3 operands
#   instead of bf16. U8 = e4m3 copy of the bf16 EC unique-row table U with one
#   power-of-two scale per row (2^E, E = ceil(log2(amax_row / 448))).
#   W1_8 = e4m3 copy of W1 with a fresh per-tensor amax/448 scale SW every
#   step (PREPROC_L2's quantize_weight arithmetic; no history). h = b1 + sum over
#   the member's gathered rows of 2^E * SW * (U8 row . W1_8 slice), fp32
#   accumulate, bf16 out (_ecix_fwd8). Every token's L1 row is still computed
#   from that token's own gathered row; nothing is reused across tokens,
#   samples or steps (no computation reduction).
#   BACKWARD (consistent, the default): the gradient of the quantized forward.
#   The FP8 head saves Ud = bf16(U8 * 2^E) (exact) for IX's unchanged wgrad
#   and uses Wd = bf16(W1_8 * SW) as its saved W1, for dX = dh Wd and as
#   E-X2b's bound W1. The bf16 backward kernels are unchanged.
#   EVAL: bf16 (eval runs under no_grad, where IX issues no
#   placeholder). The FP8 forward is train-only.
#   NUMERICS: NOT bit-identical (e4m3 U8 / W1_8 operands in the training
#   forward; dW1 and dX on the dequantized operands). MLPerf: fp8 is allowed
#   in CLOSED; lowest_numerical_precision_in_linear is already fp8 (PREPROC_L2,
#   the FP8 HSTU GEMMs), so no logged precision key changes.
#   NEEDS: IX armed (and with it PREPROC_L2); a ROCm gfx950 build.
#   FALLBACKS: an input outside the prebuilt FP8 class takes IX's bf16
#   forward for that call (one "declined" line per member); a raising FP8
#   kernel or a failed pre-RUN_START prebuild latches IX-FP8F off for the
#   process ("FAILED CLOSED"). IX itself stays on in both cases.
#   ARMED (every rank, once, tagged "[rank N]"):
#     "armed OK: [ec-indexed-l1-fp8] fwd (item)"
#     "armed OK: [ec-indexed-l1-fp8] fwd (cat)"
#     "[ec-indexed-l1-fp8] pre-run_start prebuild OK" (with BLAS_WARMUP on)
#     "[ec-indexed-l1-fp8] eval pass: bf16 Indexed-X (FP8 forward is train-only)"
#     (at the first eval forward)
#   Must be ABSENT:
#     "[ec-indexed-l1-fp8] FAILED CLOSED"
#     any "[ec-indexed-l1-fp8]" line containing "declin"
#     "DLRM_HSTU_FP8_EC_INDEXED_L1_FP8=1 IGNORED"
#   Backward sub-knob DLRM_HSTU_FP8_EC_INDEXED_L1_FP8_BWD (env only, no gin
#   binding; unset = consistent): "ste" is a diagnostic straight-through
#   backward (wgrad / dgrad on the bf16 U / W1); with the knob on, any other
#   value fails at startup. Never set it in a timed or production run.
#   Opt out (kill switch): DLRM_HSTU_FP8_EC_INDEXED_L1_FP8=0.
apply_env_bootstrap.DLRM_HSTU_FP8_EC_INDEXED_L1_FP8 = True
# -----------------------------------------------------------------------------
# VF3P (DECLARED NUMERICS CLASS). Same contract as the knobs
# above: the code default when the binding is absent is OFF, the env var
# of the same name is the kill switch, and a pre-set env var wins over gin.
#
# VF3P: reassociated silu/grad-coefficient chain of the C8 attention
#     backward (on top of the VALU-diet knobs and BWD_ATTN_V2; the VALU token "vf3p" of
#     ops/flydsl/hstu_bwd_dkdv.py, added by ops/flydsl/hstu_flydsl_mha.py
#     _bwd_vf3p_tokens to the effective DLRM_HSTU_FP8_BWD_VALU token set of
#     the dq-split calls). Code default OFF; the binding below turns it ON.
#     WHAT: the per-element act chain of bwd_dkdv (sigmoid, the silu that
#     feeds the e4m3 P operand, the grad coefficient that forms dS) folds its
#     uniform factors (alpha, the Q/K/V dequantization scale, 1/N) into the
#     exp2 argument, the 1 + exp term and the reciprocal, so the reciprocal
#     returns the scaled sigmoid directly and silu, the scaled 1 - sigmoid and
#     the grad coefficient follow from it by fused multiply-adds. Fewer packed
#     f32 operations per score-element pair; the same exp2 and reciprocal
#     count, the same e4m3 casts at the same default cast scales, the same
#     MFMAs, tiles and accumulation order. The uniform constants are computed
#     in the kernel from its runtime scales (no compile per scale) and read as
#     two packed wave-uniform pairs. Applies only to dq-split calls whose
#     effective VALU set has "ilp" (DLRM_HSTU_FP8_BWD_VALU with the reuse_pk epilogue) and
#     none of vf, vf2, h16, vf3, vf3s; any other dq-split call keeps the
#     default chain and logs one "ignored" line per reason. The token is part
#     of the bwd_dkdv compile key, so it builds its own kernel variant.
#     GUARD: an armed call takes vf3p only when its Q/K/V dequantization
#     scale satisfies 0 < qkv_scale <= 0.25 (one host float compare in the
#     launcher, _VF3P_QKV_SCALE_MAX); any other call keeps the default chain
#     and logs one "ignored" line. The bound keeps unreachable the scale
#     regions in which the reassociated chain can differ from the default by
#     more than one e4m3 code step or in NaN behaviour.
#     WHY: the act chain is VALU issue inside the bwd_dkdv loop that the MFMA
#     work does not hide. A shorter chain would have to move a factor into the
#     e4m3 cast scale, which re-rounds the bytes (the vf2 class, not enabled
#     here).
#     IMPACT: shortens bwd_dkdv on the dq-split calls; no other kernel
#     changes. Independent of DKDV_E5M2: the extra token leaves the DKDV_E5M2
#     gate (VALU nobr,msat and MSPLIT_SCHED mc) unchanged, so DKDV_E5M2 arms
#     with this on or off.
#     NUMERICS (declared): ulp-level f32
#     REASSOCIATION, no format or scale change (same e4m3 grid and cast
#     scales, same GEMM operand formats): the f32 values are formed in a
#     different operation order, so a tiny fraction of the e4m3 silu/dS bytes
#     may differ by one code step from the default chain, and dq/dk/dv (with
#     DKDV_E5M2 on: the e5m2 dV|dK bytes and the v|k column sums) differ only
#     through those bytes. dS zeros of strongly negative scores may carry the
#     opposite sign of zero (value-identical; not visible in dq/dk/dv). A
#     DECLARED operation-order change, same class as the declared fp32-order
#     knobs (WLN_DXSUM_V3, the DKDV_E5M2 column sums). Not bit-identical to
#     the default chain.
#     ARMED (every rank, once): "env bootstrap: DLRM_HSTU_FP8_BWD_VF3P=1" (or,
#     env-armed, "env bootstrap: honoring pre-set DLRM_HSTU_FP8_BWD_VF3P=1"),
#     "[hstu-attn] DLRM_HSTU_FP8_BWD_VF3P=1 armed: bwd_dkdv VALU token vf3p
#     added (valu=ilp,msat,nobr,rfl,undef,vf3p)", and the BWD_ATTN_V2 VALU line
#     then reads "[hstu-attn] bwd_dkdv VALU diet ARMED:
#     valu=ilp,msat,nobr,rfl,undef,vf3p". Must be ABSENT: "[hstu-attn]
#     DLRM_HSTU_FP8_BWD_VF3P=1 ignored". With the kill switch set
#     (DLRM_HSTU_FP8_BWD_VF3P=0): "env bootstrap: honoring pre-set
#     DLRM_HSTU_FP8_BWD_VF3P=0", no vf3p line, and the BWD_ATTN_V2 line reads
#     "valu=ilp,msat,nobr,rfl,undef".
#     Opt out (kill switch): DLRM_HSTU_FP8_BWD_VF3P=0 (the default chain).
#     A pre-set DLRM_HSTU_FP8_BWD_VALU is used verbatim; if it names vf3p itself, the token stays on, this switch
#     cannot remove it and the guard does not apply.
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_VF3P = True
# -----------------------------------------------------------------------------
# VF4: 6-op SiLU-backward chain of the C8 attention backward
#     (DECLARED PRECISION CHANGE). On top of VF3P.
#     Same contract as the knobs above: the binding below turns it ON; the
#     code default when the binding is absent is OFF, the env var of the same name is the kill switch, and a
#     pre-set env var wins over gin.
#   WHAT: the VALU token "vf4" of ops/flydsl/hstu_bwd_dkdv.py, added by
#     ops/flydsl/hstu_flydsl_mha.py _bwd_vf4_tokens to the effective
#     DLRM_HSTU_FP8_BWD_VALU token set of the dq-split calls that take vf3p.
#     The per-element act chain of bwd_dkdv drops vf3p's multiply by the
#     uniform alpha*qkv_scale: the silu that feeds the dv GEMM as its e4m3
#     operand is formed as silu/(alpha*qkv_scale), and the grad coefficient
#     that forms dS follows from it by fused multiply-adds. One packed f32
#     operation fewer per score-element pair; the same exp2 and reciprocal
#     count, the same MFMAs, tiles and accumulation order. The missing
#     factor moves into two uniform scales that the kernel computes once per
#     workgroup from its runtime Q/K/V dequantization scale: the e4m3 cast
#     scale of that silu operand is multiplied by the power of two
#     2^round(log2(alpha*qkv_scale)), and the dv epilogue (BF16, and the
#     DKDV_E5M2 e5m2 epilogue) multiplies by alpha*qkv_scale over that power
#     of two. The token is part of the bwd_dkdv compile key (one more kernel
#     variant); the scale is not, so one build serves every qkv_scale and the
#     FP8 first-use warmup builds it before RUN_START wherever it builds
#     the VF3P variant.
#   GUARD: an armed call takes vf4 only when its token set has vf3p (VF3P
#     armed and taken) and msat, on the f8b=all k128 path,
#     with VF3P's 0 < qkv_scale <= 0.25 and 2^-50 <= alpha*qkv_scale
#     <= 2^50 (host float compares in the launcher); any other call runs
#     without vf4 and logs one "ignored" line per reason.
#   WHY: the act chain is VALU issue inside the bwd_dkdv loop that the MFMA
#     work does not hide. Dropping one more multiply needs a factor in the
#     e4m3 cast scale, which re-rounds the silu bytes (the vf2 class that
#     VF3P does not enable).
#   IMPACT: shortens bwd_dkdv on the dq-split calls; no other kernel
#     changes. Independent of DKDV_E5M2: the extra token leaves the DKDV_E5M2
#     gate (VALU nobr,msat and MSPLIT_SCHED mc) unchanged.
#   NUMERICS (declared): NOT bit-identical to VF3P. The silu bytes are
#     re-rounded on an e4m3 grid shifted by the factor
#     alpha*qkv_scale/2^round(log2(alpha*qkv_scale)), which lies in
#     [2^-0.5, 2^0.5] and is undone exactly in f32 by the epilogue; dv (with
#     DKDV_E5M2 on: the e5m2 dV bytes and the v column sums) changes by one e4m3
#     re-rounding of the silu operand, and that operand saturates up to half
#     a binade earlier or later. dS keeps VF3P's cast scale and is formed
#     in a different f32 operation order: a tiny fraction of the e4m3 dS
#     bytes may differ by one code step, and dq/dk differ only through those
#     bytes (VF3P's class). Same formats and GEMM operand types.
#   ARMED (every rank, once): "env bootstrap: DLRM_HSTU_FP8_BWD_VF4=1" (or,
#     env-armed, "env bootstrap: honoring pre-set DLRM_HSTU_FP8_BWD_VF4=1"),
#     "[hstu-attn] DLRM_HSTU_FP8_BWD_VF4=1 armed: bwd_dkdv VALU token vf4
#     added (valu=ilp,msat,nobr,rfl,undef,vf3p,vf4); silu e4m3 cast scale
#     re-centred in the kernel ...", and the BWD_ATTN_V2 VALU line then reads
#     "[hstu-attn] bwd_dkdv VALU diet ARMED:
#     valu=ilp,msat,nobr,rfl,undef,vf3p,vf4". Must be ABSENT: "[hstu-attn]
#     DLRM_HSTU_FP8_BWD_VF4=1 ignored". Off (the binding below, or the kill
#     switch): "env bootstrap: DLRM_HSTU_FP8_BWD_VF4=0" (or "honoring
#     pre-set DLRM_HSTU_FP8_BWD_VF4=0"), no vf4 line, and the BWD_ATTN_V2 line
#     reads "valu=ilp,msat,nobr,rfl,undef,vf3p".
#   Arm: DLRM_HSTU_FP8_BWD_VF4=1 (the binding below). Opt out (kill switch):
#     DLRM_HSTU_FP8_BWD_VF4=0 (VF3P's chain). A pre-set
#     DLRM_HSTU_FP8_BWD_VALU that names vf4 arms it too (the guard still
#     applies); this switch cannot remove it.
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_VF4 = True
# -----------------------------------------------------------------------------
# DSC_K: C8 attention-backward dS cast headroom (DECLARED NUMERICS CHANGE).
# Same contract as the knobs above: the env var of the same name wins over
# gin, and removing the binding (or DLRM_HSTU_FP8_BWD_FULL_DSC_K=-3) restores
# the default scale.
#   WHAT: the full-FP8 attention backward casts dS to e4m3 at the scale
#   2**(ceil(log2 N) + K) (ops/flydsl/hstu_flydsl_mha.py _sc("DSC", "-3"),
#   mu2_dsc), with the hardware +-448 saturation. K = -5 instead of the
#   default -3 quarters that scale; the dk epilogue and the dq-split scale
#   divide by the same mu2_dsc, so the gradients are unchanged in exact
#   arithmetic. Nothing is skipped; same kernels, a different bwd_dkdv
#   compile-time constant (one kernel variant).
#   WHY: the per-(sequence, head, 32-token) dO block scale lifts each
#   sequence's last (target) row to the top of the e4m3 range, and on late
#   layers that row's dS exceeds 448 at the default scale and is clamped
#   (a coherent bias on the target rows that carry the loss gradient). More
#   headroom removes the clamp.
#   PROVENANCE (no offline analysis of training data): K = -5 is
#   derived synthetically. The pre-cast value is y = 2^K * beta_N * SiLU'(x) * (w . v),
#   beta_N = 2^ceil(log2 N)/N in [1, 2); the dO block scale and the qkv scale cancel,
#   SiLU' <= 1.0998, so only the absolute V scale and beta_N move the clamp-free K.
#   At init V = LN(x) W_v is near-Gaussian (sigma 0.632); a fixed-seed synthetic
#   analysis (semi-analytic, checked against Monte Carlo, no training-data
#   statistic) gives the 95th-percentile clamp-free K = -4/-5/-5 at N = 4096/2896/2049,
#   so the worst case over the config range N in (2048, 4096] is -5.
#   NUMERICS: NOT bit-identical. Target-row dS is no longer clamped; dS
#   values below the new e4m3 grid floor round to zero, which matters only
#   for the small rows that share the target's dO block (the target's dO
#   dominates their block scale); rows of every other block see only a
#   small flush-to-zero change. The dq/dk/dv
#   formats and every other scale are unchanged.
#   ARMED (every rank, once): "env bootstrap: DLRM_HSTU_FP8_BWD_FULL_DSC_K=-5"
#   (or "honoring pre-set ..."), and the backward line "[hstu-attn] FULL-FP8
#   backward ARMED: f8b=all mu2=k128 ... dsc=2^(ceil(log2 N) - 5) ..." (dsc=2^7
#   for N in (2048, 4096]; 2^9 with the default).
#   Opt out (kill switch): DLRM_HSTU_FP8_BWD_FULL_DSC_K=-3.
apply_env_bootstrap.DLRM_HSTU_FP8_BWD_FULL_DSC_K = -5
# -----------------------------------------------------------------------------
# MXFP6 forward K=512 trio: U, V/Q/K and the targets-only V/K (DECLARED
# PRECISION CHANGE). Absent = off in code; bound True below. ops/hip/mx6_fwd.py
# (adapter, call-site arms in ops/triton/triton_hstu_preprocess_and_attention.py),
# the MX6 LN producer ops/hip/ln_store_mx6.py, ops/hip/mx6_ref.py (torch
# reference of the MX6 activation bytes, checks only) and the MXFP6 K=512 GEMMs
# (module names in mx6_fwd.py).
#   WHAT: on training forwards that take the LN store_t (the fp8t uvqk / vk
#   wgrad planned with STORE_T, STORE_T_V2 and the step-tiled xT of XT_TILED,
#   all armed above) and whose e4m3 V/Q/K (targets: V/K) pack is handed to the
#   backward (SAVE_UVQK, EARLY_RELEASE_UVQK, the layer mask, SAVE_TARGETS_VK),
#   the GEMM operands change from e4m3 with one per-tensor scale to MXFP6:
#   - activations: E2M3 codes with one E8M0 scale per (row, 32 K), quantized
#     (ceil exponent rule, RNE) from the same pre-scaled y = LN(x) * inv_scale
#     the e4m3 path quantizes. The LN producer writes them pre-tiled in the
#     GEMM's LDS image order, together with the fp32 mean / rstd and the
#     token-major e4m3 xT8 the store_t writes (same bytes, same allocator);
#   - weights: E2M3 with one E8M0 scale per 32 x 32 block of W / scale_b,
#     cached per weight and refreshed when weight._version moves;
#   - V/Q/K (N=1536) and the targets-only V/K (N=1024) run on K=512 kernels of
#     v_mfma_scale_f32_16x16x128_f8f6f4 (E2M3 x E2M3) with the shipped
#     per-tensor scales, output-scale fold, scaled bias and saturating e4m3
#     epilogue; U (N=512, bf16 + bias) too once its kernel is built; until
#     then the producer also writes the e4m3 x8 and U stays on the shipped
#     FP8 GEMM.
#   Every K product is still computed. Not engaged (shipped FP8 path): the
#   calibration window, no-grad / eval forwards (eval keeps the FP8 recipe: a
#   declared train / eval asymmetry), and any call
#   outside the coverage above (a DECLINED line). A retained-graph second
#   backward rebuilds the pack through MX6, as the forward did.
#   NUMERICS: NOT bit-identical (DECLARED PRECISION CHANGE): the U / V/Q/K /
#   V/K GEMM operands are E2M3 with E8M0 block scales instead of e4m3 with one
#   per-tensor scale; the outputs keep their dtype, shape and scale. Nothing
#   else changes: mean / rstd / xT8 are the store_t's bytes, the backward
#   GEMMs, the wgrad operands and the attention kernels are unchanged.
#   GUARDS: the first producer call per device also runs the shipped store_t
#   (mean / rstd / xT8 / x8 must be its bytes), checks x6 / xs on row slices
#   (head, 2^31-byte offsets, last tile) against the torch reference of the
#   exact fp32 y, and reruns the producer's other kernel instantiation (x8
#   written or not) into fresh poisoned buffers (every output byte equal);
#   any mismatch latches the producer off (shipped LN). The first call per
#   device, site (U, VQK, VK) and weight keeps the MX6 output only if it has
#   no non-finite value and, on row windows (the first 65,536 rows, the rows
#   around each 2^31-element / -byte output offset, the last tile), matches
#   the shipped FP8 GEMM with rel L2 <= 0.25, <= 0.5 in every 128-row tile
#   and a slope <MX6, FP8> / <FP8, FP8> within 0.03 of 1 (a gross-error
#   bound: the two formats differ by design); a rejection or any exception of
#   that call latches the site to the shipped FP8 path for the process and
#   the call returns the FP8 output.
#   COLD START: with DLRM_HSTU_FP8_PREBUILD=1 (gin default),
#   triton_fp8.prebuild_extensions imports the producer and GEMM modules, runs
#   their prebuild, and self-checks before RUN_START: the producer on zeros
#   and on a deterministic ramp, both kernel instantiations, every output
#   byte against the torch reference, then the GEMMs on zeros. Synthetic data
#   in plain torch buffers: no data, no RNG, no model or cache state and no
#   TM_NONEXP pool block (the pool is first mapped by its own prewarm). A
#   failed prebuild latches every MX6 site off for the process.
#   ARMED (every rank): before RUN_START "[ln-store-mx6] prebuilt in" and
#   "[mx6-fwd] prebuilt: producer=... [impl=... src=...@<sha>] gemm=...
#   N=1536,1024,512 ... OK" (N=1536,1024 without the U kernel); at the first frozen-scale training step "ARMED
#   wgrad_ck xt_tiled producer ln_store_mx6 on cuda:<i>", "[mx6-fwd] producer
#   check on cuda:<i>: ... -> ok", "[mx6-fwd] guard VQK on cuda:<i>: ... ->
#   armed" (once per uvqk layer weight), "[mx6-fwd] guard VK on cuda:<i>: ...
#   -> armed" ("[mx6-fwd] guard U ... -> armed" once U runs MXFP6) and, once
#   every site is decided, "[mx6-fwd] ARMED on cuda:<i> (...): producer=...
#   gemm=... sites U:N=512:... VQK:N=1536:mx6 VK:N=1024:mx6"; at exit
#   "[mx6-fwd] counters at exit (pid ...): planned_uvqk=<n> planned_vk=<n>
#   served_U=... served_VQK=<n> served_VK=<n> ... declined=0" (an armed run
#   serves every planned call: served_VQK = planned_uvqk, served_VK =
#   planned_vk).
#   Must be ABSENT: "[mx6-fwd] DECLINED", "-> REJECTED", "[mx6-fwd] prebuild
#   DECLINED", "[mx6-fwd] ERROR", "[ln-store-mx6] prebuild FAILED", and
#   TM_NONEXP_TILED's "pool created lazily". A frozen-scale step before the
#   fp8t wgrad publishes its dz scale (4 warm-up backward calls) would
#   decline with "uvqk:store_t". Expected: "[mx6-fwd] not engaged
#   (expected):" for the calibration window and eval forwards.
#   Armed by the binding below; env
#   DLRM_HSTU_FP8_FWD_MXFP6=0 is the kill switch (a pre-set env value wins over
#   this binding). DLRM_HSTU_FP8_FWD_MXFP6_STRICT=1 (env only) turns a decline, a
#   guard rejection or a not-ready prebuild into an error;
#   DLRM_HSTU_FP8_FWD_MXFP6_SHADOW_AUDIT=N (env only) audits every N-th weight
#   shadow hit.
#   Diagnostic / test env knobs (env only by design, never set in production,
#   no gin binding): DLRM_HSTU_FP8_FWD_MXFP6_STRICT=1 (fail closed: raise
#   instead of falling back to the shipped FP8 path; never changes a value),
#   DLRM_HSTU_FP8_FWD_MXFP6_SHADOW_AUDIT=N (weight-shadow audit, read only),
#   DLRM_HSTU_FP8_FWD_MXFP6_GEMM_MODULE / _PRODUCER_MODULE (module-name
#   overrides for tests). Unset = the behaviour described above.
#   Kill switch: env DLRM_HSTU_FP8_FWD_MXFP6=0 (a pre-set env value wins over this binding).
apply_env_bootstrap.DLRM_HSTU_FP8_FWD_MXFP6 = True
#
# -----------------------------------------------------------------------------
# Same contract as
# the knobs above: each is gin-guarded (the bindings below turn it
# on, the code default when a binding is absent is OFF), every switch has an
# env kill switch of the same name, and a pre-set env var wins over gin. All
# three are SCHEDULING changes with BITWISE outputs and gradients:
# DD_OWN_H2D and PIPE_STREAM_PRIO_MN keep the same kernels, inputs and
# per-stream order; ACTION_PREFILL moves the action-branch forward earlier
# on the main stream and adds one tiny kernel (an int add of the UIH and
# target lengths) plus a range marker.
# How ACTION_PREFILL composes with PREPROC_GROUPED_TAIL is stated under it
# below. With the other knobs:
#   - ACTION_ENC_FUSE: the prefill's ActionEncoder call also passes
#     bf16_consumer=True (its only consumer is the action MLP's first
#     Linear under the same bf16 autocast), so the fused action encoder
#     still runs with ACTION_PREFILL on: "DLRMV4 armed OK: glue action_enc ACTIVE"
#     must stay present on every rank. GLUE_FOLD4's ACTSUM part refines
#     that encoder's backward, which the prefill's bridge node runs in
#     place: "DLRMV4 armed OK: glue_fold4 actsum ACTIVE" stays present too.
#   - PREPROC_L2: the action MLP stays BF16. The prefilled head joins
#     PREPROC_L2's FP8 tail node as its BF16 entry, whose plan slot carries the
#     prefilled last-pair Linear (ops/preproc_fp8_l2.py prefilled_slot);
#     the content and additional MLPs keep their FP8 plans, and the choice
#     of LayerNorm(512) backward (stacked or per MLP) is unchanged. With
#     PREPROC_L2 off, PREPROC_GROUPED_TAIL_BWD groups the prefilled head's
#     LayerNorm(512) backward with the other two heads (same saved tensors
#     per pair).
#   - IDIST_AFTER_PREV_FWD (1 node): its host poll runs first, then
#     the deferred next-batch input dist waits on its own H2D event
#     (DD_OWN_H2D).
#
# Action-branch prefill (modules/action_prefill.py). A SCHEDULING change.
#     WHAT: ContextualPreprocessor's action branch (target/seq/uih offsets,
#     ActionEncoder, action-MLP pair 1 = Linear 24->256 + SwishLN, and the
#     last pair's casts + addmm 256->512) reads no embedding. DlrmHSTU.
#     preprocess now issues it on the main stream right before its first touch
#     of the EC LazyAwaitable -- the point where the main stream starts
#     waiting on the forward embedding all-to-all -- so it runs in that idle
#     window (largest on the slowest rank at 2 and 4 nodes) instead of after
#     it. The preprocessor consumes it at the branch's original position;
#     without PREPROC_GROUPED_TAIL pair 2's norm (+ fuse_ln_residual epilogue) runs there. The
#     prefill graph is re-attached by a bridge node whose backward runs it
#     reentrantly, so backward kernels, their order and AccumulateGrad/DDP-hook
#     order are unchanged.
#     WITH PREPROC_GROUPED_TAIL: the
#     prefilled head (pair 1) joins the group (GroupedTail.head_prefilled) and
#     the grouped node reuses the prefilled last-pair Linear, so only the
#     grouped LayerNorm launch stays at the end of the MLP section. If the
#     group would decline AT the action MLP, the prefill falls back to the original
#     order (FALLBACK line "grouped tail declines the action MLP"): a declining
#     group completes its queued pairs before the action head, and only the
#     original order keeps the backward order then. A decline at any other
#     MLP keeps the prefill (the ACTIVE line reports grouped tail=DECLINED).
#     PREPROC_GROUPED_TAIL off: the prefill finishes on the per-MLP path
#     above. ACTION_PREFILL off: PREPROC_GROUPED_TAIL runs unchanged.
#     NUMERICS: BITWISE (same ops, operands, autocast state and GEMM pins;
#     no RNG, no host sync). Training with grad only; eval/inference/fx trace
#     run the original order, as does any input mismatch (FALLBACK line).
#     ARMED: "[action-prefill] ACTIVE" (every rank, first consumed prefill; it
#     reports pair-2 Linear prefill=on/off/RECOMPUTED, grouped tail=yes/
#     DECLINED/n/a and rank=).
#     Must be ABSENT: "[action-prefill] FALLBACK", "[action-prefill] not
#     issued".
#     Opt out: DLRM_HSTU_FP8_ACTION_PREFILL=0 (both parts);
#     DLRM_HSTU_FP8_ACTION_PREFILL_L2=0 (part A only; its sub-switch below).
#   SUB-SWITCH DLRM_HSTU_FP8_ACTION_PREFILL_L2 (modules/action_prefill.py
#     l2_enabled, read per prefill). When the action MLP runs its fused Linear+norm path,
#     the prefill also runs the last pair's two bf16 casts + addmm (256->512)
#     early; =0 runs them at the branch's original position (part A only).
#     DEFAULT: True = "1", the code default (absent = on), so the binding
#     changes nothing; inert while ACTION_PREFILL is off.
#     NUMERICS: BITWISE either way (same ops and operands).
#     ARMED: "env bootstrap: DLRM_HSTU_FP8_ACTION_PREFILL_L2=1" and the
#     ACTIVE line's "pair-2 Linear prefill=on" (=0: "prefill=off").
#     Kill switch (env wins): DLRM_HSTU_FP8_ACTION_PREFILL_L2=0.
apply_env_bootstrap.DLRM_HSTU_FP8_ACTION_PREFILL = True
apply_env_bootstrap.DLRM_HSTU_FP8_ACTION_PREFILL_L2 = True
#
# Next-batch input dist waits only on its own batch's H2D
#     (dlrm_v4/train/dd_own_h2d.py). A SCHEDULING change.
#     WHAT: with TP_DEFER_INPUT_DIST, progress() enqueues batch N+2's H2D
#     before the deferred start_sparse_data_dist(N+1). torchrec's
#     start_sparse_data_dist begins with data_dist.wait_stream(memcpy), which
#     then also waits for N+2's copy that N+1 never reads, and the
#     high-priority data-dist queue holds that blocked wait while the forward
#     runs. copy_batch_to_gpu now records an event right behind each batch's
#     own copies; the deferred input dist waits on that event (and calls
#     record_stream as _wait_for_batch does). The inline (non-deferred) path
#     keeps the stock wait.
#     NUMERICS: BITWISE (same kernels, inputs and per-stream order; only the
#     false cross-batch dependency is removed).
#     ARMED: "armed OK: dd_own_h2d" (every rank, one line per pipeline, tagged
#     rank= and pipeline#).
#     Opt out: DLRM_HSTU_FP8_DD_OWN_H2D=0.
apply_env_bootstrap.DLRM_HSTU_FP8_DD_OWN_H2D = True
#
# Normal-priority train-pipeline side streams at 2+ nodes
#     (host_sync_free.train_pipe_stream_priority). A SCHEDULING change.
#     WHAT: torchrec creates the pipeline's memcpy and data-dist streams at
#     high priority (-1). With DD_OWN_H2D the deferred next-batch input dist no
#     longer waits on the following batch's H2D and has ~a step of slack, so
#     its EC dedup / bucketize / permute kernels gain nothing from pre-empting
#     the forward; at high priority they slow the critical rank's main-stream
#     kernels. When the job spans more than one node the TRAIN pipeline's
#     pair runs at normal priority (0); the allocator pre-grow creates that
#     pair at the same priority so its pools are kept. 1-node runs and the
#     eval pipeline keep -1 (byte-identical there).
#     PLACEMENT: at priority 0 HIP binds the pair into the NORMAL hardware-
#     queue pool (GPU_MAX_HW_QUEUES per priority, least-referenced reuse) that
#     the main stream also uses. Before RUN_START a synthetic one-CU spin probe
#     (host_sync_free.shares_hw_queue) checks the pair runs beside main; if
#     either side stream shares main's queue the item falls back to -1 and
#     logs "DLRMV4 multi-node side-stream priority fallback".
#     NUMERICS: BITWISE (same kernels, inputs and per-stream order; only the
#     dispatch priority / hardware queue of the two side streams changes).
#     ARMED (2+ nodes): "armed OK: multi-node train pipeline stream priority 0
#     (DLRM_HSTU_FP8_PIPE_STREAM_PRIO_MN)", "kept pre-grown pair memcpy prio=0
#     data_dist prio=0 (train)" and "DLRMV4 multi-node side-stream priority
#     placement check: train memcpy/data_dist run beside main". At 1 node the
#     train pipeline logs once per process "DLRMV4 multi-node side-stream
#     priority inactive: single node, train pipeline keeps torchrec priority
#     -1" (log only). "DLRMV4 multi-node side-stream priority fallback ...
#     (memcpy shares the main stream's hardware queue)" on a few ranks is the
#     guard working: those ranks keep -1. Must be ABSENT (2+ nodes):
#     "placement unverified", "no pre-RUN_START placement probe", "DLRMV4
#     hw-queue probe skipped", "DLRMV4 multi-node side-stream priority
#     inactive" (the 1-node line). The
#     probe runs only before RUN_START, on the pre-grown pair (allocator pre-grow); a
#     train pair that is not that adopted pair (pre-grow off), or a probe that
#     cannot run, makes the item fall back to -1 (fail closed).
#     Opt out: DLRM_HSTU_FP8_PIPE_STREAM_PRIO_MN=-1 (torchrec's own priority;
#     at 2+ nodes the train pipeline then logs "DLRMV4 multi-node side-stream
#     priority off", as fallback ranks do; values other than -1/0 are
#     refused); DLRM_HSTU_FP8_PIPE_STREAM_PRIO=<p> overrides every pipeline
#     (testing only, unguarded).
apply_env_bootstrap.DLRM_HSTU_FP8_PIPE_STREAM_PRIO_MN = 0
#
# Diagnostic env knobs for the sparse-chain removals and the scheduling
# knobs above (not set in production).
#   Env only by design (no gin binding): a debug or VERIFY run sets one
#   explicitly; a production or timed run sets none. Unset = the default
#   behaviour. All their switches, sub-switches included, are bound
#   above.
#   DLRM_HSTU_FP8_B1PP_VERIFY=N, sparse-chain parts (b)-(d) (dlrm_v4/b1pp.py): the first N
#     engaged calls of each part (per rank) also run the stock path and
#     compare (host syncs); a mismatch RAISES ("VERIFY <part> MISMATCH").
#     Bounds on malformed offsets: outcome class only. Unset or 0 = off.
#   DLRM_HSTU_FP8_SEQ_A2A_FUSED_VERIFY=N, sparse-chain part (a) (dlrm_v4/
#     seq_a2a_rowperm.py): the first N fused send and receive calls,
#     forward and backward, are compared with the stock math (a host sync
#     per call; "... verify fwd: bitwise=True"); a mismatch logs
#     "bitwise=False", uses the stock result and turns that fused part off.
#     Unset or empty = the value of
#     DLRM_HSTU_FP8_SEQ_A2A_ROWPERM_VERIFY (unset = 0); a bound "0" would
#     cut that fallback, one more reason it has no binding.
#   DLRM_HSTU_FP8_PIPE_STREAM_PRIO=-1|0, read by the PIPE_STREAM_PRIO_MN code
#     (host_sync_free.py pipe_stream_priority): an UNGUARDED testing override of
#     the memcpy / data-dist stream priority of EVERY pipeline (train and
#     eval, any node count, no placement probe). It wins over
#     PIPE_STREAM_PRIO_MN but is NOT its kill switch (that is
#     DLRM_HSTU_FP8_PIPE_STREAM_PRIO_MN=-1). Unset = torchrec's -1, or
#     PIPE_STREAM_PRIO_MN where it applies; other values are refused.
#   Read by the same code, but not knobs: NNODES, else SLURM_NNODES (set by
#     the launcher / Slurm; they decide the sparse-chain multi-node default
#     and PIPE_STREAM_PRIO_MN's scope), LOCAL_WORLD_SIZE (process-group fallback, only without
#     either), RANK and LOCAL_RANK (log tags), TRITON_INTERPRET (Triton's
#     CPU interpreter; unit tests only).
# -----------------------------------------------------------------------------
# B15T(L2): targets-only V/K projection on the step-tiled yT
# (BIT-IDENTICAL). Same contract
# as the knobs above: the binding below arms it (gin default ON); the code
# default when the binding is absent is OFF (only "1" arms it); a pre-set env
# var of the same name wins over gin, and DLRM_HSTU_FP8_FWD_K512_TILED_A=0 is
# the kill switch. Files: targets-only forward in ops/triton/
# triton_hstu_preprocess_and_attention.py, the store_y=False call of the
# BWD_STORE_T_V2 store_t v2 wrapper in ops/triton/triton_layer_norm.py, ops/triton/
# triton_fp8.scaled_mm_fp8_out_preq_tiled_a, the tiled-A entry of
# ops/hip/k512_fp8_gemm.cu. Not an FP8 math change.
#   WHAT: in the targets-only (last) HSTU layer the UVQK_STORE_T / BWD_STORE_T_V2 store_t
#   LayerNorm writes the e4m3 normed_x y [M, 512] and its token-major copy
#   yT for the fp8t V/K wgrad. y has one reader, the e4m3 V/K projection
#   [M,512] x [512,1024] (FWD_K512's GEMM): it is not saved for backward,
#   and the compact U/Q rows are normalized from x and mean/rstd. With this
#   knob that projection runs on the K512 library's tiled-A entry
#   (k512_2wg_kernel_tiled_a<1024>), which reads A from BWD_WGRAD_CK_XT_TILED's
#   step-tiled yT [ceil(M/128), 512, 128] through transposing LDS reads
#   (ds_read_b64_tr_b8), and that layer's store_t v2 call runs with
#   store_y=False: no [M, 512] y is allocated, but y's bytes are still
#   WRITTEN: the UNMODIFIED v2 kernel issues every y store into a dedicated
#   1/32-size scratch of 16 * M + 512 bytes with row stride 16 (overlapping
#   rows that nothing reads; a fresh caching-allocator allocation per call,
#   never a view into yT, x or a TM_NONEXP pool block, asserted). The kernel, its
#   compiled binary (same pointer classes and stride specializations as the
#   ordinary layers' calls), the arithmetic, yT, mean and rstd are
#   unchanged. The tiled-A entry has the same kernel body, tile order, MFMA
#   operands and epilogue as FWD_K512's row-major entry.
#   WHEN: decided on the host before that LayerNorm, per call, from host
#   state only (no tensor read, no device sync). All of:
#   - this binding (DLRM_HSTU_FP8_FWD_K512_TILED_A=1) and FWD_K512 on;
#   - the V/K projection is the e4m3-output call (frozen V/K scale);
#   - BWD_STORE_T_V2 on and D = 512 (the v2 store_t kernel takes the call), M >= 1
#     and M * 512 <= 2**31 - 1 (the scratch keeps y's pointer class; above
#     it the wrapper forces store_y=True);
#   - BWD_WGRAD_CK_XT_TILED step-tiles the yT on this device (wgrad_ck.tiled_active,
#     evaluated once and handed to the store_t call too);
#   - K=512, N=1024, the input_scale backend mode, no fast accumulation, no
#     torch.compile tracing, and no FP8 activation telemetry
#     (DLRM_HSTU_FP8_TELEMETRY_INTERVAL=0; it samples y);
#   - the tiled-A entry passed its startup self-check on this device;
#   - B15T is not latched off (below).
#   After the LayerNorm the projection takes the tiled-A entry if K512 takes
#   the operands (the same weight shadow, folded scale and scaled bias as
#   scaled_mm_fp8_out_preq; one helper builds them for both calls) and the
#   launch succeeds.
#   FALLBACK: any "no" keeps the row-major path. Before the LayerNorm: y is
#   written to an [M, 512] tensor and scaled_mm_fp8_out_preq reads it. After
#   it (K512 declined the operands, or the tiled-A launch returned an
#   error): y is rebuilt bit for bit from yT on the ordinary allocator and
#   goes to scaled_mm_fp8_out_preq, and B15T latches off for the process
#   (later calls write the [M, 512] y again). One line per reason: "[b15t]
#   declined -> row-major y + V/K projection (<kind>): ..."; a latch adds
#   "[b15t] LATCHED OFF". A failed tiled-A self-check is latched in the K512
#   library ("[k512-fwd] tiled-A OFF for N=1024 ..."); under
#   DLRM_HSTU_FP8_FAIL_CLOSED=1 a failed prebuild self-check aborts before
#   RUN_START instead.
#   COLD START: with DLRM_HSTU_FP8_PREBUILD=1 (gin default),
#   triton_fp8.prebuild_extensions runs the tiled-A entry's self-check right
#   after FWD_K512's prebuild (same library): one M=300 launch on synthetic data
#   from a private generator (no data, no global RNG), compared byte for
#   byte with the row-major entry (NaN tail tokens, guard rows). Without the
#   prebuild it runs at the first such call (one device sync; declined while
#   a CUDA graph is being captured). No new Triton compile: the targets-only
#   store_t call with store_y=False reuses the ordinary layers' store_t v2
#   binary.
#   IMPACT: one targets-only call per step. That store_t still issues the
#   same y stores, but into the 1/32-size scratch, so about 31/32 of y's
#   M x 512 bytes are no longer written back to DRAM (fewer DRAM write-backs,
#   not fewer store instructions), and the V/K projection reads yT instead of
#   y. The TM_NONEXP_TILED=0 and
#   TM_NONEXP_XT=0 yT placements are bitwise too.
#   NUMERICS: BIT-IDENTICAL. yT holds y's bytes (the same store_t binary
#   writes the same yT, mean and rstd with store_y False and True), the
#   tiled-A entry's output equals the row-major entry's on y byte for byte,
#   and backward reads the same saved tensors.
#   ARMED (every rank, once per process):
#   - before RUN_START: "[k512-fwd] tiled-A self-check OK: N=1024 M=300
#     bitwise == row-major entry";
#   - at the first targets-only training forward that takes the store_t:
#     "[k512-fwd] armed tiled-A: N=1024 ..." and "[b15t] ARMED targets VK
#     reads tiled yT; store_t skips y: ..." (the line goes on to say that
#     y's bytes go to the 1/32-size discarded scratch). FWD_K512's "[k512-fwd]
#     armed: N=1024" still prints (its library takes the call), and so do
#     BWD_STORE_T_V2's "ARMED store_t_v2 on cuda:" and "ARMED wgrad_ck xt_tiled
#     producer store_t_v2".
#   Must be ABSENT: "[b15t] declined", "[b15t] LATCHED OFF", "[k512-fwd]
#   tiled-A OFF", "[k512-fwd] tiled-A prebuild FAILED", "wgrad_ck xt_tiled
#   OFF", "wgrad_ck xt_tiled declined by store_t_v2", "pool GREW".
#   Trace kernel names: k512_2wg_kernel_tiled_a<1024> replaces the
#   targets-only layer's k512_2wg_kernel<1024, ...> once the store_t is in
#   use; the pattern "k512_2wg_kernel" matches both (a prefix
#   "k512_2wg_kernel<1024" does not). A trace shows this knob as
#   k512_2wg_kernel_tiled_a|k512_2wg_kernel<1024,
#   not the store_t: the store_t keeps its name and binary
#   (_weighted_layer_norm_fwd_fp8_store_t_v2, unmodified), and a trace shows
#   the saved write-backs only as a shorter instance of it on the
#   targets-only layer's call.
#   Opt out (kill switch): DLRM_HSTU_FP8_FWD_K512_TILED_A=0 (the [M, 512] y
#   and FWD_K512's row-major entry; bitwise the same outputs). Inert while
#   FWD_K512, BWD_STORE_T_V2, UVQK_STORE_T or BWD_WGRAD_CK_XT_TILED is off.
apply_env_bootstrap.DLRM_HSTU_FP8_FWD_K512_TILED_A = True

# -----------------------------------------------------------------------------
# EVAL-FORWARD HYGIENE. Same contract as the
# knobs above: gin-guarded (the binding below turns it on, the code default
# when the binding is absent is OFF), env kill switch of the same name, a
# pre-set env var wins over gin.
#     Main switch DLRM_HSTU_FP8_EVAL_FWD_HYGIENE, read per call
#     (ops/eval_fwd_hygiene.py) and armed only by "1". Sub-switch
#     DLRM_HSTU_FP8_EVAL_FWD_HYGIENE_LOSS for (e) only, bound OFF below.
#   WHAT: the eval pass (model.eval() under torch.no_grad(), train/utils.py
#     _run_eval_window) stops paying for training.
#     (a) The POSENC_FAST alpha fold and the POSENC_CONCAT_FOLD contextual-
#     concat fold also serve no-grad forwards: eval does not materialize the
#     contextual concat_2D_jagged or run a separate `* alpha` pass and the
#     unfused position kernel; it runs the concat-folded position kernel
#     (ops/position.py; the transducer's fold decision follows). The
#     POSENC_DROPOUT_FUSE / POSENC_DROP_HWEPI posenc + input-dropout fusion
#     stays training-only (eval has no dropout).
#     (b) The position forward skips the index sorts that only its backward's
#     table-gradient reduction reads (the arange and the two sorts of the
#     unfused kernel; the POSENC_SORT16 / POSENC_POS_ARITH / POSENC_TS_ONESWEEP
#     sort pairs of the concat kernel), and saves nothing for a backward
#     (ops/triton/triton_position.py).
#     (c) The output projection does not save the (1,) dequant-scale tensor of
#     the BWD_OUT_WGRAD FP8 wgrad (ops/triton/triton_hstu_linear.py).
#     (b) and (c) are decided by each op's wrapper, outside its autograd
#     Function: with grad mode on and any input requiring grad (every training
#     forward) the training path runs, and the switch is not read.
#     (d) Eval batches skip the per-batch FLOPs stash in either form (the
#     LAZY_FLOPS_STASH lazy merged-lengths stash or the eager FLOPs/sample kernels; read
#     only by the train perf line; modules/dlrm_hstu.py).
#     (e) Sub-switch DLRM_HSTU_FP8_EVAL_FWD_HYGIENE_LOSS (acts only with the
#     main switch on): eval batches also skip the multitask loss
#     (modules/multitask_module.py). DlrmHSTU.main_forward reads it only to
#     build the training aux losses; in eval it is discarded. Bound OFF below.
#     Predictions, labels and weights, which the eval metrics read, are
#     unchanged by (a)-(e).
#     Not included: the per-layer sort_by_length indices (GLUE_FOLD3 builds
#     them only where a Triton attention kernel reads them, in training and
#     eval alike), and eval's legacy LN*U*dropout forward (the persistent
#     kernel training uses is not bitwise to it; see
#     DLRM_HSTU_FP8_EVAL_LNMD_V3 below).
#   IMPACT: shortens the forward of every eval batch (mainly the positional-
#     encoder block). Training steps and the eval-free benchmark run the same
#     kernels and branches either way (neither switch is read there).
#   NUMERICS: BIT-IDENTICAL eval predictions, labels and weights, with or
#     without (e) (the folds compute the same bf16 values; everything skipped
#     had no forward consumer). Every token and every forward FLOP behind the
#     predictions still runs. (a)-(d) skip only backward bookkeeping and
#     training telemetry; (e) skips the eval-time multitask loss, which
#     nothing reads in eval.
#   ARMED (every rank, once, in the first eval pass): "[eval-fwd-hygiene]
#     DLRM_HSTU_FP8_EVAL_FWD_HYGIENE=1 armed: no-grad forwards take the posenc
#     alpha/concat folds ...; eval multitask loss: computed
#     (DLRM_HSTU_FP8_EVAL_FWD_HYGIENE_LOSS off)". With (e) armed the line ends
#     "skipped (DLRM_HSTU_FP8_EVAL_FWD_HYGIENE_LOSS=1)" and a second line
#     follows: "[eval-fwd-hygiene] DLRM_HSTU_FP8_EVAL_FWD_HYGIENE_LOSS=1 armed:
#     eval forwards skip the multitask loss ...". Must be ABSENT:
#     "DLRM_HSTU_FP8_EVAL_FWD_HYGIENE_LOSS=1 ignored" (the sub-switch set
#     without the main switch).
#   Opt out (kill switch): DLRM_HSTU_FP8_EVAL_FWD_HYGIENE=0 (eval runs the
#     training-path bookkeeping; (e) is then inert). (e) alone:
#     DLRM_HSTU_FP8_EVAL_FWD_HYGIENE_LOSS=0 (the binding below).
apply_env_bootstrap.DLRM_HSTU_FP8_EVAL_FWD_HYGIENE = True
apply_env_bootstrap.DLRM_HSTU_FP8_EVAL_FWD_HYGIENE_LOSS = False

# -----------------------------------------------------------------------------
# EVAL EMBEDDING LOOKAHEAD. Same contract as the knobs above: the binding
# below is True (the code default when it is absent is OFF); env kill switch
# of the same name; a pre-set env var wins over gin
# (DLRM_HSTU_FP8_EVAL_EMB_LOOKAHEAD=0 disarms it).
#   WHAT: the forward-only eval pipeline (train/utils.py build_train_pipeline
#     role="eval") issues batch N+1's dist_init (KJT all_to_all wait + recat),
#     EmbeddingCollection TBE lookup, fused K1 send permute and forward
#     sequence all_to_all at the END of progress(N), on a dedicated
#     normal-priority side stream, instead of at the head of forward(N+1) on
#     the main stream; the all_to_all completes under batch N's dense forward
#     and the main stream no longer waits on it. The forward of N+1 consumes the issued
#     awaitable lazily at the stock first touch; K3'/decode,
#     construct_jagged_tensors and all dense work stay on main, in stock
#     order. Batch 0 of every pass runs the stock path.
#     Side stream: created before RUN_START (train_ranker, after the allocator
#     pre-grow), placed off the main stream's hardware queue by the
#     host_sync_free.shares_hw_queue probe, its large and small pools
#     pre-grown from the margin (_POOL_GIB, default 4 GiB, plus 64 MiB of
#     1 MiB blocks); one all_reduce of a 0/1 readiness vote before RUN_START
#     makes the arming rank-uniform (any rank without such a stream: OFF on
#     every rank).
#     Fences: the side stream waits on an event the main stream records right
#     after the previous batch's embedding wait (covers the last train
#     update, TBE state order, buffer reuse, and bounds the host lead); the
#     main stream waits on the side stream at the end of every pass.
#     Declines (stock eval on every rank) with DLRM_HSTU_FP8_SYNCFREE or
#     ..._DISTINIT_MAIN off; EVAL_INTERIM_LOG>0; TP_DEFER_INPUT_DIST other
#     than 1 (a rank's stock fallback mid-pass would then pair different
#     collectives with its peers); or an embedding output that no all_to_all
#     orders (the main stream waits on the side stream only through each
#     sharding's all_to_all): only table_wise, column_wise and row_wise arm;
#     data_parallel (EMB_SHARDING_OVERRIDES), world size 1 and torchrec sync
#     collectives decline. TP_EVAL_PIPELINE=0 (no eval pipeline) makes no
#     side stream or pool; EVAL_INTERIM_LOG>0 still pre-grows the pool
#     (unused margin only). Training steps, the train pipeline and the
#     eval-free benchmark are unchanged (role "train" never takes it).
#   NUMERICS: BITWISE eval predictions, labels and weights (same kernels on
#     the same inputs; same collectives in the same per-rank order; only the
#     issue time and stream of the lookup/permute/send change). Training
#     unchanged.
#   ARMED (every rank): "armed OK: eval emb lookahead stream ready" (before
#     RUN_START), "DLRMV4 eval emb lookahead: eval pipeline subclass
#     installed" and "DLRMV4 eval emb lookahead ACTIVE" (first eval pass).
#     Must be ABSENT: "eval emb lookahead DECLINED", "eval emb lookahead
#     DISABLED", "consumed-event fence missing", "failure after collectives",
#     "drained", "bitwise=False".
#   Diagnostics (env only, not bound): DLRM_HSTU_FP8_EVAL_EMB_LOOKAHEAD_VERIFY=N
#     (byte compare vs a stock recompute on main for batch indices 1..N of
#     every pass; +1 TBE forward and +1 sequence all_to_all per sharding per
#     verified batch on every rank; never in a timed run), _ISSUE=end|top,
#     _PRIO=0|-1, _POOL_GIB=<GiB> (default 4; 0 = neither pool pre-grown),
#     _REPORT=1. VERIFY coverage: the recompute reuses the looked-ahead KJT,
#     so the side-stream dist_init (KJT all_to_all wait + recat) is not
#     independently checked by VERIFY, and only embeddings are compared (not
#     predictions, labels or weights).
#   Opt out (kill switch): DLRM_HSTU_FP8_EVAL_EMB_LOOKAHEAD=0 (env wins).
apply_env_bootstrap.DLRM_HSTU_FP8_EVAL_EMB_LOOKAHEAD = True

# -----------------------------------------------------------------------------
# EVAL LN*U*DROPOUT FORWARD ON V3. DECLARED NUMERICS CHANGE OF THE EVAL
# PASS, BOUND ON below. Same contract as the knobs above: env switch of the
# same name, a pre-set env var wins over gin, the code default when the
# binding is absent is OFF.
#     Switch DLRM_HSTU_FP8_EVAL_LNMD_V3, read per call (ops/eval_lnmd_v3.py),
#     only by LN*U*dropout forwards with training=False, and armed only by "1".
#   WHAT: an LN*U*dropout forward with training=False (the eval pass,
#     model.eval() under torch.no_grad(), train/utils.py _run_eval_window)
#     that meets the eligibility the training forward requires for
#     LNMD_FWD_V3's v3 (a separated-RNG GPU, LNMD_FWD_V2's condition: ROCm,
#     DLRM_HSTU_FP8_LNMD_FWD_V2 on, N >= 2^20 rows, a sigmoid activation; a
#     full-width block; DLRM_HSTU_FP8_LNMD_FWD_V3 on) launches
#     _ln_mul_dropout_fwd_rng_v3 with TRAINING=False, the training forward's
#     persistent one-wave-per-row kernel without its dropout step, instead of
#     the legacy per-row _ln_mul_dropout_fwd
#     (ops/triton/triton_hstu_linear.py _triton_layer_norm_mul_dropout_fwd_impl).
#     In this model: the output LN*U of the two full STU layers of every eval
#     batch. The targets-only layer (batch rows only, no sigmoid) keeps the
#     legacy kernel, as its training forward keeps _ln_mul_dropout_fwd_rng.
#   WHY: LNMD_FWD_V2, LNMD_FWD_V3 and LNMD_FWD_MASKGEN move the training
#     forward off the per-row kernel in the training branch only.
#   IMPACT: a shorter output LN*U*dropout of every eval batch (eval pass
#     only). Training steps and the eval-free benchmark are unaffected (the
#     switch is not read there).
#   NUMERICS: NOT BIT-IDENTICAL to the legacy eval kernel: one-wave instead of
#     two-wave row reductions move the last bits of mean/rstd, and a small
#     fraction of the e4m3 y bytes move by one code. Same per-row arithmetic as
#     the training forward (v3 / maskgen) with the dropout step removed. Eval
#     predictions can move in the last bits. Training forwards pass training=True (output dropout
#     0.1) and never read the switch; a config with output dropout 0 would run
#     its training forward with training=False and be affected.
#   ARMED (every rank, once, at the first eval forward, tagged [rank N]):
#     "armed OK: [eval-lnmd-v3] DLRM_HSTU_FP8_EVAL_LNMD_V3=1: eval
#     (training=False) LN*U*dropout forwards with the v3 eligibility run
#     _ln_mul_dropout_fwd_rng_v3 TRAINING=False ...". Must be ABSENT:
#     "[eval-lnmd-v3] DLRM_HSTU_FP8_EVAL_LNMD_V3=1 ignored" (v3 unavailable:
#     LNMD_FWD_V2 / LNMD_FWD_V3 off or not a separated-RNG GPU).
#   TSPEC: the table carries this v3 TRAINING=False
#     specialization's eval rows (recorded with the switch on), so it compiles
#     before RUN_START; re-record after changing the kernel or its call.
#   DEFAULT ON (the binding below).
#   Kill switch (emergency, env wins): DLRM_HSTU_FP8_EVAL_LNMD_V3=0, or bind
#     False = the legacy eval kernel.
apply_env_bootstrap.DLRM_HSTU_FP8_EVAL_LNMD_V3 = True

# -----------------------------------------------------------------------------
# WHAT DLRM_HSTU_FP8_FWD TURNS ON. The eighteen values are a single named preset,
# `_FP8_FORWARD_ARM` in dlrm_v4/train/_env_bootstrap.py, rather than eighteen
# bindings here, because a run with only some of them set is a different,
# unvalidated configuration. This section is documentation, not config.
#
# A pre-set env var still wins PER KNOB, so one can be changed while the
# rest of the arm holds: `DLRM_HSTU_FP8_FWD=1 DLRM_HSTU_FP8_ATTN=0 ...`.
# Setting a compute knob WITHOUT the master switch raises, rather than quietly
# running a partial arm under a full-arm label.
#
#   GEMM=1, ATTN=1
#     e4m3 for the HSTU linear layers, and for attention q/k/v. ATTN chains
#     behind FUSE_QKV (which chains behind FUSE_LN): the quantized q/k/v it
#     consumes come from the fused qkv projection. The gin default
#     HSTU_ATTN_FWD=flydsl selects the FlyDSL e4m3 attention forward
#     (fused-silu epilogue included). HSTU_ATTN_FWD=triton is the opt-out
#     to the Triton e4m3 forward. FlyDSL backward is unchanged.
#
#   BWD=0
#     The preset's backward gemms stay bf16 (DLRM_HSTU_FP8_BWD above
#     controls the FP8 backward separately): the backward is where a frozen
#     scale's error compounds into the gradient rather than into one
#     activation.
#
#   FUSE_LN=1, FUSE_OUTLN=1, FUSE_QKV=1, FUSE_SILU=1, FUSE_RESIDUAL=1,
#   FUSE_RESIDUAL_ALGORITHM=1
#     Fold the quantization into the neighboring elementwise work so the tensor
#     is written once already scaled, instead of being written bf16 and re-read
#     to convert. Without them GEMM alone saves neither memory nor step time.
#     FUSE_QKV and ATTN must be used together for the memory saving: either
#     one alone gives it back.
#
#   SAVE_UVQK=1, SAVE_UVQK_LAYERS="0,1,2", EARLY_RELEASE_UVQK=1
#     Keep the e4m3 u/v/q/k pack from the forward so the backward re-reads it
#     instead of recomputing the projection. SAVE_UVQK_LAYERS is a
#     comma-separated list of zero-based layer indices (unset = every layer).
#     "0,1,2" (all three HSTU layers) is the default.
#     EARLY_RELEASE frees each pack at its last use inside the backward.
#     For layer 1 only, set $DLRM_HSTU_FP8_SAVE_UVQK_LAYERS=1.
#
#   SCALE_MODE="frozen", CALIBRATION_STEPS=4, HOST_SCALE_VALUES=1,
#   GEMM_ASCALE_MARGIN=1.5
#     Calibrate for four steps, then freeze. Freezing is what removes the
#     per-step amax reduction and the device-to-host scale read from the
#     steady-state step; HOST_SCALE_VALUES keeps the frozen values on the host
#     so the step never reads them back. ASCALE_MARGIN pads the activation scale
#     by 1.5x, buying headroom for post-calibration drift before saturation.
#
#   FAIL_CLOSED=1
#     Raise if a requested fp8 path is unavailable instead of silently running
#     bf16. A silent fallback would look like a small FP8 effect rather than
#     like FP8 never running. Confirm with the
#     run's `[hstu-fp8] engaged: ...` and `[hstu-fp8] resolved: ...` lines.
#
#   GEMM_FASTACC=0
#     hipBLASLt fast-accumulate, i.e. accumulating the e4m3 gemm in fp8 rather
#     than fp32. OFF: it gives up the fp32 accumulator precision.

# =============================================================================
# $SEED — global RNG seed for reproducible MODEL INITIALIZATION.
#
# WHAT IT CONTROLS (all weight init is a deterministic function of $SEED):
#   1. Dense parameters (HSTU transformer blocks, MLPs, action embeddings, the
#      postprocessor). seed_everything() seeds python/numpy/torch/torch.cuda
#      with $SEED right before make_model(). The SAME seed is set on every rank,
#      so dense weights are initialized identically across ranks AND reproducibly
#      run-to-run.
#   2. Sparse embedding tables (item_id, artist_id, album_id, uid, the cross
#      tables). These are materialized on-device while DMP shards the model, NOT
#      in make_model(), so seed_everything() alone does not pin them. Two
#      mechanisms tie them to $SEED:
#        (a) make_optimizer_and_shard() RE-SEEDS torch/torch.cuda from $SEED
#            immediately before DistributedModelParallel(...), so the fused
#            FBGEMM TBE init (which draws from the global RNG on-device) is
#            reproducible. This is the path that actually applies here.
#        (b) get_embedding_table_config() also attaches a per-table seeded
#            init_fn (seed derived from sha256($SEED, table_name)) for the
#            eager/non-meta code path. It no-ops on the meta device that DMP
#            uses, so (a) is the effective guarantee for this setup.
#   3. Any other seeded RNG consumers (e.g. dropout's init-time draws).
#
#   SCOPE: reproducible for a FIXED sharding plan — same GPU/world
#   size AND same planner output. It is NOT invariant to changing the GPU count
#   or sharding (the per-shard draw boundaries move). The init DISTRIBUTION is
#   unchanged from stock (uniform +/-1/sqrt(num_embeddings), or a table's
#   explicit weight_init_min/max), so $SEED affects determinism, not quality.
#
#   VERIFY: INIT_CHECKSUM=1 (OFF by default) logs a per-table fingerprint + a
#   one-line "[init-checksum] SEED=.. digest=.." right after DMP. Two builds with
#   the same $SEED + plan print the same digest; different seeds differ. It is OFF
#   by default because the fp64 per-shard reductions materialize a full fp64 copy
#   of each local embedding shard (>150 GiB for the big tables), leaving almost no
#   HBM headroom after sharding and OOMing the build on any node with residual
#   memory. Enable only for an explicit reproducibility check (ideally a clean
#   node / smaller batch).
#
# WHAT IT DOES *NOT* CONTROL (separate, independent knobs):
#   - Streaming data order / shuffle permutation -> $STREAMING_SHUFFLE_SEED
#     (get_dataset.streaming_shuffle_seed, below).
#   - Train/eval holdout user split               -> $SPLIT_SALT (below).
#   So holding $STREAMING_SHUFFLE_SEED + $SPLIT_SALT fixed and varying ONLY $SEED
#   isolates the effect of model initialization.
#
# PARSE NOTE: seed_everything() runs right before make_model() in train_ranker
# (after the full gin parse), so this binding resolves in the second parse where
# env_int is registered. Override per-run via $SEED.
# Default -1 draws a fresh random seed per run (MLPerf requires an unfixed
# seed); set $SEED to a fixed value for a reproducible run.
seed_everything.seed = @seed/env_int()
seed/env_int.key     = "SEED"
seed/env_int.default = -1

# $DECORRELATE_DROPOUT — re-seed torch/cuda with $SEED + rank after init so HSTU
# dropout masks differ per data-parallel rank. 1 = on, 0 = identical masks (default).
decorrelate_runtime_rng.enabled = @drr/env_int()
drr/env_int.key     = "DECORRELATE_DROPOUT"
drr/env_int.default = 0

# dense model optimizer
# Learning rate via $DENSE_LR. Unset: train_ranker sets the closed-division
# reference value 1e-6 * global_batch / 8192 (and SPARSE_LR to the same value).
dense_optimizer_factory_and_class.learning_rate = @dlr/env_float()
dlr/env_float.key     = "DENSE_LR"
dlr/env_float.default = 0.000001
dense_optimizer_factory_and_class.optimizer_name = "Adam"
dense_optimizer_factory_and_class.momentum = 0
dense_optimizer_factory_and_class.weight_decay = 0
dense_optimizer_factory_and_class.eps = 1e-8
dense_optimizer_factory_and_class.betas = (0.95, 0.999)

# Fused dense Adam: the
#     dense Adam step and the clip_grad_norm_ multiply in ONE
#     bitwise Triton launch (ops/triton/dense_adam_fused.py; switch
#     DLRM_HSTU_FP8_DENSE_ADAM_FUSED, bound through apply_env_bootstrap like the
#     FP8 kernel knobs).
#     WHAT: dense_optimizer_factory_and_class returns FusedDenseAdam, a
#     torch.optim.Adam subclass. For a param group torch 2.12 would step on its
#     default foreach path (no amsgrad/maximize/capturable/differentiable/
#     fused, weight_decay 0, float lr/betas/eps, every param/grad/state tensor
#     CUDA fp32 contiguous on one device, CPU fp32 step tensors) it runs one
#     multi-tensor Triton launch per distinct step count (normally one per
#     step) instead of torch's foreach chain (lerp_, mul_, addcmul_, sqrt,
#     div_, add_, addcdiv_; eleven multi_tensor_apply launches for this
#     model's 69 dense tensors). Any other group, and any group whose tensors
#     fail the check on a given step, runs torch's own functional adam() with
#     Adam.step's arguments. The three clip call sites in train/utils.py
#     (_StreamingTrainPipeline._optimizer_step and both loops) call
#     _clip_grad_norm_: with this armed it computes the same total norm
#     and clamped coefficient with the same torch ops, multiplies every grad
#     the fused optimizer does not own with torch._foreach_mul_ as before, and
#     hands the coefficient tensor to FusedDenseAdam, whose kernel multiplies
#     the owned grads (fp32 product, written back to .grad) right before
#     using them.
#     IMPACT: removes the foreach Adam chain and the clip multiply launch from
#     every step on every rank (dense params are replicated, so the saving
#     does not depend on the node count). The host side does less too
#     (one step increment pass and one item() per param instead of two).
#     COLD START: two Triton JIT compiles (with and without the clip fold),
#     both at the first fused step, which is torchrec init_state's dummy step
#     in make_optimizer_and_shard (the second variant is compiled there without
#     being launched).
#     NUMERICS: BIT-IDENTICAL params, exp_avg, exp_avg_sq, state['step'] and
#     clipped .grad vs torch.optim.Adam(foreach) + clip_grad_norm_, by
#     construction: each element replays torch's ROCm rounding
#     sequence, with the FMA contractions torch's HIP kernels actually use
#     (lerp: fma(w, g - m, m); addcmul: fma(1 - b2, g * g, v); addcdiv:
#     fma(step_size, m / d, p); IEEE div; correctly rounded sqrt incl.
#     denormals), host scalars from the same Python double expressions,
#     rounded to fp32 as c10::Scalar does. State dict, param_groups and
#     checkpoints are torch.optim.Adam's (the subclass adds no state).
#     Between the clip and the step the owned .grad tensors still hold the
#     unscaled values (nothing reads them there).
#     ARMED: "[dense optimizer] DLRM_HSTU_FP8_DENSE_ADAM_FUSED=1: FusedDenseAdam
#     ..." at construction, then per rank "armed OK: dense Adam fused
#     (DLRM_HSTU_FP8_DENSE_ADAM_FUSED): rank=R tensors=69 elements=15243057
#     chunks=... clip_fold=False ..." at the first fused step (init_state's
#     dummy step) and, with clipping on, "armed OK: dense Adam fused ...
#     clip_fold=True ... (first step with the clip fold)" at the first training
#     step. A group that falls back logs "[dense-adam-fused] group falls back
#     to torch Adam: <reason>" once per reason.
#     Signed zeros and NaN signs are preserved too: scalars are broadcast by
#     an exact multiply by 1.0 (a -0.0 step_size at lr == 0 stays -0.0) and the
#     large-weight lerp branch negates the weight factor by a sign-bit flip
#     as torch's HIP lerp does; a host scalar that overflows fp32 raises the
#     same error as torch's checked conversion.
#     Default ON. Kill switch: DLRM_HSTU_FP8_DENSE_ADAM_FUSED=0 (only 0
#     disarms; a pre-set environment variable wins over this binding).
apply_env_bootstrap.DLRM_HSTU_FP8_DENSE_ADAM_FUSED = True

# sparse model optimizer
# Learning rate via $SPARSE_LR; must equal the dense rate (set together above).
sparse_optimizer_factory_and_class.learning_rate = @slr/env_float()
slr/env_float.key     = "SPARSE_LR"
slr/env_float.default = 0.000001
sparse_optimizer_factory_and_class.optimizer_name = "RowWiseAdagrad"
sparse_optimizer_factory_and_class.momentum = 0
sparse_optimizer_factory_and_class.weight_decay = 0
sparse_optimizer_factory_and_class.eps = 1e-8
sparse_optimizer_factory_and_class.betas = (0.95, 0.999)

# Gradient clipping for the STREAMING path (clips dense params; sparse tables
# use a fused optimizer and are unaffected). Env-overridable via $GRAD_CLIP_NORM.
# Default 1.0 = ON (max_norm=1.0); set 0.0 via $GRAD_CLIP_NORM to disable.
streaming_train_eval_loop.grad_clip_norm = @gcn/env_float()
gcn/env_float.key     = "GRAD_CLIP_NORM"
gcn/env_float.default = 1.0

# ============================================================================
# LR WARMUP (streaming train/eval path)
# ============================================================================
# WHAT IT DOES
#   Linearly ramps the learning rate from 0 up to the configured base LR over
#   the first N GLOBAL train steps, then holds flat at the base LR for the rest
#   of the run:
#
#       effective_lr(gstep) = base_lr * min(1.0, gstep / N)
#
#   The ramp scales BOTH learning-rate channels in lockstep:
#     1. the dense / non-fused optimizer (the `optimizer` passed to the loop), and
#     2. the in-backward FUSED sparse-embedding optimizer (model.fused_optimizer),
#        i.e. the per-table embedding LR that DOMINATES convergence for this
#        model. The warmed LR is also pushed into the FBGEMM TBE backward kernel
#        (via set_learning_rate), so the embedding backward actually sees the
#        ramped value in the SAME step (not one step late).
#
# WHY IT EXISTS
#   Warmup tames the early-step trajectory divergence that a large LR causes on
#   freshly-initialized weights/embeddings. That early divergence is a major
#   source of run-to-run variance (CV). Warmup lets us use a higher base LR (or
#   stretch the gentle early-rise region) without paying the early-instability
#   penalty. It does NOT reduce plateau-region CV (that is set by data ordering).
#
# RESUME SAFETY
#   The ramp is keyed off the monotonic, checkpoint-restored global_step, so it
#   is identical on a cold start and on every relaunch:
#     - a run that crashes mid-warmup resumes at the correct multiplier;
#     - a run already past step N is a pure no-op (LRs already hold base).
#
# HOW TO ENABLE / DISABLE
#   Controlled by the $LR_WARMUP_STEPS environment variable (read at startup):
#     - DISABLED: set $LR_WARMUP_STEPS to 0.
#         => warmup code early-returns; base LRs are NEVER mutated; behavior is
#            byte-identical to running without warmup.
#     - ENABLED: export LR_WARMUP_STEPS=<N>   (N = number of global steps to ramp;
#         gin default 24000 below)
#         e.g.  export LR_WARMUP_STEPS=1500    # short warmup (~0.5% of data @ GB=8192)
#               export LR_WARMUP_STEPS=16000   # long warmup  (~5.7% of data @ GB=8192)
#         Rule of thumb: data fraction spent ramping = N * global_batch / total_train.
#
# NOTE: this only changes the LR SCHEDULE. The base LR itself is set separately
#   via DENSE_LR / SPARSE_LR; warmup never overrides those base values.
streaming_train_eval_loop.lr_warmup_steps = @lrw/env_int()
lrw/env_int.key     = "LR_WARMUP_STEPS"
lrw/env_int.default = 24000      # 24k-step LR warmup (CV-reduction default)

# ----------------------------------------------------------------------------
# LR WARMUP FLOOR / STARTING LR  (only meaningful when $LR_WARMUP_STEPS > 0)
# ----------------------------------------------------------------------------
# WHAT IT DOES
#   Sets the LR the ramp STARTS from at global step 0 instead of starting from
#   zero, turning the schedule into a "partial warmup" that ramps from `start`
#   up to the base LR over $LR_WARMUP_STEPS, then holds flat:
#
#       effective_lr(gstep) = start + (base_lr - start) * min(1.0, gstep / N)
#
#   `start` is applied PER param group and clamped to <= that group's base LR
#   (a floor >= base means "no ramp" for that group -> it starts at base). Like
#   the main warmup, the floor scales both the dense optimizer and the fused
#   sparse-embedding optimizer, and is pushed into the FBGEMM TBE kernel.
#
# WHY IT EXISTS
#   With a long warmup the first several thousand steps run at a near-zero LR
#   (e.g. at gstep 1k of a 24k ramp, LR ~= base/24 ~= 4e-9) and barely train.
#   A small nonzero floor reclaims that near-dead head of the ramp, banking
#   extra effective learning (integral rises from 1/2*N*base to
#   1/2*N*(base+start)) to reach a target AUC in fewer steps. The trade-off is
#   that a higher floor reintroduces some early seed-divergence, so it costs
#   some of warmup's CV-reduction benefit; keep `start` << base to stay in the
#   low-CV regime.
#
# HOW TO ENABLE / DISABLE
#   Controlled by the $LR_WARMUP_START_LR environment variable (read at startup):
#     - DEFAULT 0.0: classic 0 -> base ramp; byte-identical to plain warmup.
#     - NONZERO: export LR_WARMUP_START_LR=<abs LR>   (must be < base LR)
#         e.g. at base=1e-7:  1.25e-8 (= base/8)   2.5e-8 (= base/4)
#   No effect unless $LR_WARMUP_STEPS > 0 (there is no ramp to lift a floor on).
streaming_train_eval_loop.lr_warmup_start_lr = @lrws/env_float()
lrws/env_float.key     = "LR_WARMUP_START_LR"
lrws/env_float.default = 0.0     # 0.0 = classic 0 -> base ramp (same as plain warmup)

# Data root: resolved at runtime from $DLRM_DATA_PATH if set, else the literal
# below. Used by both make_train_test_dataloaders and get_dataset.
# Scoped (`data/env_path`) so this binding doesn't collide with the RUN_NAME
# env_path binding below — every distinct env_path() call site needs its own
# scope or the later `env_path.key=...` overrides earlier ones.
DATA_PATH = @data/env_path()
data/env_path.key = "DLRM_DATA_PATH"
data/env_path.default = "/data/dlrm_data"

# Shared train:eval split: fraction of USERS used for training; the remaining
# (1 - this) fraction are held out as a fixed eval set and NEVER trained.
# Bound to BOTH the static train-eval path (make_train_test_dataloaders, a
# positional split) and the streaming path (get_dataset, an explicit by-user
# hash split), so one value configures the holdout in either mode.
# 1.0 = no holdout (legacy streaming behavior). Override via $TRAIN_SPLIT_PERCENTAGE.
# Default 1.0: all users are trained AND evaluated (full-coverage eval); set <1.0
# (e.g. 0.90) for a clean held-out cohort.
TRAIN_SPLIT_PERCENTAGE = @tsp/env_float()
tsp/env_float.key     = "TRAIN_SPLIT_PERCENTAGE"
tsp/env_float.default = 1.0

# dataloader configs
make_train_test_dataloaders.batch_size = %batch_size
make_train_test_dataloaders.eval_batch_size = 1024
make_train_test_dataloaders.dataset_type = %dataset
make_train_test_dataloaders.train_split_percentage = %TRAIN_SPLIT_PERCENTAGE
make_train_test_dataloaders.new_path_prefix = %DATA_PATH
make_train_test_dataloaders.num_workers = %num_workers
make_train_test_dataloaders.prefetch_factor = %prefetch_factor
make_train_test_dataloaders.num_blocks = 1

# embedding planner: per-rank HBM ceiling the torchrec sharder targets.
# Override via $HBM_CAP_GB (e.g. lower to 150 to force more CW sharding).
make_optimizer_and_shard.hbm_cap_gb = @env_int()
env_int.key = "HBM_CAP_GB"
env_int.default = 260

# Per-rank host-DDR ceiling the planner may use for UVM-backed tables. 0 (the
# default) means no DDR budget, so every table must fit HBM and a "uvm"/
# "uvm_caching" placement below cannot be planned at all. Raise it via
# $DDR_CAP_GB to trade embedding HBM for activation headroom, e.g.
#   DDR_CAP_GB=64 EMB_PLACEMENT_OVERRIDES="uid=uvm_caching,item_id=uvm_caching"
make_optimizer_and_shard.ddr_cap_gb = @ddr/env_int()
ddr/env_int.key     = "DDR_CAP_GB"
ddr/env_int.default = 0

# Embedding table placement. Global default applied to EVERY table:
#   auto        -> no constraint; planner decides from the HBM cap (default)
#   hbm         -> FUSED          (resident in GPU HBM)
#   uvm         -> FUSED_UVM      (host DDR via UVM, no HBM cache)
#   uvm_caching -> FUSED_UVM_CACHING (host DDR + HBM cache)
# "force HBM" for all tables = set this to "hbm" (or export EMB_PLACEMENT=hbm).
make_optimizer_and_shard.embedding_placement = @emp/env_str()
emp/env_str.key     = "EMB_PLACEMENT"
emp/env_str.default = "auto"

# Per-table placement overrides (win over the global default above). Configure
# each table independently here as a gin dict; allowed values per table:
#   "hbm" | "uvm" | "uvm_caching" | "auto"  (unlisted tables use the global
# default above). merge=True means a per-run env override LAYERS ON TOP of this
# dict per key (tweak one table at launch, keep the rest), e.g.:
#   EMB_PLACEMENT_OVERRIDES="uid=hbm"   # only retargets uid; others stay as below
make_optimizer_and_shard.embedding_placement_overrides = @env_str_map()
env_str_map.key     = "EMB_PLACEMENT_OVERRIDES"
env_str_map.merge   = True
env_str_map.default = {}

# Per-table SHARDING-TYPE overrides (shard layout, orthogonal to placement above).
# Absent/"auto" tables keep the planner's choice (ROW_WISE for the large yambda
# tables). Allowed per table: "row_wise"|"column_wise"|"table_wise"|
# "table_row_wise"|"table_column_wise"|"data_parallel"|"auto" (aliases rw/cw/tw/
# twrw). DEFAULT OFF ({}) -> plan is byte-identical to the legacy all-ROW_WISE
# path. Opt in per run via env, e.g.:
#   EMB_SHARDING_OVERRIDES="album_id=column_wise,artist_id=column_wise"
# WHY: ROW_WISE routes every lookup of row r to the single owner rank, so a few
# hot IDs concentrate the embedding all-to-all onto one rank and can OOM it.
# COLUMN_WISE splits the table by embedding dim (every rank holds all rows,
# dim/world cols), so the a2a load is balanced by RANK regardless of which IDs
# are hot, at identical per-rank table bytes. Convert only the skewed
# high-volume tables (album_id, artist_id); leave the balanced, highest-volume
# item_id and the tiny length-1 contextual/cross tables on ROW_WISE.
# WHY THIS GETS WORSE AT LARGER GLOBAL BATCH: the ROW_WISE a2a input buffer on the
# owner rank is sized by how many times its hot IDs appear across the WHOLE global
# batch, so that transient scales ~linearly with global batch size while every
# other rank stays idle. COLUMN_WISE makes each rank receive dim/world
# of EVERY lookup, so the per-rank a2a volume is ~global_batch/world (balanced)
# and grows with world size, not with which IDs are hot.
# NOTE: changing the sharding plan changes the on-disk shard layout; a checkpoint
# written under a different plan must be resharded/validated on load.
make_optimizer_and_shard.embedding_sharding_overrides = @esh/env_str_map()
esh/env_str_map.key     = "EMB_SHARDING_OVERRIDES"
esh/env_str_map.merge   = True
esh/env_str_map.default = {}

# Sparse embedding all-to-all wire precision. The embedding shuffle is the
# dominant, bandwidth-bound (esp. multi-node) collective; quantizing it via
# TorchRec QCommsConfig halves (bf16/fp16, both 2 bytes) the wire volume.
# Forward and backward are set independently (each: "fp32" | "bf16" | "fp16").
# Both "fp32" = off (no quantization).
# Default fp16/fp16, which halves the embedding-a2a wire volume.
# TorchRec golden_training suggests fwd=fp16 / bwd=bf16 (bf16's wider exponent
# hedges gradient overflow); here the gradients stay well within fp16 range
# (grad-clip=1.0), so bwd=fp16 is used.
# Override via $SPARSE_A2A_FWD / $SPARSE_A2A_BWD (e.g. set both "fp32" to disable).
make_optimizer_and_shard.sparse_a2a_forward_precision = @saaf/env_str()
saaf/env_str.key     = "SPARSE_A2A_FWD"
saaf/env_str.default = "fp16"
make_optimizer_and_shard.sparse_a2a_backward_precision = @saab/env_str()
saab/env_str.key     = "SPARSE_A2A_BWD"
saab/env_str.default = "fp16"

# =============================================================================
# RUNTIME PATCHES / MONKEYPATCHES
# -----------------------------------------------------------------------------
# Third-party kernels we override AT RUNTIME (no fork of the dependency). Each
# knob here is a kill switch for one such patch: ON by default, but flippable
# per-run to reproduce the original failure or fall back to stock if a future
# dependency version makes the patch unnecessary or incorrect. Patches are applied during model
# build/shard (make_optimizer_and_shard), before any training step.
# =============================================================================
#
# --- qcomm_lowmem_clamp_cast: low-memory fbgemm fp16/bf16 quant codec ---------
# WHAT IT PATCHES
#   fbgemm_gpu's embedding-a2a quantizer, fp32_to_fp16_with_clamp (and the bf16
#   variant), which the TorchRec qcomm codec calls to pack the sparse
#   embedding all-to-all payload onto the wire. Stock implementation is:
#       torch.clamp(tensor, HALF_MIN, HALF_MAX).half()
#   torch.clamp() materializes a SECOND full-size fp32 tensor (same numel as the
#   input) BEFORE the cast, so the transient peak is
#       input(fp32) + clamp_temp(fp32) + output(fp16)  ~= 2.5x the input.
#   The patch reorders to an in-place, allocation-free-equivalent:
#       tensor.half().clamp_(HALF_MIN, HALF_MAX)
#   i.e. cast FIRST (only the fp16 output is allocated), then clamp IN PLACE —
#   dropping the full-size fp32 clamp temp and cutting the transient peak by the
#   size of the input tensor.
#
# WHY IT'S NEEDED (the bug it fixes)
#   Embeddings are ROW-WISE sharded: every lookup of row r routes to the single
#   rank that owns r. On a data-skewed batch a few extremely hot IDs send a
#   disproportionate share of the global lookups to ONE owner rank, so that
#   rank's a2a input tensor balloons. With the stock codec the extra fp32 clamp
#   temp on that rank can OOM it mid-forward. The OOM'd rank then drops out of
#   the collective while its peers block in the embedding all-to-all until the
#   NCCL watchdog aborts the whole job. See
#   generative_recommenders/dlrm_v4/train/utils.py
#   (_patch_fbgemm_lowmem_clamp_cast).
#
# CORRECTNESS / PERF
#   Numerically IDENTICAL (bit-for-bit) to stock: the single fp32->fp16 cast is
#   the only rounding step in both orders; an fp32 value above HALF_MAX casts to
#   +inf which clamp_ maps back to HALF_MAX, and NaNs pass through unchanged.
#   In-place is safe because the codec encode() runs inside the qcomm autograd
#   Function.forward with grad disabled (no graph to corrupt). It does strictly
#   less memory traffic and allocation than stock.
#
# WHEN TO TURN OFF (set 0): only to reproduce the original OOM/hang for
#   debugging, or to revalidate against stock after an fbgemm_gpu upgrade.
#   Override via $QCOMM_LOWMEM_CODEC. Only takes effect when the embedding a2a is
#   actually quantized (SPARSE_A2A_FWD/BWD not both fp32); with fp32 a2a there is
#   no codec to patch and this knob is a no-op.
make_optimizer_and_shard.qcomm_lowmem_clamp_cast = @qlcc/env_int()
qlcc/env_int.key     = "QCOMM_LOWMEM_CODEC"
qlcc/env_int.default = 1

# --- ec_index_dedup: in-batch embedding index deduplication ------------------
# Enables TorchRec's use_index_dedup on the sequence EmbeddingCollectionSharder.
# Before the sparse input all-to-all, duplicate ids within a batch are collapsed
# to unique rows (torch.ops.fbgemm.jagged_unique_indices), the embedding lookup
# runs once per unique id, then results scatter back to their original positions
# via reverse_indices. For a NON-POOLED EmbeddingCollection this reconstruction
# is exact, so it is numerically LOSSLESS (unlike the fp16 a2a it does not move
# AUC/NE) — it only cuts (a) the sparse input all-to-all element COUNT and (b)
# the number of rows the fused TBE kernel gathers per step.
#
# WHY IT HELPS HERE: the default streaming order is user-major
# (STREAMING_SHUFFLE_FRACTION=0), so consecutive anchors are the same user's UIH
# re-reading the same item/artist/album ids -> very high in-batch duplicate rate
# on the big UIH sequence tables (DIAG_UNIQUE_EMB reports the unique fraction),
# so collapsing to unique rows removes the bulk of the lookup + a2a volume.
# Dedup COMPOSES with the fp16 qcomm a2a (dedup cuts element count, qcomm cuts
# bytes/element) and the COLUMN_WISE skew fix.
# The benefit grows with node count because at >1 node dedup also shrinks the
# cross-node embedding all-to-all, the dominant bandwidth-bound multi-node
# collective.
#
# NUMERICAL NEUTRALITY: the reconstruction is exact, so training is
# bit-for-bit unaffected (unlike the fp16 a2a, which is lossy).
#
# The dedup buffers are persistent=False -> NO change to the on-disk shard layout
# and safe to toggle on an existing checkpoint (no reshard). Applied as a final
# pass over the sharder list so it covers BOTH the qcomm-on (default) and
# qcomm-off (SPARSE_A2A_*=fp32) construction paths.
#
# DEFAULT ON (1): lossless. The benefit shrinks as batch diversity rises
# (high STREAMING_SHUFFLE_FRACTION -> fewer in-batch dups, so the
# jagged_unique_indices + scatter overhead stops paying for itself); consider
# EC_INDEX_DEDUP=0 for such a high-shuffle run. Override per-run via $EC_INDEX_DEDUP.
make_optimizer_and_shard.ec_index_dedup = @ecid/env_int()
ecid/env_int.key     = "EC_INDEX_DEDUP"
ecid/env_int.default = 1

# --- ec_gather_select: how the dedup expand is spelled -----------------------
# Only meaningful with EC_INDEX_DEDUP=1 (above), which is what creates the
# expand in the first place. After the deduped lookup returns one row per UNIQUE
# id, TorchRec's construct_jagged_tensors expands it back to one row per token.
# It offers two spellings of that same operation:
#   index_select(embeddings, 0, reverse_indices)        -- default
#   gather(embeddings, 0, reverse_indices.expand(...))  -- use_gather_select=True
# They compute the identical forward. Their BACKWARDS are different kernels:
# index_select's is index_add_ -> ATen indexFuncLargeIndex, gather's is
# scatter_add_. On torch 2.12 the former is much slower than the latter, so
# the default spelling is the expensive one on the pinned stack.
#
# NUMERICAL NEUTRALITY: both spellings accumulate duplicates with atomics in a
# nondeterministic order, and both have the same error against a float64
# reference. Neither is the "exact" one;
# swapping them changes which nondeterministic order you get, not the accuracy.
# The forward is bit-identical either way.
#
# DEFAULT ON (1). Set EC_GATHER_SELECT=0 to fall back to index_select.
# Requires a torchrec exposing the flag (the
# pinned 1.7.0a0+bf55480 does; 1.4.0 does not) -- if enabled on a torchrec
# without it, model construction raises rather than running silently inert.
make_model.ec_gather_select = @ecgs/env_int()
ecgs/env_int.key     = "EC_GATHER_SELECT"
ecgs/env_int.default = 1

# --- EC output in bf16: cast the UNIQUE rows, not the expanded ones ---------
# TorchRec's construct_jagged_tensors receives the unique-row tensor and
# expands it to one row per token (about 100x more rows) inside the call. Every
# consumer of the three large UIH features (item_id / artist_id / album_id)
# rounds to bf16 one op later anyway, so casting before the expand deletes
# that rounding at token scale and halves the expand itself. In the backward,
# the two ToCopyBackward0 casts and half the SplitWithSizesBackward0 cat go
# away and one [T,512] bf16->fp32 upcast appears in their place.
#
# NUMERICS: the forward is BITWISE EXACT -- gather and cat are pure copies, so
# rounding-then-copying equals copying-then-rounding. The BACKWARD IS
# UNCHANGED: the custom autograd Function upcasts the incoming bf16 gradient
# and runs scatter_add_ in fp32, so the ~103 duplicates per unique row still
# accumulate in fp32. Key segments below DLRMV4_EC_BF16_MIN_ROWS (default
# 100,000 -- the 1024-row contextual and candidate features) are re-expanded
# in fp32 and substituted back, because _item_forward runs
# _item_embedding_mlp OUTSIDE any autocast and would raise on a bf16 input.
#
# DEFAULT ON (1). EC_BF16_OUTPUT=0 disarms it; =1 arms
# it; the run logs "armed OK: ec_bf16_output ACTIVE ... dtype=torch.float32"
# on the first hoisted call, so the arm proves itself from the log.
make_model.ec_bf16_output = @ecbo/env_int()
ecbo/env_int.key     = "EC_BF16_OUTPUT"
ecbo/env_int.default = 1

# Tuning for the hoist itself. Both are gin so the operative config records
# them. The values below are the defaults; uncomment only to change them.
# bwd_chunk_rows caps the rows the fp32 backward materialises at once (0 = one
# shot, the default); min_rows is the size below which the hoist declines
# to cast, which keeps the 1024-row contextual/candidate features in fp32
# because _item_embedding_mlp runs outside autocast.
#   configure_ec_bf16_output.bwd_chunk_rows = 0       # 0 = no chunking
#   configure_ec_bf16_output.min_rows       = 100000  # below this, stay fp32

# ---------------------------------------------------------------------------
# EC_SEGMENT_REDUCE -- replace the hoisted expand's scatter_add_ backward with
# a sort-then-segment-reduce Triton kernel.
#
# THE ATOMICS ARE THE COST, NOT THE BANDWIDTH. The expand backward scatters
# many token rows into far fewer unique rows, and aten::scatter_add_ serialises
# every duplicate landing on the same row through a global atomic. Sorting the
# destinations first makes each output row a CONTIGUOUS SEGMENT that a single
# program folds with tl.sum, so the cold path has no atomic at all; only rows
# longer than enable_segment_reduce.split_above are cut into pieces that
# finish with one.
#
# NUMERICS: this CANNOT be bit-identical to scatter_add_ -- atomics accumulate
# in nondeterministic order, so there are no bits to match. Against an fp64
# index_add_ reference its error is lower than scatter_add_'s. It reduces in
# fp32 regardless of the gradient's dtype, matching the scatter_add_ backward.
#
# REQUIRES ec_bf16_output=1 -- the kernel replaces the backward of the HOISTED
# expand, so with the hoist off it is never reached. make_model RAISES on that
# combination rather than letting it train inert. Mutually exclusive with
# configure_ec_bf16_output.bwd_chunk_rows > 0 for the same reason (the kernel
# reads the gradient in place and never makes the copy chunking bounds).
#
# DEFAULT ON (1). EC_SEGMENT_REDUCE=0 disarms it; the run logs
# "DLRMV4 armed OK: ec_segment_reduce backward active (T=... -> U=... rows)"
# on the first backward, so the arm proves itself from the feature rather than
# from an echo of the env var.
make_model.ec_segment_reduce = @ecsr/env_int()
ecsr/env_int.key     = "EC_SEGMENT_REDUCE"
ecsr/env_int.default = 1

# Fold main_forward's uih+candidate concat_2D_jagged (item/artist/album) into
# the hoisted expand's index, and give each key its own expand so the
# SplitWithSizesBackward0 cat of per-key gradients disappears. Lives inside
# ec_bf16_output (disarms with a warning when that is off). Forward bitwise
# identical; backward is a reduction-order change only (same fp32 addends,
# per-key order). Proof of arming:
# "DLRMV4 armed OK: ec_merge_uih_candidate ACTIVE". False rolls back.
make_model.ec_merge_uih_candidate = True

# Kernel launch geometry (defaults shown below). num_warps=2: 8 warps put two
# waves on a SIMD at ~256 VGPR each and the register tile spills to scratch.
# block_s is the in-flight load count that hides HBM latency.
# split_above is for LOAD BALANCE, not occupancy: at ~54k output rows the grid
# already fills the device; 1024 sits between the segment-length p99 and p999.
# Re-time before changing any of these.
#
# They bind on enable_segment_reduce, NOT on ec_segment_reduce.py's own
# configure_segment_reduce, which forwards them. That module imports triton, so
# it is imported lazily -- i.e. AFTER train_ranker.py's strict gin parse -- and
# a binding on a configurable that is not yet registered raises "No configurable
# matching". enable_segment_reduce lives in the light module that utils.py
# imports eagerly for this reason; do not make that import lazy.
#   enable_segment_reduce.split_above = 8192
#   enable_segment_reduce.block_s     = 16
#   enable_segment_reduce.num_warps   = 2
#   enable_segment_reduce.block_w_cap = 512
# Diagnostic: dump the REAL segment-length distribution (bincount + quantile on
# each new largest call). Off for timing runs.
#   enable_segment_reduce.seg_hist = False

# EC backward optimizations default ON; set either binding False to roll back.
# Both preserve the existing sort order and fp32 reduction contract.
enable_segment_reduce.gpu_planner = True
enable_segment_reduce.fixed_size_offsets = True

# ---------------------------------------------------------------------------
# fuse_linear_norm -- fold each Linear's bias gradient into the following
# norm's backward.
#
# ContextualPreprocessor builds three MLPs, each
# Sequential(Linear, SwishLayerNorm, Linear, LayerNorm) = six (Linear, Norm)
# pairs. Autograd computes each Linear's bias gradient as a standalone
# aten::sum over the norm's dx -- a full reread of [N, D] from HBM immediately
# after the norm backward wrote it. The fused path computes that column sum
# while dx is still in registers and deletes the reread. The fused container
# is forward-identical and routes a gradient to every parameter.
#
# NUMERICS: dxsum reduces the fp32 dx in registers where aten::sum reduced the
# stored bf16 dx -- more accurate, but not bit-identical (differences at the
# bf16 rounding scale).
#
# DEFAULT ON (1). FUSE_LINEAR_NORM=0 disarms it; =1 arms
# it; the run logs "armed OK: fuse_linear_norm ACTIVE" so the arm proves itself
# from the log rather than from an echo of the env var.
make_model.fuse_linear_norm = @fln/env_int()
fln/env_int.key     = "FUSE_LINEAR_NORM"
fln/env_int.default = 1

# fuse_ln_residual: fold ContextualPreprocessor's two residual adds into the
# fused MLP's final norm epilogue.
#
#   preprocessors.py  output_seq_embeddings = output_seq_embeddings
#                                             + self._<x>_embedding_mlp(<x>)
#
# Each is a full [M, 512] read-modify-write against HBM issued immediately
# after that MLP's final LayerNorm finished writing the same tensor. It is
# forward-only: for out = LN(h) + r,
# dL/dr == dL/dout, so the residual's gradient is the incoming gradient itself.
# No saved tensors, no autocast surface.
#
# NUMERICS: the FUSION is exact; the CONTAINER is not. The kernel rounds y to the
# output dtype BEFORE adding the residual, which is exactly what the unfused
# `+` does (it adds a bf16 residual to an already-stored bf16 norm output), and
# the backward sibling _weighted_layer_norm_bwd_dx answers the same
# question the same way. But _weighted_layer_norm_fwd is @triton_autotune and
# the autotune cache key includes argument DTYPES -- so passing a RESIDUAL
# makes a distinct key, the variant is benchmarked independently, and it lands
# on BLOCK_N:2/num_warps:2 where the plain variant takes BLOCK_N:4/num_warps:4.
# A different warp count splits the 512-wide row reduction differently and
# moves rstd by one fp32 ulp. With the two variants pinned to one config the
# fused container is bit-identical to mlp(x) + r; as autotuned they can differ
# by a couple of bf16 ulp on a tiny fraction of elements. That is far below
# the step-to-step nondeterminism the model's backward already has (fp32
# atomics in aten::scatter_add_). Adding an optional tensor to an autotuned
# Triton kernel is never numerically free, however constexpr-guarded the body is.
#
# fuse_ln_residual rides inside fuse_linear_norm's container and is not
# separately armable: requesting it with FUSE_LINEAR_NORM=0 RAISES rather than
# falling back silently.
#
# BOTH DEFAULT TO 1, WHICH MAKES THE GUARD EASY TO TRIP: turning off
# fuse_linear_norm requires turning off fuse_ln_residual too --
# `FUSE_LINEAR_NORM=0` alone leaves this at 1 and the run RAISES in
# preprocessors.py. Use:
#     FUSE_LINEAR_NORM=0 FUSE_LN_RESIDUAL=0
make_model.fuse_ln_residual = @flnr/env_int()
flnr/env_int.key     = "FUSE_LN_RESIDUAL"
flnr/env_int.default = 1

get_dataset.name = %dataset
get_dataset.new_path_prefix = %DATA_PATH
# Total user-interaction-history (UIH) budget per sample, distributed evenly
# across 3 behaviour pools (listen+ / like / skip) at L//3 events each.
# Per-sample sequence the model sees =
#     3 × (L // 3) + 8 contextual + 1 candidate
# Choosing 4086 makes 3 × 1362 + 9 = 4095, the largest value that fits
# get_hstu_configs.max_seq_len = 4096 with no dataset-side truncation (the
# 4k analog of the 2039/2048 shape, where 3×679+9=2046 ≤ 2048).
# Larger L overflows the budget; the dataset truncates UIH events to fit.
# Note: like events are only 1.9% of the yambda corpus and max user lifetime
# is ~28k events, so the like pool fills to ~105 events per anchor on
# average (not 1362) — TRITON's jagged attention skips the unfilled slots,
# so the under-fill costs sequence budget but not GPU compute.
# Cache is keyed by L on disk under <processed_dir>/hstu_cache_L<N>/;
# switching L reuses an existing cache or builds a new one. Override via
# $HISTORY_LENGTH (default 4086 = the 4k-no-truncation shape; use 2039 with
# MAX_SEQ_LEN=2048 for the 2k single-task shape and its cache).
get_dataset.history_length = @hl/env_int()
hl/env_int.key     = "HISTORY_LENGTH"
hl/env_int.default = 4086

# UIH construction strategy — how a user's prior events become the sequence the
# model attends over. Override via $HISTORY_STRATEGY. Both strategies scan the
# last `scan_window` (20000) events before the anchor and consider ONLY the 3
# behavior pools (listen+ / like / skip); dislike/unlike/undislike are excluded
# (no action-weight bit), so the model's action_weights=[1,2,4] are unchanged.
# The two differ only in HOW they pick events out of that scan window:
#
#   "interleaved" (default):
#     - Budget = equal per-pool quota of HISTORY_LENGTH//3 (=1362) events; take
#       the last 1362 of EACH pool independently, then merge + re-sort by time.
#     - HISTORY_LENGTH is thus a PER-POOL cap (nominal total = 3 * L//3).
#     - Consequence: likes are only ~1.9% of the corpus, so the like pool
#       under-fills (~105 of its 1362 slots) and that budget is NOT reallocated
#       — the sequence comes up short: ~2663 events effective on average,
#       ~4.0% of them likes (i.e. likes OVER-represented vs their natural rate).
#     - Use when you want guaranteed like exposure per sample (class-balanced UIH).
#
#   "last_n":
#     - Budget = a single pool-agnostic cap: take the last HISTORY_LENGTH events
#       of ANY pool type, already chronological (no per-pool split, no re-sort).
#     - HISTORY_LENGTH is thus the LITERAL TOTAL UIH cap (not a per-pool L//3).
#     - Consequence: the sequence fills to ~HISTORY_LENGTH (the only limit is how
#       many pooled events exist in the scan window), so effective length is
#       higher and the like share falls to its natural rate: ~4085
#       events effective on average (~1.5x interleaved), ~1.2% of them likes.
#     - Trade-off: more recent listen+/skip context (longer effective sequence)
#       at the cost of fewer likes; more eval/step compute (more non-skipped
#       jagged-attention positions). Keep HISTORY_LENGTH=4086 to fill the 4k
#       model budget.
#
# Both strategies are strategy-INDEPENDENT on disk: the gather runs at
# sample-build time, so switching reuses the SAME hstu_cache_L<HISTORY_LENGTH>/
# and positions cache — no rebuild needed.
get_dataset.history_strategy = @hs/env_str()
hs/env_str.key     = "HISTORY_STRATEGY"
hs/env_str.default = "interleaved"

# Anchor-eligibility floor: a LISTEN event becomes a trainable/eval anchor once
# the user has >= MIN_HISTORY prior events. Decoupled from history_length (which
# is only the gather/truncation cap) — jagged attention handles short UIH, so we
# do not need a full history_length of context to include a sample. Requiring
# a full history_length (which drops ~60% of users) is
# MIN_HISTORY=4086, which is the default below (the reference setting); 0 would
# include ~all users AND their cold-start first event (zero prior context). Positions/anchor-ts caches are
# keyed by (L, MIN_HISTORY) so floors don't collide. Override via $MIN_HISTORY.
get_dataset.min_history = @mh/env_int()
mh/env_int.key     = "MIN_HISTORY"
mh/env_int.default = 4086

# Model-side attention budget. Dataset truncates UIH to fit this value if
# `history_length + contextual + candidate` would overflow. Override via
# $MAX_SEQ_LEN (default 4096, the 4k-no-truncation shape paired with
# HISTORY_LENGTH=4086: 3*1362+9=4095 ≤ 4096). Set MAX_SEQ_LEN=2048 with
# HISTORY_LENGTH=2039 for the 2k single-task shape.
get_hstu_configs.max_seq_len = @msl/env_int()
msl/env_int.key     = "MAX_SEQ_LEN"
msl/env_int.default = 4096

# HSTU transformer depth (number of attention layers). Default 3.
# Override per-run via $HSTU_NUM_LAYERS. NOTE: changing depth changes the model
# shape, so a run with a new depth MUST use a FRESH CKPT_PATH (incompatible with
# checkpoints of a different depth). Resolved in the full gin parse
# (get_hstu_configs is not registered during the early skip_unknown parse), so
# the @env_int reference is skipped on the first pass — same safe path as the LR knobs.
get_hstu_configs.hstu_attn_num_layers = @nl/env_int()
nl/env_int.key     = "HSTU_NUM_LAYERS"
nl/env_int.default = 3

# --- streaming (temporal-order) training -------------------------------------
# Only consumed under `--mode streaming-train-eval`; the default train-eval
# path above is unaffected. Trains time window T then evals window T+1,
# advancing forward in wall-clock time (no future leakage). Window size is the
# temporal-ordering granularity knob (default 1 day). num_train_ts is clamped
# to the dataset's available window count at runtime; override via $NUM_TRAIN_TS.
get_dataset.streaming_window_seconds = 86400
get_dataset.streaming_sort_within_window = False
# Offline time-window index (ts_indices_*/ts_offsets_*.npy, int64, 8 bytes per
# anchor, ~18.3 GB for hstu_cache_L4086). Without it every window boundary masks
# the whole 17 GiB timestamp array; with it the lookup is a slice and
# window/sample counts are offset arithmetic. Built once per
# (positions file, window_seconds) during dataset init, before RUN_START, or
# beforehand (verified, with a sidecar) with `scripts/ts_index_tool.py prebuild`.
# Default ON here (upstream default is False). $DL_WINDOW_INDEX=0 restores the
# full-scan path.
# MIN_HISTORY=0/1 (>2^32 anchors): this backend builds ~37 GB (int64) per
# cache location in dataset init.
# Prebuild it offline (ts_index_tool.py prebuild --min-history 0) or set
# DL_WINDOW_INDEX=0. uint32 window_index_* files are not used.
get_dataset.use_offline_ts_indices = @swi/env_int()
swi/env_int.key     = "DL_WINDOW_INDEX"
swi/env_int.default = 1
# In-window shuffle to break user-major batching (consecutive sliding-window
# anchors otherwise come from the same few users -> few unique embedding reads).
# Diversity dial in [0,1] -- the AGREED, config-invariant benchmark knob. Maps to
# a within-segment shuffle with K = round(fraction * per-window train-anchor
# count): 0 = off (user-major, page-local mmap scans), 1 = full per-element
# shuffle (max diversity), intermediate = interpolation. Same fraction => same
# diversity regardless of world_size / #nodes / batch_size.
#
# Default 0.0 (no shuffle -> user-major, page-local mmap scans) so the standard
# run matches the production streaming order. Together with the fixed seed below
# the in-window order is fully DETERMINISTIC and identical across runs/resumes.
# Override per-run via $STREAMING_SHUFFLE_FRACTION (e.g. 1.0 for a full
# per-element shuffle / max diversity, 0.03 for the diversity/locality sweet spot).
streaming_shuffle_fraction = 0.0
get_dataset.streaming_shuffle_fraction = @ssf/env_float()
ssf/env_float.key     = "STREAMING_SHUFFLE_FRACTION"
ssf/env_float.default = %streaming_shuffle_fraction
# Fixed shuffle seed -> reproducible permutation. Exposed as a knob; override via
# $STREAMING_SHUFFLE_SEED only if you deliberately want a different draw.
get_dataset.streaming_shuffle_seed = @ssfseed/env_int()
ssfseed/env_int.key     = "STREAMING_SHUFFLE_SEED"
ssfseed/env_int.default = 0
# User-level train:eval holdout for the streaming path. With tsp<1.0, the top
# (1 - tsp) fraction of users (by a deterministic hash of uid+split_salt) are
# held out as a FIXED eval set and never trained -> no temporal/user leakage,
# stable comparable eval curve, bounded eval time. split_salt lets you draw a
# different holdout without changing the ratio. Override salt via $SPLIT_SALT.
get_dataset.train_split_percentage = %TRAIN_SPLIT_PERCENTAGE
get_dataset.split_salt = @ssalt/env_int()
ssalt/env_int.key     = "SPLIT_SALT"
ssalt/env_int.default = 0
make_streaming_dataloader.batch_size = %batch_size
make_streaming_dataloader.num_workers = %num_workers
make_streaming_dataloader.prefetch_factor = %prefetch_factor
make_persistent_streaming_dataloader.batch_size = %batch_size
make_persistent_streaming_dataloader.num_workers = %num_workers
make_persistent_streaming_dataloader.prefetch_factor = %prefetch_factor
# Allocate each batch in pinned (page-locked) host memory, via the DataLoader's
# pin thread calling Samples.pin_memory() on the KJTs.
#
# Why it matters: a GPU can only DMA out of pinned pages. Handed a pageable
# source, the driver instead copies it into an internal pinned bounce buffer and
# then DMAs from there, and the calling thread blocks for the whole round trip.
# At bs=1024 the batch is ~215 MB, so the trainer would sit idle in
# `Samples.to(device)` for that staged copy. Pinning up front makes
# the copy a single real DMA, and it happens on the loader's own thread, one
# batch ahead, instead of on the critical path.
#
# Set DL_PIN_MEMORY=0 to disable.
pin_memory = @pin/env_int()
pin/env_int.key     = "DL_PIN_MEMORY"
pin/env_int.default = 1
make_streaming_dataloader.pin_memory = %pin_memory
make_persistent_streaming_dataloader.pin_memory = %pin_memory
streaming_train_eval_loop.num_train_ts = @nts/env_int()
nts/env_int.key = "NUM_TRAIN_TS"
# 299 daily windows -> with start_ts=0 the run covers ts=0..298, the full corpus.
# Clamped to the dataset's available window
# count at runtime. Override via $NUM_TRAIN_TS.
nts/env_int.default = 299
# Anchors need >= history_length prior events, so the first ~130 daily windows
# are near-empty warm-up. Default start_ts=0 trains the full corpus from the
# start; set $START_TS=150 to skip warm-up and
# begin at a dense window. Override via $START_TS.
streaming_train_eval_loop.start_ts = @sts/env_int()
sts/env_int.key = "START_TS"
sts/env_int.default = 0
# Per-step metric logging cadence. Default 0 = training-side metric logging
# OFF; this binding is the single source of the default. Opt-ins: 50 (coarse
# debugging metrics), 1 (every step emits a parseable "Step N metrics" line,
# e.g. for trajectory comparison). Throughput comparisons set METRIC_LOG_FREQ
# explicitly, with the same value in every run.
# METRIC_LOG_FREQ=0 disables training-side metric logging COMPLETELY (no per-step
# torchmetrics update, no train compute_and_log / perf lines, no LR or unique-emb
# diagnostics); step bookkeeping, eval and every MLLOG event are unchanged, and
# the MLPerf train_loss cadence is set separately by mltlf below (default 0 = OFF). Armed
# log (rank 0): "armed OK: training metrics OFF (METRIC_LOG_FREQ=0): no train
# metric update/compute_and_log". env_int returns 0 for an explicit "0".
streaming_train_eval_loop.metric_log_frequency = @mlf/env_int()
mlf/env_int.key     = "METRIC_LOG_FREQ"
mlf/env_int.default = 0
# Interim eval logging: when >0, log partial-holdout metrics every
# METRIC_LOG_FREQ batches DURING an eval pass (debug/progress only). The durable
# <LOG>.metrics.jsonl, early-stop, and MLPerf EVAL_ACCURACY all use ONLY the
# end-of-pass whole-holdout compute(), so these interim calls are redundant AUC
# reductions (a BinnedCumulativeAUC histogram all-reduce + GPU->CPU sync per
# call, x window_ and lifetime_ sets). 0 (default) = OFF -> skip them.
#
# *** AUC-METRIC NEUTRAL — toggling this NEVER changes the reported eval AUC. ***
# WHY (by construction): every eval batch's predictions/labels are folded into
# the metric state via metric_logger.update() UNCONDITIONALLY, once per batch,
# regardless of this flag. The reported eval AUC is the SINGLE end-of-pass
# metric_logger.compute(mode="eval") over the whole holdout, which is a pure
# function of that accumulated state (BinnedCumulativeAUC integrates its score
# histogram; compute() does NOT mutate the histogram). The interim
# compute_and_log() calls this flag gates only READ that same state to print a
# running partial-holdout number — they cannot alter what update() accumulated,
# so the final AUC is identical whether they fire 0 or N times. This is why the
# flag is safe to leave OFF by default (pure logging removal, not a metric change).
# Override via $EVAL_INTERIM_LOG.
streaming_train_eval_loop.eval_interim_metrics = @eil/env_int()
eil/env_int.key     = "EVAL_INTERIM_LOG"
eil/env_int.default = 0
# MLPerf train_loss MLLOG cadence (submission logging profile).
# Default 0 = OFF: no train_loss event and no per-step cross-rank loss all_reduce.
# MLPerf Training 6.1 does not require train_loss (no compliance-checker rule); every
# required MLLOG event (run/init/block/eval, eval_accuracy with samples_count,
# cache_clear, hyperparameter and submission keys) is unaffected. Independent of
# METRIC_LOG_FREQ. Opt in with $MLPERF_TRAIN_LOSS_LOG_FREQ=N (N > 0; 1 for per-step
# MLLOG timing); throughput comparisons set it, together with METRIC_LOG_FREQ, to the
# same values in every run. Disable the whole MLPerf stream with $MLPERF_LOGGING=0
# (never for submission: early stop reads window_auc through it).
streaming_train_eval_loop.mlperf_train_loss_log_frequency = @mltlf/env_int()
mltlf/env_int.key     = "MLPERF_TRAIN_LOSS_LOG_FREQ"
mltlf/env_int.default = 0
# Diagnostic: log per-batch unique/total embedding-id counts on logged steps
# (rank 0). Quantifies the user-major batching redundancy and the realized
# diversity from get_dataset.streaming_shuffle_fraction. Off; set $DIAG_UNIQUE_EMB=1.
streaming_train_eval_loop.streaming_diag_unique_emb = @due/env_int()
due/env_int.key     = "DIAG_UNIQUE_EMB"
due/env_int.default = 0
# Chrome trace capture: reuses the shared Profiler.* bindings below (5-step
# window at step 52). The streaming step counter advances across train+eval
# batches, so step 52 lands in the first (train) window's compute. Off by
# default to avoid profiler overhead in production runs; set $OUTPUT_TRACE=1.
streaming_train_eval_loop.output_trace = @ot/env_int()
ot/env_int.key     = "OUTPUT_TRACE"
ot/env_int.default = 0
# Reuse one DataLoader (persistent workers) across windows instead of respawning
# per window. Skip eval to isolate window-reset cost. Override via env.
streaming_train_eval_loop.persistent_loader = @pl/env_int()
pl/env_int.key = "PERSISTENT_LOADER"
pl/env_int.default = 1
# ---- Eval cadence: choose EXACTLY ONE of the two knobs below ----------------
# The streaming loop can decide WHEN to run the full-holdout eval pass in one of
# two ways. They are MUTUALLY EXCLUSIVE — enabling the data-fraction cadence
# (EVAL_EVERY_DATA_PCT>0) requires EVAL_EVERY_N_WINDOWS=0; setting both >0 raises
# a ValueError at startup. The final end-of-run eval always runs in either mode.
#
# (1) PER-WINDOW cadence (EVAL_EVERY_N_WINDOWS).
# Full-holdout eval cadence (single knob). 0 (default) = per-window cadence OFF
# -> defer to the
# data-fraction cadence below (EVAL_EVERY_DATA_PCT); if that is also 0, eval is
# disabled entirely (train-only, e.g. benchmarking; the
# eval dataloader isn't even built). 1 = eval after every window. N>1 (e.g. 5
# via $EVAL_EVERY_N_WINDOWS) = eval every Nth window (and always the final one)
# to amortize the cost of consuming the full next-day eval window. The cadence is
# anchored to the absolute ts grid so eval points stay stable across a mid-run
# resume.
# NOTE: each daily window has a DIFFERENT number of training samples, so a
# per-window cadence produces eval points that are UNEVENLY spaced in terms of
# how much data was trained between them. This is why the data-fraction cadence
# below is the default; enable this per-window knob only if you specifically
# want eval anchored to the daily window grid.
streaming_train_eval_loop.eval_every_n_windows = @evn/env_int()
evn/env_int.key = "EVAL_EVERY_N_WINDOWS"
evn/env_int.default = 0
#
# (2) DATA-FRACTION cadence (EVAL_EVERY_DATA_PCT).
# Run the full-holdout eval every time the run has trained this FRACTION of the
# run's TOTAL training data, so eval points are EVENLY spaced by data volume
# (compute), independent of how many samples each daily window happens to hold.
# This avoids the per-window cadence's uneven spacing noted above.
#   value semantics (it is a fraction in (0, 1], NOT a percent number):
#     0.0            = OFF  -> fall back to the per-window EVAL_EVERY_N_WINDOWS;
#                      if that is also 0, eval is disabled entirely (train-only).
#     0.001 (default)= eval every 0.1% of the data -> ~1000 eval points total.
#     0.005          = eval every 0.5% of the data -> ~200 eval points total.
#     0.01           = eval every 1%  of the data  -> ~100 eval points total.
#     0.05           = eval every 5%  of the data  -> ~20  eval points total.
#     0.10           = eval every 10% of the data  -> ~10  eval points total.
# How "fraction of data" becomes an eval trigger: at startup the fraction is
# converted ONCE into a global train-step interval
#     eval_interval_steps = round(pct * total_train_anchors / (batch_size * world_size))
# where total_train_anchors is counted over the ORIGINAL requested window range
# [start_ts, start_ts+num_train_ts). Eval then fires whenever the monotonic
# train global_step crosses a multiple of that interval (it can fire MID-WINDOW,
# i.e. partway through a daily window, and across window boundaries). Because the
# interval is computed over the original range and global_step is
# checkpoint-restored, the eval grid is identical on a cold start and on every
# resume. Each eval record's label carries "@step=<global_step>" so the
# trajectory can be plotted against data volume. Override via $EVAL_EVERY_DATA_PCT.
streaming_train_eval_loop.eval_every_data_pct = @edp/env_float()
edp/env_float.key     = "EVAL_EVERY_DATA_PCT"
edp/env_float.default = 0.001
# ---- SKIP_EVAL_EPOCH_PCT: warm-up eval skipping (early-run overhead cut) ----
# WHAT IT DOES
#   Suppresses every *scheduled/periodic* full-holdout eval pass until the run
#   has trained a given FRACTION OF THE EPOCH. Early in a run the model sits far
#   below the AUC target, so those eval points carry no signal -- yet each one is
#   a real cost (a forward sweep over the whole held-out set plus its metric
#   all-reduce). On this benchmark the holdout is close to the size of the
#   training data between two eval points, so evaluating at every point spends
#   a large share of the run on eval.
#
# VALUE SEMANTICS -- a FRACTION of the epoch, not a percent number and not a
# count of eval passes:
#     0.0    = OFF -> eval from the very first scheduled point.
#     0.01   = start eval once 1% of the epoch has been trained.
#     0.025  = DEFAULT -> start at 2.5% of the epoch (the GBS=8192 value; see
#              the per-GBS table below -- this knob is GBS-DEPENDENT).
#   "Epoch" here is total_train_samples, the SAME denominator MLPerf EPOCH_NUM
#   uses, so the value can be read straight off an epoch-vs-eval_accuracy plot.
#
# HOW THE FRACTION BECOMES A SKIP DECISION
#   At startup the fraction is resolved ONCE into a global train-step threshold
#     skip_eval_until_step = CEIL(pct * total_train_samples / global_batch_size)
#   (global_batch_size = per-rank batch_size * world_size). Any scheduled eval
#   boundary landing at global_step < skip_eval_until_step is skipped; the first
#   boundary at or after it runs, and every boundary after that runs normally.
#   Both cadences consult the same threshold:
#   * DATA-FRACTION cadence (EVAL_EVERY_DATA_PCT>0): boundaries fire at
#     k*eval_interval_steps; those below the threshold are skipped.
#   * PER-WINDOW cadence (EVAL_EVERY_N_WINDOWS>0): eval-eligible windows whose
#     global_step is still below the threshold are skipped.
#   Rounding is UP, so eval never starts earlier than the requested fraction.
#   The startup log line `[skip-eval] skip_eval_epoch_pct=... ->
#   skip_eval_until_step=...` records the resolved threshold.
#
# CHOOSING A VALUE (target AUC 0.75)
#   The start point must scale with GBS: the earliest possible crossing of the
#   target moves later in epoch terms as GBS grows. The default (-1) uses a
#   line in GBS through the earliest crossings at GBS 8192 and 32768, backed
#   off by a MARGIN OF 2 EVAL BLOCKS (2*2,293,760 = 4,587,520 samples) so a
#   fast seed cannot cross the target before the first eval fires:
#       start_eval_samples = FLOOR((4480*GBS + 135331840) / 3)
#       pct                = start_eval_samples / total_train_samples
#   One eval block is eval_interval_steps*GBS = 2,293,760 samples at all three
#   GBS (280/140/70 steps). Use that, NOT the nominal EVAL_EVERY_DATA_PCT *
#   total_train_samples (= 2,290,835): the grid is rounded to whole steps, so the
#   nominal value leaves the margin a fraction of a step short and the CEIL in
#   the threshold resolution rounds it back up into a whole MISSED eval.
#   Resulting values: 0.025 / 0.0303 / 0.041 at GBS 8192 / 16384 / 32768.
#   A positive value overrides the default, 0 disables skipping.
#
# RESUME SAFETY / RANK SAFETY
#   The threshold depends only on total_train_samples and the global batch size,
#   and is compared against the monotonic, checkpoint-restored global_step --
#   never a per-process or per-rank counter. So the skipped set is IDENTICAL on
#   a cold start and on every mid-run resume, and every rank reaches the same
#   verdict (a per-rank disagreement here would deadlock the next collective).
#
# WHAT IS NEVER SKIPPED
#   The end-of-run FINAL eval always runs (it is the definitive convergence
#   number), and early-stop / MLPerf EVAL_ACCURACY fire normally once eval
#   starts. This knob only removes early *periodic* passes; it never changes the
#   training trajectory, only how often the model is measured.
# Override via $SKIP_EVAL_EPOCH_PCT.
streaming_train_eval_loop.skip_eval_epoch_pct = @seep/env_float()
seep/env_float.key     = "SKIP_EVAL_EPOCH_PCT"
seep/env_float.default = -1.0
# Double-buffer windows: prepare the next window (index mask + first-batch
# prefetch) in a background thread during the current window's compute, hiding
# the per-window reset. Needs persistent_loader=1. Override via env.
streaming_train_eval_loop.double_buffer = @db/env_int()
db/env_int.key = "DOUBLE_BUFFER"
db/env_int.default = 1
# -----------------------------------------------------------------------------
# COLD-START BUNDLE: DataLoader pre-start + cold first-batch prefetch + BLAS
#     first-use warmup + startup preload. Turns the one-time startup cost of the
#     first training step (worker fork, first-use library init / code-object
#     load, cold first reads) into untimed initialization or overlapped I/O, so a
#     run that starts from a FLUSHED page cache (the launcher's MLPerf cache
#     flush) does not pay them serially inside the timed region.
#   (a) DataLoader pre-start (prestart_streaming_loaders, $DL_PRESTART).
#     WHAT: build the streaming dataset object and fork the train pool(s) (one
#     chained pool with DL_SINGLE_POOL=1) and the persistent eval pool BEFORE
#     INIT_STOP/RUN_START, each with an
#     EMPTY sampler window: no index is handed out and no sample is read,
#     prefetched or collated before RUN_START; the first window's iter() is then
#     a reset of running workers. The global CPU RNG state is saved/restored
#     around the forks and the draws are replayed where the loop makes them, so
#     the sample order is identical to DL_PRESTART=0. On the data-fraction eval
#     cadence the eval pool's startup fill (batches the legacy path reads after
#     RUN_START and then discards unconsumed at the first eval's reset) is
#     skipped: no eval changes (same holdout set, order and metric).
#     PROOF (rank 0, once, after the first step): the "[dlstart] timeline" line
#     stamps worker-ready before and the first worker read after RUN_START and
#     prints "compliance OK".
#     Before RUN_START only setup happens: the dataset object opens and maps
#     the data files (headers only, no sample bytes), the small artist/album
#     mapping tables are read, and the worker processes are started idle. Every
#     sample is read after RUN_START. Each run logs a per-node page-cache count
#     right before RUN_START (sample pages resident, zero after the flush), and a
#     hard guard refuses to release the samplers or start the prefetch earlier.
#   (b) Cold first-batch prefetch (dlrm_v4/train/cold_prefetch.py; level 2 of
#     $DL_PRESTART, or $DL_COLD_PREFETCH=1|2). AFTER RUN_START, when the sampler
#     is released, one thread per rank issues fadvise(WILLNEED) over the byte
#     ranges of this rank's first batches, so a flushed cache is refilled by
#     parallel I/O instead of serial page faults. Runs inside the timed region.
#     Advice only: bytes, order and windows unchanged. ARMED: "[cold-prefetch]".
#   (c) BLAS first-use warmup (run_blas_warmup, $BLAS_WARMUP). Runs every GEMM
#     family the first forward+backward uses (bf16/fp32 addmm/mm/baddbmm with the
#     production epilogues, FP8 _scaled_mm, the residual-fused hipBLASLt
#     extension, the data-free FP8 output-scale-mode probe) once on synthetic
#     torch.full/ones tensors at a small row count ($BLAS_WARMUP_M) that no real
#     batch produces, so handle / TunableOp operator construction and code-object
#     load leave the timed region. Touches no module, parameter, buffer,
#     optimizer, FP8 scale or weight cache, calibration counter, autotune table,
#     BLAS pin or RNG stream (generator states checked and restored); a TunableOp
#     miss with tuning off records nothing, so it cannot shadow a later pin.
#     Library initialization only, like the C++ extension prebuild; no data is read.
#     ARMED (every rank): "armed OK: [blas-warmup]". A failing GEMM warns only.
#   (d) Startup preload (run_startup_preload, same switch as (c)), right AFTER
#     the pre-start forks: imports the FlyDSL attention kernel modules (library
#     load, no kernel launched), JIT-builds the WLN_BWD_FLYDSL FlyDSL
#     LayerNorm-backward kernels by launching each once on synthetic zero/one
#     tensors (no data, no RNG, outputs discarded; skip only that with
#     run_startup_preload.ln_bwd = 0) and runs one gc.collect()+gc.freeze(),
#     so the first in-loop collect walks only post-RUN_START objects. ARMED:
#     "armed OK: [startup-preload]".
#   IMPACT: removes most of the first-step startup wait from the timed region;
#     no effect on the steady training rate. Untimed initialization grows (well
#     inside the 30-minute limit).
#   NUMERICS: BIT-IDENTICAL training state and sample order (no training state
#     or RNG draw moves; DataLoader worker seeds may differ, which yambda's
#     RNG-free dataset does not use).
#   Opt out: DL_PRESTART=0 (pre-start and prefetch), DL_PRESTART=1 (pre-start
#     without prefetch) or DL_COLD_PREFETCH=0; BLAS_WARMUP=0 (warmup + preload).
prestart_streaming_loaders.enabled = @dlps/env_int()
dlps/env_int.key = "DL_PRESTART"
dlps/env_int.default = 2
# The other bindings mirror the loop's own macros (same pools as the loop).
prestart_streaming_loaders.persistent_loader = @pl/env_int()
prestart_streaming_loaders.double_buffer = @db/env_int()
prestart_streaming_loaders.eval_num_workers = @enw/env_int()
prestart_streaming_loaders.eval_every_n_windows = @evn/env_int()
prestart_streaming_loaders.eval_every_data_pct = @edp/env_float()
run_blas_warmup.enabled = @blasw/env_int()
blasw/env_int.key = "BLAS_WARMUP"
blasw/env_int.default = 1
# Warmup GEMM row count ($BLAS_WARMUP_M): a token count no real batch produces,
# so no production TunableOp key is resolved early.
run_blas_warmup.m = @blaswm/env_int()
blaswm/env_int.key = "BLAS_WARMUP_M"
blaswm/env_int.default = 16
run_startup_preload.enabled = @blasw/env_int()
#
# FP8 first-use warmup before RUN_START (extends the cold-start bundle;
#     $FP8_WARMUP; train_ranker -> dlrm_v4/train/fp8_warmup.py).
#     Armed at tier 2 by the binding below (the code default when the binding
#     is absent is OFF).
#     WHAT: after the DataLoader pre-start (only when DL_PRESTART forked the
#     pools) and before the startup preload, the allocator pre-grow and
#     INIT_STOP/RUN_START, train_ranker calls the production FP8 kernel
#     wrappers once on synthetic zero-filled tensors of the production shape
#     class, so the Triton/FlyDSL compiles of the kernels the bf16->FP8 switch
#     first uses happen in untimed initialization: the FlyDSL e4m3 attention
#     forward (FWD_PIPE config) and full-FP8 backward (dq-split with
#     the BWD_ATTN_V2 tokens, and the BWD_DQ_E5M2 e5m2 dq sink), the
#     targets-only delta attention (DELTA_FWD_BM16 short-block forward, BWD_VKP_V2
#     VK-producer backward), the FP8 LayerNorm variants (BWD_STORE_T_V2 token-major
#     store), the e4m3 LN*U*dropout forward (LNMD_FWD_MASKGEN mask-generating
#     kernel), the backward casts and the BWD_HELPERS_FUSED kernels, the
#     WSHADOW_FUSED weight-shadow refresh (singly and batched) and the
#     FWD_U_DP U-slice data-parallel GEMM. FP8_WARMUP=2 adds the bf16
#     calibration-window kernels (Triton main and delta attention, FlyDSL bf16
#     backward, bf16 LN*U*dropout forward). Items whose production operands
#     are always larger than 2 GiB run on storages larger than 2 GiB (the AMD
#     Triton backend compiles one variant per storage-size class);
#     FP8_WARMUP_STORES=both adds the large class for operands that straddle
#     2 GiB from batch to batch. The allocator pre-grow gets a
#     converge pass that maps the device memory the warmup's libraries hand
#     back only during the pre-grow (a no-op without the warmup).
#     IMPACT: moves those first-use compiles, including FlyDSL builds that no
#     kernel cache covers, out of the FP8 switch step and the first training
#     steps into initialization; untimed initialization grows. No effect on
#     the steady step.
#     NUMERICS: none. Synthetic tensors only: no module forward, autograd
#     Function, parameter value, optimizer, FP8 scale or calibration state,
#     FP8 weight-shadow cache, dataset or dataloader is read or written.
#     Every once-latch, counter, workspace and cache the wrappers touch is
#     restored, autotune keys it adds are dropped, the RNG is checked and
#     restored.
#     RULES: MLPerf training_rules.adoc (initialization, including
#     JIT on synthetic inputs, is untimed; the clock starts before the dataset
#     is touched, and this touches none; the state at RUN_START
#     equals a fresh initialization: FP8_WARMUP_VERIFY=1 hashes the dense
#     model state and digests the FP8 modules' globals before and after).
#     ARMED log (every rank, tagged rank=R): "armed OK: [fp8-warmup] tier=...
#     ok=... skip=... fail=... items=..."; a changed guard logs "[fp8-warmup] NOT armed:
#     guard ... changed" on the rank that saw it. Per-item failures warn and
#     continue; nothing here aborts the run. Knobs:
#     FP8_WARMUP_STORES=small|both (default small),
#     FP8_WARMUP_SKIP=F1,W1,..., FP8_WARMUP_QUIET=1, FP8_WARMUP_VERIFY=1,
#     FP8_WARMUP_N11=1.
#     TM_NONEXP's private token-major pool is held off during the warmup
#     (the wrappers allocate from the main pool) and prewarmed by the
#     allocator pre-grow afterwards.
#     Kill switch: FP8_WARMUP=0.
# env_str (not env_int): the function parses it inside its own try, so a
# malformed FP8_WARMUP warns and skips instead of raising before RUN_START.
run_fp8_first_use_warmup.enabled = @fp8w/env_str()
fp8w/env_str.key = "FP8_WARMUP"
fp8w/env_str.default = "2"
#
# DLRM_HSTU_FP8_WARMUP_F2E: the
#     e8 bwd_dkdv build in the FP8 first-use warm-up (on top of FP8_WARMUP
#     and DKDV_E5M2; dlrm_v4/train/fp8_warmup.py warmup case F2e). Code default ON
#     (absent or "1"); the binding below states it; the env var of the same
#     name wins over gin.
#     WHAT: with DKDV_E5M2 on, every engaged ordinary-layer backward hands the
#     FlyDSL backward a DkdvE5m2Sink, a second bwd_dkdv compile key (F2's key
#     plus e8emit="only") that otherwise compiles at the first engaged call,
#     inside the timed region. F2e makes that call in the warm-up on
#     synthetic zeros with the sinks of an engaged call (the dV|dK sink and, on
#     the joint path, the dq sink adopting the same dz8), then the finishes
#     the engaged call runs, for F2's N list.
#     IMPACT: the e8 FlyDSL build leaves the first engaged training step;
#     untimed initialization pays it instead. No effect on the steady step.
#     NUMERICS: none (bit-identical). Synthetic tensors and local sink
#     objects only; every latch and container it touches is restored
#     (FP8_WARMUP_VERIFY=1 checks the dense state, the RNG and the FP8
#     modules' globals).
#     ARMED (every rank, tagged rank=R): "[fp8-warmup] item=F2e
#     flydsl_bwd_full_fp8_e8 N=<N> store=big path=b1a_joint ok ...
#     e8_builds_new=<k> rank=R" for each N of F2's list, and "F2e:" in the
#     items= of the warm-up's armed OK line. Must be ABSENT: "path=b1a_joint
#     FAIL(", "E1 sink not engaged".
#     Opt out (kill switch): DLRM_HSTU_FP8_WARMUP_F2E=0 (or
#     FP8_WARMUP_SKIP=F2e); rank 0 then logs "[fp8-warmup] item=F2e
#     flydsl_bwd_full_fp8_e8 skip(reason=...)".
apply_env_bootstrap.DLRM_HSTU_FP8_WARMUP_F2E = True
#
# F2r: every RPP bucket of the two e5m2 sink finalizers in the FP8
#     first-use warm-up (dlrm_v4/train/fp8_warmup.py item F2r). Code default ON (absent or
#     "1"); the binding below states it; the env var of the same name wins
#     over gin.
#     WHAT: the E1 sink's finalizer (_e8_fin_kernel, DkdvE5m2Sink.finish)
#     and the dq sink's (_dq8_fin_kernel, _dq8_finalize) specialize on
#     RPP = rows per program = 8*ceil(ceil(rb/256)/8), rb = (M+127*B)//128+1
#     for a layer call of M rows. F2e/F2q reach RPP 8 only and the TSPEC
#     table holds 64..88, so an engaged step whose M reaches another RPP
#     compiles both kernels inside the timed region. F2r
#     calls both finalizers through the production wrappers once per RPP
#     bucket of M = 0 .. B*4096 (B = 1024: RPP 8..136, 17 per kernel) on
#     synthetic partials of the bucket's largest M whose all-zero row prefix
#     masks every row (nothing is read), under F2e's (e8) and F2q's (dq8)
#     preconditions.
#     IMPACT: no fin-kernel compile after RUN_START at any scale, window or
#     data order. Untimed initialization pays the new compiles once per
#     rank: 24 at B = 1024 with the TSPEC table (64..88) and F2e/F2q (8)
#     already in. No effect on the steady step.
#     NUMERICS: none (bit-identical). The same Triton L1 keys and binaries
#     the engaged steps would otherwise compile on demand (no kernel source change);
#     synthetic local tensors only, no RNG draw, no model / optimizer / FP8
#     scale state (FP8_WARMUP_VERIFY=1 checks).
#     ARMED (every rank, tagged rank=R): "[fp8-warmup] item=F2r sink_fin_rpp
#     B=<B> M<=<4096*B> ok ... e8_rpp=8..136/17 dq8_rpp=8..136/17 rank=R"
#     (B = 1024, both sinks on) and "F2r:1" in the items= of the warm-up's
#     armed OK line. Must be ABSENT: "item=F2r sink_fin_rpp" with "FAIL(";
#     with TRITON_SPEC_MONITOR=1, _e8_fin_kernel / _dq8_fin_kernel in the
#     kernels= of "[triton-spec] monitor post-run_start".
#     Opt out (kill switch): DLRM_HSTU_FP8_WARMUP_FIN_RPP=0 (or
#     FP8_WARMUP_SKIP=F2r); rank 0 then logs "[fp8-warmup] item=F2r
#     sink_fin_rpp skip(reason=...)".
apply_env_bootstrap.DLRM_HSTU_FP8_WARMUP_FIN_RPP = True
# -----------------------------------------------------------------------------
# EVAL LOADERS: BIT-IDENTICAL BATCHED BATCH BUILDER (datasets/yambda.py
#     DLRMv4YambdaDataset.build_batch; switches in datasets/dataset.py, applied
#     by train/utils.py fast_batch_pools, bound below).
#     WHAT: every eval batch is built by one batched numpy pass written straight
#     into the collated key-major layout, instead of one Python-list KJT per
#     sample followed by collate_fn. The per-anchor history selection is the
#     per-sample path's own numpy code; the feature gathers and per-anchor
#     scalars run once over the whole batch; the cross-feature ids come from a
#     bit-exact vectorized XXH64; inside a DataLoader worker the output tensors
#     are allocated in shared memory, so handing the batch to the trainer is
#     not a copy.
#     collate_fn passes the finished batch through. Every eval loader uses it:
#     the persistent eval pool (pre-started by the cold-start bundle or built by the loop,
#     reused for the final eval) and the per-call eval loaders of the paths
#     without double buffering. A layout the builder does not cover falls back
#     to the per-sample path (still bit-exact) with a one-time "[fast-batch]
#     build_batch not used (...)" warning. The train pools have their own
#     switch, DL_FAST_BATCH (below).
#     WHY: the holdout eval pass is bound by its input pipeline. Building a
#     batch the per-sample way costs a worker more CPU time than the eval
#     forward of that batch takes, so every rank waits on its eval loader and
#     the slowest rank stalls the lockstep collectives. The batched build needs
#     a small fraction of that CPU time.
#     IMPACT: shorter eval passes at every node count; a pass whose data is not
#     yet in the page cache stays bound by disk reads. Training steps are not
#     touched (the train pools have their own switch below). COST: no extra
#     compute; the eval pool's prefetch queue can now fill to its bound
#     (PREFETCH_FACTOR x EVAL_NUM_WORKERS batches per rank), so more eval
#     batches sit in shared memory during a pass.
#     MLPERF: a data-loader implementation change only. Each eval pass reads
#     the same holdout samples in the same order, batched the same way, and
#     every tensor value is identical (the collated batches are bit-identical
#     to the per-sample path's); eval cadence, metric and target unchanged. No
#     sample is read before RUN_START: the pools are still forked with empty
#     sampler windows (cold-start bundle). Nothing is cached across eval passes: every
#     pass builds every batch again from the dataset.
#     NUMERICS: BIT-IDENTICAL eval inputs, hence identical eval results.
#     ARMED (every rank, tagged rank=R, once per pool kind, at pool setup):
#     "armed OK: [fast-batch] eval pools: fast builder (build_batch;
#     DL_FAST_BATCH_EVAL=1, gin default)" ("env" instead of "gin default"
#     when the variable is set; the train pools' line: see below). Every
#     rank, worker 0 of each eval pool, at its first batch: "armed OK:
#     [fast-batch] DL_FAST_BATCH_EVAL=1: batched yambda
#     build (pid ..., worker 0, first batch ...)". Must be ABSENT:
#     "[fast-batch] build_batch not used".
#     Opt out: DL_FAST_BATCH_EVAL=0 (every eval loader back on the per-sample
#     path; each rank's line then reads "[fast-batch] eval pools: per-sample
#     path"). DL_FAST_BATCH_EVAL=-1 makes the eval loaders follow
#     DL_FAST_BATCH. An integer read through env_int, like the
#     other DL_* switches.
fast_batch_pools.eval_pools = @dlfbe/env_int()
dlfbe/env_int.key = "DL_FAST_BATCH_EVAL"
dlfbe/env_int.default = 1
#
# TRAIN POOLS: BIT-IDENTICAL BATCHED BATCH BUILDER (extends the eval batched
#     builder to the single chained train pool; datasets/yambda.py
#     DLRMv4YambdaDataset.build_batch; switch in datasets/dataset.py, resolved
#     by train/utils.py fast_batch_pools, bound below).
#     WHAT: the train pool's workers build every train batch the way the
#     eval workers build the eval batches: one batched numpy pass
#     written straight into the collated key-major layout instead of one
#     Python-list KJT per sample followed by collate_fn. With
#     DL_FAST_BATCH_ONESTORE and DL_PIN_FREE_SHM on (their gin defaults) each
#     train batch is then one shared-memory
#     storage whose UIH/candidate tensors are views of the merged tensors,
#     pinned by the pool's pin thread with one copy, its shared memory
#     released after the pin. Sampler, sample order, batches, per-window
#     counts, drop_last, resume skip, worker count and prefetch depth are
#     unchanged; only how a worker builds a batch changes. A layout the
#     builder does not cover falls back to the per-sample path (still
#     bit-exact) with the same one-time "[fast-batch] build_batch not used
#     (...)" warning.
#     WHY: with the per-sample builder a rank's train workers produce batches
#     only a little faster than the trainer consumes them, so whenever they
#     slow down (cold page-cache reads after the MLPerf cache flush,
#     long-history samples, CPU contention on the node) the slowest rank
#     waits on its loader and stalls the lockstep collectives. The batched
#     build needs a small fraction of that CPU time, so the pool keeps its
#     prefetch queue filled.
#     IMPACT: the train steps stop waiting on the loader where the per-sample
#     builder could not keep up: at one node, the early windows of a run
#     started on a flushed page cache. At two and four nodes each rank builds
#     fewer batches per window; the effect there is expected to be smaller.
#     COST: no extra compute (less worker CPU per batch). A queued train
#     batch is one storage of about half the bytes of a per-sample batch, but
#     the prefetch queue (PREFETCH_FACTOR x NUM_WORKERS batches per rank) now
#     fills to its bound, so that bound sets the host memory held in queued
#     train batches.
#     NUMERICS: BIT-IDENTICAL inputs: the same samples in the same order,
#     batched the same way; every tensor value, dtype, shape and stride equals
#     the per-sample path's (only the host storage layout and offsets differ,
#     DL_FAST_BATCH_ONESTORE), and the host-to-device copy is per tensor, so the model
#     receives the same device tensors.
#     MLPERF: a data-loader implementation change only. Same samples, same
#     order, same batches, same per-window counts. No sample is read before
#     RUN_START: the single pool is still forked with an empty sampler window
#     (cold-start bundle). Nothing is cached across steps or windows: every batch is
#     built from the dataset when the sampler yields it.
#     ARMED (every rank, tagged rank=R, at pool setup): "armed OK:
#     [fast-batch] train pools: fast builder (build_batch; DL_FAST_BATCH=1,
#     gin default) rank=R" ("env" instead of "gin default" when the variable
#     is set). Every rank, worker 0 of the train pool, at its first batch:
#     "armed OK: [fast-batch] DL_FAST_BATCH=1: batched yambda build (pid ...,
#     worker 0, first batch ...) [onestore] DL_FAST_BATCH_ONESTORE=2 (gin
#     default): 1 storage (... B, shared=True, uih/cand aliased into merged)
#     per batch". The DL_FAST_BATCH_ONESTORE setting line lists the train pool
#     ("fast-builder pools: train, eval"), and its pin-thread lines ("armed
#     OK: [onestore] ..." and "armed OK: [onestore-free-shm] ...") and
#     DL_PIN_FREE_SHM's "armed OK: [pin-free-shm] ... freed 1 shared
#     storage(s) ..." come with the first train batch. Must be ABSENT:
#     "[fast-batch] train pools: per-sample path", "[fast-batch] build_batch
#     not used", "[pin-free-shm] WARN".
#     PRECONDITION: the single chained train pool (DL_SINGLE_POOL=1, its gin
#     default). fast_batch_pools reads that switch exactly as the loader
#     does (window_single_pool()). When that switch is off (DL_SINGLE_POOL=0
#     or any value below 1 in the environment, an override of its gin
#     default, or a config without its binding: the loader then
#     builds the two alternating pools), the train pools keep the per-sample
#     path unless DL_FAST_BATCH is set in the environment, and each rank's
#     line reads "[fast-batch] train pools: per-sample path (DL_FAST_BATCH=0,
#     gin default 1 held because ... single train pool is off:
#     window_single_pool() False, env DL_SINGLE_POOL=0; env DL_FAST_BATCH=1
#     overrides) rank=R" (it names the value as set; when the variable is
#     not set, "DL_SINGLE_POOL unset: ..." replaces "env DL_SINGLE_POOL=0").
#     DL_FAST_BATCH=1 set in the environment still puts the two pools on the
#     batched builder; that is not a recommended configuration (the re-prime
#     burst described under DL_SINGLE_POOL gets denser when each batch builds
#     faster). Only DL_SINGLE_POOL is checked: the
#     loader shapes that never build the single pool although that switch is
#     on (PERSISTENT_LOADER=0 or DOUBLE_BUFFER=0) also take the batched
#     builder, as do the per-window consumers of the single pool
#     (TP_WARM_WINDOWS=0 or TRAIN_PIPELINE=0); their batches are
#     bit-identical.
#     Kill switch: DL_FAST_BATCH=0 (the train pools back on the per-sample
#     path; each rank's line then reads
#     "[fast-batch] train pools: per-sample path (DL_FAST_BATCH=0, env)
#     rank=R", and no train worker logs a "DL_FAST_BATCH=1: batched yambda
#     build" line). An integer read through env_int, like the other DL_*
#     switches. DL_PIN_FREE_SHM and DL_FAST_BATCH_ONESTORE keep their
#     own kill switches; eval loaders with DL_FAST_BATCH_EVAL=-1 follow this
#     switch.
fast_batch_pools.train_pools = @dlfb/env_int()
dlfb/env_int.key = "DL_FAST_BATCH"
dlfb/env_int.default = 1
# 3-stage TorchRec pipeline (TrainPipelineSparseDist): overlaps the H2D copy of
# batch N+2 and the embedding input_dist of batch N+1 with the dense fwd/bwd of
# batch N. ON by default; set TRAIN_PIPELINE=0 for the sequential fwd/bwd loop.
# Eval, in-window checkpointing and gradient clipping all behave as they do on the sequential
# path. $TP_WARM_WINDOWS (default 1) chains the per-window iterators so the
# pipeline prefetches across window boundaries instead of draining and refilling
# at each one — it needs DOUBLE_BUFFER=1. A num_train_batches cap is folded into
# the chained stream's own read limit, so truncated windows are warm-kept too.
streaming_train_eval_loop.use_pipeline = @tp/env_int()
tp/env_int.key = "TRAIN_PIPELINE"
tp/env_int.default = 1
# Queue current backward/update work before resolving the next batch's sparse
# input split sizes. Set False in a Gin override to wait for the split sizes first.
build_train_pipeline.defer_next_input_wait = True
#
# Streaming cold-page-cache read-ahead (extends the cold-start bundle's
#     first-batch prefetch; $DL_COLD_PREFETCH_STREAM; dlrm_v4/train/cold_prefetch.py,
#     hooks in train/utils.py). DEFAULT ON: bound to "1" below (the armed
#     values are 1 and auto, with DL_PRESTART=2, the gin default).
#     WHAT: the cold first-batch prefetch reads ahead only the rank's first batches. With
#     DL_COLD_PREFETCH_STREAM=1 the same background thread keeps walking the
#     rank's exact batch sequence (the sampler's windows, per-rank round-robin
#     slice, drop_last, per-window cap and resume skip) across window
#     boundaries for the whole run, issuing posix_fadvise(WILLNEED) for the
#     byte ranges of each group of DL_COLD_PREFETCH_GROUP batches (default 4)
#     and staying at most DL_COLD_PREFETCH_LEAD batches (default 64) ahead of
#     the batches the training pipeline has pulled (pacing counters the
#     loader updates). DL_COLD_PREFETCH_HORIZON caps the walk in per-rank
#     batches; the default is the whole stream, because a walk that stops
#     mid-run leaves every local rank to cold page faults at the same steps.
#     Needs the prefetcher armed (DL_PRESTART=2 or DL_COLD_PREFETCH=1|2); has
#     no effect otherwise and is one-shot only without the offline window
#     index.
#     MODES: DL_COLD_PREFETCH_STREAM=auto runs the walk only when the run
#     spans more than one node, i.e. when $NNODES is an integer > 1; NNODES=1, unset or not a positive
#     integer keeps it off (train_ranker treats a missing NNODES as one node).
#     1/true/on/yes force the walk on at any node count; unset,
#     0/off/false/no keep it off.
#     EVAL HOLDOUT: without the walk, the workers' cold faults on the train
#     data read the kernel's 4 MiB mmap read-around, which over the run also
#     caches the history ranges of the fixed eval holdout (its anchors sit
#     past every train window); the walk caches only the exact train ranges,
#     so the first holdout eval pass would read its data cold. With the walk
#     on, when the data-fraction eval cadence is on (EVAL_EVERY_DATA_PCT > 0)
#     the loop hands the walk the holdout anchors, the eval batch size, the
#     per-pass batch cap and the training steps to the first eval
#     (cold_prefetch.set_eval_plan; metadata only), and the walk also issues
#     the exact ranges of this rank's eval batches (the eval sampler's
#     per-rank slice, drop_last, cap): from DL_COLD_PREFETCH_EVAL_LEAD pulled
#     batches (default 1024) before that eval, one group of
#     DL_COLD_PREFETCH_GROUP eval batches at most every
#     DL_COLD_PREFETCH_EVAL_GAP_S seconds (default 1.0), only while the
#     train read-ahead waits on the consumer (it keeps priority); the rest
#     at once when the eval is fewer than 64 pulled batches away or the
#     train walk reaches the end of the stream first. An error in the eval
#     read-ahead turns only it off (one warning); the train walk goes on.
#     The holdout is the same at every pass, so this happens once per
#     run. A walk cut by DL_COLD_PREFETCH_HORIZON leaves the holdout to the
#     read-around. Inert with the walk off. Kill switch:
#     DL_COLD_PREFETCH_EVAL=0 (any value but unset/1/true/on/yes turns it
#     off).
#     IMPACT: the flushed page cache is refilled ahead of the
#     loader through the early windows, where each cold batch would otherwise
#     be one worker's serial chain of page faults, and ahead of the first
#     eval pass; the steady state is unchanged (the walk sleeps on the pacing
#     counters).
#     NUMERICS: none. Advice only: workers (train and eval) still read through
#     their own mmaps, so samples, order, batches, eval contents and RNG are
#     unchanged.
#     RULES: runs only after the sampler release, i.e. after RUN_START
#     (start() refuses earlier), inside the timed region, overlapping data
#     I/O with compute (training_rules.adoc); nothing is read
#     before RUN_START. The page cache is flushed before every run (the
#     MLPerf cache flush), so nothing carries over between runs.
#     ARMED log (rank 0): the cold prefetch's "[cold-prefetch] armed mode=fadvise
#     ..." line ends with " stream=on lead=... horizon=all group=..." and the
#     eval read-ahead fields (" eval=on at=<steps> lead=... gap_s=... cap=..."
#     or " eval=off(<why>)"); a "[cold-prefetch] eval holdout walk rank=0
#     batches=... bytes=... trigger=lead|urgent|stream_end ..." line when the
#     eval read-ahead is done, and a "[cold-prefetch] stream done ...
#     eval_batches=N eval_walked=N" line when the walk ends (bytes= in these
#     lines are the ranges requested by that rank; a node's ranks overlap, so
#     they are not device reads). Under auto the stream fields
#     carry " auto=multi-node(nnodes=N)"; when auto resolves off, rank 0 logs
#     one "[cold-prefetch] stream=auto resolved off: single node (nnodes=1)"
#     line instead and the armed line has no stream fields.
#     Knobs: DL_COLD_PREFETCH_STREAM,
#     DL_COLD_PREFETCH_LEAD, DL_COLD_PREFETCH_HORIZON, DL_COLD_PREFETCH_GROUP,
#     DL_COLD_PREFETCH_BATCHES, DL_COLD_PREFETCH_THREADS,
#     DL_COLD_PREFETCH_EVAL, DL_COLD_PREFETCH_EVAL_LEAD,
#     DL_COLD_PREFETCH_EVAL_GAP_S. DL_COLD_PREFETCH_STREAM is also
#     gin-bindable as apply_env_bootstrap.DL_COLD_PREFETCH_STREAM (a pre-set
#     env var still wins); bound to "1" below: the walk runs at every node
#     count ("auto" would leave one-node runs on the one-shot first-batch
#     prefetch). NUMERICS: none (page-cache advice only, see above).
#     Kill switch: DL_COLD_PREFETCH_STREAM=0 (emergency; env wins; the
#     one-shot first-batch prefetch is unchanged).
apply_env_bootstrap.DL_COLD_PREFETCH_STREAM = "1"
# -----------------------------------------------------------------------------
# Input pipeline, eval pass (DL_PIN_FREE_SHM also
# acts on every TRAIN batch, see its SCOPE). Same contract as the
# knobs above: each is gin-guarded (the binding turns it on; the code default when
# a binding is absent is OFF), every switch has an env kill switch of the
# same name, and a pre-set env var wins over gin. Both blocks sit here, next
# to what they extend: the eval batched builder, whose batches
# DL_FAST_BATCH_ONESTORE lays out, and the loaders' pin_memory
# (DL_PIN_MEMORY), whose pin threads run both.
#   DL_PIN_FREE_SHM: pin-thread shared-memory release (every loader that
#        pins: TRAIN and eval batches);
#   DL_FAST_BATCH_ONESTORE: one-storage fast-builder batches (by default the
#        eval pools and, with DL_FAST_BATCH, the single train pool).
# Precedence and interactions:
#   - DL_FAST_BATCH_ONESTORE changes only the layout of the batches the fast
#     builder makes (for the eval pools and, with DL_FAST_BATCH, the train
#     pool), and does nothing with no pool on that builder
#     (DL_FAST_BATCH_EVAL=0 and DL_FAST_BATCH=0). DL_PIN_FREE_SHM releases
#     each received batch's shared storages after its pin: one per batch
#     with DL_FAST_BATCH_ONESTORE, one per tensor otherwise. Each works
#     without the other.
#   - Train loader: neither changes the single chained pool's pacing
#     (pools, prefetch depth, schedule, batches).
#     DL_PIN_FREE_SHM also releases the train batches; with DL_SINGLE_POOL=0
#     that includes the re-prime burst of the two alternating pools at each
#     window boundary.
#   - The cold-start bundle's pre-start installs both switches before any
#     pool forks; nothing is read before RUN_START.
#
# Pin-thread shared-memory release (extends the
#     loaders' pin_memory; datasets/dataset.py Samples.pin_memory, switch
#     resolved by train/utils.py pin_free_shm_release, bound below).
#     WHAT: a batch a DataLoader worker hands to the trainer arrives in shared
#     memory: one unlinked shm file per KJT tensor, or one per batch with
#     DL_FAST_BATCH_ONESTORE. The loader's pin thread copies it into pinned memory
#     (Samples.pin_memory; pin_memory above, DL_PIN_MEMORY) and then drops
#     it. With this on, once the pinned copy is complete, the pin thread
#     releases the shared-memory pages of the batch it was given with one
#     madvise(MADV_REMOVE) per distinct shared storage, called through
#     ctypes, which drops the GIL for the call; the storage destructors that
#     run when the batch is dropped then find no pages left to free. Every
#     loader with pin_memory on: the train pool(s) and the eval pool. A
#     storage is released only if it is a file_descriptor-strategy shared
#     CPU storage, page aligned, not a file mapping, not aliased by the
#     pinned copy, and at most twice the bytes of this batch's tensors in it
#     (+ 64 KiB), so views covering less than about half of a larger shared
#     array never release it (collate builds fresh tensors per batch here).
#     Any other storage is left to its destructor, as before. The release
#     step never raises: on an error the pinned batch is complete and the
#     destructor frees the pages.
#     SCOPE: unlike DL_FAST_BATCH_ONESTORE, this is not limited to the eval
#     pass. It acts on EVERY TRAIN BATCH as well: the pin thread of the single
#     train pool (or of the two alternating pools with DL_SINGLE_POOL=0) releases
#     each train batch it receives, exactly as the eval pool's does.
#     DL_PIN_FREE_SHM=0 turns it off for train and eval batches alike.
#     WHY: without it each storage destructor unmaps its shm file and, as the
#     file's last user, frees its pages with the GIL held, on the pin thread.
#     The trainer's main thread needs the GIL for its host work (kernel
#     launches, input_dist, the eval forward) and waits for every such free:
#     at every received batch, and in bursts when many batches arrive at
#     once (with DL_SINGLE_POOL=0: the re-prime of the window after next at
#     each window boundary of the two alternating train pools).
#     IMPACT: the main thread no longer waits for the pin thread's page
#     freeing. That matters where the host side bounds the trainer: the warm
#     eval passes, and the window boundaries of the two alternating train
#     pools (DL_SINGLE_POOL=0). With the single pool there is no
#     boundary burst to remove. COST: one madvise call per received storage
#     on the pin thread; no extra copy or memory.
#     MLPERF: a data-loader memory-release change only. The pinned batch the
#     trainer consumes is complete before anything is released; the same
#     samples reach the model in the same order, batched the same way, with
#     every tensor value identical. No caching, no compute, schedule or
#     numerics change; it acts only on batches already received, so nothing
#     is read before RUN_START.
#     NUMERICS: BIT-IDENTICAL inputs (the pinned batches are unchanged).
#     CONTRACT: nothing reads a batch's unpinned input after
#     Samples.pin_memory; true for the DataLoader pin thread, its only caller
#     (a released storage reads as zeros).
#     ARMED (every rank process, by its pin thread, at the first released
#     batch): "armed OK: [pin-free-shm] DL_PIN_FREE_SHM=1 (gin default): freed
#     ... shared storage(s), ... B, GIL-free after pinning (pid ...)" ("env"
#     instead of "gin default" when the variable is set). Every rank, at pool
#     setup (the setting, not the proof): "[pin-free-shm] pin threads:
#     release each received batch's shared memory after pinning
#     (DL_PIN_FREE_SHM=1, gin default) rank=R" ("; inert: no loader pins,
#     DL_PIN_MEMORY=0" is added when no pin thread runs). Must be ABSENT:
#     "[pin-free-shm] WARN" (a storage kept by a guard or a failed release;
#     one line per process, with counts).
#     Kill switch: DL_PIN_FREE_SHM=0 (every pin thread leaves the shared
#     memory to the storage destructor; no "armed OK:
#     [pin-free-shm]" line, and each rank's setting line reads
#     "[pin-free-shm] pin threads: shared memory left to the storage
#     destructor (DL_PIN_FREE_SHM=0, env) rank=R"). An integer read through
#     env_int, like the other DL_* switches.
#     Without pin_memory (DL_PIN_MEMORY=0) no pin thread runs and this
#     does nothing.
pin_free_shm_release.enabled = @dlpfs/env_int()
dlpfs/env_int.key     = "DL_PIN_FREE_SHM"
dlpfs/env_int.default = 1
#
# One-storage fast-builder batches (extends the eval batched builder;
#     datasets/yambda.py DLRMv4YambdaDataset.build_batch and
#     datasets/dataset.py Samples.pin_memory; switch resolved by
#     train/utils.py fast_batch_onestore, bound below).
#     WHAT: every batch the fast builder makes (every eval batch, and
#     every train batch with DL_FAST_BATCH) is laid out in ONE storage
#     instead of one storage per KJT tensor. The merged values and lengths
#     (the KJT the embedding lookup consumes) are two 4 KiB-aligned slices of
#     it, and the UIH and candidate values and lengths are views of the two
#     halves of those slices: the merged tensors are [UIH | candidates]
#     already, so each value is held once and the worker skips the two
#     concatenations. Inside a DataLoader worker the storage is in shared
#     memory, so a batch reaches the trainer as one shared-memory file
#     instead of six. The loader's pin thread pins such a batch with one
#     pinned allocation and one copy of that storage (only when the batch's
#     tensors cover it up to the alignment padding) and rebuilds the three
#     KJTs as views of the pinned copy (same offsets, sizes and strides);
#     every other batch (the per-sample builder's, i.e. the train pools' with
#     DL_FAST_BATCH=0) is built and pinned per tensor. With
#     DL_PIN_FREE_SHM the pin thread then releases the batch's one shared storage.
#     WHY: the warm holdout eval pass is bound by the trainer process's host
#     side. What a received batch costs that process grows with its bytes:
#     faulting in its shared-memory pages, the pinned copy and, without
#     DL_PIN_FREE_SHM, freeing those pages under the GIL. The per-tensor layout carries
#     the UIH and candidate values twice: in their own tensors and in the
#     merged tensors.
#     IMPACT: a received eval batch is about half the bytes, one storage, one
#     pinned allocation and one host copy, so the warm eval passes get
#     shorter where the trainer's host side is the bottleneck. A pass whose
#     data is not yet in the page cache stays bound by disk reads. With
#     DL_FAST_BATCH every received train batch takes the same layout (one storage, one
#     pinned allocation, one host copy); with the train pools on the
#     per-sample builder training steps are not touched. COST: no extra copy
#     or memory; the host-to-device copy moves the same tensors as before. A
#     batch's views share one storage, which is freed when the last of them
#     is dropped (the batch is dropped whole).
#     MLPERF: a data-loader memory-layout change only. Each eval pass (and,
#     with DL_FAST_BATCH, each train window) reads the same samples in the same
#     order, batched the same way; every tensor value, dtype, shape and
#     stride is identical (only the storage
#     offsets of the host views differ), and the host-to-device copy copies
#     each tensor on its own, so the model receives the same device tensors.
#     No sample is read before RUN_START: the pools are still forked with
#     empty sampler windows (cold-start bundle). Nothing is cached across eval
#     passes or train steps: every batch is built again from the dataset.
#     NUMERICS: BIT-IDENTICAL inputs (the pinned batches and their device
#     copies).
#     CONTRACT: nothing writes a batch's tensors on the host before the
#     host-to-device copy (until then the UIH/candidate KJTs share memory
#     with the merged KJT; true in this tree), and that copy stays per
#     tensor (KeyedJaggedTensor.to): a single-buffer copy of the storage
#     would carry the aliasing to the device, where an in-place op or
#     torchrec's KJT.clear_storage() on one KJT would change the others.
#     ARMED (every rank): worker 0 of each pool that uses the fast builder
#     extends its fast-batch line at its first batch: "armed OK:
#     [fast-batch] DL_FAST_BATCH_EVAL=1: batched yambda build (...) [onestore]
#     DL_FAST_BATCH_ONESTORE=2 (gin default): 1 storage (... B, shared=True,
#     uih/cand aliased into merged) per batch" (DL_FAST_BATCH=1 for the train
#     pool). The pin thread of every rank
#     process, at the first batch it pins as one storage: "armed OK:
#     [onestore] DL_FAST_BATCH_ONESTORE=2 (gin default): batch pinned as one
#     storage (pid ..., 6 tensors, ... B)" and, with DL_PIN_FREE_SHM, "armed OK:
#     [onestore-free-shm] DL_FAST_BATCH_ONESTORE=2 (gin default)
#     DL_PIN_FREE_SHM=1 (gin default): batch pinned as one storage, then
#     freed 1 shared storage(s), ... B, kept 0 (pid ...)" ("env" instead of
#     "gin default" when the variable is set, "env: <value>" when that value
#     is not 2). With DL_FAST_BATCH these come with the first train batch; with
#     the eval pools alone on the fast builder, with the first eval. Every
#     rank, at pool setup (the setting, not the proof): "[onestore]
#     fast-builder batches: one storage per batch, UIH/candidate tensors are
#     views of the merged tensors, pinned with one copy
#     (DL_FAST_BATCH_ONESTORE=2, gin default; fast-builder pools: train,
#     eval) rank=R" ("eval" alone with the train pools on the per-sample
#     path; "inert: no pool uses the fast builder" replaces the pool list
#     when none does). Must be ABSENT: "[pin-free-shm] WARN" (the size guard
#     never keeps a one-storage batch).
#     Kill switch: DL_FAST_BATCH_ONESTORE=0 (one storage per tensor and the
#     per-tensor pin; no "[onestore]" arming
#     line, and each rank's setting line reads "[onestore] fast-builder
#     batches: one storage per tensor (DL_FAST_BATCH_ONESTORE=0, env)
#     rank=R"). An integer read through env_int, like the other DL_*
#     switches (any value > 0 selects the layout). With no pool on the fast
#     builder (DL_FAST_BATCH_EVAL=0 and DL_FAST_BATCH=0) this does nothing.
fast_batch_onestore.level = @dlfbos/env_int()
dlfbos/env_int.key     = "DL_FAST_BATCH_ONESTORE"
dlfbos/env_int.default = 2
#
# Fixed eval-holdout window range (held-out users' anchors over these windows
# form the eval set evaluated at EVERY eval step). Default 299 = the window just
# past the ts=0..298 training range. Set
# EVAL_HOLDOUT_TS<0 to instead resolve at runtime to start_ts+num_train_ts (also
# stable across resume). EVAL_HOLDOUT_NUM_WINDOWS widens the eval span.
streaming_train_eval_loop.eval_holdout_ts = @eht/env_int()
eht/env_int.key     = "EVAL_HOLDOUT_TS"
eht/env_int.default = 299
streaming_train_eval_loop.eval_holdout_num_windows = @ehnw/env_int()
ehnw/env_int.key     = "EVAL_HOLDOUT_NUM_WINDOWS"
ehnw/env_int.default = 1
# num_train_batches / num_eval_batches unset => consume each full window.
# Set them (e.g. via gin) to cap per-window steps for short experiments.

# Default (non-streaming) train-eval loop variables; used unless
# `--mode streaming-train-eval` selects the temporal-order path configured above.
train_eval_loop.num_epochs = 1
train_eval_loop.metric_log_frequency = 50
train_eval_loop.eval_frequency = 500
train_eval_loop.num_eval_batches = 200
train_eval_loop.checkpoint_frequency = 1000000000  # disable mid-training checkpoints (disk-full guard)
train_eval_loop.output_trace = True
# 3-stage TorchRec pipeline: overlaps the embedding all-to-all (the dominant
# exposed-comm bottleneck) with dense fwd/bwd. Set False to fall back to the
# sequential fwd/bwd loop.
train_eval_loop.use_pipeline = False

# Run name → recommendation/results/<run_name>/ (override via $RUN_NAME env).
RUN_NAME = @run/env_path()
run/env_path.key     = "RUN_NAME"
run/env_path.default = "default"
run_results_dir.run_name = %RUN_NAME

# profiler: capture a 5-step window starting at step 52, every rank.
# `trim_warmup = True` (default) post-filters the chrome trace so only the 5
# `active` steps appear; the 1 WARMUP step still runs (lets CUPTI/ROCprof
# settle) but its events are dropped from the output file.
#
# THROWAWAY FIRST WINDOW. The first window a process ever records pays a
# one-time initialization of the ROCm tracing backend (roctracer library load,
# activity-buffer allocation, dispatch + HIP-API callback registration, driver
# profiling session). Contended across 8 processes that lands as dead host
# time at the top of the first recorded step, which renders as a
# cold-start stall and a fake cross-rank skew. `Profiler.warmup`
# cannot absorb it: `_multi_window_schedule` puts the backend's start_trace()
# on the WARMUP->RECORD edge, so the init always lands inside the first
# RECORDED step no matter how long the warmup is.
#
# A second window in the same process re-arms cheaply -- stop_trace() tears down
# the session, not the init. The first window exists only to absorb the init. Its trace_step42_rank*.json
# files are garbage by construction -- delete them, keep trace_step52_rank*.json.
# Files are named by their first EXPORTED step (start + skip_head).
#
# WINDOW PLACEMENT. Windows:
#   first  [41, 48]: warmup 40, recorded 41-48 -> trace_step42_* (throwaway)
#   second [51, 58]: warmup 50, recorded 51-58, 51 = lead-in head (dropped from
#                    the export), 52-56 exported, 57-58 unexported tail
# The last WARMUP step before each window also runs a full gc.collect() (see
# Profiler.step) so the previous window's export garbage is not collected
# inside a recorded step. The metric-log drain at 59 (METRIC_LOG_FREQ=20) is
# outside the recorded window. Window-boundary steps: see "WINDOW-BOUNDARY
# STEPS" below; at 1n the exported step 56 is one.
Profiler.trace_steps = [41, 51]
Profiler.warmup = 1
# THROWAWAY TAIL STEPS. Symmetrically to the init above, the tail of a window
# pays the tracing-session teardown. What teardown costs is cross-rank
# SKEW, not a wall-time shift: the last recorded steps go ragged as the eight
# ranks finish flushing at different times. Recording two steps past
# `keep_active = 5` moves the ragged ones off the exported steps.
#
# THROWAWAY HEAD STEP (`skip_head = 1`, host-sync-free step). `align_ranks`
# below drains the device and barriers before the first recorded step. With
# the host-sync-free step the host normally runs one step ahead of the GPU, so
# that first step starts on an empty launch queue with no host lead and is not
# a representative training step (it runs shorter than the steps after it).
# `skip_head = 1` records it and drops it from the export. Together: record
# 51-58 (`active = 8`), drop 51, export 52-56, leave 57-58 as tail headroom.
# LEAD-IN. With the host one step ahead, the GPU is still running step 51
# when CPU step 52 begins, so trimming 51 by launch
# would leave the compute stream blank at the top of the export. The dropped
# head step is kept as a labelled lead-in instead (`ProfilerStep#51 (lead-in,
# not exported)`, args.lead_in); clipping it at the earliest exported CPU step
# start across ranks gives a stitched trace that opens with step 51's tail
# running into step 52 rather than a gap.
# Profiler warns at construction if a sync-free window has no unexported head
# or tail step.
#
# CAPTURE-WINDOW EVENTS. A streaming window boundary (`_window_boundary_barrier`
# drains the run-ahead queue; the new window's first forward can stall), an
# eval pass, or a METRIC_LOG_FREQ metrics drain inside the window makes that
# step long for reasons that are not step time. The training loop notes these
# on the profiler (only when tracing); one inside an exported step logs a
# warning and is listed in the trace under
# traceRendering.capture_window_events, and the rebuild report's
# traceRendering.gpu_annotation_rebuild.step_wall.extended_steps names steps
# far above the window median (span or start-to-start period) with the host
# call that spent the time.
#
# WINDOW-BOUNDARY STEPS. With START_TS=0 the first step of each data window
# (window-boundary barrier) is, by topology (global batch 8192 / 16384 /
# 32768):
#   1n: ... 39 46 56 68 84 102     2n: ... 38 47 57 68 80 95
#   4n: ... 42 51 61 72 85 100
# The default export 52-56 avoids them at 2n (57 is a tail step) and 4n (51 is
# the dropped head step) but contains 1n step 56. That is inherent to step 52
# at 1n. With the host-sync-free run-ahead the barrier's hipStreamSynchronize
# drains the queue, so on the CPU step 56 reads long while its main-stream GPU
# span stays near a normal step. Read 56 at 1n as a boundary step. A
# METRIC_LOG_FREQ=20 drain is at step 19 mod 20 (59, 79, ...).
# Boundary-free alternative at 1, 2 and 4n alike (exports 62-66, files
# trace_step62_*; the 1n and 2n boundaries at 68 and the 4n one at 61 fall
# on unexported steps):
#   Profiler.trace_steps = [41, 61]   (active = 8, skip_head = 1,
#                                      keep_active = 5, warmup = 1 unchanged)
# 1n only, 5 clean steps 48-52: Profiler.trace_steps = [37, 47]
# (trace_step48_*). Each recorded window [s, s+7] must stay inside one data
# window and off 59/60 for its exported steps to be boundary-free.
# These step numbers hold for START_TS=0 without a resume; other START_TS or
# datasets move the boundaries (the first step of window ts is the sum of
# the earlier windows' per-rank batch counts, ~floor(anchors / global batch);
# windows with fewer anchors than one global batch train no step).
Profiler.active = 8
Profiler.skip_head = 1
Profiler.keep_active = 5
# Move the export past a recorded window-boundary step (detected from the
# barrier in the trace) when the window recorded enough steps. Off: with the
# values above it cannot move (needs active >= skip_head + 2*keep_active + 1)
# and a longer window runs into the metric-log steps; place trace_steps
# instead (see above). When on, the file keeps its trace_steps name and
# traceCapture.exported_steps says which steps were kept.
Profiler.skip_boundary_steps = False
# PURPOSE: measurement fidelity ONLY. This is not a training optimization and
# it cannot make training faster or slower. `Profiler` is constructed only when
# $OUTPUT_TRACE is set (`Profiler(rank) if output_trace else None`), so on a
# normal run this code does not execute at all. Its only job is to make the
# captured steps resemble untraced steps more closely than they otherwise would.
#
# WHAT IT DOES: one `torch.cuda.synchronize()` + `dist.barrier()` on the last
# WARMUP step before each window opens, so all ranks enter the first RECORDED
# step from the same instant.
#
# WHY: arming Kineto is per-process and unsynchronized, so without this the
# first RECORDED step absorbs the cost of turning the profiler ON -- a cost an
# untraced run never pays. Ranks enter that step skewed, and the skew draws as
# exposed collective that does not exist in real training. That step measures
# the profiler, not the model.
#
# WHAT IT COSTS, stated precisely: the barrier does NOT delete the rank skew,
# it RELOCATES it into the WARMUP step, which is never exported. The wait still
# happened; it is simply not in the file. So the first RECORDED step comes out
# slightly OPTIMISTIC, but much closer to an untraced step than without the
# barrier, which is why it is on.
#
# CONSEQUENCE FOR READING A CAPTURE: the first RECORDED step is a boundary
# step, not a training step. Nothing fires on steps 2..N, so those are clean.
# With `skip_head = 1` the barriered step is 51, which is recorded but not
# exported, so the exported steps 52-56 do not carry it. Run-to-run deltas are
# unaffected -- every run is barriered identically at the same step.
#
# Deliberately once per window, not per step: a per-step barrier would
# serialize the pipeline's run-ahead and change what is being measured. The
# barrier itself happens during WARMUP, so it is not in the captured trace.
Profiler.align_ranks = True
# Post-export GC (dlrm_v4/utils.py Profiler.step, traced runs only).
# Code default ON (absent
# or "1"); the binding below states it; the env var of the same name wins
# over gin.
#   WHAT: one gc.collect() on every rank right after the export
#   (RECORD_AND_SAVE) of a trace window that no later window follows, so the
#   first full collection after the export is paid at one unexported step
#   on every rank instead of at each rank's own later CPython collection (one
#   pause per rank, at a different step on every rank, each stalling all
#   ranks through the per-step collectives). A window that another window
#   follows is covered by that window's pre-window collection (above).
#   NUMERICS: none; host objects only (no tensor, RNG, data order or kernel).
#   Measurement fidelity only: untraced runs never construct the Profiler.
#   ARMED (rank 0, once per traced run): "Profiler: gc.collect() after trace
#   export at profiler step <n>: <k> unreachable object(s), <ms> ms". Must be
#   ABSENT: "gc after trace export failed". Diagnostic (env only, default
#   off): DLRM_HSTU_FP8_GC_TRACE=1 logs every long generation-2 collection
#   per rank ("[gc2] ...").
#   Opt out (kill switch): DLRM_HSTU_FP8_PROF_POST_GC=0.
apply_env_bootstrap.DLRM_HSTU_FP8_PROF_POST_GC = True
# Diagnostic env knobs for the post-export GC (not set in production):
#   DLRM_HSTU_FP8_GC_TRACE=1 (env only; unset/0 = off; no gin binding; only
#   the exact value "1" arms it). Traced runs only: the Profiler that installs
#   it exists only with OUTPUT_TRACE=1. It appends a gc.callbacks hook on
#   every rank that times each generation-2 (full) collection and logs those
#   of >= 50 ms as "[gc2] rank=R profiler_step=P full collection X ms
#   collected=C uncollectable=U" (armed line: "[gc2] rank=R full-collection
#   trace armed (>= 50 ms)"). Log only: it never triggers, skips or changes a
#   collection. The hook runs on every collection, so never set it in a timed
#   or production run.
# Where the per-rank chrome traces are written. The default lives inside the
# container: /tmp is NOT one of the bind mounts (only $REPO_MOUNT, $DATA_MOUNT
# and the optional node-local dataset copy are), so a capture is destroyed when
# the next job re-provisions the container. Pointing this at shared storage
# makes the capture outlive the container and removes the copy-out race.
# Overridable per run via $TRACE_DIR so concurrent captures do not overwrite
# each other.
tdir/env_path.key     = "TRACE_DIR"
tdir/env_path.default = "/tmp/dlrm_v4_traces"
Profiler.trace_dir = @tdir/env_path()

# logger variables
# TensorBoard event dir. DISABLED BY DEFAULT (empty path): the shared-NFS
# tfevents writer is the only metrics sink whose I/O error is uncaught, so a
# transient remote-I/O error on the shared filesystem crashes the trainer.
# Nothing in this pipeline reads TensorBoard — eval-window AUCs come from the durable
# `<LOG>.metrics.jsonl` sink (try/except-guarded) and the text run log. An empty
# path makes MetricsLogger install a no-op writer (see _NoOpSummaryWriter).
# Re-enable for a run by setting $TENSORBOARD_LOG_PATH to a non-empty dir.
MetricsLogger.tensorboard_log_path = @tbp/env_path()
tbp/env_path.key     = "TENSORBOARD_LOG_PATH"
tbp/env_path.default = ""
MetricsLogger.world_size = 8
# MLPerf convergence target: run stops when the selected eval AUC reaches it.
# 0.75 is the dlrmv4 quality target, so a default run early-stops at convergence
# and emits RUN_STOP with status=success. Set $AUC_THRESHOLD=1.0 to make the
# target unreachable and train through all windows instead (no early stop).
MetricsLogger.auc_threshold = @at/env_float()
at/env_float.key     = "AUC_THRESHOLD"
at/env_float.default = 0.75
# EVAL_ACCURACY + early-stop are driven by per-window AUC (window_auc) vs the
# threshold above.
# Lifetime-AUC backend, selectable independently for the train cumulative AUC and
# the eval cumulative ("lifetime_*") AUC. Both default to "binned":
#   "binned" = BinnedCumulativeAUC: exact-cumulative AUC from an O(bins) score
#     histogram (additive all-reduce, memory independent of #samples/#windows).
#   "capped" = LifetimeAUCMetricComputation: AUC over a trailing buffer of
#     `lifetime_auc_window` samples/rank (legacy; per-rank buffer all-gathered).
# Override per-run via $TRAIN_LIFETIME_AUC_MODE / $EVAL_LIFETIME_AUC_MODE.
MetricsLogger.train_lifetime_auc_mode = @tlam/env_str()
tlam/env_str.key     = "TRAIN_LIFETIME_AUC_MODE"
tlam/env_str.default = "binned"
MetricsLogger.eval_lifetime_auc_mode = @elam/env_str()
elam/env_str.key     = "EVAL_LIFETIME_AUC_MODE"
elam/env_str.default = "binned"
# Score-histogram resolution for the "binned" backend. Higher = finer AUC
# resolution at O(bins) memory. Override via $CUMULATIVE_AUC_BINS.
MetricsLogger.cumulative_auc_bins = @cab/env_int()
cab/env_int.key     = "CUMULATIVE_AUC_BINS"
cab/env_int.default = 100000
# Trailing-buffer size (samples/rank) for the "capped" backend. Override via
# $LIFETIME_AUC_WINDOW. Ignored when the backend is "binned".
MetricsLogger.lifetime_auc_window = @law/env_int()
law/env_int.key     = "LIFETIME_AUC_WINDOW"
law/env_int.default = 10000000
# Checkpointing disabled by default — a full DMP checkpoint is ~100s of GB and
# the streaming loop always saves on the final window. save_dmp_checkpoint
# no-ops on the empty path. Set $CKPT_PATH to a directory to re-enable; the
# load path auto-resolves to the highest-numbered numeric subdir inside it.
save_dmp_checkpoint.path = @ckpt/env_path()
ckpt/env_path.key     = "CKPT_PATH"
ckpt/env_path.default = ""
load_dmp_checkpoint.path = @ckpt/env_path()
# Retention: keep only the most-recent N numeric subdirs after each successful
# save (atomic rename + prune-older). Override via $KEEP_LAST_N.
save_dmp_checkpoint.keep_last_n = @kln/env_int()
kln/env_int.key     = "KEEP_LAST_N"
kln/env_int.default = 1
# In-window checkpoint cadence for streaming-train-eval. 0 (default) = end-of-
# window only; on crash mid-window the partial progress is lost. Set N>0 (e.g.
# via $IN_WINDOW_CKPT_FREQ) for batch-granularity exact-once-on-resume — paired
# with the auto-latest load above, the resumed run skips the K already-trained
# batches of the partial window and continues with bit-equal trajectory.
streaming_train_eval_loop.in_window_checkpoint_frequency = @iwcf/env_int()
iwcf/env_int.key     = "IN_WINDOW_CKPT_FREQ"
iwcf/env_int.default = 0
# Global-step checkpoint cadence: save whenever the monotonic train global_step
# crosses a multiple of N (a true "every 1000 steps" trigger that spans windows
# and survives resume). 0 (default) = off. Override via $CKPT_STEP_FREQ.
streaming_train_eval_loop.checkpoint_step_frequency = @csf/env_int()
csf/env_int.key     = "CKPT_STEP_FREQ"
csf/env_int.default = 0
# Wall-clock checkpoint cadence in seconds: save when >= this many seconds have
# elapsed since the last save. Rank 0 owns the clock and broadcasts the decision
# so all ranks save together. Default 3600 = hourly saves; set 0.0 to disable. Override via $CKPT_TIME_INTERVAL_S.
streaming_train_eval_loop.checkpoint_time_interval_s = @ctis/env_float()
ctis/env_float.key     = "CKPT_TIME_INTERVAL_S"
ctis/env_float.default = 3600.0
# Skip the timer broadcast when the resolved checkpoint destination is empty.
# False restores the requested timer without changing checkpoint save cadences.
streaming_train_eval_loop.skip_checkpoint_polling_when_disabled = True
# Cap each train_ts window's batch count (e.g. for short test runs).
# Unset / 0 = use the full window.
streaming_train_eval_loop.num_train_batches = @ntb/env_int()
ntb/env_int.key     = "NUM_TRAIN_BATCHES"
ntb/env_int.default = 0
# Cap each eval (full-holdout) window's batch count. Unset / <=0 = consume the
# full eval window (the genuine full-holdout NE/AUC). Set >0 via $NUM_EVAL_BATCHES to subsample eval for fast validation.
streaming_train_eval_loop.num_eval_batches = @neb/env_int()
neb/env_int.key     = "NUM_EVAL_BATCHES"
neb/env_int.default = 0
# Test-only failure injection: when >=0 and metric_logger.global_step['train']
# reaches this, the process exits with code 42 right after the in-window save
# fires. Used to test streaming resume.
streaming_train_eval_loop.die_at_step = @das/env_int()
das/env_int.key     = "DIE_AT_STEP"
das/env_int.default = -1
#
# -----------------------------------------------------------------------------
# Teardown: clean process exit after a successful run
#     (dlrm_v4/train/clean_exit.py, called from
#     train_ranker.py). NOT a gin knob: env DL_TEARDOWN_HARD_EXIT, read once,
#     at exit. Default ON (unset = on).
#     WHAT: streaming-train-eval only. Once the loop has returned (after
#     RUN_STOP when MLPerf logging is on; MLPERF_LOGGING=0 runs take the same
#     exit), the input pools are closed (DL_TEARDOWN_CLOSE_POOLS) and the
#     teardown barrier and destroy_process_group have run, every rank runs the
#     trainer's own exit hooks (TSPEC's monitor exit report and recorder
#     close), rank 0 logs "[teardown] clean exit: os._exit(0) after
#     barrier/destroy_process_group (DL_TEARDOWN_HARD_EXIT=1) rank=0", the
#     rank SIGKILLs its remaining DataLoader worker processes without joining
#     them, the logs and stdio are flushed, and the process ends with
#     os._exit(0) instead of the interpreter's normal exit (atexit callbacks,
#     DataLoader worker terminate + join, finalization). The kill replaces
#     that terminate: a worker the close did not signal (close off, a stalled
#     close) can otherwise hang at its own exit, and every worker holds the
#     spawn parent's process sentinel, so the job step would wait for it.
#     Success path only: a run that raises keeps its traceback and nonzero
#     exit code. A TunableOp tuning or record-untuned session keeps the normal
#     exit (a precaution for its results file; rank 0 logs "[teardown] clean
#     exit skipped: ...").
#     WHY: in the normal exit, a daemon thread of the input pipeline (the train
#     pool's close helper, or a pin-memory thread) can still be freeing
#     tensors inside torch, with the GIL released, when the main thread starts
#     finalizing the interpreter. CPython 3.12 then ends that thread with
#     pthread_exit(), the unwind reaches a noexcept torch frame and the rank
#     aborts ("terminate called without an active exception", SIGABRT), so a
#     run that has logged RUN_STOP ends with a nonzero job exit code.
#     os._exit never finalizes the interpreter, so this cannot happen.
#     MLPERF: acts after the loop has returned, i.e. after RUN_STOP and the
#     result are logged; nothing before RUN_STOP changes. NUMERICS: none.
#     Kill switch: DL_TEARDOWN_HARD_EXIT=0 (the normal interpreter exit; rank
#     0 logs "[teardown] DL_TEARDOWN_HARD_EXIT=0: normal interpreter exit
#     (atexit, finalization)").
